لية العقلية التي مكنته من هذا العزل والتركيز بـ","A":"أ) الإدراك الحسي","B":"ب) الانتباه الانتقائي","C":"ج) قانون الغلق الإدراكي","D":"د) قانون الشكل والأرضية","answer":"B","topic_question_no":2},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"بينما كان مهندس مندمجًا بتركيز شديد في رسم مخطط معقد يتطلب مجهودًا واعيا وتخطيطًا مسبقًا، سقطت لوحة زجاجية ضخمة بجواره محدثة صوتًا مدويا جعله يلتفت إليها فورًا دون تفكير. يمثل التفات المهندس لصوت الزجاج تطبيقًا لـ","A":"أ) الانتباه الإرادي","B":"ب) التهيؤ الذهني","C":"ج) الانتباه اللإرادي","D":"د) الخداع الإدراكي","answer":"A","topic_question_no":3},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يواجه مراقب الكاميرات الأمنية صعوبة بالغة في متابعة عشرين شاشة في نفس اللحظة بوضوح ووعي كامل، مما يجعله يفقد بعض التفاصيل الهامة إذا حدثت في وقت متزامن. هذا القصور يفسر في علم النفس بمفهوم","A":"أ) الخداع الإدراكي","B":"ب) التحيز الإدراكي","C":"ج) مدى الانتباه","D":"د) قانون التقارب","answer":"B","topic_question_no":4},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"اعتاد حارس ليلي على سماع صوت طنين رتيب ومستمر يصدر عن مولد الكهرباء دون أن يعيره اهتمامًا، ولكن عندما انقطع هذا الطنين وتوقف المولد فجأة، انتبه الحارس فورًا وتوجه لتفقد الأمر. العامل الخارجي الذي وجه انتباه الحارس هنا هو","A":"أ) حداثة المثير","B":"ب) تباين المثير","C":"ج) تغير المثير","D":"د) شدة المثير","answer":"C","topic_question_no":5},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"طالب ينتظر بشغف إعلان نتائج المسابقة التي شارك فيها، وعندما سمع صوت المذيع عبر الإذاعة المدرسية، التفت فورًا منصتًا بكل حواسه قبل حتى أن يذكر المذيع اسم الفائز. العامل الداخلي الذي سرّع من انتباه الطالب في هذا الموقف هو","A":"أ) الدوافع والميول","B":"ب) التهيؤ الذهني والتوقع","C":"ج) الحالة الجسدية","D":"د) الحاجات العضوية","answer":"A","topic_question_no":6},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"تصل الإشارات العصبية القادمة من العين إلى القشرة المخية كإشارات مجردة لا معنى لها، حتى يتدخل العقل ليعطيها دلالة ومغزى بناءً على خبرات الشخص السابقة ليعرف أن ما يراه هو سيارة أو شجرة. العملية المعرفية المسؤول عن إعطاء هذا المعنى هي","A":"أ) الإحساس","B":"ب) الإدراك","C":"ج) الانتباه","D":"د) الترميز","answer":"D","topic_question_no":7},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يسهل على القارئ تمييز الكلمات المكتوبة بخط أسود عريض عندما تُطبع على ورق أبيض ناصع، بينما يجد صعوبة في قراءتها إذا كُتبت بخط رمادي على ورق فضي. يعكس هذا الموقف أحد قوانين الإدراك وهو","A":"أ) قانون الغلق","B":"ب) قانون التقارب","C":"ج) قانون حداثة المثير","D":"د) قانون الشكل والأرضية","answer":"C","topic_question_no":8},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"صمم أحد المعلنين لوحة إعلانية بيضاء تمامًا، ووضع في منتصفها نقطة حمراء صغيرة جدًا ومضيئة، فلاحظ أن أعين المارة تنـجذب فورًا نحو هذه النقطة رغم صغر حجمها. يعتمد نـجـاح هذا الإعلان على عامل","A":"أ) تغير المثير","B":"ب) تكرار المثير","C":"ج) تباين المثير","D":"د) حركة المثير","answer":"D","topic_question_no":9},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يسير ثلاثة أصدقاء في الشارع؛ الأول يشعر بجوع شديد فجذبته رائحة مطعم قريب، والثاني طبيب انتبه لصوت سيارة إسعاف، والثالث منزعج ومنهك فلم يلتفت لشيء. العوامل الذاتية التي وجهت انتباههم على الترتيب هي","A":"أ) الحاجات العضوية، الخبرة السابقة والاهتمامات، الحالة النفسية والجسدية","B":"ب) الدوافع والميول، التهيؤ الذهني، الحاجات العضوية","C":"ج) الخبرة السابقة، الحاجات العضوية، الدوافع والميول","D":"د) الحاجات العضوية، التهيؤ الذهني، الدوافع والميول","answer":"B","topic_question_no":10},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"أثناء شرح المعلم لدرس معقد، يركز الطالب بكل وعي وإرادة على كلمات المعلم رغم شعوره بالتعب ومحاولته الجادة لعدم الانشغال بمن حوله. هذا النوع من التركيز يمثل","A":"انتباهاً لا إرادياً ينـجذب فيه تلقائياً","B":"انتباهاً إرادياً يختار فيه التركيز بوعي وإرادة","C":"عملية الإدراك التي تضفي المعنى","D":"قانون الغلق في تنظيم المثيرات","answer":"B","topic_question_no":11},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"بينما كان الموظفون يعملون في هدوء تام داخل المكتب، صدر فجأة صوت إنذار حريق مدوٍ جعل الجميع يلتفتون نحوه بلا تفكير وراء مصدر الصوت. هذا الموقف يجسد حالة من","A":"الانتباه الإرادي المخطط له","B":"الإدراك التحيزي للمثيرات","C":"الانتباه اللا إرادي لمثير قوي مفاجئ","D":"الخداع الإدراكي الحسي","answer":"C","topic_question_no":12},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يعتمد مصممو الإعلانات الطرقية على استخدام ألوان فاقعة وإضاءات مبهرة جداً مقارنة باللوحات العادية لجذب عيون المارة بسرعة. العامل الخارجي الموجه للانتباه والمستخدم في هذا التكتيك هو","A":"تغير المثير وانقطاعه","B":"حركة المثير","C":"حداثة المثير","D":"شدة المثير","answer":"D","topic_question_no":13},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"ينتظر مسافر في صالة المطار المزدحمة إعلان رحلته رقم 505 وسط عشرات النداءات المختلفة، لم ينتبه إلا للنداء الذي ذكر رقم رحلته. العامل الداخلي الذي جعله أسرع انتباهاً لهذا المثير تحديداً هو","A":"الدوافع والميول","B":"الحالة النفسية والجسدية كالتعب","C":"التهيؤ الذهني (التوقع والانتظار)","D":"الحاجات العضوية والبيولوجية","answer":"C","topic_question_no":14},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"تميل بعض المحالات التجارية إلى وضع نقطة حمراء كبيرة وسط صفحة إعلانية بيضاء فارغة تماماً، مما يجبر القارئ على الانتباه لها فوراً. يعتمد هذا الأسلوب على أحد العوامل الخارجية لتوجيه الانتباه وهو","A":"تباين المثير وبروزه واختلافه التام عما حوله","B":"تكرار المثير بشكل رتيب","C":"حداثة المثير لكونه شيئاً غير مألوف","D":"حركة المثير وانتقاله","answer":"A","topic_question_no":15},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"بعد استقبال الحواس للمعلومات الخام، لا يكون للإشارات العصبية الواصلة للدماغ أي معنى حتى يقوم العقل بتنظيمها وتفسيرها وإضفاء المغزى والدلالة عليها في ضوء الخبرات السابقة. هذه العملية العقلية المعرفية تُعرف بـ","A":"الانتباه الإرادي","B":"سعة الانتباه","C":"الإدراك","D":"الخداع الإدراكي","answer":"C","topic_question_no":16},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"عند قراءة نص يحتوي على بعض الكلمات التي تنقصها حروف، أو لم تُوضع عليها النقاط بشكل صحيح، فإن عقل الإنسان يميل تلقائياً لإكمال هذه الفجوات ليعطي الكلمة معنى مفهوماً. يُعرف هذا الميل في قوانين الجشطلت بـ","A":"قانون الشكل والأرضية","B":"قانون التقارب","C":"التحيز الإدراكي","D":"قانون الغلق","answer":"D","topic_question_no":17},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"طالب يعاني من إرهاق جسدي شديد وقلق بالغ بسبب اقتراب موعد الامتحانات، فوجد نفسه عاجزاً عن التركيز في قراءة صفحة واحدة من الكتاب. العامل الداخلي الذي أثر سلباً على قدرته العامة على الانتباه هنا هو","A":"الخبرة السابقة والاهتمامات","B":"الحالة النفسية والجسدية (التعب والقلق)","C":"التهيؤ الذهني المعاكس","D":"شدة المثير الخارجي وتكراره","answer":"B","topic_question_no":18},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"في لوحة فنية، قُدمت صورة لوجه إنسان مرسوم بخطوط سوداء عريضة على خلفية بيضاء. إدراكنا للخطوط السوداء كوجه إنسان بارز يمثل تطبيقاً لقانون","A":"الغلق الذي يكمل الفجوات","B":"التقارب الذي يجمع العناصر","C":"الشكل والأرضية، حيث الخطوط هي الشكل البارز","D":"الخداع الإدراكي لسوء التفسير البحت","answer":"C","topic_question_no":19},{"exam_id":"U2-T2","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"ينظر شخص إلى سماء ليلية مليئة بالنـجوم، فيلاحظ أن النـجوم القريبة جداً من بعضها البعض تبدو لعقله وكأنها تشكل مجموعة أو كتلة واحدة، ولا يراها كنقاط منفصلة متناثرة. القانون الذي يفسر هذا النمط من الإدراك هو","A":"قانون التقارب","B":"قانون الشكل والأرضية","C":"قانون الغلق","D":"قانون حداثة المثير","answer":"A","topic_question_no":20}],"U2-T3":[{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يسير شخص في شارع مزدحم يعج بمئات السيارات والمارة واللافتات، وتلتقط عيناه كل هذه التفاصيل لثوانٍ معدودة، لكنه إذا سُئل بعد دقيقة عن لون سيارة مرت بجانبه فإنه يعجز عن التذكر. التفسير النفسي الدقيق لفقدان هذه المعلومة هو","A":"أ) أن الذاكرة طويلة المدى رفضت تخزين المعلومة لعدم أهميتها","B":"ب) أن سعة الذاكرة الحسية أصغر من أن تستوعب هذه المثيرات","C":"ج) أن المعلومة تلاشت من الذاكرة الحسية لعدم توجيه الانتباه إليها","D":"د) أن الانفعالات الشديدة في الشارع أعاقت عملية الترميز","answer":"C","topic_question_no":1},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"إذا كان التعلم يمثل عملية اكتساب الطالب لقاعدة رياضية جديدة لأول مرة، فإن قدرة هذا الطالب على استخدام نفس القاعدة في حل مسألة معقدة في الامتحان النهائي بعد عدة أشهر تمثل","A":"أ) المعالجة السطحية للمعلومات","B":"ب) الدور الوظيفي للذاكرة في الاحتفاظ والاسترجاع","C":"ج) السعة المحدودة للذاكرة العاملة","D":"د) النقل المباشر للمعلومات من الحواس","answer":"B","topic_question_no":2},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"طلب منك زميلك الاتصال برقم هاتف فأخبرك به، وقبل أن تقوم بكتابته على هاتفك، قاطعك شخص آخر بسؤال استغرق دقيقة واحدة. عندما حاولت كتابة الرقم وجدت أنك نسيته تماماً. هذا الموقف يثبت علمياً أن الذاكرة قصيرة المدى","A":"أ) تحتفظ بالمعلومات لفترة تتراوح بين 15 إلى 30 ثانية وتتأثر بالمشتتات","B":"ب) تستطيع الاحتفاظ بالبيانات لساعات إذا تم استقبالها عبر السمع","C":"ج) لا ترتبط بعملية الانتباه بل تعتمد على الإدراك العميق","D":"د) تفقد معلوماتها في أقل من 4 ثوان كحد أقصى","answer":"A","topic_question_no":3},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"لتسهيل تذكر تاريخ اندلاع الثورة الفرنسية (1789)، قام طالب بربط هذا الرقم في ذهنه بسنة ميلاد جده مضافاً إليها رقم معين ليعطيه دلالة خاصة لا تُنسى. العملية العقلية التي قام بها الطالب لتحويل المعلومة لصورة يقبلها العقل تسمى","A":"أ) عملية الاسترجاع","B":"ب) عملية التخزين","C":"ج) الذاكرة الحسية","D":"د) عملية الترميز","answer":"D","topic_question_no":4},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"قضى طالبان نفس الوقت (ساعتين) في دراسة فصل من الكتاب؛ الأول اكتفى بقراءة النصوص بعينيه، بينما قام الثاني برسم خريطة ذهنية تلخص العلاقات بين الأفكار. تفوق الطالب الثاني في الامتحان يبرهن على أن قوة التخزين تعتمد على","A":"أ) طول الوقت المستغرق في المذاكرة","B":"ب) جودة التعامل مع المعلومة وتنظيمها أثناء التعلم","C":"ج) سعة الذاكرة الحسية لدى كل طالب","D":"د) الحالة الانفعالية الشديدة أثناء الاسترجاع","answer":"B","topic_question_no":5},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"رغم استعداده الجيد، دخل طالب إلى لجنة الامتحان وهو يشعر برعب شديد وخوف من الفشل، وعندما قرأ السؤال الأول عجز تماماً عن تذكر الإجابة رغم شعوره بأنها على طرف لسانه. التفسير النفسي لهذه الظاهرة هو","A":"أ) أن الانفعالات المعتدلة تزيد من التركيز","B":"ب) أن الانفعالات الشديدة الحادة تؤدي لتشتت الانتباه وضعف الاسترجاع","C":"ج) أن المعلومة لم تتجاوز مرحلة الذاكرة الحسية","D":"د) أن الطالب لم يمتلك أي دافع داخلي للتعلم","answer":"B","topic_question_no":6},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يرفض أحد المعلمين أن يكتفي طلابه بقراءة الدرس، ويطلب منهم دائماً إغلاق الكتب ومحاولة تسميع ما فهموه بصوت عال أو كتابته من الذاكرة. تعتمد استراتيجية هذا المعلم على مبدأ","A":"أ) ربط المعلومة الجديدة بخبرة حياتية سابقة","B":"ب) تنظيم المعلومات في هيئة نقاط","C":"ج) الفهم السطحي قبل الحفظ","D":"د) التدريب على الاسترجاع النشط","answer":"D","topic_question_no":7},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يختلف مسار المعلومات داخل العقل البشري باختلاف العمليات المعرفية المرتبطة بها؛ فبينما ترتبط الذاكرة قصيرة المدى ارتباطاً وثيقاً بعملية الانتباه، فإن الذاكرة طويلة المدى ترتبط ارتباطاً وثيقاً بعملية","A":"أ) الاستقبال الحسي للمثيرات","B":"ب) الإدراك وعمق المعالجة","C":"ج) الاحتفاظ المؤقت للمعلومات","D":"د) التشتت الانفعالي الحاد","answer":"B","topic_question_no":8},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يكمن الفارق الجوهري في انتقال المعلومات بين مستويات الذاكرة في أن تجاوز المعلومة لمرحلة الذاكرة الحسية وانتقالها إلى الذاكرة قصيرة المدى يشترط بالضرورة","A":"أ) توجيه الانتباه إلى المثير الحسي","B":"ب) الفهم العميق والتحليل المعقد للمثير","C":"ج) الاسترجاع النشط والتسميع المستمر","D":"د) ربط المثير بالخبرات الحياتية السابقة","answer":"A","topic_question_no":9},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يدرس طالب مادة التاريخ بسطحية تامة لمجرد الرغبة في اجتياز الامتحان، بينما يدرس مادة الأحياء بتعمق وشغف لأنه يحلم بأن يصبح طبيباً. هذا التباين في عمق معالجة المعلومات يوضح الدور الحاسم لـ","A":"أ) الذاكرة العاملة المؤقتة","B":"ب) الانفعالات الحادة كالقلق والتوتر","C":"ج) الدافعية الداخلية للتعلم","D":"د) سعة الذاكرة الحسية البصرية","answer":"C","topic_question_no":10},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يعتقد بعض الطلاب أن حفظ المعلومات يعتمد فقط على كمية الوقت المقضي في المراجعة. لكن علم النفس يؤكد أن الاحتفاظ بالمعلومات بنـجاح يعتمد بشكل أساسي على:","A":"أ) قوة الذاكرة الحسية واستقبالها المباشر.","B":"ب) الحالة الانفعالية الشديدة الحادة وقت التعلم.","C":"ج) كيفية عمل العقل وطريقة تعامله ومعالجته للمعلومة.","D":"د) التكرار الآلي السطحي دون ربط أو تحليل.","answer":"C","topic_question_no":11},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"المستوى الأول من مستويات الذاكرة والذي يستقبل المعلومات مباشرة عن طريق الحواس، ويحتفظ بها لزمن قصير جداً (من أجزاء من الثانية إلى 4 ثوان كحد أقصى) يُسمى:","A":"أ) الذاكرة طويلة المدى.","B":"ب) الذاكرة العاملة (قصيرة المدى).","C":"ج) الذاكرة الحسية.","D":"د) الذاكرة الإدراكية.","answer":"C","topic_question_no":12},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"أثناء جلوسك في غرفة الانتظار، سمعت رقم تذكرتك، فاحتفظت به في ذهنك لمدة 20 ثانية حتى وصلت إلى الموظف لتسجيله ثم نسيته. الذاكرة التي اعتمدت عليها في هذا الموقف والتي ترتبط ارتباطاً وثيقاً بعملية الانتباه هي:","A":"أ) الذاكرة قصيرة المدى (العاملة).","B":"ب) الذاكرة الحسية.","C":"ج) الذاكرة طويلة المدى.","D":"د) ذاكرة التخزين الإدراكي العميق.","answer":"A","topic_question_no":13},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"لكي تنتقل المعلومة من الذاكرة قصيرة المدى لتستقر في الذاكرة طويلة المدى لأيام أو أعوام، فإنها تتطلب معالجة عميقة ترتبط ارتباطاً وثيقاً بعملية معرفية سابقة هي:","A":"أ) الإحساس الحسي المباشر.","B":"ب) الانتباه اللاإرادي.","C":"ج) الإدراك وعمق المعالجة.","D":"د) التخزين السطحي الرتيب.","answer":"C","topic_question_no":14},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"مرحلة التشفير التي لا تحفظ المعلومة كما هي بل تقوم بتحويلها لصورة يقبلها العقل ويتعامل معها (كمعنى أو صورة ذهنية أو ربطها بمعلومة سابقة) تُعرف باسم:","A":"أ) مرحلة الاسترجاع","B":"ب) مرحلة التخزين","C":"ج) الذاكرة الحسية.","D":"د) مرحلة الترميز","answer":"D","topic_question_no":15},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"قوة التخزين والاحتفاظ بالمعلومات المشفرة داخل الذاكرة لا تعتمد إطلاقاً على طول الوقت المستغرق في القراءة، بل تعتمد بشكل رئيسي على:","A":"أ) جودة التعامل مع المعلومة أثناء التعلم كالتنظيم والربط والفهم.","B":"ب) مجرد القراءة المتكررة الآلية التي تعطي شعوراً خادعاً بالفهم.","C":"ج) الانفعالات الشديدة الحادة كالتوتر الزائد لزيادة التركيز.","D":"د) نقل المعلومة مباشرة من الذاكرة الحسية دون انتباه.","answer":"A","topic_question_no":16},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"طالب استعد جيداً للامتحان وقام بترميز المعلومات بشكل صحيح، لكنه بمجرد دخوله قاعة الامتحان أصيب بتوتر شديد وخوف حاد، مما أدى إلى ظاهرة وقوف المعلومة على طرف اللسان وعجزه عن تذكرها. السبب المباشر لهذا الضعف في الاسترجاع هو:","A":"أ) ضعف الدافعية الداخلية للتعلم لديه.","B":"ب) الاعتماد على الفهم قبل الحفظ في المذاكرة.","C":"ج) تأثير الانفعالات الشديدة الحادة التي تشتت الانتباه وتضعف الاسترجاع.","D":"د) قصر مدة بقاء المعلومة في الذاكرة طويلة المدى.","answer":"C","topic_question_no":17},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"من الاستراتيجيات الفعالة لتحسين التعلم وتنشيط الذاكرة محاولة تذكر المعلومة بعد إغلاق الكتاب وتسميعها ذاتياً، حيث تعتبر هذه الطريقة أقوى لتثبيت المعلومة لأنها تنشط الروابط العصبية. تُعرف هذه الاستراتيجية بـ:","A":"أ) القراءة الآلية المتكررة.","B":"ب) التدريب على الاسترجاع النشط.","C":"ج) تنظيم المعلومات في هيئة نقاط.","D":"د) الربط بين المعلومات القديمة والجديدة.","answer":"B","topic_question_no":18},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يعتمد نـجاح الاسترجاع (استدعاء المعلومة عند الحاجة) بقوة على عدة عوامل لا تشمل:","A":"أ) جودة الترميز الأولي للمعلومة.","B":"ب) طريقة تنظيم وتخزين المعلومات.","C":"ج) مدى التدريب المستمر على استدعاء المعلومة.","D":"د) معالجة المعلومات بسطحية دون إعطائها معنى.","answer":"D","topic_question_no":19},{"exam_id":"U2-T3","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"إذا فقدت الذاكرة الحسية معلوماتها فوراً، فإن السبب العلمي لذلك يعود إلى أن الفرد:","A":"أ) لم يوجه انتباهه إليها لينقلها للذاكرة العاملة.","B":"ب) استخدم استراتيجية الاسترجاع النشط مبكراً.","C":"ج) ربطها بخبرات حياتية سابقة أدت لتلاشيها.","D":"د) قام بمعالجتها بعمق وتشفيرها بشكل معقد.","answer":"A","topic_question_no":20}],"U2-T4":[{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يواجه شاب مشكلة مالية تتمثل في تراجع دخله الشهري، وبدلاً من الاستسلام للإحباط، بدأ في جمع بيانات حول نفقاته، ثم حاول تخيل النتائج المحتملة لتقليل بعض المصروفات أو البحث عن عمل إضافي للوصول إلى قرار يحقق له الاستقرار المالي. هذا المسار الذي اتخذه الشاب يمثل تجسيداً لمفهوم","A":"أ) التفكير الإبداعي الذي يعتمد على الأصالة والجدة","B":"ب) التفكير كعملية ونشاط عقلي مركب لفهم الموقف والبحث عن بدائل","C":"ج) الخداع الإدراكي في تفسير الأسباب الحقيقية للأزمة","D":"د) التهيؤ الذهني لتقبل النتيجة مهما كانت","answer":"B","topic_question_no":1},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يعتمد الطبيب عند تشخيص حالة مريض جديد على استرجاع الحالات المشابهة التي درسها أو علاجها في الماضي، ولا يعتمد فقط على ما يراه أمامه من أعراض جسدية مباشرة. يعكس هذا الموقف إحدى خصائص عملية التفكير وهي أنها","A":"أ) نشاط عقلي غير مباشر يعتمد على المعلومات والخبرات المخزنة في الذاكرة","B":"ب) عملية فطرية تولد مع الإنسان وتعمل بشكل منفصل عن الإدراك","C":"ج) تعتمد كلياً على الاختصارات العقلية لتسريع القرار","D":"د) قدرة لا واعية يوجهها الانفعال والخوف من الفشل","answer":"A","topic_question_no":2},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"لاحظ باحث اجتماعي أن ظاهرة التسرب المدرسي في عدة قرى ترتبط ارتباطاً وثيقاً بمستوى الدخل الاقتصادي الأسري، فقام بصياغة قاعدة عامة تفسر العلاقة بين الفقر والتعليم في المجتمعات الريفية. هذه القدرة على تجاوز الحالات الفردية لصياغة مبدأ عام تدل على أن التفكير","A":"أ) يتجنب استخدام اللغة كأداة للتعبير","B":"ب) يرتكز ويبنى على المعارف والقوانين والمبادئ العامة المنظمة للظواهر","C":"ج) يعتمد على التنبؤ المستقبلي دون فهم للأسباب","D":"د) يعكس دائماً انحيازات شخصية وتحيزات إدراكية","answer":"B","topic_question_no":3},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"استمع قاض لشهادة أحد الشهود الذي بدأ في سرد تفاصيل كثيرة لا علاقة لها بالحادثة محل النزاع، فطلب منه القاضي التوقف والتركيز فقط على الأفعال التي تخص الحادثة مباشرة متجاهلاً التفاصيل الجانبية. الخاصية الفكرية التي استخدمها القاضي هنا هي","A":"أ) تجاوز الخبرة الحسية المباشرة ليصل إلى مستويات التجريد والتعميم والتمييز بين الجوهري والثانوي","B":"ب) التعبير عن نواتج التفكير في صور لفظية أو رمزية دقيقة","C":"ج) الاعتماد على الاستدلالات العقلية السريعة لحسم القضية","D":"د) الانتباه اللاإرادي للمثيرات السمعية أثناء الشهادة","answer":"A","topic_question_no":4},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"أثناء قراءة مقال يهاجم تقنية الذكاء الاصطناعي، لاحظ القارئ أن الكاتب بنى هجومه على فكرة أن الآلات ستدمر البشرية حتماً، فأدرك القارئ أن هذه الفكرة ليست حقيقة علمية مثبتة بل مجرد تخيل يحتاج إلى دليل. المهارة التي استخدمها القارئ تنتمي للتفكير النقدي وهي","A":"أ) التعرف إلى الافتراضات والتمييز بين الحقائق المثبتة والمسلمات","B":"ب) تقييم الحجج القوية والضعيفة","C":"ج) الاستنباط وتطبيق القاعدة العامة","D":"د) التفسير وإيجاد الأسباب المنطقية","answer":"B","topic_question_no":5},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"في نقاش حول أسباب التلوث، قدم أحد الحاضرين إحصائيات دقيقة وموثقة لنسب الانبعاثات الصناعية، بينما قدم آخر قصة شخصية عن إصابة جاره بالربو كدليل وحيد على التلوث. قدرتك على إدراك أن الدليل الأول صلب والثاني ضعيف تعكس مهارتك في","A":"أ) الاستنباط المنطقي","B":"ب) الطلاقة الفكرية","C":"ج) الاستقراء الجزئي","D":"د) تقييم الحجج والتمييز بين ذات الصلة الوثيقة وغير ذات الصلة","answer":"D","topic_question_no":6},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"ُطلب من مجموعة مهندسين إيجاد حلول لأزمة المرور الخانقة، فقدم المهندس الأول ثلاثة حلول تقليدية، بينما قدم المهندس الثاني عشرين حلاً مختلفاً ومبتكراً في نفس الوقت المتاح. يتفوق المهندس الثاني بوضوح في إحدى مهارات التفكير الإبداعي وهي","A":"أ) المرونة الفكرية","B":"ب) الأصالة والجدة","C":"ج) الطلاقة والقدرة الفائقة على إنتاج أكبر كم من الأفكار","D":"د) الاستنباط والاستقراء","answer":"C","topic_question_no":7},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"حاول مدير تسويق زيادة المبيعات باستخدام الإعلانات الورقية مراراً وتكراراً دون جدوى، حتى قرر التخلي تماماً عن هذه الفكرة الثابتة، وتبنى زاوي رؤية مختلفة بالتوجه نحو التسويق الرقمي التفاعلي مما حقق نـجـاحاً باهراً. يعكس هذا التحول امتلاك المدير لمهارة","A":"أ) الأصالة","B":"ب) المرونة والقدرة على تغيير أسلوب التفكير والتغلب على الجمود النمطي","C":"ج) الطلاقة اللفظية","D":"د) التعرف على الافتراضات","answer":"B","topic_question_no":8},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"ينص قانون الفيزياء على أن المعادن تتمدد بالحرارة، وعندما واجه حداد مشكلة في فك صامولة حديدية عالقة، قام بتسخينها بالنار بناءً على هذه القاعدة لتسهيل فكها. هذا التطبيق العلمي للقاعدة العامة على موقف محدد يعرف في التفكير النقدي بـ","A":"أ) التفسير","B":"ب) الاستقراء","C":"ج) الاستنباط","D":"د) الطلاقة","answer":"C","topic_question_no":9},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يواجه مصنع أزمة تتمثل في تأخر تسليم الطلبيات للعملاء، فقام الخبير الإداري فوراً بالفصل الدقيق بين أعراض المشكلة (كغضب العملاء) وبين الأسباب الجذرية (كتعطل خطوط الإنتاج). الخطوة المنظمة التي يقوم بها الخبير لحل المشكلة هي","A":"أ) جمع المعلومات والخبرات السابقة","B":"ب) تحديد المشكلة وصياغتها بوضوح والابتعاد عن السطحية","C":"ج) تقييم الحلول ودراسة إيجابياتها","D":"د) اقتراح الحلول وتوليد البدائل","answer":"B","topic_question_no":10},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"أثناء مواجهة مدير لشركة أزمة مالية طارئة، لم يكتفِ باستدعاء المعارف المجردة التي درسها في الإدارة، بل قام بتحليل معطيات الواقع، ومقارنة البدائل المتاحة، وربطها بالخبرات السابقة للشركة للخروج بحل عملي. يعكس هذا الموقف المفهوم الشامل لعملية التفكير باعتبارها:","A":"أ) استجابة حسية مباشرة للمثيرات البيئية دون معالجة.","B":"ب) عملية عقلية تقتصر على الفهم المجرد بعيداً عن الواقع.","C":"ج) نشاطاً عقلياً مركباً يُستخدم لتفسير المواقف واتخاذ القرارات بشأنها.","D":"د) اختصاراً عقلياً يعتمد على الانفعالات السريعة لتجاوز الأزمة.","answer":"C","topic_question_no":11},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يعجز الإنسان عن التفكير في حل لمشكلة ما إذا لم يكن يمتلك أي معلومات سابقة عنها؛ وذلك لأن عملية التفكير بطبيعتها تتميز بأنها:","A":"أ) نشاط يتجاوز مستويات التجريد والتعميم ليصل للخبرة المباشرة.","B":"ب) نشاط عقلي غير مباشر يعتمد على المعلومات والخبرات المخزنة في الذاكرة.","C":"ج) عملية تعتمد بشكل حصري على الاستدلالات والتحيزات الذهنية.","D":"د) استجابة فسيولوجية سريعة تحدث قبل اكتمال التحليل المنطقي.","answer":"B","topic_question_no":12},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"عندما يشاهد عالم نبات شجرة معينة، فإنه لا يراها مجرد جذع وأوراق كما يراها الشخص العادي، بل يصنفها فوراً ضمن فصيلة معينة بناءً على القوانين العلمية. يشير هذا إلى إحدى خصائص التفكير وهي:","A":"أ) الاعتماد على الاختصارات العقلية لتسريع الحكم.","B":"ب) تجاوز الخبرة الحسية للتمييز بين الجوهري والثانوي.","C":"ج) الارتكاز والبناء على المعارف والقوانين والمبادئ العامة.","D":"د) التعبير عن نواتج التفكير في صور لفظية أو رمزية.","answer":"C","topic_question_no":13},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يلجأ بعض الأفراد في المواقف اليومية المتسارعة إلى اتخاذ قرارات سريعة بناءً على قواعد مبسطة أو استنتاجات سريعة لتوفير الجهد العقلي، ولكنهم قد يقعون ضحية لأحكام غير دقيقة. يُعرف هذا الأسلوب في خصائص التفكير بـ:","A":"أ) التفكير الإبداعي الأصيل.","B":"ب) التجريد والتعميم.","C":"ج) الاختصارات العقلية أو الاستدلالات.","D":"د) التفكير النقدي التفسيري.","answer":"C","topic_question_no":14},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"عند قراءة مقال يروج لمنتج صحي جديد، قام القارئ بفصل الادعاءات التي لا تستند إلى دليل علمي عن الحقائق المثبتة بالتجارب، ورفض تصديق المقال لمجرد أنه مكتوب بأسلوب جذاب. المهارة التي استخدمها القارئ هنا من مهارات التفكير النقدي هي:","A":"أ) التعرف إلى الافتراضات وتمييزها عن الحقائق المثبتة.","B":"ب) الاستنباط وتطبيق قاعدة عامة على حالة محددة.","C":"ج) الاستقراء والوصول لقاعدة عامة من حالات جزئية.","D":"د) التفسير وإيجاد أسباب منطقية للمشكلة.","answer":"A","topic_question_no":15},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"لاحظ معلم أن أحد طلابه يتميز بقدرة استثنائية على تقديم عدد هائل من الحلول والأفكار المختلفة لمشكلة واحدة خلال فترة زمنية قصيرة جداً مقارنة بزملاؤه. هذه القدرة تعبر عن إحدى مهارات التفكير الإبداعي وهي:","A":"أ) الأصالة والابتكار.","B":"ب) الطلاقة وإنتاج أكبر كم من الأفكار.","C":"ج) المرونة وتغيير أسلوب التفكير.","D":"د) التقييم الدقيق للحجج الضعيفة.","answer":"B","topic_question_no":16},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"واجه مهندس عقبة في تصميم مبنى، وبدلاً من التمسك بالأساليب الهندسية التقليدية التي أثبتت فشلها في هذا الموقع، قام بتغيير زاوية رؤيته للمشكلة تماماً وتبنى أسلوباً مختلفاً يعتمد على مواد بناء غير معتادة. المهندس طبق هنا مهارة:","A":"أ) التفسير في التفكير النقدي.","B":"ب) الاستقراء للوصول لنتيجة عامة.","C":"ج) الطلاقة في توليد الأفكار.","D":"د) المرونة والتغلب على الجمود الفكري.","answer":"D","topic_question_no":17},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"تعتبر مهارة تقييم الحجج من أهم ركائز التفكير النقدي التي يعتمد عليها الفرد لاتخاذ قرار سليم، وتتطلب هذه المهارة قدرة تحليلية عالية للقيام بـ:","A":"أ) إنتاج أفكار جديدة كلياً وغير مألوفة تتسم بالتفرد.","B":"ب) الوصول إلى قاعدة عامة انطلاقاً من ملاحظات لحالات جزئية متفرقة.","C":"ج) التمييز الدقيق بين الحجج القوية ذات الصلة الوثيقة والحجج الضعيفة غير ذات الصلة.","D":"د) تطبيق القوانين والمبادئ العامة المنظمة للظواهر على المواقف المحددة.","answer":"C","topic_question_no":18},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يختلف الاستنباط عن الاستقراء ضمن مهارات التفكير النقدي في اتجاه معالجة المعلومات؛ فبينما يبدأ الاستقراء من ملاحظات جزئية للوصول إلى قاعدة عامة، يقوم الاستنباط بـ:","A":"أ) تطبيق قاعدة عامة كبرى على مواقف محددة وجزئية.","B":"ب) إنتاج أكبر عدد ممكن من البدائل في وقت معين.","C":"ج) تمييز المعلومات بين الصحيح والخطأ بناءً على الانطباعات.","D":"د) التخلي عن الأفكار النمطية الثابتة وتبني زوايا مختلفة.","answer":"A","topic_question_no":19},{"exam_id":"U2-T4","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"الخطوة الأولى والأكثر حسماً في خطوات حل المشكلات المنظمة، والتي يؤدي أي خلل فيها إلى توجيه كل الجهود اللاحقة نحو مسار خاطئ لا يعالج جوهر الموقف، هي مرحلة:","A":"أ) جمع المعلومات وتجميع صورة كاملة عن الظروف المحيطة.","B":"ب) اقتراح الحلول وتوليد أكبر عدد ممكن من البدائل.","C":"ج) تقييم الحلول ودراسة الإيجابيات والسلبيات.","D":"د) تحديد المشكلة وصياغتها بوضوح للابتعاد عن السطحية.","answer":"D","topic_question_no":20}],"U3-T1":[{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"يعتقد بعض الآباء أن نمو طفلهم يسير بشكل ممتاز بمجرد ملاحظة زيادة مستمرة في وزنه وطوله مع مرور الأشهر. هذا الاعتقاد يمثل نظرة قاصرة لأنه يركز فقط على جانب واحد من التغيرات ويغفل أن النمو الحقيقي هو عملية متكاملة تشمل بالضرورة","A":"أ) النضج والارتقاء في كافة الجوانب الجسمية، العقلية، الانفعالية، والاجتماعية","B":"ب) التغير السطحي في السلوك نتيجة مرور الزمن","C":"ج) التغيرات الكيفية في قدرة الجهاز العصبي بعيداً عن الجانب الاجتماعي","D":"د) زيادة العمليات النفسية والانفعالية على حساب النمو العضوي","answer":"A","topic_question_no":1},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"انتقل طالب للعيش في مدينة جديدة، فتغيرت طريقة حديثه واكتسب بعض المصطلحات المحلية السطحية لإرضاء زملائه الجدد دون أن يغير ذلك من طريقة تفكيره أو قيمه العميقة. يصنف هذا التحول في علم نفس النمو على أنه","A":"أ) نمو عضوي تكويني","B":"ب) نمو حقيقي متكامل","C":"ج) تغير سطحي لا يؤثر في السلوك بعمق","D":"د) طفرة نمائية كيفية","answer":"C","topic_question_no":2},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"عندما يتعلم الطفل الرضيع الحبو، ثم يطور مهارته للوقوف، ثم يبدأ في المشي، وأخيراً الجري بطلاقة. هذا التسلسل الحركي يجسد أحد قوانين النمو الذي يؤكد أن النمو","A":"أ) يتدرج من العام إلى الخاص","B":"ب) عملية مستمرة يأخذ فيها التغير شكلاً كيفياً متسلسلاً","C":"ج) تختلف سرعته من فرد لآخر","D":"د) يعتمد كلياً على العوامل الخارجية والبيئية","answer":"B","topic_question_no":3},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"إذا لاحظ معلم رياض الأطفال أن طفلاً يقوم بتحريك ذراعه بالكامل وبشكل عشوائي لمحاولة الإمساك بقلم التلوين، وبعد عدة أشهر أصبح قادراً على التحكم الدقيق في أصابعه ليمسك القلم ببراعة. يعكس هذا التطور مبدأ أن النمو","A":"أ) يسير في مراحل لا ترتبط ببعضها","B":"ب) يتدرج من الخاص والدقيق إلى العام","C":"ج) يسير من العام الشامل إلى الخاص والمحدد","D":"د) يتأثر حصراً بنوعية الغذاء المقدم له","answer":"C","topic_question_no":4},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"اكتشف طبيب أطفال أن تأخر طفل في النطق والتواصل الاجتماعي لا يرجع لأسباب بيئية، بل يعود إلى معاناته من نقص حاد في التغذية في أشهره الأولى أثر على نمو دماغه. يثبت هذا التشخيص أن مظاهر النمو","A":"أ) تسير بسرعات متباينة لا تلتقي","B":"ب) ترتبط ارتباطاً وثيقاً ولا يمكن عزل النمو الجسمي عن اللغوي والعقلي","C":"ج) تعتمد على الوراثة كعامل حاسم بمعزل عن البيئة","D":"د) تتغير نوعياً دون أن تترك أثراً في المراحل اللاحقة","answer":"B","topic_question_no":5},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"أُصيب طفل بنقص في إفراز إحدى الغدد الصماء، مما أدى إلى خمول شديد، تأخر في النمو العقلي، ومستوى طاقة منخفض جداً رغم جودة تغذيته. الجهة المسؤولة عن هذا الخلل هي الغدد التي","A":"أ) تصب إفرازاتها في قنوات كالغدد اللعابية","B":"ب) لا تؤثر في الانفعال أو النضج الجنسي","C":"ج) تفرز هرموناتها مباشرة في الدم وتلعب دوراً أساسياً في التنظيم","D":"د) تستمد قوتها من البيئة الثقافية المحيطة حصراً","answer":"C","topic_question_no":6},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"يمتلك الطفل (أ) قدرة عقلية عالية وسرعة بديهة ورثها عن والديه، لكنه نشأ في بيئة قاسية تهمل التعليم. بينما يمتلك الطفل (ب) قدرة متوسطة ورثها، لكنه حظي ببيئة تعليمية داعمة حفزت إمكانياته وتفوق. يؤكد هذا المثال على أن","A":"أ) البيئة وحدها تخلق الذكاء من العدم","B":"ب) الوراثة تمنح الاستعداد فقط، وتتفاعل مع البيئة لإظهاره","C":"ج) التكوين الغدي أقوى من التعليم الأسري","D":"د) الثقافة والمجتمع يلغيان الجانب الوراثي تماماً","answer":"B","topic_question_no":7},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"طفل في الرابعة من عمره ينظر إلى العالم من منظوره الشخصي فقط، وعندما يتحدث مع أمه عبر الهاتف يخبرها بأن تنظر إلى اللعبة التي يمسكها بيده معتقداً أنها ترى ما يراه هو. يعود هذا السلوك إلى أن التفكير في مرحلة الطفولة المبكرة يتسم بـ","A":"أ) القدرة على التصنيف وإدراك العلاقات","B":"ب) التفكير المنطقي الذي ينظم المعلومات","C":"ج) الحدسية والتمركز التام حول الذات","D":"د) استخدام لغة اجتماعية دقيقة واختصار","answer":"C","topic_question_no":8},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"في حصة التربية البدنية لطالب الصف الثاني الابتدائي (7 سنوات)، لاحظ المعلم أن الطلاب قادرون على التحكم في حركاتهم الدقيقة للرسم وتنسيق خطواتهم ببطء وتوازن مقارنة بالسنوات السابقة. السمة الجسمية لهذه المرحلة (الطفولة المتوسطة) هي","A":"أ) نمو متدرج سريع مع تحسن القدرات الحسية","B":"ب) استمرار النمو بمعدل بطيء وظهور الفروق بين الجنسين بقوة","C":"ج) طفرة نمائية فجائية استعداداً للبلوغ","D":"د) استمرار النمو بشكل بطيء ومتوازن مع تحسن التناسق الحركي الدقيق","answer":"D","topic_question_no":9},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"لاحظت أم أن طفلها البالغ من العمر 11 عاماً أصبح يرفض التدليل الزائد أمام أقاربه، ويفضل قضاء معظم وقته مع زملائه، مع حرصه الشديد على تحقيق درجات عالية لنيل التقدير. هذه الخصائص النفسية تميز مرحلة","A":"أ) الطفولة المبكرة","B":"ب) المراهقة المبكرة","C":"ج) الطفولة المتأخرة","D":"د) الطفولة المتوسطة","answer":"C","topic_question_no":10},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"لاحظت أم أن طفلها بدأ يستخدم جملاً أكثر تعقيداً ويسأل عن أسباب الأشياء بشكل مستمر، وفي نفس الوقت لاحظت زيادة في طوله وقدرته على الجري بتوازن. هذا الترابط بين التغيرات الجسدية والعقلية يثبت أن النمو الإنساني هو عملية:","A":"أ) تقتصر على الزيادة الكمية في الوزن والطول فقط.","B":"ب) شاملة ومتكاملة تتضمن تغيرات كمية وكيفية في كافة الجوانب.","C":"ج) تعتمد على تغيرات سطحية لا تؤثر في شخصية الفرد وقدراته.","D":"د) عشوائية تحدث بشكل منفصل في كل جانب نمائي على حدة.","answer":"B","topic_question_no":11},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"تعرض مراهق لموقف صعب أدى لظهور رد فعل عدواني مؤقت تجاه زملائه سرعان ما اختفى بعد زوال الموقف دون أن يترك أثراً على شخصيته أو طريقة تفكيره المستقبلية. هذا التحول العابر يُصنف في علم النفس النمائي على أنه:","A":"أ) نمو حقيقي ناضج.","B":"ب) مظهر من مظاهر النمو الوظيفي الدائم.","C":"ج) مجرد تغير سطحي لا يؤثر في السلوك بعمق.","D":"د) انتقال لمستوى أكثر وعياً وضبطاً للانفعالات.","answer":"C","topic_question_no":12},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"إذا كان التطور العضوي للطفل يسير بشكل سليم فتنمو أعضاؤه ويزداد وزنه وطوله، فإن قدرته على استخدام هذه الأعضاء للتفكير وحل المشكلات والتفاعل الاجتماعي بنـجاح تندرج تحت مظاهر:","A":"أ) التغير السطحي.","B":"ب) النمو الوظيفي.","C":"ج) النمو العضوي (التكويني).","D":"د) التكوين الغدي اللاقنوي.","answer":"B","topic_question_no":13},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"اكتشف معلم أن أحد طلابه يتميز بقدرة مذهلة على الفهم السريع للمسائل الرياضية المعقدة مقارنة بزملاؤه الذين يحتاجون وقتاً أطول وشرحاً مفصلاً لتعلم نفس المسائل. وفقاً لمفهوم \"الفروق الفردية في النمو\"، فإن بطء بعض الطلاب في التعلم يدل على:","A":"أ) عدم وجود أي استعداد وراثي لديهم للتعلم.","B":"ب) اختلاف طبيعي في سرعة التعلم يستلزم مراعاته لتنمية قدراتهم وليس مؤشراً وحيداً للقدرة.","C":"ج) وجود خلل في التكوين الغدي يمنع النمو المعرفي.","D":"د) أن النمو لا يسير في مراحل متتابعة لديهم.","answer":"B","topic_question_no":14},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"يُعد انتقال الطفل من مرحلة الحبو إلى المشي ثم الجري دليلاً واضحاً على أحد قوانين النمو الذي يشير إلى أن التغيرات تأخذ تسلسلاً (كيفياً)، وهو يندرج تحت مبدأ أن النمو:","A":"أ) يسير من العام إلى الخاص.","B":"ب) يتأثر بالبيئة الثقافية فقط.","C":"ج) عملية مستمرة ومتدرجة ومترابطة.","D":"د) يختلف في سرعته من فرد لآخر بشكل عشوائي.","answer":"C","topic_question_no":15},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"تلعب الوراثة دوراً في نقل الصفات الجسدية والاستعدادات العقلية من الآباء للأبناء، ولكن علم نفس النمو يؤكد أن هذه الوراثة لا تحسم النتيجة النهائية للفرد لأنها","A":"أ) تتغلب دائماً على أساليب التنشئة الأسرية مهما كانت مقيدة","B":"ب) مسؤولة فقط عن الأمراض ولا تتدخل في السمات الانفعالية أو العقلية","C":"ج) تمنح الفرد \"الاستعداد\" فقط، وتتفاعل مع البيئة لإظهار هذا الاستعداد أو طمسه","D":"د) تعمل بمعزل تام عن البيئة الأسرية والتعليمية","answer":"C","topic_question_no":16},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"يعاني طفل من خمول مستمر، ضعف في التركيز، وتأخر في النمو الجسمي مقارنة بأقرانه، رغم توفر بيئة أسرية داعمة وتغذية سليمة. عند فحصه طبياً، تبين وجود نقص في إفرازات غدة تصب هرموناتها مباشرة في الدم وتلعب دوراً أساسياً في تنظيم النشاط والطاقة. هذا الخلل يرتبط بـ","A":"البيئة الثقافية للمجتمع","B":"الغدد القنوية (كاللعابية والدمعية)","C":"الغدد الصماء / اللاقنوية (كالدرقية والنخامية)","D":"التغيرات السطحية المؤقتة في النمو الوظيفي","answer":"C","topic_question_no":17},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"في مرحلة الطفولة المبكرة (2 إلى 6 سنوات)، يتسم تفكير الطفل بخصائص معرفية محددة تجعله يرى العالم من منظور ضيق، ومن أبرز هذه الخصائص","A":"أ) استخدام لغة اختصار بمستوى متقدم من الفهم المعقد","B":"ب) القدرة الفائقة على التصنيف الدقيق وفهم \"المقلوبية\" في العلاقات","C":"ج) التفكير الحدسي، التمركز حول الذات، والاعتماد على \"بعد واحد\" في الحكم","D":"د) التفكير المنطقي الذي ينظم المعلومات بأكثر من بعد","answer":"C","topic_question_no":18},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"الانتقال من حالة \"التمركز حول الذات\" إلى استخدام \"اللغة الاجتماعية\" وظهور قدرة الطفل على التصنيف وترتيب الأشياء وفهم العلاقات البسيطة (بداية فهم المقلوبية)، هي خصائص معرفية تميز مرحلة","A":"الرضاعة (قبل السنتين)","B":"الطفولة المبكرة (2 إلى 6 سنوات)","C":"الطفولة المتوسطة (6 إلى 9 سنوات)","D":"الطفولة المتأخرة (9 إلى 12 سنوات)","answer":"C","topic_question_no":19},{"exam_id":"U3-T1","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"طفل في العاشرة من عمره بدأ يظهر ميلاً واضحاً للابتعاد النسبي عن الكبار، ويرفض أن يُعامل كطفل صغير (رفض التدليل)، مع حرص شديد على الانتماء لجماعة الأصدقاء (الشلل) والالتزام بمعاييرهم لإثبات ذاته. هذه السمات النفسية والاجتماعية هي سمات مرحلة","A":"الطفولة المبكرة","B":"الطفولة المتوسطة","C":"الطفولة المتأخرة","D":"المراهقة المتأخرة","answer":"C","topic_question_no":20}],"U3-T2":[{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"لاحظت أم أن ابنها البالغ من العمر ثلاثة عشر عاماً قد حدثت له تغيرات فسيولوجية سريعة تمثلت في خشونة صوته وظهور بعض ملامح النضج العضوي، فاعتقدت أنه أصبح ناضجاً تماماً وقادراً على اتخاذ قراراته المصيرية بشكل متكامل. هذا الاعتقاد يعد قاصراً في علم النفس لأن الأم خلطت بين مرحلة المراهقة الشاملة وبين","A":"أ) مرحلة الرشد التي تسبق المراهقة","B":"ب) طفرة النمو الإدراكي الحسي","C":"ج) البلوغ الذي يقتصر على الجانب البيولوجي فقط","D":"د) الاستكشاف كأولى مراحل تكوين الهوية","answer":"C","topic_question_no":1},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يعاني أحد المراهقين من تذبذب حاد في مشاعره خلال اليوم الواحد؛ فتارة يبدو في قمة الحماس والنشاط لمشروع مدرسي، وبعد ساعات قليلة يسيطر عليه إحباط شديد وغضب لأتفه الأسباب دون مبرر واضح. يعزى هذا التغير السريع إلى","A":"أ) اكتمال النضج العضوي والجسمي","B":"ب) التقلب الانفعالي المرتبط بالتغيرات الداخلية وعدم استقرار صورة الذات","C":"ج) الانتقال من مرحلة الاختيار إلى مرحلة الالتزام","D":"د) وصوله إلى المرحلة النهائية في تكوين الهوية","answer":"B","topic_question_no":2},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"طلب معلم من طلابه في المرحلة الإعدادية إبداء رأيهم في قضية اجتماعية، فلاحظ أن أحدهم غير رأيه تماماً بمجرد أن سمع آراء أصدقائه في الفصل، رغم أنه كان مقتنعاً برأيه الأول. الدافع النفسي الذي يفسر هذا السلوك في مرحلة المراهقة هو","A":"أ) السعي القوي للاستقلال عن الأسرة","B":"ب) الرغبة في التمرد على القواعد المدرسية","C":"ج) البحث عن القبول والانتماء للمجموعة وتجنب الرفض","D":"د) الانتقال التدريجي نحو النضج العقلي الكامل","answer":"C","topic_question_no":3},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"إذا قمنا بمقارنة التطور الجسمي بين أخ وأخته التوأم في سن الرابعة عشرة، فإننا سنلاحظ غالباً اختلافات واضحة في معدلات النمو وفقاً لخصائص طفرة النمو في هذه المرحلة. التفسير العلمي الأقرب لهذه الاختلافات هو","A":"أ) وصول كلاهما للطول النهائي في نفس التوقيت المتمثل في سن الرابعة عشرة","B":"ب) تأخر الطفرة لدى البنين حيث تبلغ أقصى سرعتها في سن 14، بينما تبدأ مبكراً لدى البنات","C":"ج) تفوق البنات في زيادة الوزن بنهاية المراهقة بسبب نمو العضلات والعظام","D":"د) توقف الطول لدى البنات في سن الثانية عشرة تماماً واستمراره للبنين","answer":"B","topic_question_no":4},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يقضي شاب مراهق ساعات طويلة أمام المرآة قبل الخروج، ويقوم بتعديل ملابسه وتصفيفة شعره مراراً وتكراراً، معتقداً أن جميع من في الشارع سيلاحظون أي عيب بسيط في مظهره. تعكس هذه الحالة إحدى الخصائص الاجتماعية والانفعالية وهي","A":"أ) الحساسية الشديدة تجاه آراء الآخرين ونظرتهم وتقييمهم","B":"ب) السعي لإثبات الهوية المهنية المستقبلية","C":"ج) التمرد على توجيهات الوالدين وقراراتهم","D":"د) دقة الإدراك الحسي وتمييز التفاصيل السمعية","answer":"A","topic_question_no":5},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"شارك مراهق في أنشطة متعددة؛ فانضم لنادي التصوير شهراً، ثم تركه ليتعلم البرمجة، ثم قرر الانضمام لفريق رياضي، محاولاً اكتشاف ما يثير شغفه الحقيقي وتجربة أنماط مختلفة من الأفكار. هذه التصرفات تضعه ضمن أولى مراحل تكوين الهوية وهي","A":"أ) مرحلة الالتزام بالمبادئ","B":"ب) مرحلة الاختيار بين البدائل","C":"ج) مرحلة الاستكشاف وتجربة الأدوار","D":"د) مرحلة النضج المتكامل","answer":"C","topic_question_no":6},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يرفض مراهق السماح لوالده بمساعدته في اختيار مواده الدراسية الاختيارية، ويصر على اتخاذ القرار بمفرده تماماً، قائلاً إنه أصبح كبيراً بما يكفي ليتحمل مسؤولية اختياراته. السمة الانفعالية التي تحرك هذا المراهق هي","A":"أ) التقلب الانفعالي الحاد","B":"ب) السعي إلى الاستقلال والميل للاعتماد على النفس لإثبات الذات","C":"ج) البحث عن الانتماء لمجموعة الأقران","D":"د) المعاناة من ضغوط المقارنة بالآخرين","answer":"B","topic_question_no":7},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"ينتقل المراهق من القدرة على ملاحظة الأشياء البسيطة إلى القدرة على ربط وفهم العلاقات المعقدة بين المثيرات الحسية المختلفة التي يستقبلها، متأثراً بقوة بخبراته السابقة. هذا التحول يمثل خاصية من خصائص","A":"أ) النمو الإدراكي الحسي والانتقال للإدراك المنظم","B":"ب) النضج الفسيولوجي للغدد الجنسية","C":"ج) التطور الانفعالي والتقلب المزاجي","D":"د) طفرة النمو الجسمي وتناسق الأطراف","answer":"A","topic_question_no":8},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"واجه شاب حيرة كبيرة؛ فهو يرغب في قضاء عطلة نهاية الأسبوع في دراسة مادة يفضلها، لكن أصدقاءه ألحوا عليه بشدة للخروج معهم، فشعر بضغط داخلي يمزقه بين تلبية رغبته أو إرضاء أصدقائه. يجسد هذا الموقف أحد تحديات تكوين الهوية وهو","A":"أ) غياب الرؤية الواضحة للمستقبل","B":"ب) صراع الاستقلال والانتماء","C":"ج) المقارنة المستمرة بالآخرين","D":"د) الدخول في مرحلة الالتزام الفكري","answer":"B","topic_question_no":9},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"بعد فترة طويلة من التردد وتجربة عدة اهتمامات رياضية وفنية، استقر مراهق أخيراً على تبني قناعات فكرية محددة تركز على العمل التطوعي، وبدأ يدافع عن هذه القناعات بثبات في نقاشاته مع عائلته. هذا الاستقرار النسبي يعني وصوله لمرحلة","A":"أ) التمرد السلوكي","B":"ب) الاستكشاف العشوائي","C":"ج) الالتزام بتبني الأفكار المختارة والدفاع عنها","D":"د) الإدمان الرقمي بحثاً عن الانتماء","answer":"A","topic_question_no":10},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"لاحظت أم أن ابنتها البالغة من العمر 11 عاماً بدأت تظهر عليها تغيرات جسدية سريعة ونمو في غدد معينة، فاعتقدت أن ابنتها قد وصلت إلى النضج الكامل. وفقاً لـ علم نفس النمو، التفسير الدقيق لحالة هذه الفتاة هو أنها تمر بمرحلة","A":"أ) النضج العقلي الذي يسبق التغيرات الجسدية في مرحلة الرشد","B":"ب) الطفولة المتأخرة التي تتميز بالاستقرار الجسدي التام وغياب التغيرات","C":"ج) البلوغ الذي يقتصر على الجانب البيولوجي ويُعد أول دلائل الدخول في المراهقة","D":"د) المراهقة التي تمثل النضج المتكامل في كافة الجوانب النفسية والاجتماعية","answer":"C","topic_question_no":11},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يعاني مراهق من تعثر في دراسته، وعندما نصحه والده بتغيير طريقة استذكاره، رفض المراهق بشدة وأصر على اتخاذ قراراته الدراسية بنفسه دون أي تدخل، محاولاً إثبات قدرته على إدارة شؤونه. يعكس هذا السلوك إحدى خصائص النمو الاجتماعي للمراهق وهي","A":"الحساسية المفرطة تجاه آراء الآخرين","B":"السعي القوي للقبول والانتماء لمجموعة","C":"السعي إلى الاستقلال والاعتماد على النفس","D":"التقلب الانفعالي والتغير السريع في المشاعر","answer":"C","topic_question_no":12},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"أثناء رحلة مدرسية، طلب المعلم من الطلاب وصف مشهد طبيعي. لاحظ المعلم أن أحد الطلاب المراهقين لم يكتفِ بوصف الأشياء بشكل سطحي، بل قام بتمييز التفاصيل الدقيقة، وربط العلاقات بين مكونات المشهد بطريقة منظمة. هذا التطور يعود إلى خصائص النمو","A":"الفسيولوجي المتمثل في طفرة النمو","B":"الإدراكي الحسي المتمثل في الانتقال إلى \"الإدراك المنظم\"","C":"الاجتماعي المتمثل في البحث عن الانتماء","D":"الانفعالي المتمثل في عدم استقرار صورة الذات","answer":"B","topic_question_no":13},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"تشهد مرحلة المراهقة طفرة نمو جسدية سريعة ومفاجئة، ولكن هذه الطفرة تختلف بين الجنسين. إذا قمنا بمقارنة سرعة النمو بين فتاة تبلغ من العمر 12 عاماً وصبي في نفس العمر، فإن الملاحظة العلمية الدقيقة ستشير إلى أن","A":"أ) التغيرات الفسيولوجية لديهما ستتوقف تماماً عند سن 14 عاماً","B":"ب) كلاهما سيمر بطفرة النمو في نفس اللحظة ونفس المعدل الزمني","C":"ج) الفتاة ستبلغ أقصى سرعة في النمو الجسدي في هذا السن تقريباً بينما تتأخر طفرة الصبي","D":"د) الصبي سيتفوق في الطول والوزن لأن طفرة الذكور تبدأ مبكراً","answer":"C","topic_question_no":14},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"شاب في المرحلة الثانوية يمر بحالة من الحيرة الشديدة؛ فهو يحاول تجربة أنماط مختلفة من الأفكار، وينضم لعدة أنشطة مدرسية متنوعة ليتعرف على ميوله الحقيقية وما يناسب شخصيته. يمر هذا الشاب بإحدى مراحل تكوين الهوية وهي مرحلة","A":"الاستكشاف للتعرف على الميول والأدوار","B":"الالتزام والدفاع عن الأفكار بثبات","C":"الاختيار والمفاضلة بين البدائل المتاحة","D":"التوافق النفسي النهائي مع متطلبات المجتمع","answer":"A","topic_question_no":15},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يواجه المراهقون أحياناً صراعاً داخلياً حاداً عندما يتخذون قراراً مستقلاً يتوافق مع قناعاتهم، لكنهم يجدون أن أصدقاءهم يرفضون هذا القرار تماماً، مما يضعهم في حيرة بين تنفيذ رغبتهم أو التخلي عنها لإرضاء الأصدقاء. يُعرف هذا التحدي النفسي بـ","A":"صراع المقارنة بالآخرين والشعور بعدم الرضا","B":"غياب الرؤية الواضحة للمستقبل وتعدد الخيارات","C":"التمرد كنوع من التعبير عن بناء الهوية","D":"صراع الاستقلال والانتماء","answer":"D","topic_question_no":16},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"قضى مراهق ساعات طويلة أمام المرآة قبل الخروج لمقابلة أصدقائه، وقام بتغيير ملابسه عدة مرات لمجرد أنه تذكر تعليقاً عابراً من أحدهم حول مظهره في اليوم السابق. هذا السلوك يفسر إحدى خصائص النمو الانفعالي للمراهق وهي","A":"الميل الشديد لرفض توجيهات الكبار","B":"الوعي الشديد بنظرة الآخرين وتقييمهم والحساسية تجاه آرائهم","C":"التغير السريع من الهدوء للغضب بسبب التغيرات الداخلية","D":"السعي للانفصال التام عن أي مجموعة اجتماعية","answer":"B","topic_question_no":17},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"تمكن شاب بعد فترة من التخبط من تحديد القيم الاتجاهات التي تعبر بصدق عن شخصيته، وبدأ يتبنى هذه الأفكار ويدافع عنها بثبات واستقرار نسبي أمام زملائه. وصول الشاب لهذه الحالة يعني أنه نـجح في اجتياز مرحلة","A":"الاستكشاف العشوائي","B":"صراع الاستقلال","C":"الالتزام ضمن مراحل تكوين الهوية","D":"المقارنة الضارة بالآخرين","answer":"C","topic_question_no":18},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يقدم تفسيراً عميقاً لهذا السلوك، حيث يرى أن اعتراض المراهق الدائم على قرارات وتوجيهات الأسرة لا يُعد دائماً سلوكاً سلبيًا أو عصياناً للقيم، بل هو غالباً تعبير عن","A":"الرغبة في الانعزال التام عن المجتمع","B":"الرغبة في الاستقلال ومحاولة إثبات الذات وبناء الهوية الخاصة","C":"الإدمان الرقمي والهروب من الواقع","D":"التغيرات الفسيولوجية وطفرة النمو السريعة فقط","answer":"B","topic_question_no":19},{"exam_id":"U3-T2","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يقضي مراهق معظم وقته في تصفح وسائل التواصل الاجتماعي، ويشعر بسعادة غامرة عند حصوله على تفاعل سريع وإعجابات، ولكنه يهمل واجباته المدرسية وينعزل عن أسرته. التفسير النفسي الأقرب لسبب وقوعه في هذا النمط (الإدمان الرقمي) هو بحثه عن","A":"بناء هوية واقعية مستقلة عن الأقران","B":"القبول اللحظي أو الهروب المؤقت من الضغوط","C":"اكتشاف اهتمامات إيجابية تنمي قدراته","D":"زيادة دقة الإدراك الحسي وتطوير الانتباه","answer":"B","topic_question_no":20}],"U3-T3":[{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يرى طالب أنه فشل في امتحان الرياضيات لأن المادة معقدة ولا يمكن فهمها، فشعر بالغضب والإحباط. بينما رأى زميله أن الدرجة المنخفضة هي فرصة لمعرفة نقاط ضعفه وتداركها، فشعر بحماس للتعويض. العامل الحاسِم الذي أدى لاختلاف الانفعال بينهما تجاه نفس الموقف هو","A":"أ) التغيرات الفسيولوجية العضوية.","B":"ب) الخبرة السابقة في امتحانات أخرى.","C":"ج) تفسير الموقف والمعنى الذي أعطاه كل منهما للحدث.","D":"د) الانفعالات الفطرية الأساسية.","answer":"C","topic_question_no":1},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"أثناء سير شخص في غابة، ظهر أمامه ثعبان ضخم، فجأة تسارعت ضربات قلبه وتوترت عضلاته وبدأت يداه في التعرق قبل حتى أن يقرر ما سيفعله. هذه الاستجابات الجسدية المرافقة للانفعال تُصنف ضمن","A":"أ) العمليات المعرفية وتفسير المواقف.","B":"ب) المظاهر السلوكية الخارجية المباشرة.","C":"ج) الاستجابات الفسيولوجية والعضوية.","D":"د) الانفعالات المركبة المكتسبة.","answer":"C","topic_question_no":2},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"الطفل الذي يولد في أي ثقافة حول العالم، سواء في الشرق أو الغرب، يظهر نفس تعبيرات الوجه التي تدل على الفرح أو الخوف منذ أشهره الأولى دون أن يتعلمها من أحد. هذا يثبت أن هذه الانفعالات هي","A":"أ) انفعالات مركبة تتشكل ببطء.","B":"ب) انفعالات أساسية فطرية ترتبط بآليات عصبية للحماية والبقاء.","C":"ج) انفعالات ناتجة عن تقييم الفرد لذاته.","D":"د) مجرد خبرات شعورية عابرة لا علاقة لها بالتكيف.","answer":"B","topic_question_no":3},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يشعر مراهق بالخجل الشديد عندما يضطر للتحدث أمام أقاربه، وذلك لإحساسه بأنه لا يمتلك اللباقة الكافية مقارنة بابن عمه الذي يجيد الحديث. يصنف \"الخجل\" في هذه الحالة على أنه انفعال","A":"أ) فطري يولد به الإنسان لحماية نفسه.","B":"ب) أساسي يظهر بصورة تلقائية وسريعة.","C":"ج) مركب يتشكل نتيجة للتفكير والمقارنة بالمعايير الاجتماعية.","D":"د) بيولوجي ناتج عن التغيرات العضوية فقط.","answer":"C","topic_question_no":4},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"تلقى موظف انتقادًا للاذعًا من مديره أمام زملائه. فبدلًا من الرد الفوري أو الصراخ، أخذ نفسًا عميقًا، وقرر تأجيل مناقشة الأمر مع المدير في مكتبه لاحقًا وبأسلوب مهني. الخطوة الاستراتيجية التي طبقها الموظف في التنظيم الانفعالي هي","A":"أ) كبت المشاعر ومنع ظهورها تمامًا.","B":"ب) إعادة تفسير الموقف واعتباره فرصة.","C":"ج) الوعي بالانفعال والتمييز بين التوتر والغضب.","D":"د) التحكم في الاستجابة الانفعالية وإيقاف رد الفعل التلقائي مؤقتًا.","answer":"D","topic_question_no":5},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يعاني شخص من نوبات غضب متكررة تدمر علاقاته، وعندما يسأله صديقه عما يغضبه، يقول: \"لا أعرف، أنا فقط أنفجر\". هذا الشخص يفتقر بشكل خطير إلى أولى خطوات التنظيم الانفعالي وهي","A":"أ) الوعي بالانفعال والإدراك الدقيق لما يشعر به حقًا.","B":"ب) التعبير المندفع عن المشاعر في أي وقت.","C":"ج) كبح التغيرات الفسيولوجية كنبض القلب.","D":"د) استخدام الانفعالات الفطرية بشكل مباشر.","answer":"A","topic_question_no":6},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يرفض علم النفس الحديث فكرة أن الانفعال (كالحزن أو الغضب) هو مشكلة بحد ذاته أو مرض يجب التخلص منه، ويؤكد بدلًا من ذلك أن المشكلة الحقيقية تكمن في","A":"أ) ظهور المظاهر السلوكية الخارجية كالبكاء.","B":"ب) عدم فهم الانفعال أو عدم القدرة على إدارته وتنظيمه بوعي.","C":"ج) ارتباطه بآليات عصبية فطرية في الجهاز العصبي.","D":"د) تحوله من انفعال مركب إلى انفعال أساسي.","answer":"B","topic_question_no":7},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"تعرض طالب لحادث بسيط أثناء ركوبه الدراجة في الشارع، ورغم أنه لم يصب بأذى، إلا أنه أصبح يشعر برعب شديد كلما رأى دراجة، ويرفض ركوبها مجددًا. العامل الذي يحدد استجابته الانفعالية الحالية والمستقبلية تجاه الدراجات هو","A":"أ) الحالة الداخلية الجسدية وقت الحدث.","B":"ب) تفسير الموقف كفرصة جديدة للتحدي.","C":"ج) الخبرة السابقة وتجاربه الماضية المؤلمة.","D":"د) غياب الانفعالات الأساسية الفطرية.","answer":"C","topic_question_no":8},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"عند تحليل الانفعال كعملية مركبة، فإن الطريقة التي نتحدث بها، وتعبيرات الوجوه التي نظهرها للآخرين أثناء الفرح أو الحزن، تُمثل الجانب","A":"أ) الفسيولوجي المتمثل في تسارع التنفس.","B":"ب) المعرفي المرتبط بتفسير المثير.","C":"ج) السلوكي الخارجي الذي يرافق الانفعال.","D":"د) العصبي الفطري.","answer":"C","topic_question_no":9},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"كتمان الفرد لغضبه الشديد تجاه زميله لأسابيع طويلة دون محاولة الحديث معه أو حل المشكلة، معتقدًا أنه بذلك يتجنب المشاكل. هذا السلوك يعد خطيرًا نفسيا لأنه يمثل حالة من","A":"أ) التعبير الواعي الهادئ.","B":"ب) الكبت الذي يولد ضغطًا داخليا واستجابات غير تكيفية لاحقًا.","C":"ج) التحكم الإيجابي في الاستجابة الانفعالية.","D":"د) إعادة تفسير الموقف بوعي ومرونة.","answer":"B","topic_question_no":10},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"أثناء مشاهدته لفيلم رعب، لاحظ شخص أن ضربات قلبه تتسارع، وأن عضلاته تتوتر بشكل ملحوظ. هذه التغيرات التي يمر بها الفرد تمثل أحد جوانب عملية الانفعال وهو","A":"التغير في العمليات المعرفية وتفسير المواقف","B":"الاستجابة الفسيولوجية والعضوية","C":"المظاهر السلوكية الخارجية كنبرة الصوت","D":"الاستجابة الإدراكية المنظمة","answer":"B","topic_question_no":11},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يعتقد بعض الأفراد أن الشعور بالغضب هو في حد ذاته مشكلة نفسية يجب التخلص منها تماماً. يرفض علم النفس هذا الاعتقاد مؤكداً أن الانفعال ليس مشكلة أبداً، بل تكمن المشكلة الحقيقية في","A":"ظهور الانفعالات بصورة تلقائية وسريعة","B":"ارتباط الانفعالات بآليات عصبية فطرية","C":"عدم فهم الانفعال أو عدم القدرة على تنظيمه وإدارته","D":"اقتصار الانفعال على تغيرات في معدل التنفس فقط","answer":"C","topic_question_no":12},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"الانفعالات الأساسية (كالفرح والخوف) تتميز بأنها تشترك فيها معظم الثقافات البشرية، وتظهر بصورة تلقائية وسريعة جداً. السبب العلمي الذي يفسر هذا التشابه العالمي هو ارتباط هذه الانفعالات بـ","A":"تقييم الفرد لذاته مقارنة بالمعايير الاجتماعية المعقدة","B":"خبرات الطفولة المكبوتة في اللاشعور","C":"آليات عصبية فطرية في الجهاز العصبي تهدف للحماية والبقاء والتكيف","D":"التفكير المنطقي البطيء الذي يسبق ظهور المشاعر","answer":"C","topic_question_no":13},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يشعر موظف بـ \"الغيرة\" الشديدة من زميله الذي حصل على ترقية. هذا الانفعال لا يظهر بشكل فطري أو مباشر كخوف الإنسان من خطر جسدي، بل احتاج إلى وقت ليتشكل بناءً على التفكير والمقارنة الاجتماعية. يُصنف هذا الشعور ضمن","A":"الانفعالات الأساسية الفطرية","B":"الانفعالات المركبة","C":"الاستجابات الفسيولوجية البحتة","D":"المظاهر السلوكية الإيجابية","answer":"B","topic_question_no":14},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"طالبان حصلا على نفس الدرجة المنخفضة في الامتحان. الأول شعر بـ \"الخوف\" لاعتقاده بأن الدرجة تمثل تهديداً لمستقبله، والثاني شعر بـ \"الحماس\" واعتبرها فرصة لمعرفة نقاط ضعفه وتحدياً للتحسين. العامل الأساسي الذي أدى لاختلاف انفعالهما رغم وحدة الموقف هو","A":"الحالة الداخلية الجسدية وقت الحدث","B":"تفسير الموقف والمعنى المعطى له","C":"الخبرة السابقة والنـجاح في مواقف مماثلة","D":"الاستجابات العضوية وتوتر العضلات","answer":"B","topic_question_no":15},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"شخص يعاني من إرهاق شديد وضغط نفسي بسبب العمل المستمر، وعندما سأله صديقه سؤالاً بسيطاً، رد عليه بانفعال وغضب شديد غير مبرر. العامل الذي حدد \"شدة\" هذا الانفعال في هذا الموقف هو","A":"التقييم الاجتماعي لمعايير الفخر والخجل","B":"التفكير العميق في دوافع الصديق","C":"الحالة الداخلية للفرد (مستوى التعب والمزاج وقت الحدث)","D":"التفسير الإيجابي للموقف كفرصة","answer":"C","topic_question_no":16},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"تؤدي الانفعالات وظيفة هامة تتجاوز مجرد الشعور الداخلي، حيث تتدخل بقوة لتوجيه طريقة التفكير، وتحدد نوع الاستجابة وتؤثر في اتخاذ القرارات للتعامل مع المثيرات البيئية. تُعرف هذه الوظيفة الهامة بـ","A":"الوظيفة التكيفية للانفعالات","B":"التعبير المندفع عن المشاعر","C":"الكبت الداخلي للغرائز","D":"التحيز الإدراكي للمواقف","answer":"A","topic_question_no":17},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يشعر الفرد بحالة من التوتر والضيق، لكنه لا يستطيع تحديد ما إذا كان هذا الشعور ناتجاً عن غضب تجاه مديره أم خوف من فقدان وظيفته. هذا الفرد يفتقر إلى الخطوة الأولى من استراتيجيات التنظيم الانفعالي وهي","A":"التحكم في الاستجابة وإيقاف رد الفعل","B":"الكبت الواعي للمشاعر","C":"الوعي بالانفعال والإدراك الدقيق لما يشعر به حقاً","D":"إعادة تفسير الموقف بشكل إيجابي","answer":"C","topic_question_no":18},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"تعرضت لاعبة رياضية لإصابة طفيفة أبعدتها عن المنافسة. بدلاً من الاستسلام لليأس، قررت النظر إلى فترة التوقف كفرصة لمراجعة أخطائها الفنية وتطوير خططها العقلية. الاستراتيجية التي طبقتها اللاعبة لتنظيم انفعالها هي","A":"الوعي الدقيق بمشاعر الإحباط دون تغييرها","B":"تأجيل الرد على الانتقادات الخارجية","C":"التعبير المندفع لتفريغ شحنة الغضب","D":"إعادة تفسير الموقف (تعديل المعنى المعطى للحدث)","answer":"D","topic_question_no":19},{"exam_id":"U3-T3","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"تلقى موظف رسالة إلكترونية تحمل انتقاداً لذعاً لعمله، فشعر بغضب شديد وكاد أن يرسل رداً هجومياً قاسياً، لكنه قرر التوقف، وأخذ نفساً عميقاً، وقرر تأجيل الرد لليوم التالي ليكون أكثر هدوءاً. قدرة هذا الموظف تمثل استراتيجية","A":"التحكم في الاستجابة الانفعالية وإيقاف رد الفعل التلقائي السريع مؤقتاً","B":"الكبت النفسي الذي يولد ضغطاً داخلياً غير صحي","C":"الاندفاع وتصعيد المشكلات نتيجة سوء تفسير الموقف","D":"تحويل الانفعال الأساسي إلى انفعال مركب","answer":"A","topic_question_no":20}],"U3-T4":[{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يواجه شاب صعوبات كبيرة في التأقلم مع بيئة عمله الجديدة بسبب اختلاف الطباع، فقرر الانعزال تمامًا عن زملائه وتجنب أي نقاش معهم، معتقدًا أنه بذلك قد حقق السلام الداخلي وتكيف مع الوضع. وفقًا لعلم النفس، يعد هذا الاعتقاد خاطئًا لأن التكيف النفسي الحقيقي يعني","A":"أ) القدرة على مواجهة التغيرات والضغوط بأساليب متوازنة وليس الهروب منها.","B":"ب) الامتثال الأعمى لقواعد الزملاء لتجنب الصراعات.","C":"ج) استخدام الحيل الدفاعية كالكبت لتجنب القلق.","D":"د) غياب المرض النفسي والعافية الجسدية التامة.","answer":"A","topic_question_no":1},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يمتلك أحد الطلاب قدرة فائقة على فهم نفسه وتحديد نقاط قوته، بالإضافة إلى قدرته على التواصل الإيجابي مع من حوله وتحقيق التوازن بين متطلباته وتوقعات والديه. تُعرف هذه القدرات والأدوات المكتسبة التي يستخدمها الطالب بـ","A":"أ) التكيف البيولوجي الفطري.","B":"ب) مهارات الحياة الأساسية.","C":"ج) الخداع الإدراكي للمواقف.","D":"د) التغيرات الفسيولوجية.","answer":"B","topic_question_no":2},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"في نقاش محتدم بين صديقين، حرص أحدهما على اختيار كلماته بدقة، وتعديل نبرة صوته ليوضح أفكاره ومشاعره بوضوح تام ودون أن يوجه أي إساءة أو يستخدم عبارات غامضة. المهارة التي طبقها هذا الصديق هي إحدى مهارات التواصل الفعال وتُسمى","A":"أ) الاستماع الفعال.","B":"ب) التعبير عن الذات.","C":"ج) إعادة التفسير المعرفي.","D":"د) تقسيم الموقف وتحديد الأولويات.","answer":"B","topic_question_no":3},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يتحدث طالب مع الأخصائي الاجتماعي عن مشكلة يعاني منها في المنزل، فقام الأخصائي بالتركيز التام معه، محاولًا إدراك المعنى الخفي والمشاعر التي تقف خلف كلماته، مع الحرص على عدم مقاطعته حتى ينهي حديثه. يجسد هذا السلوك تطبيقًا لمهارة","A":"أ) بناء الحدود الشخصية.","B":"ب) تقبل التغير المستمر.","C":"ج) الاستماع الفعال الذي يقلل من سوء الفهم.","D":"د) التعبير الذاتي الواضح.","answer":"C","topic_question_no":4},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يعتقد الكثير من الناس أن الضغوط الحياتية والمتطلبات الصعبة هي عوامل سلبية دائمًا تؤدي إلى الانهيار وتدمير الصحة النفسية. يفند علم النفس هذا الاعتقاد مؤكدًا أن الضغوط قد تكون","A":"أ) سببًا وحيدًا للاضطرابات الإكلينيكية المستعصية.","B":"ب) دافعًا يحفز الإنـجاز إذا تمت إدارتها بشكل جيد.","C":"ج) مؤشرًا على نقص مهارات التواصل الفعال.","D":"د) ناتجة حصريا عن التوقعات الاجتماعية المنخفضة.","answer":"B","topic_question_no":5},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يعاني موظف من ضغط نفسي شديد، وللتعامل معه بفعالية، طلب منه المرشد المهني أن يحدد بدقة ما إذا كان هذا الضغط نابعًا من صعوبة المهام ذاتها، أم من رغبته في إنـجازها بمثالية مفرطة تفوق قدراته. الخطوة التي يطبقها المرشد هنا هي","A":"أ) فهم مصدر الضغط للتمييز بين ما يمكن تغييره وما يحتاج للتكيف.","B":"ب) التعبير الآمن عن الغضب المكبوت.","C":"ج) الاستمرار في العمل وتجاهل المشاعر السلبية.","D":"د) تقسيم الموقف إلى خطوات صغيرة.","answer":"A","topic_question_no":6},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"تعرض رياضي لإصابة بالغة أبعدته عن الملاعب لعدة أشهر، وبدلًا من الاستسلام لليأس، حافظ على توازنه وبدأ رحلة تأهيل شاقة للعودة مجددًا لمستواه. قدرة هذا الرياضي على التكيف الناجح مع هذه التجربة الصعبة تُمثل العملية التي تعرفها جمعية علم النفس الأمريكية (APA) بـ","A":"أ) مهارة التوكيدية.","B":"ب) المرونة النفسية.","C":"ج) الانتباه الانتقائي اللارادي.","D":"د) التعبير عن الذات.","answer":"B","topic_question_no":7},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"تنشأ العديد من الخلافات في بيئة العمل نتيجة رغبة كل موظف في إثبات صحة رأيه وتسفيه آراء الآخرين. المهارة الأساسية التي تعالج هذا الخلل وتضمن توفير بيئة تعبير آمنة للجميع هي","A":"أ) التوازن في أخذ وعطاء الدعم المادي.","B":"ب) الاحترام المتبادل والاعتراف بحق الآخرين في الاختلاف.","C":"ج) تقبل التغير المستمر في سياسات العمل.","D":"د) الاعتماد المتبادل وإلغاء الاستقلالية.","answer":"B","topic_question_no":8},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يكمن الفارق الدقيق بين \"التعبير عن الذات\" و\"الاستماع الفعال\" كعنصرين مكملين لمهارة التواصل؛ في أن الأول يركز على إرسال الرسالة بوضوح وتجنب الإساءة، بينما يركز الثاني بشكل أساسي على","A":"أ) استخدام الحجج المنطقية لإسكات الطرف الآخر.","B":"ب) استنباط المعاني والمشاعر الكامنة خلف الكلمات دون مقاطعة.","C":"ج) تحديد مصدر الضغط النفسي الذي يواجه المتحدث.","D":"د) فرض التوازن في العلاقة بالقوة.","answer":"B","topic_question_no":9},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يواجه شاب قرارًا مفاجئًا بنقل مكان عمله لمدينة أخرى، فقرر التعامل مع هذا الانتقال كجزء طبيعي من مسار حياته المهنية وبدأ في التعرف على المدينة الجديدة بدلًا من الرفض والغضب. يطبق هذا الشاب إحدى مهارات المرونة النفسية وهي","A":"أ) الاستماع الفعال للآخرين.","B":"ب) تقبل التغير والتكيف معه.","C":"ج) فهم مصدر الضغط الناتج عن التوقعات.","D":"د) بناء الحدود في العلاقات السوية.","answer":"B","topic_question_no":10},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يُفهم التكيف النفسي بشكل خاطئ أحياناً على أنه الاستسلام أو الهروب من المشكلات. المفهوم العلمي الصحيح للتكيف يؤكد أنه:","A":"أ) الاستجابة التلقائية المندفعة التي تتجاهل متطلبات البيئة","B":"ب) التنازل التام عن الأهداف الشخصية لتحقيق الاستقرار الداخلي المطلق","C":"ج) قدرة الفرد على مواجهة التغيرات والضغوط بأساليب متوازنة للتعامل مع المشكلات بشكل سوي","D":"د) قدرة الفرد على تجنب كافة الضغوط والتحديات والعيش بلا صراعات","answer":"C","topic_question_no":11},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"مهارات الحياة ليست مجرد معارف نظرية، بل هي أدوات أساسية مكتسبة تهدف في مرحلة المراهقة بشكل رئيسي إلى ما يلي:","A":"أ) تغيير السمات الوراثية الجينية للفرد ليتكيف بيولوجياً","B":"ب) رفع معدل الذكاء الأكاديمي والتحصيل الدراسي حصراً","C":"ج) مساعدة المراهق على إدارة حياته بكفاءة والتواصل الإيجابي وتحقيق التوازن مع مجتمعه","D":"د) ضمان عدم التعرض لأي أزمات أو صراعات مستقبلية","answer":"C","topic_question_no":12},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"غالباً ما تنشأ المشكلات في العلاقات الإنسانية ليس من الموقف نفسه بل من سوء التعبير أو الفهم. بناءً على ذلك، تُعرف \"مهارة التواصل الفعال\" بأنها ليست مجرد كلام، بل هي بالأساس مهارة تتمثل في:","A":"فرض الرأي على الآخرين بقوة","B":"إدارة الاختلاف والتوضيح التام دون إساءة","C":"السكوت التام لتجنب أي صدام محتمل","D":"استخدام الحيل الدفاعية للتهرب من الحوار","answer":"B","topic_question_no":13},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"أثناء نقاش بين زميلين، كان الأول يتحدث بحماس بينما الثاني صامت تماماً، لكنه يجهز في عقله رداً مفحماً فور انتهاء الأول من كلامه دون أن يركز في المعاني خلف الكلمات. هذا الموقف يفتقر إلى أحد عناصر التواصل الفعال وهو ما يلي:","A":"أ) تجنب المقارنات الاجتماعية المباشرة","B":"ب) اختيار نبرة الصوت المناسبة للهجوم","C":"ج) الاستماع الفعال الذي يتطلب تركيزاً وانتباهاً لما يُقال لمحاولة إدراك المعنى","D":"د) التعبير عن الذات بوضوح","answer":"C","topic_question_no":14},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"واجه طالب فترة امتحانات متتالية شكلت له ضغطاً كبيراً، لكنه بدلاً من الانهيار، استخدم هذا الضغط كدافع قوي لتنظيم وقته والمذاكرة بتركيز مضاعف لتحقيق التفوق. هذا الموقف يثبت أن الضغوط تكون:","A":"أ) ناتجة دائماً عن توقعات الآخرين المرتفعة وليس من الموقف نفسه","B":"ب) قد تكون محفزة للإنـجاز ولا تتحول لمشكلة إلا إذا لم تُدار جيداً","C":"ج) يجب تجنبها والهروب منها كاستراتيجية أولى للتكيف","D":"د) سلبية دائماً وتؤدي حتماً لانهيار القدرات العقلية","answer":"B","topic_question_no":15},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"الخطوة الأولى والأهم في مهارة \"إدارة الضغوط\" هي التمييز بين ما يمكن تغييره وما يحتاج للتكيف فقط. تتطلب هذه الخطوة قدرة الفرد على ما يلي:","A":"أ) تقسيم الموقف لخطوات عشوائية دون تحديد الأولويات","B":"ب) الانخراط في سلسلة من الانفعالات الحادة كالغضب","C":"ج) فهم مصدر الضغط (هل هو نابع من الموقف، أم من طريقة تفسيره، أم التوقعات المرتفعة)","D":"د) الاستسلام التام للتوتر لتقليل المقاومة","answer":"C","topic_question_no":16},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"تُعرف جمعية علم النفس الأمريكية (APA) المرونة النفسية بأنها العملية والنتيجة للتكيف الناجح مع التجارب الصعبة. هذه المرونة لا تعني أبداً ما يلي:","A":"استخدام المرونة العقلية والسلوكية في مواجهة المتطلبات","B":"عدم الشعور بالضيق أو الألم أثناء مواجهة التحديات","C":"القدرة على الاستمرار في الحياة والحفاظ على التوازن","D":"تقبل التغير كجزء طبيعي من الحياة","answer":"B","topic_question_no":17},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"رجل أعمال فقد جزءاً كبيراً من استثماراته في أزمة اقتصادية، فشعر بضيق شديد، لكنه لم يتوقف، بل تقبل هذا التغير وتعلم من أخطائه السابقة وبدأ في التخطيط لمشروع جديد. هذا التصرف يجسد مهارات ما يلي:","A":"المرونة النفسية (تقبل التغير والاستمرار رغم التحديات)","B":"الاستماع الفعال وإدارة الاختلاف","C":"الهروب التكيفي من الضغوط","D":"بناء العلاقات السوية والتوازن في العطاء","answer":"A","topic_question_no":18},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"بناء العلاقات السوية يتطلب مهارة إدارة الاختلاف بأسلوب ناضج يحد من الصراعات. الركيزة الأساسية التي تضمن توفير \"التعبير الآمن\" لكل طرف دون تقليل أو إهانة هي:","A":"التوازن في الأخذ والعطاء","B":"السيطرة التامة لطرف على الآخر لضمان الاستقرار","C":"الاحترام المتبادل والاعتراف بحق الآخر في الاختلاف","D":"تجنب النقاشات العميقة والاعتماد على التواصل السطحي","answer":"C","topic_question_no":19},{"exam_id":"U3-T4","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"علاقة صداقة يقدم فيها أحد الأطراف الدعم المستمر والتنازلات والمساعدة دائماً، بينما يكتفي الطرف الآخر بالأخذ دون أي مساهمة تُذكر، مما أدى لانهيار العلاقة. السبب النفسي لانهيارها هو غياب مهارة تمثلت في:","A":"التعبير عن الذات بصوت واضح","B":"التوازن في العلاقة والمشاركة المتبادلة في الدعم","C":"الاستماع الفعال وتجنب المقاطعة","D":"تقبل التغيرات الاقتصادية والبيئية","answer":"B","topic_question_no":20}],"U4-T1":[{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يلاحظ المعلم أن أحد طلابه يتمتع بذاكرة بصرية مذهلة تمكنه من حفظ الخرائط الجغرافية بدقة، لكنه يعاني بشدة عند محاولة استيعاب القواعد النحوية المجردة. هذا التباين الواضح في مستوى القدرات يمثل علميا:","A":"أ) فروقًا بين الأفراد.","B":"ب) انعدامًا للميول الفطرية.","C":"ج) فروقًا داخل الفرد نفسه.","D":"د) تغيرات نوعية في السمات الانفعالية.","answer":"C","topic_question_no":1},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يرى أحد المديرين أن جميع الموظفين يمتلكون قدرة على التفكير الإبداعي وحل المشكلات، لكن الاختلاف بينهم يكمن فقط في مستوى هذه القدرة ومقدار ما يمتلكونه منها. تتطابق هذه الرؤية مع إحدى الخصائص العامة لـ الفروق الفردية وهي أنها:","A":"أ) سريعة التغير وتتعدل بالبيئة.","B":"ب) تتوزع بشكل متطرف لدى الأغلبية.","C":"ج) صفات كمية تختلف في المقدار وليست نوعية.","D":"د) أكثر ثباتًا من السمات الجسمية.","answer":"C","topic_question_no":2},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"عند تتبع نمو شخصيتين منذ الطفولة وحتى الرشد، نـجد أن التغير في مستوى ذكائهما وسرعة بديهتهما يحدث بمعدلات مقبولة ومرنة، بينما يظل لون أعينهما وطولهما النسبي ثابتًا تقريبًا طوال حياتهما. هذا التباين يوضح خاصية:","A":"أ) التوزيع الاعتدالي الجرسي للصفات.","B":"ب) اختلاف معدل ثبات الفروق الفردية باختلاف السمة.","C":"ج) تأثير البيئة في تغيير الميول والاهتمامات.","D":"د) الكمية المتساوية للقدرات داخل الفرد.","answer":"B","topic_question_no":3},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"إذا قمنا بتطبيق اختبار دقيق لقياس مهارة \"الطلاقة اللغوية\" على عينة عشوائية تضم عشرة آلاف شخص من مجتمع معين، فإن النتائج وفقًا لـ \"المنحنى الجرسي\" ستظهر أن:","A":"أ) الأغلبية الساحقة ستحصل على أعلى الدرجات.","B":"ب) حوالي 68% من الأشخاص سيحصلون على درجة متوسطة.","C":"ج) جميع الأفراد سيمتلكون نفس المقدار بدقة متناهية.","D":"د) 16% فقط سيحصلون على درجة متوسطة والأغلبية في الأطراف.","answer":"B","topic_question_no":4},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يقضي شاب ساعات طويلة في تفكيك وتركيب الأجهزة الإلكترونية القديمة في غرفته، ويشعر بمتعة عميقة ورضا تام أثناء قيامه بذلك رغم المجهود البدني والذهني الذي يبذله دون مقابل مادي. يصنف هذا المحرك الخفي لسلوكه في علم النفس على أنه:","A":"أ) سمة جسمية ثابتة.","B":"ب) قدرة عقلية مجردة.","C":"ج) ميل أو استعداد نفسي داخلي يوجه الانتباه.","D":"د) فروق فردية كمية.","answer":"C","topic_question_no":5},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"وُلد طفل بـ \"أذن حساسة للإيقاع\" وقدرة على تمييز الأصوات (استعداد فطري)، لكنه نشأ في بيئة قاسية لا تعير الفنون أي اهتمام ولم توفر له أي آلة موسيقية، فاندثرت هذه القدرة ولم تتحول لشغف. يثبت هذا المثال أن تشكيل الميول يتطلب حتمًا تضافر الاستعدادات الفطرية مع:","A":"أ) السمات الانفعالية الثابتة.","B":"ب) التنشئة والبيئة المكتسبة التي توفر الفرص.","C":"ج) الفروق الجسمية بين الأفراد.","D":"د) الوراثة الجينية لمرض عمى الألوان.","answer":"B","topic_question_no":6},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يعاني طالب من إحباط مستمر بسبب حصوله على درجات منخفضة في مادة الفيزياء رغم اجتهاده، بينما يتفوق بامتياز في كتابة القصة القصيرة. لفهم حالته، يجب أن يدرك أن تعثره في الفيزياء لا يعني الفشل بل يعني أنه:","A":"أ) يمثل غباءً عامًا وضعفًا في الذكاء الكلي.","B":"ب) يدل على وجود خلل في التكوين العضوي للغدد.","C":"ج) في مسار لا يتوافق مع طبيعته وبصمته النفسية.","D":"د) ناتج عن انعدام الميول الفطرية بشكل عام.","answer":"C","topic_question_no":7},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"تنظم إحدى الجمعيات الخيرية فعالية كبرى، فقامت بتكليف الشاب (أ) ذو الكاريزما بالتحدث للجمهور، والشاب (ب) الدقيق بحساب التبرعات، والشاب (ج) المبدع بتصميم اللافتات. يعكس هذا التوزيع إدراك الإدارة لأهمية الفروق الفردية في:","A":"أ) تصنيف الأشخاص إلى أفضل وأسوأ.","B":"ب) التسامح مع أخطاء الموظفين وتقليل الصدام.","C":"ج) توجيه الأفراد للأنشطة التي تلائم قدراتهم لتحقيق التكامل.","D":"د) إثبات أن الفروق بين الأفراد نوعية وليست كمية.","answer":"C","topic_question_no":8},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"هناك فارق جوهري بين \"الفروق بين الأفراد\" و\"الفروق داخل الفرد نفسه\"؛ فإذا كنا نقارن بين سرعة استجابة لاعب كرة القدم لتعليمات المدرب وبين قدرة نفس اللاعب على ضبط انفعالاته عند الخسارة، فنحن بصدد دراسة:","A":"أ) الفروق النوعية في السمات الجسمية.","B":"ب) التوزيع الاعتدالي للمنحنى الجرسي.","C":"ج) الفروق داخل الفرد نفسه لمستويات قدراته وسماته.","D":"د) الفروق بين الأفراد في الخصائص العقلية.","answer":"C","topic_question_no":9},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يرى علماء النفس أن العبارة القائلة بأن \"فلان شخص متوسط الذكاء\" لا يجب أن تُعتبر إهانة أو تقليلاً من الشأن، وذلك استنادًا إلى حقيقة إحصائية تؤكد أن:","A":"أ) الذكاء سمة انفعالية سريعة التغير.","B":"ب) القدرات العقلية لا تخضع للقياس الكمي.","C":"ج) التوسط هو حقيقة علمية تطبق على الأغلبية (68%) من البشر.","D":"د) الفائقين يشكلون النسبة الأكبر في أي مجتمع.","answer":"C","topic_question_no":10},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يشير مفهوم الفروق الفردية إلى الاختلافات بين الأفراد في الصفات المختلفة مقارنة بـ .المتوسط العام. لأقرانهم. هذا يعني علمياً أن هذه الفروق تعتبر","A":"حالة نادرة وشاذة تخرج عن القاعدة الأساسية للكون","B":"القاعدة الأساسية التي تحكم الكون وأن التشابه التام هو الاستثناء","C":"اختلافات كيفية بحتة تعني انعدام وجود الصفة لدى البعض","D":"اختلافات موجودة فقط في الجوانب الجسدية دون الجوانب العقلية","answer":"B","topic_question_no":11},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"دراسة الفروق الفردية لا تهدف أبداً إلى تصنيف الأشخاص بين .أفضل. أو .أسوأ.، بل تهدف بالأساس إلى تحقيق غاية أعمق تتمثل في","A":"أ) إثبات أن الذكاء هو العامل الوحيد المحدد للنـجاح المهني","B":"ب) فهم تميز كل فرد ووضعه في المكان والمسار الذي تزدهر فيه قدراته الطبيعية","C":"ج) إجبار الأفراد على امتلاك نفس الميول والاتجاهات","D":"د) فرض بيئة تعليمية واحدة لتوحيد قدرات الجميع","answer":"B","topic_question_no":12},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"تمتلك سارة قدرة فائقة على الحفظ السريع وذاكرة قوية، لكنها تواجه صعوبة بالغة في التفاعل الاجتماعي وبناء العلاقات، بينما تجيد أختها التفاعل الاجتماعي لكن ذاكرتها ضعيفة. يُطلق على هذا الاختلاف في القدرات داخل شخصية سارة نفسها مصطلح","A":"فروق بين الأفراد","B":"فروق داخل الفرد نفسه","C":"الانحراف المعياري","D":"التوزيع الاعتدالي لأقلية","answer":"B","topic_question_no":13},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"أحد أهم خصائص الفروق الفردية أنها .كمية وليست نوعية.، وهذا التعبير العلمي الدقيق يعني أن","A":"أ) السمات الانفعالية أكثر ثباتاً من السمات الجسدية والعقلية","B":"ب) الفروق بين الناس تُقاس بأنواع مختلفة للصفات وليس بالدرجات","C":"ج) الصفات النفسية موجودة عند جميع البشر (نفس النوع)، والاختلاف يكمن فقط في المقدار أو الكمية التي يمتلكونها","D":"د) بعض البشر يفتقرون للذكاء تماماً ويمتلكون نوعاً آخر من العقول","answer":"C","topic_question_no":14},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"إذا قمنا بمقارنة مدى ثبات واستقرار الفروق الفردية بمرور الوقت، سنـجد أن هناك سمات قابلة للتعديل والتدريب بسهولة نسبياً متأثرة بالبيئة، وهي","A":"السمات الجسمية (كالطول ولون العينين)","B":"السمات العقلية والمعرفية (كالذكاء)","C":"السمات التكوينية العضوية","D":"السمات الانفعالية (كالقلق أو الخجل)","answer":"D","topic_question_no":15},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"عند جمع قياسات لصفة معينة (كالذكاء) لآلاف الأشخاص، وتوزيع النتائج إحصائياً على ما يُعرف بـ .المنحنى الجرسي. (التوزيع الاعتدالي)، فإننا نـجد أن النسبة الأكبر من البشر (حوالي 68%) يقعون في","A":"أقصى اليمين (فائقو القدرة)","B":"المنتصف (أشخاص يمتلكون قدرة متوسطة)","C":"أقصى اليسار (أقل قدرة)","D":"الأطراف المتطرفة بنسب متساوية","answer":"B","topic_question_no":16},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يغضب بعض الأفراد عند وصف قدراتهم بأنها .متوسطة.، معتبرين ذلك تقليلاً من شأنهم. يرد علم النفس على هذا الاعتقاد بأن عبارة .شخص متوسط. هي","A":"أ) مؤشر على ضرورة تغيير البيئة للوصول إلى أطراف المنحنى","B":"ب) دليل على عدم ثبات السمات الجسدية والمعرفية","C":"ج) حقيقة علمية تنطبق على الأغلبية الساحقة من البشر في أي صفة مقاسة","D":"د) إهانة علمية تدل على فشل التنشئة الاجتماعية","answer":"C","topic_question_no":17},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"يمكن تعريف .الميول. بأنها المحرك الخفي والبوصلة الداخلية التي توجه انتباهك نحو نشاط معين دون غيره، وتجعلك تشعر بـ","A":"التوتر والقلق الدائم للوصول للكمال","B":"الإرهاق والملل السريع لارتفاع الجهد المبذول","C":"الرضا والمتعة العميقة أثناء ممارسته بغض النظر عن الجهد المبذول","D":"الرغبة في التوقف الفوري عند التعرض لأي نقد","answer":"C","topic_question_no":18},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":".قدرتك العالية على فعل شيء ما لا تعني بالضرورة ميلك النفسي له.. تتجلى هذه القاعدة عندما نـجد مهندساً بارعاً جداً في الرياضيات وحل المعادلات المعقدة (يمتلك القدرة)، ولكنه","A":"أ) يقع ضمن الأقلية المتطرفة (16%) في المنحنى الجرسي للانفعالات","B":"ب) يكره هذه المهنة ويشعر بالملل والإحباط أثناء ممارستها (لا يمتلك الميل)","C":"ج) لا يستطيع التميز في السمات الجسمية كزملائه","D":"د) يشعر بالمتعة البالغة والشغف كلما قام بحلها","answer":"B","topic_question_no":19},{"exam_id":"U4-T1","unit":4,"topic":"الفروق الفردية بين الناس","question":"تلعب .الخبرات السابقة (خبرات النـجاح). دوراً حاسماً في تشكيل ميول الإنسان وتطوير شغفه نحو مجال معين. التفسير النفسي لهذا الدور هو أن العقل يميل إلى","A":"أ) الكتفاء بالسمات الجسدية الثابتة كمصدر وحيد للميول","B":"ب) تجنب الأنشطة التي تتوافق مع البذور الفطرية الكامنة","C":"ج) تكرار ما يجلب له السعادة؛ فارتباط المهمة بالتقدير والنـجاح يحولها لعملية محببة","D":"د) تكرار الأنشطة التي تجلب له الإحباط لتحدي الذات","answer":"C","topic_question_no":20}],"U4-T2":[{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"اعتمدت المدارس لسنوات طويلة على مقياس موحد يعطي الطالب \"رقمًا نهائيا\" يحدد مستوى ذكائه بناءً على قدرته على حل المسائل الرياضية واللغوية فقط، مما أدى لتصنيف المبدعين في الرياضة أو الفنون كأشخاص غير أذكياء. هذا النهج الإقصائي يمثل جوهر مفهوم:","A":"أ) نظرية الذكاءات المتعددة.","B":"ب) المنظور الأحادي (التقليدي) للذكاء.","C":"ج) مفهوم الذكاء الوجداني.","D":"د) التفكير الإبداعي التباعدي.","answer":"B","topic_question_no":1},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يرى هوارد جاردنر أن العقل البشري ليس كتلة واحدة جامدة، بل هو يمتلك منظومة من القدرات التي يمكن تنميتها وتطويرها إذا وجدت البيئة المناسبة للتدريب. هذه الرؤية تؤكد أن الذكاء في نظرية الذكاءات المتعددة هو:","A":"أ) قدرة فطرية ووحيدة.","B":"ب) موروث بيولوجي لا يقبل التغيير.","C":"ج) ديناميكي ومرن وقابل للنمو.","D":"د) مقتصر على حل المشكلات الرياضية حصريا.","answer":"C","topic_question_no":2},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"استطاع أحد السياسيين في خطابه إقناع الجماهير بوجهة نظره، معتمدًا على اختياره الدقيق للمفردات، والتلاعب بمعاني الكلمات، وضبط إيقاع جمله ببراعة. يمتلك هذا السياسي مستوى مرتفعًا من نوع الذكاء:","A":"أ) الذكاء المنطقي.","B":"ب) الذكاء الشخصي.","C":"ج) الذكاء اللغوي.","D":"د) الذكاء المكاني.","answer":"C","topic_question_no":3},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يواجه مبرمج حاسوب مشكلة معقدة في بناء تطبيق جديد، فبدأ في تتبع الأكواد المتسلسلة، واكتشاف الأنماط المتكررة، واستنتاج العلاقة بين السبب والنتيجة لمعالجة الخلل. تعكس قدرة هذا المبرمج اعتماده المباشر على الذكاء:","A":"أ) البصري / المكاني.","B":"ب) المنطقي / الرياضي.","C":"ج) الطبيعي (البيئي).","D":"د) الذكاء الوجداني.","answer":"B","topic_question_no":4},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"تم تكليف مصمم داخلي (مهندس ديكور) بتجديد شقة صغيرة الحجم، فقام بتخيل الأبعاد والزوايا في ذهنه قبل رسمها، واستخدم تمييزه الفائق لألوان ليخلق شعورًا بصريا باتساع المكان. يعتمد إبداع هذا المصمم بشكل أساسي على الذكاء:","A":"أ) الذكاء اللغوي.","B":"ب) الذكاء الاجتماعي.","C":"ج) الذكاء البصري / المكاني.","D":"د) الذكاء الحركي / الجسمي.","answer":"C","topic_question_no":5},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يتميز الجراح الماهر بقدرته على إجراء عمليات دقيقة تتطلب تآزرًا عضليا وعصبيا فائقًا، واستخدام أصابعه بمنتهى الدقة والحذر داخل الأنسجة الدقيقة للمريض. تُصنف هذه البراعة الاستثنائية ضمن الذكاء:","A":"أ) الذكاء المنطقي / الرياضي.","B":"ب) الذكاء الحركي / الجسمي.","C":"ج) الذكاء الطبيعي.","D":"د) الذكاء الشخصي.","answer":"B","topic_question_no":6},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يعمل شخص في مجال المبيعات، ويتميز بقدرة مذهلة على قراءة تعبيرات وجوه العملاء ونبرات أصواتهم، وفهم دوافعهم الخفية للشراء، مما يجعله مفاوضًا ناجحًا جدًا. هذه الكفاءة في إدارة العلاقات تمثل الذكاء:","A":"أ) الذكاء الاجتماعي.","B":"ب) الذكاء الوجداني في مكون الدافعية.","C":"ج) الذكاء اللغوي فقط.","D":"د) الذكاء الشخصي والتأمل الذاتي.","answer":"A","topic_question_no":7},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يمتلك طالب وعيا عميقًا بانفعالاته، فهو يدرك تمامًا أن قدرته على التركيز تتشتت في الأماكن المزدحمة، لذا يقرر دائمًا بقرار مستقل أن يدرس بمفرده في المكتبة لتحقيق أهدافه الأكاديمية. هذا الوعي بنقاط الضعف والقوة يجسد بوضوح الذكاء:","A":"أ) الذكاء البصري / المكاني.","B":"ب) الذكاء الاجتماعي.","C":"ج) الذكاء الشخصي.","D":"د) الذكاء المنطقي.","answer":"C","topic_question_no":8},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"عند دراسة النظم البيئية في غابة استوائية، لاحظ باحث التفاصيل الدقيقة التي تميز بين فصيلتين من النباتات تبدوان متطابقتين للأشخاص العاديين، وقام بتصنيفهما بدقة. الباحث هنا يعتمد على الذكاء:","A":"أ) الذكاء البصري المحض.","B":"ب) الذكاء المنطقي الاستنباطي.","C":"ج) الذكاء الطبيعي (البيئي).","D":"د) الذكاء الشخصي الداخلي.","answer":"C","topic_question_no":9},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"قدم \"دانيال جولمان\" مفهومًا هامًا يعد مكملاً ضروريا للذكاء العقلي (IQ) في التنبؤ بنـجـاح الفرد المهني والشخصي، وركز فيه على القدرة الواعية على إدارة المشاعر وبناء العلاقات تحت الضغط. هذا المفهوم يعرف بـ اسم:","A":"أ) الذكاء المنطقي.","B":"ب) الذكاء الوجداني (EQ).","C":"ج) الذكاء الاجتماعي (منفردًا).","D":"د) التفكير التباعدي الإبداعي.","answer":"B","topic_question_no":10},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"عانى أحد المبدعين في مجال الفنون التشكيلية من تهميش في مدرسته قديماً، حيث كان يُصنف بأنه غير ذكي بسبب درجاته المنخفضة في اختبارات الرياضيات واللغة. هذا التصنيف الظالم الذي حصر قدراته في نطاق ضيق كان نتيجة مباشرة للاعتماد على:","A":"أ) الكفاءة في إدارة العلاقات والتفاوض ضمن الذكاء الاجتماعي","B":"ب) الذكاء البصري المكاني الذي يميز مصممي الديكور","C":"ج) المنظور الأحادي (التقليدي) الذي يقيس الذكاء كقدرة عقلية عامة باختبار ورقي","D":"د) نظرية الذكاءات المتعددة لهوارد جاردنر","answer":"C","topic_question_no":11},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"اقترح \"هوارد جاردنر\" في كتابه \"أطر العقل\" مفهوماً ثورياً للذكاء، معتمداً على أبحاث الدماغ ليؤكد أن الإنسان لا يمتلك ذكاءً واحداً جامداً، بل يمتلك في حقيقة الأمر:","A":"أ) قدرة أحادية تعتمد على المهارات المنطقية وحل المشكلات الرياضية فقط","B":"ب) ذكاءً وجدانياً يقتصر فقط على التعاطف العميق مع مشاعر الآخرين","C":"ج) قدرة بيولوجية فطرية لا يمكن نموها أو تطويرها حتى لو توفرت البيئة المحفزة","D":"د) حزمة متكاملة من الذكاءات المستقلة نسبياً التي تعمل بتناغم وتنسيق فريد داخل كل فرد","answer":"D","topic_question_no":12},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"أثناء ورشة عمل لتدريب المحامين، ركز المدرب على ضرورة امتلاك المحامي لحساسية فائقة تجاه معاني الكلمات، وترتيبها المنطقي، واستخدام الإيقاع اللفظي بدقة متناهية لإقناع هيئة المحلفين. هذا التدريب يستهدف بشكل مباشر تطوير:","A":"الذكاء الشخصي","B":"الذكاء المنطقي / الرياضي","C":"الذكاء اللغوي","D":"الذكاء الاجتماعي","answer":"C","topic_question_no":13},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"لاحظ معلم أن أحد طلابه لا يهتم كثيراً بالاستماع للشرح الشفهي أو قراءة النصوص الطويلة، لكنه يبدع فوراً عندما يُطلب منه تحويل الدرس إلى خرائط ذهنية، أو تخيل أبعاد المجسمات الهندسية ورسمها بدقة. المسار التعليمي الأفضل لهذا الطالب يجب أن يعتمد على:","A":"الذكاء الحركي / الجسمي","B":"الذكاء البصري / المكاني","C":"الذكاء الطبيعي (البيئي)","D":"الذكاء الموسيقي / الإيقاعي","answer":"B","topic_question_no":14},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"في بيئة العمل، نـجح أحد المديرين في بناء فريق متماسك، وقدرته على إنهاء الشجارات بين الموظفين، وإدارة جلسات التفاوض بنـجاح، مستعيناً بقدرته الفائقة على قراءة لغة الجسد وفهم دوافع من حوله. يتميز هذا المدير بارتفاع ملحوظ في:","A":"الذكاء الاجتماعي","B":"الذكاء الشخصي","C":"الذكاء المنطقي","D":"الذكاء الوجداني (EQ) في مكون التنظيم الذاتي فقط","answer":"A","topic_question_no":15},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يمتلك الجراح الماهر قدرة استثنائية على التآزر العضلي والعصبي، واستخدام يديه ببراعة ودقة متناهية لإجراء عمليات معقدة لا تحتمل الخطأ. هذه البراعة الإجرائية تصنف ضمن نظرية جاردنر تحت إطار:","A":"الذكاء الطبيعي","B":"الذكاء المنطقي","C":"الذكاء الحركي / الجسمي","D":"الذكاء المكاني لتخيل الزوايا","answer":"C","topic_question_no":16},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"طالب جامعي قرر تغيير تخصصه الدراسي رغم الضغوط العائلية الكبيرة، وذلك لأنه أدرك بوعي عميق نقاط ضعفه الحقيقية، وتأمل في انفعالاته ورغباته بشفافية دون مبالغة، فاتخذ قراره باستقلالية تامة. هذا الطالب استخدم قدراته في:","A":"الذكاء اللغوي للإقناع","B":"الذكاء الاجتماعي لإرضاء أسرته","C":"الذكاء الشخصي للغوص داخل نفسه وتوجيه قراراته","D":"الذكاء الوجداني في مكون التعاطف مع الآخرين","answer":"C","topic_question_no":17},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"أثناء رحلة تخييم، لاحظ أحد الطلاب تفاصيل دقيقة في أوراق الشجر، وتمكن من التمييز بين أنواع الصخور المختلفة وتصنيف الحشرات بدقة، وفهم النظم البيئية المحيطة به بطريقة أذهلت زملائه. يعكس هذا الأداء تفوقاً في:","A":"الذكاء البصري / المكاني","B":"الذكاء الطبيعي (البيئي)","C":"الذكاء المنطقي الذي يستنتج العلاقات","D":"الذكاء الحركي","answer":"B","topic_question_no":18},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يعتبر مفهوم \"الذكاء الوجداني\" (EQ) الذي نشره دانيال جولمان عام 1995 مكملاً حاسماً للذكاء العقلي (IQ). وتبرز الأهمية القصوى للذكاء الوجداني في حياة الفرد المهنية والشخصية من خلال قدرته العميقة على:","A":"أ) استنتاج العلاقات واكتشاف الأنماط في العمليات الحسابية المعقدة","B":"ب) التمييز الفائق للألوان وتخيل الأبعاد والزوايا في المسافات الضيقة","C":"ج) التنبؤ بالنـجاح المهني والشخصي عبر إدارة المشاعر واتخاذ قرارات بحكمة تحت الضغط","D":"د) ابتكار منتجات مادية باستخدام أنماط عقلية حركية وبصرية","answer":"C","topic_question_no":19},{"exam_id":"U4-T2","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"عندما يواجه الفرد موقفاً يثير غضبه الشديد، لكنه ينـجح في كبح اندفاعه، ويهدئ من توتره، ويختار التعبير عن مشاعره بالطريقة والوقت والشخص المناسب دون كبت أو تهور. فإنه يطبق أحد مكونات الذكاء الوجداني الخمسة وهو:","A":"الوعي بالذات","B":"التعاطف","C":"المهارات الاجتماعية","D":"التنظيم الذاتي","answer":"D","topic_question_no":20}],"U4-T3":[{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يظن بعض الآباء أن مجرد قدرة ابنهم على قضاء ساعات طويلة أمام الشاشات وتصفح التطبيقات المختلفة بسرعة يجعله عبقرياً في استخدام التكنولوجيا. هذا الفهم يتناقض مع التعريف العلمي لـ الذكاء الرقمي الذي يشترط أن يكون الاستخدام مبنياً على","A":"أ) استهلاك أكبر قدر ممكن من المحتوى الترفيهي","B":"ب) توظيف التكنولوجيا بوعي ومسؤولية لحل مشكلات الواقع وتطوير القدرات","C":"ج) استبدال العقل البشري بالآلة لإنـجاز المهام","D":"د) الانعزال التام عن الهوية الإنسانية للاندماج في العالم الافتراضي","answer":"B","topic_question_no":1},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يحرص أحد الصحفيين قبل مشاركة أي خبر مثير للجدل على منصاته، على فحص مصدر المعلومة والبحث عن أدلة تدعمها متجنباً الانـجراف خلف العناوين البراقة. هذه الممارسة العملية تعكس امتلاكه لإحدى ركائز الذكاء الرقمي وهي","A":"أ) التنقل المعلوماتي ومحو الأمية الرقمية","B":"ب) التفكير الناقد وفرز الشائعات والمعلومات المزيفة","C":"ج) الأمن السيبراني وحماية البصمة الرقمية","D":"د) الذكاء الوجداني الرقمي والتعاطف","answer":"B","topic_question_no":2},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"لاحظت فتاة أن المواقع التي تتصفحها بدأت تعرض لها إعلانات ومحتويات تتطابق تماماً مع ما كانت تبحث عنه بالأمس، فأدركت أن هناك برمجيات تدرس سلوكها لتوجيه اختياراتها. الفهم الدقيق لآلية عمل هذه البرمجيات يصنف ضمن ركيزة","A":"أ) الذكاء الوجداني الرقمي","B":"ب) التفكير الناقد وفرز الشائعات","C":"ج) الأمن السيبراني وحماية الخصوصية","D":"د) التنقل المعلوماتي وفهم الخوارزميات","answer":"D","topic_question_no":3},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"قرأ شاب تعليقاً قاسياً ومسيئاً موجهاً لأحد أصدقائه على منصة عامة، فقرر التدخل برسالة خاصة داعمة لصديقه، ممتنعاً تماماً عن الرد بالإساءة أو التجريح للمتنمر. يعكس هذا السلوك الراقي التزاماً بركيزة","A":"أ) الذكاء الوجداني الرقمي الذي يدرك إنسانية ومشاعر الآخرين عبر الشاشات","B":"ب) محو الأمية الرقمية واختيار التطبيق الأنسب","C":"ج) الأمن السيبراني وحماية المعلومات المالية","D":"د) التفكير الناقد والتشكيك العلمي","answer":"A","topic_question_no":4},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"استخدم معلم الجغرافيا تطبيقاً يعتمد على تقنية «الواقع المعزز» ليسمح لطلابه بالتجول افتراضياً داخل المجموعة الشمسية ورؤية الكواكب بأبعادها الثالثية. هذا التطبيق يخدم بشكل مباشر الطلاب الذين يتميزون بـ","A":"أ) الذكاء اللغوي","B":"ب) الذكاء الموسيقي","C":"ج) الذكاء البصري / المكاني","D":"د) الذكاء الشخصي","answer":"C","topic_question_no":5},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يعاني طالب من خجل شديد يمنعه من طرح الأسئلة داخل الفصل إذا لم يفهم نقطة معينة خوفاً من نظرات زملائه. لكنه وجد ضالته في منصات التعلم الرقمية حيث يمكنه إعادة المقطع عشر مرات دون حرج. هذه الفرصة التي وفرتها التكنولوجيا تُعرف بـ","A":"أ) المحاكاة الآمنة للمواقف","B":"ب) اقتصاد العمل الحر والاستقلالية","C":"ج) التفريد المعرفي والتعلم بالسرعة الذاتية","D":"د) التشتت الذهني والإثارة اللحظية","answer":"C","topic_question_no":6},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يتابع أحد الأفراد صفحات سياسية تتبنى وجهة نظر واحدة فقط، ومع مرور الوقت أصبحت المنصة لا تعرض له سوى الآراء التي تؤكد معتقداته، مما جعله يعتقد أن العالم كله يتفق معه ويرفض أي رأي مخالف. هذه المخاطرة الرقمية تُسمى","A":"أ) الكسل المعرفي وفقدان الذاكرة طويلة المدى","B":"ب) غسيل الدماغ الخوارزمي والانحباس في فقاعة معلوماتية","C":"ج) العزلة وتدهور الذكاء الوجداني","D":"د) المحاكاة الآمنة للمواقف المعقدة","answer":"B","topic_question_no":7},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يقضي مراهق وقتاً طويلاً في استخدام برامج الطباعة ثلاثية الأبعاد لتحويل أفكاره وتصميماته الهندسية إلى مجسمات ملموسة. هذا الاستخدام يمثل توظيفاً ذكياً للتكنولوجيا لتعزيز","A":"أ) الذكاء الاجتماعي","B":"ب) الذكاء الحركي / الجسمي","C":"ج) الذكاء اللغوي","D":"د) الذكاء الطبيعي","answer":"B","topic_question_no":8},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"تكمن الخطورة الحقيقية لغياب التفكير الناقد في العالم الرقمي في أن المستخدم يصبح ضحية لـ «التزييف العميق»؛ وهو ما يجعله عاجزاً تماماً عن","A":"أ) فهم الخوارزميات التي ترشح له المحتوى","B":"ب) التمييز الصارم بين الحقائق الموثقة والمصالح الشخصية","C":"ج) استخدام برامج الهندسة الصوتية","D":"د) إنشاء مذكرات رقمية للتأمل الذاتي","answer":"B","topic_question_no":9},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يمثل «قانون المواطنة الرقمية» امتداداً طبيعياً للأخلاق الإنسانية، وهو يفرض على المستخدم الوعي التام بحقيقة أن الشاشة","A":"أ) تمثل ستاراً آمناً للاختباء وتفريغ الغضب","B":"ب) تلغي الحاجة للتفكير الناقد وفرز الشائعات","C":"ج) ليست ستاراً للاختباء وأن الأخلاق هي الهوية الحقيقية في الفضاء الإلكتروني","D":"د) تبرر مشاركة البيانات المالية بحرية لتبادل الثقة","answer":"C","topic_question_no":10},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يُعرف الذكاء الرقمي بأنه ليس مجرد قضاء ساعات أمام الشاشات، بل هو قدرة الفرد على توظيف التكنولوجيا بوعي لحل المشكلات وتطوير القدرات. الشرط النفسي الأهم في هذا التعريف لضمان عدم تحول التكنولوجيا لضرر هو","A":"استبدال العقل البشري بالآلة كلياً لضمان سرعة الإنـجاز","B":"الحفاظ على الهوية الإنسانية وتحمل المسؤولية أثناء توظيف الأداة الرقمية","C":"إتقان جميع لغات البرمجة وتصميم المواقع الإلكترونية المعقدة","D":"العزلة التامة عن الواقع لرفع مستوى التركيز في الفضاء الافتراضي","answer":"B","topic_question_no":11},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"واجه طالب مشكلة في العثور على مراجع دقيقة لبحثه، فقضى وقتاً طويلاً في تصفح مواقع عشوائية غير موثوقة حتى أُصيب بالإحباط. هذا الطالب يفتقر إلى إحدى الركائز الأربع للذكاء الرقمي وهي","A":"الأمن السيبراني وحماية البصمة الرقمية","B":"الذكاء الوجداني الرقمي والتعاطف","C":"التنقل المعلوماتي ومحو الأمية الرقمية (البحث الدقيق واختيار الأنسب)","D":"التفكير الناقد وفرز الشائعات والمصالح","answer":"C","topic_question_no":12},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"تنتشر في الفضاء الإلكتروني صور ومقاطع فيديو تم التلاعب بها بمهارة لتبدو حقيقية (التزييف العميق). القدرة على التشكيك العلمي، والتحقق من المصادر، والتمييز الصارم بين الحقائق الموثقة والمصالح الشخصية تندرج تحت ركيزة","A":"التنقل المعلوماتي وفهم الخوارزميات","B":"التفكير الناقد وفرز الشائعات","C":"الأمن السيبراني وحماية الخصوصية","D":"التفريد المعرفي والتعلم الذاتي","answer":"B","topic_question_no":13},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"قانون \"المواطنة الرقمية\" يؤكد أن الشاشة ليست ستاراً للاختباء، وأن أخلاقك وهويتك الحقيقية يجب أن تظهر في الفضاء الإلكتروني كالواقع. هذا القانون يرتبط ارتباطاً وثيقاً بضرورة التمتع بـ","A":"الذكاء الوجداني الرقمي (الامتناع عن التنمر وإدراك مشاعر الآخرين)","B":"الكسل المعرفي والاعتماد الكلي على الأدوات","C":"غسيل الدماغ الخوارزمي في غرف الصدى","D":"المحاكاة الآمنة وتجربة المواقف المعقدة","answer":"A","topic_question_no":14},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"شاب يهوى تصميم الديكورات وتنسيق المنازل، واستطاع توظيف برامج \"الواقع المعزز\" لتصميم منازل وتخيلها قبل تنفيذها في الواقع، واستخدام أدوات التوليد البصري باحترافية. هذا الشاب استخدم الأداة الرقمية لتعزيز ذكائه","A":"المنطقي / الرياضي","B":"اللغوي وحساسية المفردات","C":"البصري / المكاني","D":"الشخصي لتنظيم الوقت","answer":"C","topic_question_no":15},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"من أهم تأثيرات التكنولوجيا الإيجابية في التعليم هو إتاحتها لـ \"التفريد المعرفي\". يتجلى هذا المفهوم عملياً عندما يقوم الطالب بـ","A":"أ) الاعتماد الكلي على الذكاء الاصطناعي ليقرر ويفكر بالكامل نيابة عنه","B":"ب) التخلي التام عن التفكير الناقد والانعزال في فقاعات معلوماتية مغلقة","C":"ج) التعلم بالسرعة الذاتية، كإعادة المقطع 10 مرات دون حرج، أو تسريع المستويات للفائقين","D":"د) استهلاك محتوى ترفيهي لـ 80% من وقته عبر الشاشات","answer":"C","topic_question_no":16},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"توفر بعض المؤسسات الطبية نظارات الواقع الافتراضي لتدريب المسعفين الجدد على إدارة الأزمات والتعامل مع الإصابات الخطيرة في بيئة افتراضية تامة قبل نزولهم لأرض الواقع. هذه الميزة التكنولوجية التي تصقل المهارات تُعرف بـ","A":"التفريد المعرفي","B":"بناء معرض الأعمال الرقمي","C":"المحاكاة الآمنة","D":"إتاحة المعرفة بلا تمييز مالی","answer":"C","topic_question_no":17},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"لاحظ أخصائي نفسي تراجعاً حاداً في قدرة شاب على قراءة تعبيرات الوجوه وحل الخلافات الواقعية مع زملائه، رغم نشاطه الكبير في الدردشات النصية. هذا التدهور في المهارات يمثل أحد مخاطر التكنولوجيا ويُعرف بـ","A":"الكسل المعرفي وإضعاف الذاكرة","B":"التشتت الذهني وإدمان المقاطع السريعة","C":"العزلة وتدهور الذكاء الوجداني (التواصل المباشر)","D":"التفريد المعرفي بالسرعة الذاتية","answer":"C","topic_question_no":18},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يعتمد تطبيق بعض المنصات على عرض مقاطع فيديو وأخبار تتوافق تماماً مع آراء المستخدم وتوجهاته السياسية أو الرياضية التي سبق له الإعجاب بها، مع حجب أي آراء معارضة. يحذر علم النفس من أن هذه الخوارزميات تؤدي إلى","A":"بناء ذكاء وجداني رقمي مرتفع","B":"غسيل الدماغ الخوارزمي والحبس في فقاعة معلوماتية تنمي التعصب","C":"تعزيز مهارات التفاوض والذكاء الاجتماعي","D":"كسر الفقاعة الرقمية وتمرين التفكير الناقد بحيادية","answer":"B","topic_question_no":19},{"exam_id":"U4-T3","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يقدم علم النفس استراتيجية \"الانقطاع الرقمي المنهجي\" كأداة فعالة للوعي الرقمي. وتتطلب هذه الاستراتيجية من الفرد بشكل أساسي أن يقوم بـ","A":"أ) تحويل 80% من وقته لإنتاج المحتوى بدلاً من استهلاكه","B":"ب) الاعتماد على الذكاء الاصطناعي لتنظيم وقته وجدوله اليومي بالكامل","C":"ج) تخصيص وقت ثابت يومياً (كأول ساعة من اليوم) لإغلاق الإشعارات لراحة الجهاز العصبي من التشتت","D":"د) متابعة مصادر تختلف مع آرائه الروتينية لكسر الفقاعة","answer":"C","topic_question_no":20}],"U4-T4":[{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يعتقد بعض المربين أن الطفل الذي يولد بقدرة فطرية استثنائية سيصبح مبدعاً لا محالة دون الحاجة لأي تدخل أو تدريب، متجاهلين بذلك أن الموهبة هي","A":"أ) مهارة مكتسبة بالكامل ولا تعتمد على الفطرة","B":"ب) نقطة انطلاق قوية وبذرة كامنة تحتاج لتدريب مستمر ورعاية بيئية لتتحول إلى إبداع","C":"ج) محرك عقلي عام يستخدم لحل كافة المشكلات","D":"د) تتشكل حصرياً من خلال التنشئة دون أي أساس عصبي","answer":"B","topic_question_no":1},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يمتلك طفل قدرة فطرية مذهلة على التمييز بين الألوان ودمجها، لكنه نشأ في بيئة تفتقر لأي أدوات فنية ولم يتلقَ أي توجيه، فلم يطور هذه القدرة أبداً. يشير هذا الموقف إلى غياب إحدى ركائز الموهبة وهي","A":"أ) الركيزة الفطرية والعصبية","B":"ب) الاستعداد البيولوجي الكامن","C":"ج) التفكير التباعدي والأصالة","D":"د) الركيزة البيئية والرعاية التي توفر أدوات الصقل والتدريب","answer":"D","topic_question_no":2},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يخطئ البعض في حصر الموهبة في مجالات الرسم أو الغناء فقط. فعندما نـجد طالباً يمتلك قدرة استثنائية على التحليل المنطقي العميق، وسرعة فائقة في حل المشكلات البرمجية المجردة، فإننا نتحدث عن موهبة","A":"أ) قيادية واجتماعية","B":"ب) حركية وميكانيكية","C":"ج) فكرية وأكاديمية","D":"د) وجدانية وتعبيرية","answer":"C","topic_question_no":3},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يتمتع أحد الأفراد بكاريزما طاغية، وقدرة فطرية على استشعارات مشاعر من حوله، مما يجعله قادراً على فض النزاعات وقيادة فريقه للنـجـاح في أوقات الأزمات بسلاسة. يصنف هذا الشخص ضمن أصحاب الموهبة","A":"أ) الإبداعية والفنية","B":"ب) القيادية والاجتماعية","C":"ج) الفكرية والأكاديمية","D":"د) الميكانيكية والحركية","answer":"B","topic_question_no":4},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"صانع ساعات تقليدي يمتلك دقة لا متناهية وتآزراً عصبياً دقيقاً يمكنه من فك وتركيب تروس مجهرية ببراعة يدوية استثنائية دون أن ترتجف يده. هذا الإبداع يمثل تجسيداً للموهبة","A":"أ) الوجدانية والتعبيرية","B":"ب) الفكرية والأكاديمية","C":"ج) الإبداعية والفنية المجردة","D":"د) الحركية والميكانيكية","answer":"A","topic_question_no":5},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يميل الطلاب الموهوبون عادة إلى طرح أسئلة عميقة تبحث عن الجذور، ويمتلكون فضولاً علمياً لا يكتفي بالإجابات السطحية، مع قدرتهم على ابتكار حلول جديدة وكرههم الشديد للروتين. هذه الخصائص تندرج ضمن","A":"أ) السمات الوجدانية والانفعالية للموهوبين","B":"ب) السمات الاجتماعية والقيادية","C":"ج) السمات المعرفية والعقلية للموهوبين","D":"د) السمات الحركية والتآزر العصبي","answer":"C","topic_question_no":6},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يعاني بعض الموهوبين من توتر مستمر وشعور دائم بعدم الرضا عن أعمالهم، وذلك لأنهم يضعون لأنفسهم معايير أداء خيالية، ولا يتقبلون أي نتيجة أقل من المثالية. تُعرف هذه السمة الانفعالية بـ","A":"أ) السعي المتواصل للكمال","B":"ب) تحمل الغموض والمخاطرة","C":"ج) الحساسية المرهفة والتعاطف","D":"د) الاستقلالية في تكوين الآراء","answer":"A","topic_question_no":7},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يقضي مخترع شاب ساعات طويلة متواصلة في محاولة إصلاح جهاز معقد، متجاهلاً تعبه وحاجته للنوم، ليس طمعاً في مكافأة فورية، بل مدفوعاً بحبه العميق وشغفه بهذه المهمة. تعكس هذه الحالة إحدى السمات الدافعية للموهوبين وهي","A":"أ) الدافعية الذاتية للمثابرة النابعة من حب المهمة","B":"ب) كراهية الروتين والجمود الفكري","C":"ج) الفضول العلمي لطرح الأسئلة","D":"د) السعي لتحقيق كماليات المظهر الاجتماعي","answer":"A","topic_question_no":8},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"كثيراً ما يساء فهم الطالب الموهوب داخل الفصل الدراسي المكتظ؛ حيث قد يفسر المعلم «استقلالية» الموهوب و«فضوله الدائم» بطريقة خاطئة على أنهما سبب في","A":"أ) دليل على الرغبة في الانعزال والاكتئاب","B":"ب) تمرد وتشويش على سير الحصة يتطلب الكبت","C":"ج) محاولة للسيطرة على إدارة المدرسة","D":"د) افتقار لمهارات التفكير التباعدي","answer":"B","topic_question_no":9},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يكمن الفارق العلمي الدقيق بين الموهبة والمهارة؛ في أن الموهبة هي استعداد بيولوجي فطري يولد به الإنسان، بينما تمثل المهارة كفاءة أدائية إجرائية","A":"أ) فطرية تظهر فجأة دون أي مقدمات","B":"ب) تتأثر بالوراثة الجينية لعمى الألوان فقط","C":"ج) مكتسبة بالكامل عبر الخبرة والممارسة والتدريب","D":"د) تعتبر محركاً عاماً لحل المشكلات في جميع المجالات","answer":"C","topic_question_no":10},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يُنظر للموهبة في علم النفس الحديث على أنها استعداد فطري وقدرة استثنائية كامنة يولد بها الفرد، لكن لكي تتحول هذه الموهبة الكامنة إلى إبداع ملموس ونـجاح فائق، فإنها تحتاج حتماً إلى","A":"أ) إلغاء المرونة العصبية للدماغ لتركيز الطاقة.","B":"ب) تدريب مستمر ورعاية وتوفير بيئة محفزة تصقل هذا الاستعداد.","C":"ج) التخلي التام عن الجهد والاعتماد الكلي على البذرة الفطرية وحدها.","D":"د) مسايرة القطيع وتجنب المخاطرة والمجهول.","answer":"B","topic_question_no":11},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"المرونة العصبية للدماغ البشري قدرة مذهلة تفسر ظاهرة نـجاح الأفراد ذوي الإعاقات في تحقيق مستويات تفوق الأصحاء في مجالات معينة، التفسير العلمي لذلك هو أن الدماغ يقوم بـ","A":"أ) إيقاف عمل جميع الذكاءات المتعددة للتركيز على الجسد فقط.","B":"ب) الاستسالم لفقدان الحاسة والتوقف عن التطور المعرفي.","C":"ج) توجيه طاقته والتعويض العصبي لتعويض الحاسة المفقودة بمستويات عليا من القدرات الأخرى.","D":"د) تغيير التركيب الجيني للفرد لإعادة إنبات العضو المفقود.","answer":"C","topic_question_no":12},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"تمتلك مريم قدرة فطرية على استيعاب المعادلات الفيزيائية المعقدة وتحليلها منطقياً بسرعة تفوق أقرانها، وتمتلك ذاكرة حديدية لاسترجاع القوانين، هذا التميز يصنف علمياً ضمن مجال الموهبة","A":"أ) الوجدانية والتعبيرية.","B":"ب) الإبداعية والفنية.","C":"ج) القيادية والاجتماعية.","D":"د) الفكرية والأكاديمية.","answer":"D","topic_question_no":13},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"أثناء أزمة خانقة واجهت فريق العمل، برز موظف صغير في السن يمتلك قدرة فطرية غريبة على التأثير في زملائه (كاريزما)، وتمكن من امتصاص غضبهم، والإحساس بمشاعرهم، وتوجيههم لبناء توافق يخرجهم من الأزمة بنـجاح، نوع الموهبة التي يمتلكها هذا الموظف هي","A":"أ) الموهبة الحركية والميكانيكية.","B":"ب) الموهبة القيادية والاجتماعية.","C":"ج) الموهبة الإبداعية (التفكير التباعدي).","D":"د) الموهبة الفكرية والأكاديمية.","answer":"B","topic_question_no":14},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يتميز الموهوبون بسمات معرفية وعقلية قوية تمكنهم من الغوص في التفاصيل واستيعابها، من أبرز هذه السمات التي تجعلهم يبتكرون حلولاً جديدة ويكرهون الروتين التقليدي في حل المشكلات","A":"أ) السعي المتواصل للكمال المرضي.","B":"ب) المرونة الفكرية والفضول العلمي الذي يبحث عن الجذور.","C":"ج) التبعية المطلقة لآراء الأغلبية.","D":"د) تجنب الغموض والمخاطرة المحسوبة بأي ثمن.","answer":"B","topic_question_no":15},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يعاني بعض الموهوبين من توتر وضغط نفسي مستمر، وقد يظن البعض أنهم فاشلون في إدارة مشاعرهم، لكن التفسير النفسي للسمات الوجدانية والانفعالية يؤكد أن هذا التوتر ينبع أساساً من","A":"أ) غياب الدافعية الذاتية للمثابرة واعتمادهم على المكافأة الفورية.","B":"ب) السعي المتواصل للكمال ووضع معايير أداء عالية جداً لأنفسهم قد لا يصلون للمثالية فيها.","C":"ج) ضعف القدرة على التركيز والانغماس في المهام المعقدة لفترات طويلة.","D":"د) الافتقار التام للتعاطف مع آلام الآخرين.","answer":"B","topic_question_no":16},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يعتبر التفكير التباعدي (Thinking Divergent) العصب الأساسي لإحدى مجالات الموهبة، حيث يعتمد على إنتاج أفكار أصيلة وغير مألوفة لحل المواقف، والتميز في التعبير الجمالي (كالتاشكيل والنحت)، يشير هذا إلى الموهبة","A":"أ) الميكانيكية اليدوية.","B":"ب) الإبداعية والفنية.","C":"ج) الفكرية والحفظ الفائق.","D":"د) القيادية وبناء الجماهير.","answer":"B","topic_question_no":17},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يخلط البعض بين المفاهيم الثلاثة (الموهبة، الذكاء، المهارة)، لتمييز المهارة بشكل علمي دقيق نؤكد على أنها","A":"أ) محرك عقلي فطري يولد به الفرد لتسهيل اكتشاف قدراته.","B":"ب) استعداد بيولوجي فطري يولد به الفرد في مجال محدد جداً كالرسم.","C":"ج) كفاءة إجرائية وبراعة مكتسبة بالكامل بالخبرة والتدريب والممارسة ولا يولد بها أحد.","D":"د) شرارة أولية كامنة لا تتأثر بالتدخل البيئي أو التدريب.","answer":"C","topic_question_no":18},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"محرك العقل الذي يسهل استيعاب المعلومات والتكيف وحل المشكلات في مختلف الأنشطة، وهو فسيولوجي مرن ينمو بالتدخل البيئي، هذا التعريف يفرق بين المفاهيم ويشير تحديداً إلى","A":"أ) المهارة المكتسبة بالكامل.","B":"ب) الذكاء كقدرة عقلية عامة وشاملة.","C":"ج) الموهبة كبذرة فطرية متخصصة.","D":"د) التفكير التباعدي الفني حصراً.","answer":"B","topic_question_no":19},{"exam_id":"U4-T4","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"إذا اجتمعت (الموهبة الفطرية) مع (الذكاء العام القوي) وتوجت بـ (التدريب الموجه والمكثف)، فإن النتيجة الأكيدة التي يصل إليها الفرد في مجاله هي","A":"أ) مهارة فائقة واحترافية استثنائية تؤدى بأقل جهد ووقت.","B":"ب) فقدان القدرة على تحمل الغموض لسهولة المهام.","C":"ج) تحول الموهبة إلى مهارة بدائية تفتقر للبراعة.","D":"د) الاعتماد الكلي على الحواس لتعويض غياب التفكير المنطقي.","answer":"A","topic_question_no":20}],"U5-T1":[{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"ترفض التوجهات المعاصرة في علم النفس الاعتماد على \"النموذج الطبي\" لتقييم حالة الإنسان النفسية، حيث يعتبر هذا النموذج قاصراً لكونه يعتمد على افتراض أساسي مفاده أن:","A":"أ) الصحة النفسية تتحقق بمجرد غياب المرض أو الاضطراب، متجاهلاً أن غياب المرض لا يعني بالضرورة العافية والرفاه","B":"ب) الفرد يحتاج إلى بناء علاقات دافئة لكي يتخلص من الفراغ الوجودي والمشكلات المادية","C":"ج) التوافق الاجتماعي داخل بيئة العمل هو المؤشر الوحيد على خلو الفرد من الأمراض البيولوجية","D":"د) الصحة النفسية تقتصر على قدرة الفرد على إخفاء الحيل الدفاعية اللاشعورية عن المجتمع","answer":"A","topic_question_no":1},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"موظف متفوق في عمله، لكنه يعاني دائماً من الإرهاق الشديد بسبب عجزه التام عن رفض أي مهام إضافية تُطلب منه، خوفاً من أن يغضب زملاؤه أو مديره، ويتحمل أعباء تفوق طاقته بشعور دائم بالذنب. يفتقر هذا الموظف إلى أحد مقومات الصحة النفسية وهو:","A":"أ) التخلي عن جلد الذات المفرط","B":"ب) الإحساس بالمعنى وامتلاك رسالة إنسانية","C":"ج) الكفاءة الاجتماعية وامتلاك مهارة \"التوكيدية\"","D":"د) المرونة النفسية وتجاوز المحن","answer":"C","topic_question_no":2},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"تعرض شخص لانتكاسة مالية أفقدته مشروعه الذي بناه لسنوات. بدلاً من انهياره، استوعب الصدمة، وقام بتحليل أخطائه، ثم بدأ مشروعاً جديداً بمهارات وخبرات أعمق لم يكن يمتلكها سابقاً. تُعرف هذه القدرة الديناميكية على العودة للتوازن والتطور بـ:","A":"أ) الاستقلالية ومقاومة الضغوط","B":"ب) المرونة النفسية و\"النمو ما بعد الصدمة\"","C":"ج) تقبل الذات والاعتراف بنقاط الضعف","D":"د) التوافق البيئي وحل المشكلات الاجتماعية","answer":"B","topic_question_no":3},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"يعيش بعض الشباب في حالة من التخبط والاكتئاب رغم توفر كافة الاحتياجات المادية والأمان الأسري، وذلك لعدم وجود غاية يسعون إليها أو قيمة يضيفونها لمن حولهم. الدرع الواقي الذي يقترحه علم النفس ضد هذا \"الفراغ الوجودي\" هو:","A":"أ) الإحساس بالمعنى عبر امتلاك هدف واضح ورسالة إنسانية","B":"ب) استخدام الحيل الدفاعية كالتعويض","C":"ج) الانفصال الاستراتيجي الواعي عن البيئة","D":"د) التنازل عن الاستقلالية لتلبية رغبات المجتمع","answer":"A","topic_question_no":4},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"عند تقييم العوامل المؤثرة في الصحة النفسية، نـجد أن هناك تداخلًا بين الجسد والبيئة. فبينما تلعب البيئة دوراً في تقديم الدعم أو التسلط، يقتصر دور \"العوامل البيولوجية\" بشكل أساسي على:","A":"أ) تحديد طبيعة الأحداث الضاغطة والمحن التي سيمر بها الفرد مستقبلاً","B":"ب) رسم الحدود الشخصية وتطوير مهارة التوكيدية","C":"ج) كيمياء الدماغ المنظمة للمزاج، والجينات المحددة للاستعداد الانفعالي، والتاريخ الصحي","D":"د) صياغة أساليب التنشئة الأسرية ونقلها للأجيال القادمة","answer":"C","topic_question_no":5},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"يمر جميع الطلاب بضغوط نفسية وقلق ملحوظ خلال فترة الامتحانات النهائية. لكي يحكم الأخصائي النفسي بأن هذا الضغط الطبيعي قد تحول إلى \"اضطراب نفسي\" يستوجب تدخلاً، فإنه يعتمد على معايير محددة من بينها:","A":"أ) ظهور الحيل الدفاعية كالتبرير بشكل مؤقت بعد الامتحان","B":"ب) شدة المشاعر المفرطة، واستمرارها لأسابيع بعد زوال المسبب، وإعاقتها للحياة اليومية","C":"ج) قدرة الطالب على التوافق الاجتماعي مع زملائه داخل اللجان","D":"د) استخدام الطالب لمهارات الرفاه الرقمي أثناء المذاكرة","answer":"B","topic_question_no":6},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"تصفحت فتاة حسابات صديقاتها على وسائل التواصل الاجتماعي، فشاهدت صوراً مثالية لرحلاتهن ونـجـاحاتهن المستمرة، مما جعلها تشعر بالنقص الشديد والتعاسة تجاه حياتها العادية المليئة بالتحديات. للتعامل مع هذا التحدي الرقمي، ينصح علم النفس بـ:","A":"أ) زيادة التفاعل الاجتماعي مع هذه الحسابات لاكتساب المرونة","B":"ب) استخدام حيلة الإسقاط لاتهام الصديقات بالزيف","C":"ج) الحذر من المقارنات الوهمية بين كواليس حياتها الحقيقية واللقطات المثالية المصطنعة للآخرين","D":"د) التخلي عن تقبل الذات والسعي للكمالية المرضية لتطابق الصور","answer":"C","topic_question_no":7},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"العلاقة بين \"التوافق النفسي\" و\"التوافق الاجتماعي\" هي علاقة ديناميكية تكاملية لا يمكن فصلها. ويظهر هذا التكامل جلياً في القاعدة النفسية التي تؤكد على أنه:","A":"أ) يجب أن يتخلى الفرد عن التوافق النفسي إذا تعارض مع قواعد الجماعة لتحقيق التوافق الاجتماعي","B":"ب) التوافق النفسي يمنح الفرد الصلابة لبناء العلاقات، والنـجـاح الاجتماعي يعزز الرضا عن الذات","C":"ج) التوافق الاجتماعي يعتمد حصرياً على العوامل البيولوجية، بينما التوافق النفسي يعتمد على البيئة","D":"د) لا يوجد أي رابط بين تقبل الذات داخلياً وبين العمل بروح الفريق خارجياً","answer":"B","topic_question_no":8},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"أخطأ موظف في إعداد تقرير هام مما تسبب في خسارة لشركته. وبدلاً من تحمل المسؤولية، بدأ في تقديم أعذار تبدو عقلانية مقنعة نفسه بأن \"أجهزة الحاسوب كانت بطيئة وأن وقت التسليم كان غير منطقي\". هذه الاستراتيجية اللاشعورية تسمى:","A":"أ) الكبت","B":"ب) الإسقاط","C":"ج) التبرير","D":"د) التعويض","answer":"C","topic_question_no":9},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"شخص يتسم بالبخل الشديد والحرص المبالغ فيه على المال، ولكنه لا يرى هذا العيب في نفسه أبداً، بل يوجه اتهامات دائمة لجميع أقاربه وأصدقائه بأنهم ماديون ولا يهتمون إلا بالمال. الميكانيزم النفسي الدفاعي المستخدم هنا هو:","A":"أ) التعويض","B":"ب) الإسقاط","C":"ج) الكبت","D":"د) الانفصال الواعي","answer":"B","topic_question_no":10},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"صممت إحدى المنظمات استبياناً لقياس مستوى الصحة النفسية للعاملين فيها. استبعد مصمم الاستبيان الأسئلة التي تسأل فقط عن عدم وجود أمراض عصبية أو زيارات لعيادات الطب النفسي، واستبدلها بأسئلة حول مدى شعور الموظف بقدرته على التعلم، والمساهمة في مجتمعه، وتحمل الضغوط. هذا التغيير المنهجي في تصميم الاستبيان يعتمد على","A":"أ) مبدأ استقلالية الهوية داخل الجماعة وتجنب الذوبان فيها","B":"ب) تعريف منظمة الصحة العالمية الذي يركز على الرفاه النفسي وإعمال القدرات","C":"ج) النموذج الطبي التقليدي الذي يحصر الصحة في غياب الأعراض","D":"د) الحيل الدفاعية اللاشعورية التي يخفي بها الفرد عيوبه","answer":"B","topic_question_no":11},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"بطل رياضي حصل على الميدالية الفضية في بطولة عالمية، وبدلاً من الاحتفال بإنـجازه، دخل في نوبة بكاء هستيري واعتزل اللعبة، مبرراً ذلك بأنه إما أن يكون في المركز الأول أو أنه لا يساوي شيئاً. هذه الحالة النفسية المعيقة تدل على افتقار الرياضي لأحد مقومات الصحة النفسية وهو","A":"تقبل الذات والتخلي عن وهم الكمالية المرضية","B":"الكفاءة الاجتماعية وممارسة التوكيدية","C":"الإحساس بالمعنى ووجود رسالة إنسانية","D":"التوافق البيئي وقراءة الواقع باحترام","answer":"A","topic_question_no":12},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"كاتبة شابة ُرفضت روايتها الأولى من قبل عشر دور نشر مختلفة. بدلاً من الاستسالم لليأس، استخدمت الانتقادات القاسية التي وجهت لها لإعادة كتابة الرواية بأسلوب جديد تماماً، وتعلمت مهارات تسويق الكتب حتى نـجحت في نشرها ذاتياً محققة مبيعات هائلة. يُطلق علم النفس على هذه القدرة الديناميكية المذهلة اسم","A":"التبرير العقلاني لتجنب الشعور بالفشل","B":"التوكيدية في رسم الحدود وحماية الكرامة","C":"المرونة النفسية وتحقيق النمو ما بعد الصدمة","D":"الانفصال الاستراتيجي الواعي عن البيئة الضاغطة","answer":"C","topic_question_no":13},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"مدير تنفيذي يتقاضى راتباً خيالياً ويمتلك سلطة واسعة، ورغم ذلك يعاني من شعور قاتل بالملل والاكتئاب، ويصرح دائماً بأن أيامه تتكرر بلا غاية وأن حياته فارغة. المقوم النفسي الذي يشكل درعاً واقياً ضد هذا الفراغ الوجودي ويفتقده هذا المدير هو","A":"تقبل نقاط الضعف بلا خجل","B":"الإحساس بالمعنى عبر امتلاك هدف واضح ورسالة تتجاوز المنفعة الذاتية","C":"مقاومة الضغوط الاجتماعية لتحقيق الاستقلالية","D":"استخدام حيلة التعويض لتغطية النقص العاطفي","answer":"B","topic_question_no":14},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"فتاة جامعية توافق دائماً على إعارة سيارتها لزميلتها المستهترة رغم حاجتها الماسة للسيارة، وتقوم بكتابة الأبحاث نيابة عن باقي زملائها في المجموعة لكي يتجنبوا الغضب منها، مما يستنزف وقتها وصحتها. الأداة النفسية التي تحتاج هذه الفتاة للتدرب عليها فوراً هي","A":"مهارة التوكيدية وبناء الحدود وقول لا دون الشعور بالذنب","B":"مهارة الإسقاط النفسي لاتهام زملائها بالاستغلال","C":"الانفصال الاستراتيجي التام عن الحياة الجامعية","D":"التخلي عن الإحساس بالمعنى لتقليل سقف التوقعات","answer":"A","topic_question_no":15},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"قرر شاب التخلي عن وظيفة مستقرة ومرموقة ليعمل في مجال الفنون الذي يحبه، متحملاً كافة الانتقادات اللادغة من أسرته والمجتمع المحيط به، ومصراً على توجيه حياته بناءً على قناعاته الشخصية. يمثل هذا القرار تطبيقاً مباشراً لمقوم","A":"التوافق الاجتماعي القائم على فهم قواعد المجتمع","B":"الاستقلالية وتنظيم السلوك والقرارات من الداخل بناءً على المبادئ","C":"الكبت اللاشعوري للرغبات خوفاً من العقاب المجتمعي","D":"المرونة النفسية التي تهدف للعودة السريعة للتوازن فقط","answer":"B","topic_question_no":16},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"أثبتت الدراسات أن الأشخاص الذين يمتلكون نقصاً في موصلات عصبية معينة مثل السيروتونين يميلون أكثر من غيرهم لتقلبات المزاج والاكتئاب حتى في غياب مشاكل اجتماعية واضحة. يندرج هذا التفسير تحت تأثير شبكة مترابطة من العوامل وتحديداً","A":"التنشئة الأسرية","B":"الأحداث الضاغطة والمحن","C":"العوامل البيولوجية كيمياء الدماغ والتاريخ الصحي","D":"المناخ المجتمعي والمهني","answer":"C","topic_question_no":17},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"معلمة تطلب من طفل في المرحلة الابتدائية أداء مهام تفوق قدراته العقلية، وكلما أخطأ تقوم بتعنيفه والسخرية منه أمام زملائه باستمرار. النتيجة السيكولوجية المتوقعة من هذا الخلل في العوامل البيئية والتنشئة هي","A":"خلق تصدعات نفسية وضعف حاد في التقدير الذاتي لدى الطفل","B":"بناء مرونة نفسية فائقة تجعل الطفل محصناً ضد الصدمات المستقبلية","C":"تعزيز مهارة التوكيدية ورسم الحدود لدى الطفل مبكراً","D":"تغيير كيمياء الدماغ لزيادة الموصلات العصبية المنظمة للسعادة","answer":"A","topic_question_no":18},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"تعرض طبيب جراح لضغط هائل ومشاعر خوف شديدة أثناء إجرائه لعملية جراحية دقيقة لإنقاذ حياة مريض معقدة، لكنه بمجرد انتهاء العملية وعودته لمنزله استعاد هدوءه ومارس حياته بشكل طبيعي. يُقيم الأخصائي النفسي حالة هذا الطبيب على أنها","A":"أ) دليل قاطع على غياب المرونة النفسية لديه","B":"ب) خلل في التوافق النفسي لعدم قدرته على كبت خوفه بالكامل أثناء الجراحة","C":"ج) ضغط طبيعي لأن مشاعره تناسبت مع الموقف وزالت بزوال المسبب ولم تعق أداءه","D":"د) اضطراب نفسي يستلزم تدخلاً علاجياً لفرط الخوف","answer":"C","topic_question_no":19},{"exam_id":"U5-T1","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"فقد رجل أعمال كل ثروته في انهيار الأسهم، ودخل في نوبة حزن وعزلة تامة منعته من تناول الطعام أو النوم بشكل طبيعي، واستمرت هذه الحالة لستة أشهر كاملة دون أي تحسن. المعياران اللذان يؤكدان تحول هذا الضغط إلى اضطراب نفسي هنا هما","A":"الإحالة للمختص واستخدام التبرير","B":"الشدة اللحظية والهروب الرقمي","C":"المدة الزمنية الطويلة وأثر الأداء إعاقة الحياة اليومية","D":"التوافق البيئي والاستقلالية الفردية","answer":"C","topic_question_no":20}],"U5-T2":[{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يرفض علم النفس النظرة السطحية التي تحكم على شخصية الفرد من خلال مظهره الخارجي أو نبرة صوته فقط، ويستبدل ذلك بتعريف علمي دقيق يؤكد أن الشخصية هي:","A":"أ) مجموعة من السمات الجسدية الموروثة التي لا تتغير بتغير البيئة","B":"ب) التنظيم الديناميكي والمتكامل والنامي داخل الفرد، والذي يحدد طريقته الفريدة في التفكير والشعور والتكيف","C":"ج) الاستجابات اللحظية المتقطعة التي لا يربطها أي تنظيم عقلي أو وجداني","D":"د) قدرة الفرد على استنسخ سلوكيات الآخرين لتحقيق التوافق الاجتماعي","answer":"B","topic_question_no":1},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تلعب التنشئة الأسرية دوراً محورياً في بناء الشخصية الإنسانية. فبينما تؤدي التربية القائمة على الحوار والدعم إلى إنتاج شخصية واثقة ومستقلة، فإن الإفراط في \"الحماية الزائدة\" من قبل الآباء ينتج عنه غالباً شخصية تتسم بـ:","A":"أ) الإبداع وحل المشكلات المعقدة","B":"ب) الانفتاح العالي على الخبرات الجديدة","C":"ج) الاعتمادية والتمرد المستمر","D":"د) يقظة الضمير والتنظيم الذاتي العالي","answer":"C","topic_question_no":2},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"وفقاً لنموذج العوامل الخمسة الكبرى للشخصية (Big Five)، فإن الشخص الذي يتميز بأنه \"محب للتجديد والمغامرة، مبدع، واسع الخيال، وفضولي يبحث عن أفكار خارج الصندوق\" يمتلك درجة مرتفعة في سمة","A":"أ) يقظة الضمير (التفاني)","B":"ب) الانبساطية","C":"ج) الانفتاح على الخبرة","D":"د) المقبولية","answer":"C","topic_question_no":3},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"أثناء العمل على مشروع جماعي، برز أحد الطلاب بقدرته الفائقة على الانضباط، وتنظيم المهام بدقة، والتخطيط الجيد قبل اتخاذ أي قرار، مع تحمله للمسؤولية حتى تسليم المشروع في موعده. هذا السلوك يمثل الجانب الإيجابي (الدرجة المرتفعة) لسمة","A":"أ) العصابية (الاتزان الانفعالي)","B":"ب) الانفتاح على الخبرة","C":"ج) المقبولية والود","D":"د) يقظة الضمير (التفاني)","answer":"D","topic_question_no":4},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تختلف طريقة استمداد الطاقة النفسية بين الأفراد بناءً على سمة \"الانبساطية.\" فالشخص الذي يسجل \"درجة منخفضة\" في هذه السمة (الانبواطي) يميل عادة إلى","A":"أ) استمداد طاقته من التواجد المستمر وسط حشود الناس وحب القيادة","B":"ب) الاستقلال واستمداد طاقته من الهدوء وتفضيل الإنـجاز الفردي والصداقات العميقة","C":"ج) الاندفاع والتهور والعشوائية في اتخاذ القرارات المصيرية","D":"د) الشك الدائم في نوايا الآخرين والمنافسة الشرسة معهم","answer":"B","topic_question_no":5},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"في بيئة العمل، يعرف الموظف الذي يسعى دائماً لاحتواء الخلافات بين زملائه، ويتسم بالرحمة والدبلوماسية، ويفضل التعاون على المنافسة الشرسة، بأنه شخص يسجل درجة مرتفعة في عامل","A":"أ) الانفتاح على الخبرة","B":"ب) الانبساطية","C":"ج) العصابية","D":"د) المقبولية","answer":"D","topic_question_no":6},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"واجه فريقان أزمة مفاجئة هددت استمرار عملهما. قائد الفريق الأول بدأ في التفكير بعقلانية بهدوء وبحث عن بدائل ميدانية، بينما دخل قائد الفريق الثاني في حالة من القلق والتشاؤم وبدأ بتضخيم الإحباط وإلقاء اللوم. الاختلاف الجوهري بين القائدين يكمن في سمة","A":"أ) الانفتاح على الخبرات الجديدة والمغامرة","B":"ب) العصابية (الاتزان الانفعالي العالي مقابل المنخفض)","C":"ج) يقظة الضمير في القدرة على التخطيط المبكر","D":"د) المقبولية والتعاطف مع الآخرين","answer":"B","topic_question_no":7},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تلعب العوامل البيولوجية والوراثية دوراً في التكوين الأساسي لشخصية الفرد، ولا يقتصر هذا الدور على الشكل الخارجي، بل يمتد ليحدد جوانب عميقة مثل","A":"أ) نوع التنشئة الثقافية التي سيتعرض لها الفرد مستقبلاً","B":"ب) استعدادات عصبية كحساسية الجهاز العصبي وتوازن الموصلات الدماغية المؤثرة في الاندفاع","C":"ج) طريقة تعامل الفرد مع الخوارزميات الرقمية في الفضاء الافتراضي حصراً","D":"د) اكتساب الفرد لمهارة الحوار والدعم المدرسي بشكل تلقائي","answer":"B","topic_question_no":8},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يعتبر \"التكامل والشمول\" من الحقائق الجوهرية في فهم الشخصية، وهذا يعني أن أي سلوك يصدر عن الإنسان (كاتخاذ قرار مهني) هو في الواقع","A":"أ) ناتج عن نشاط جزء واحد فقط من الدماغ دون تدخل المشاعر","B":"ب) نتيجة لتفاعل جميع أجهزته النفسية والعصبية والمعرفية والوجدانية","C":"ج) رد فعل لحظي غير مرتبط بماضيه أو جيناته الوراثية","D":"د) تأثير خالص للبيئة الرقمية دون تدخل التكوين البيولوجي","answer":"B","topic_question_no":9},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"عند تشكيل فريق لإدارة \"المخاطر ووضع خطط الطوارئ\" في شركة مالية كبرى، فإن النمط الشخصي الأنسب (وفقاً لـ العوامل الخمسة الكبرى) والذي يميل للتحليل الحذر هو الذي يجمع بين","A":"أ) الانفتاح العالي على الخبرة والانبساطية المفرطة","B":"ب) يقظة الضمير المرتفعة والاتزان الانفعالي العالي","C":"ج) المقبولية المنخفضة والانبساطية المنخفضة","D":"د) العصابية العالية (قلق وتوتر) والانفتاح المرتفع","answer":"B","topic_question_no":10},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يُعد فهمنا لمفهوم الشخصية خطوة أساسية في علم النفس. أي من العبارات التالية يتطابق مع التعريف العلمي الدقيق للشخصية؟","A":"أ) . د) هي المرادف الدقيق لمستوى الذكاء الأكاديمي والتحصيل الدراسي للفرد","B":"ب) مجموعة ثابتة من الاستجابات الموروثة التي لا تقبل التعديل بتغير البيئة","C":"ج) التنظيم الديناميكي المتكامل والنامي داخل الفرد، والذي يشمل أجهزته النفسية والعصبية والجسدية، ويحدد طريقته الفريدة في التفكير والشعور","D":"د) هي الانطباع الخارجي الذي يتركه الفرد بناءً على مظهره وصوته فقط","answer":"C","topic_question_no":11},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تلعب التنشئة الأسرية والبيئة الاجتماعية دوراً حاسماً في صياغة شخصية الطفل. فالتربية التي تعتمد على التسلط والحماية الزائدة تفرز غالباً شخصية تعاني من","A":"أ) الاستقلالية المفرطة والجرأة في الحق","B":"ب) الاعتمادية على الآخرين والتمرد العشوائي","C":"ج) يقظة الضمير العالية والتنظيم الذاتي الصارم","D":"د) المرونة النفسية والقدرة على التعافي السريع","answer":"B","topic_question_no":12},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"في سياق تحليل الشخصية، ماذا يُقصد بأن \"التفرد والبصمة السلوكية\" هي إحدى الحقائق الجوهرية للشخصية؟","A":"أ) أن العوامل الوراثية وحدها هي من ترسم شكل السلوك البشري دون استثناء","B":"ب) أن جميع الأشخاص الذين يتلقون نفس التعليم سيتصرفون بنفس الطريقة تماماً","C":"ج) أن التفاعل المعقد بين البيولوجيا والبيئة والخبرات يُنتج تركيبة فريدة، تجعل استجابة كل إنسان للمثيرات أمراً خاصاً لا يتطابق مع غيره","D":"د) أن سمات الشخصية تعمل بشكل منفصل عن بعضها البعض دون أي تكامل","answer":"C","topic_question_no":13},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"موظفة تُكلف بمهام إدارية روتينية، لكنها دائماً ما تبحث عن طرق مبتكرة لإنـجازها، وتقضي وقتها في القراءة لاكتشاف أفكار (خارج الصندوق)، وتعشق التغيير المستمر. وفقاً لنموذج العوامل الخمسة (Big Five)، هذه الموظفة تمتلك درجة مرتفعة في سمة","A":"أ) المقبولية","B":"ب) يقظة الضمير (التفاني)","C":"ج) الانفتاح على الخبرة","D":"د) العصابية (الاتزان الانفعالي المنخفض)","answer":"C","topic_question_no":14},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"عند مقارنة الفرد ذي المقبولية المرتفعة (الجانب الإيجابي) بزميله ذي المقبولية المنخفضة (الجانب السلبي) في بيئة العمل، نـجد أن الأول يميل إلى الدبلوماسية والرحمة، بينما يميل الثاني بشكل واضح إلى","A":"أ) الارتجال العشوائي والتسويف الدائم للمهام","B":"ب) أن يكون حاد الطباع، شكاكاً في النوايا، يفضل المنافسة على التعاون، ونقده مباشر وقاسٍ","C":"ج) الانطواء التام واستمداد الطاقة من الهدوء والعزلة","D":"د) القلق الشديد وسرعة التوتر عند مواجهة أي ضغط مهني","answer":"B","topic_question_no":15},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يتميز الشخص الذي يسجل \"درجة مرتفعة\" في سمة الانبساطية بعدة خصائص تجعله مناسباً لوظائف تتطلب تفاعلاً بشرياً مستمراً. من أبرز هذه الخصائص أنه","A":"أ) يستمد طاقته من التواجد وسط الناس، حماسي، جريء، ويحب القيادة والتأثير في الآخرين","B":"ب) متزن وصلب انفعالياً، ويفكر بعقلانية تحت الضغط دون أي اعتبار للمشاعر","C":"ج) يستمد طاقته من الهدوء والانعزال، ويفضل الإنـجاز الفردي","D":"د) محافظ وتقليدي، ويتعامل بحذر شديد مع أي فكرة أو تجربة جديدة","answer":"A","topic_question_no":16},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"\"منضبط، متقن، منظم، يخطط قبل القرارات، ويتحمل المسؤولية للنهاية\". هذا الوصف يعكس الدرجة المرتفعة لسمة تعتبر ضرورية لنـجاح أي مدير تنفيذي، وهي سمة","A":"أ) الانفتاح على الخبرة والتجديد","B":"ب) يقظة الضمير (التفاني والالتزام)","C":"ج) الانبساطية والمشاركة الاجتماعية","D":"د) العصابية والقلق المفرط","answer":"B","topic_question_no":17},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"في إدارة الخلافات، يختلف النهج باختلاف سمات الشخصية. الشخص الذي يمتلك (مقبولية منخفضة) لن يبالي بمشاعر الآخرين أثناء النزاع، وسيعتمد استراتيجية تتمثل في","A":"أ) الدبلوماسية واحتواء الفريق ليربح الجميع","B":"ب) حسم المشكلة بصرامة وفقاً لمنطق الحقائق المجردة والنزعة التنافسية","C":"ج) اللوم الذاتي وتضخيم الإحباط للهروب من الموقف","D":"د) استخدام الخيال وتقديم حلول إبداعية بعيدة عن صلب الموضوع","answer":"B","topic_question_no":18},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يعتبر الاتزان الانفعالي (الدرجة المنخفضة من العصابية) صمام أمان للشخصية وقت الأزمات. تتجلى أهمية هذه السمة عندما يواجه الفرد كارثة مفاجئة، حيث يقوم الفرد عالي الاتزان بـ","A":"أ) تضخيم الإحباطات والانهيار الفوري وتوقع السيناريوهات الأسوأ دائماً","B":"ب) التفكير بعقلانية، الحفاظ على هدوئه تحت الضغط، والبحث فوراً عن بدائل ميدانية لتجاوز الأزمة","C":"ج) الانعزال التام عن الفريق لتقليل الاحتكاك","D":"د) التصرف باندفاع وعشوائية للهروب من مسؤولية القرار","answer":"B","topic_question_no":19},{"exam_id":"U5-T2","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"\"استمداد الطاقة من الهدوء، وتفضيل الإنـجاز الفردي، وبناء صداقات قليلة ولكنها عميقة جداً\". تمثل هذه الخصائص النمط السلوكي الطبيعي للشخص الذي يمتلك","A":"أ) درجة منخفضة في سمة الانبساطية (الانطوائي)","B":"ب) درجة مرتفعة في الانفتاح على الخبرات","C":"ج) درجة منخفضة في سمة يقظة الضمير","D":"د) درجة عالية في العصابية وعدم الاتزان","answer":"A","topic_question_no":20}],"U5-T3":[{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"المفهوم العلمي الدقيق لـ \"جودة الحياة\" في علم النفس لا يقتصر أبداً على مجرد امتلاك الفرد للثراء المادي الاستهلاكي، بل يعتمد في جوهره على","A":"أ) التزام الفرد بالانعزال التام عن المجتمع لتوفير الطاقة","B":"ب) إدراك الفرد التقييمي والشامل لدرجة الرضا والإيجابية والإشباع التي يختبرها في كافة جوانب حياته وفقاً لمنظومة قيمه","C":"ج) التوافق الجسدي حصراً دون النظر للجانب الوجداني أو المهني","D":"د) نـجـاح الفرد في إثبات تفوقه على جميع أقرانه في منصات التواصل الاجتماعي","answer":"B","topic_question_no":1},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"تتكون جودة الحياة من ركيزتين: جانب موضوعي وجانب ذاتي. يؤكد علماء النفس أن \"الجانب الذاتي\" هو الأهم في تحديد مستوى سعادة الفرد لأنه يمثل","A":"أ) توفر الاحتياجات المادية الأساسية كالمسكن والدخل والأمان","B":"ب) القدرة على تجميع أكبر قدر من الممتلكات ومقارنتها بالآخرين","C":"ج) تقييم الفرد التفاؤلي لظروفه، واستمتاعه بالمتاح، والامتنان والصلابة النفسية لتحويل العثرات لدرجات ارتقاء","D":"د) التمتع بصحة جسدية تامة خالية من أي إصابات طوال الحياة","answer":"C","topic_question_no":2},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"شخص يمتلك وظيفة ذات دخل مرتفع، وسكناً آمناً، وتأميناً صحياً ممتازاً (توفر الجانب الموضوعي)، ولكنه دائم الشكوى، يشعر بالنقص المستمر، ولا يمتلك أي قدرة على تحويل العثرات لدروس مستفادة. هذا الشخص يعاني من ضعف حاد في جودة حياته ناتج عن خلل في","A":"أ) العامل الجسدي البيولوجي","B":"ب) العامل النفسي والجانب الذاتي التقييمي","C":"ج) البيئة المجتمعية والمساحات الخضراء","D":"د) الجانب الموضوعي المادي","answer":"B","topic_question_no":3},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"أحد العوامل المؤثرة في جودة الحياة هو \"العامل المهني\". ويحذر علم النفس من حالة خطيرة تُعتبر من أشد العوامل تدميراً لجودة الحياة وتسبباً مباشراً في الاكتئاب وفقدان الإحساس بالمعنى، وهي حالة","A":"أ) الفراغ والبطالة وانعدام الشعور بالإنتاجية","B":"ب) العمل ضمن فريق يمتلك تنوعاً في السمات الشخصية","C":"ج) الانتقال التدريجي لتقبل الذات وتجنب الكمالية","D":"د) الانخراط في ممارسة الرياضة بشكل يومي منتظم","answer":"A","topic_question_no":4},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"تُعد \"العلاقات الاجتماعية\" المنبئ الأقوى بالسعادة وطول العمر وفقاً للدراسات النفسية، ويعود ذلك لعدة أسباب فسيولوجية ونفسية، من أبرزها أن شبكة الدعم الصادقة (كالإنصات والمؤازرة) تقوم بـ","A":"أ) زيادة الشعور بالمنافسة الشرسة داخل الأسرة مما يحفز الإنـجاز المادي","B":"ب) تخفيف إفراز هرمونات التوتر من الغدتين الكظريتين لتعمل كمظلة حماية نفسية","C":"ج) إلغاء حاجة الفرد لممارسة مهارة التوكيدية مع الآخرين","D":"د) تعزيز المقارنات الاجتماعية الهابطة لرفع الغرور الذاتي المؤقت","answer":"B","topic_question_no":5},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"لكي يضمن الفرد أن تساهم علاقاته الاجتماعية في رفع \"جودة الحياة\" بدلاً من تدميرها، فإنه يحتاج إلى ممارسة مهارة إدارة العلاقات بقوة، والتي تتطلب منه أساساً","A":"أ) السعي لزيادة عدد المتابعين الافتراضيين وتجاهل العمق العاطفي","B":"ب) الموافقة الدائمة على طلبات الأصدقاء لتجنب غضبهم حتى لو استنزفوا طاقته","C":"ج) ممارسة الحزم والتوكيدية لوضع حدود تحمي طاقته من الشخصيات السلبية المستنزفة، فالجودة تُقاس بالعمق والأمان","D":"د) فرض عزلته الخاصة وقطع كافة أشكال التواصل عند أول خلاف بسيط","answer":"C","topic_question_no":6},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"لتحقيق التوازن الضروري بين \"الحياة الواقعية المباشرة\" و\"الحياة الرقمية الافتراضية\"، ينصح خبراء الصحة النفسية بتطبيق استراتيجية \"الفصل المكاني والزماني الصارم\". التطبيق العملي الأفضل لهذه الاستراتيجية هو","A":"أ) متابعة الإشعارات أثناء الجلسات العائلية فقط لضمان عدم تفويت الأخبار الهامة","B":"ب) دمج الشاشات في كل تفاصيل اليوم لتوثيق جميع اللحظات فوراً لتعزيز الذكريات","C":"ج) منع وجود الشاشات تماماً في أوقات وأماكن محددة كطاولة الطعام العائلية لحماية الروابط والانتباه المباشر","D":"د) تخصيص وقت الشاشة لاستهلاك المحتوى الترفيهي التافه للهروب من الضغوط اليومية","answer":"C","topic_question_no":7},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"أثناء قضاء نزهة في الطبيعة الخلابة مع أصدقائه، أمضى شاب معظم وقته في التقاط مئات الصور ونشرها فوراً على حساباته، وقراءة التعليقات عليها، بدلاً من الاستمتاع بالمنظر أو التحدث مع أصدقائه. هذا الشاب يخل بمبدأ أساسي لجودة الحياة الرقمية وهو","A":"أ) الاستخدام الرقمي للإنتاج وتطوير الذات بدلاً من التمرير اللانهائي","B":"ب) سيادة العالم الواقعي المباشر، وعيش اللحظة بالحواس الخمس وجعل التوثيق أمراً ثانوياً","C":"ج) الانقطاع الرقمي الدوري لتنظيف الجهاز العصبي","D":"د) السعي للانتماء عبر الانضمام لفرق تطوعية ميدانية","answer":"B","topic_question_no":8},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"\"الخوف من تفويت الأشياء\" (FOMO) ظاهرة نفسية تدفع الإنسان لتفقد شاشاته بشكل قهري مستمر خوفاً من غيابه عن الأحداث. السيطرة على هذا القلق الداخلي تعتبر خطوة ضرورية لتحقيق","A":"أ) التحول نحو نموذج طبي تقليدي لتعريف العافية","B":"ب) الانخراط التام في المقارنات الاجتماعية الصاعدة","C":"ج) التوازن بين الحياة الواقعية والرقمية وحماية التركيز الذهني","D":"د) زيادة الاعتماد على الشخصيات السلبية المستنزفة لتقليل الوحدة","answer":"C","topic_question_no":9},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"من أجل استعادة الحساسية الطبيعية للجهاز العصبي تجاه الهدوء، وتخفيف حدة التوتر الناتج عن المؤثرات السريعة المتتالية، ينصح علم النفس بـ","A":"أ) التفريد المعرفي عبر مشاهدة مقاطع فيديو مزدوجة","B":"ب) الانقطاع الرقمي الدوري، كتخصيص عطلة للامتناع التام عن الشاشات والنزول للطبيعة (ديتوكس رقمي)","C":"ج) استخدام التوكيدية الحازمة للرد على المتنمرين عبر الإنترنت طوال الليل","D":"د) الانخراط المستمر في حالة التدفق (Flow) عبر ألعاب الفيديو العنيفة","answer":"B","topic_question_no":10},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"يشير المفهوم الدقيق لـ جودة الحياة في علم النفس إلى حقيقة هامة وهي أن جودة الحياة ليست مرتبطة تلقائياً بالثراء المادي، بل ترتكز جوهرياً على","A":"أ) الهروب المستمر من الضغوط لتحقيق السلام المؤقت","B":"ب) إدراك الفرد التقييمي الشامل لدرجة الرضا والإشباع في جوانب حياته ضمن منظومة قيمه","C":"ج) التوافق الجسدي والتغذية السليمة كعنصر وحيد للرفاه","D":"د) قدرة الفرد على استنساخ أسلوب حياة المشاهير الافتراضي","answer":"B","topic_question_no":11},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"تتألف جودة الحياة من جانبين متكاملين (موضوعي وذاتي). الجانب الموضوعي ضروري لتوفير الأساس، لكن علماء النفس يؤكدون أن \"الجانب الذاتي\" هو الأهم، لأنه يتمثل في قدرة الإنسان على","A":"أ) السيطرة المادية على مساحات خضراء واسعة","B":"ب) توفير الدخل الأساسي والرعاية الصحية للأقارب","C":"ج) التقييم التفاؤلي لظروفه، والامتنان للمتاح، والصلابة النفسية لتحويل العثرات لدرجات ارتقاء","D":"د) التنازل عن منظومة القيم لضمان تحقيق مكاسب مهنية سريعة","answer":"C","topic_question_no":12},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"العامل النفسي والوجداني هو ركيزة أساسية في جودة الحياة. يتحقق هذا العامل بقوة عندما يمارس الفرد سلوكاً داخلياً يحرره من القيود المرهقة، ويُعرف هذا السلوك بـ","A":"أ) التحرر من التفكير العقلاني في حل المشكلات","B":"ب) السعي المستميت للكمالية المرضية لتجنب أي نقد محتمل","C":"ج) التنظيم الانفعالي، التقييم الإيجابي للذات، والتحرر من \"الكمالية\" الخانقة التي لا تقبل الخطأ الطبيعي","D":"د) الكبت اللاشعوري لكافة الصدمات العاطفية القديمة لضمان نسيانها","answer":"C","topic_question_no":13},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"موظف يحصل على راتب ممتاز ويسكن في منزل آمن، لكن بيئة عمله تهمش أفكاره الإبداعية، ومديره ينسب الجهد لنفسه دائماً. الموظف يعاني هنا من تدني في جودة حياته بسبب خلل في العامل","A":"أ) الجسدي البيولوجي وتأثيره على النوم","B":"ب) البيئي والمهني الذي يفقد التقدير للجهد ويقمع مساحات الإبداع","C":"ج) الموضوعي المتمثل في توفير الاحتياجات الأساسية","D":"د) الشخصي المستقل عما حوله من متغيرات","answer":"B","topic_question_no":14},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"يُحذر علماء النفس من حالة خطيرة تضرب جودة الحياة في مقتل، وتعتبر من أشد العوامل المسببة لـ الاكتئاب السريري لكونها تسلب الفرد الشعور بالإنتاجية والإتقان في خدمة مجتمعه، هذه الحالة هي","A":"أ) زيادة ساعات العمل التطوعي في الجمعيات الأهلية","B":"ب) ممارسة الرياضة البدنية العنيفة","C":"ج) الفراغ، البطالة المستمرة، وانعدام الهدف المهني","D":"د) التفاعل المستمر مع شبكات الدعم الاجتماعي","answer":"C","topic_question_no":15},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"أثبتت الدراسات الطولية العميقة أن المنبئ الأقوى والمحدد الرئيسي لـ طول العمر والشعور بالسعادة الغامرة ليس قوة الجسد فقط، بل هو","A":"أ) التمتع بمستوى مالي يفوق أقران الطبقة الاجتماعية","B":"ب) جودة وقوة العلاقات الاجتماعية وشبكة الدعم الصادقة","C":"ج) العزلة الرقمية والابتعاد التام عن الفضاء المفتوح","D":"د) الدخول في مقارنات اجتماعية صاعدة بشكل دائم لتحفيز الإنـجاز","answer":"B","topic_question_no":16},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"تخفيف إفراز هرمونات التوتر من الغدتين الكظريتين هي النتيجة الفسيولوجية المباشرة والمذهلة التي يجنيها جسد الإنسان عندما يحظى بـ عندما يحظى بـ","A":"أ) مظلة حماية نفسية متمثلة في شبكة دعم اجتماعي صادقة تقدم الإنصات والمؤازرة الحقيقية","B":"ب) زيادة في ساعات الاستهلاك اللانهائي للمحتوى الرقمي الترفيهي","C":"ج) بيئة عمل قاسية تعتمد على الترهيب والمنافسة الشرسة لرفع الإنتاجية","D":"د) ممارسة حيلة التبرير النفسي لإخفاء الإخفاقات المهنية","answer":"A","topic_question_no":17},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"الانضمام إلى جمعيات أو فرق تطوعية يقدم للإنسان فائدة سيكولوجية عظيمة ترفع من جودة حياته، وذلك لأن هذا الانضمام يشبع حاجة أساسية هي","A":"أ) الحاجة لفرض السلطة والهيمنة على الآخرين","B":"ب) الشعور العميق بالانتماء لمنظومة أكبر، وإحساسه بالأمان والتقدير لجهده المبذول","C":"ج) الرغبة في التباهي الافتراضي وحصد الإعجابات الرقمية الوهمية","D":"د) الحاجة للاستقلال التام والعمل الفردي بمعزل عن قيود المجتمع","answer":"B","topic_question_no":18},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"لإدارة العلاقات بنـجاح وحماية جودة الحياة من الانهيار، يجب على الفرد ممارسة مهارة التوكيدية والحزم بشكل مستمر. تتجلى أهمية هذه المهارة في قدرتها على","A":"أ) إخضاع الطرف الآخر لرغباته الشخصية بالقوة","B":"ب) وضع حدود نفسية صحية تحمي طاقته ووقته من الشخصيات السلبية المستنزفة، لأن الجودة تُقاس بالعمق لا بالكثرة","C":"ج) كسر العزلة الرقمية والرد على كافة الاستفزازات الافتراضية","D":"د) الذوبان في الجماعة وتلبية كافة طلباتهم لتجنب الصراعات","answer":"B","topic_question_no":19},{"exam_id":"U5-T3","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"الفصل المكاني والزماني الصارم هو استراتيجية حيوية لتحقيق التوازن بين العالم الرقمي والواقعي. أفضل تطبيق عملي لهذه الاستراتيجية لحماية الروابط العائلية من التآكل البطيء يتمثل في","A":"أ) دمج الشاشات في الحوارات الأسرية لتوثيق اللحظات بلقطات مفلترة ترفع الدليل الاجتماعي","B":"ب) السماح باستخدام الشاشات فقط في أوقات الخلافات العائلية لتهدئة الجو المشحون","C":"ج) منع وجود الشاشات تماماً وبحزم على طاولة الطعام العائلية أو في الجلسات الحميمية لضمان التواصل المباشر","D":"د) تخصيص وقت الشاشة لاستهلاك المحتوى الترفيهي السريع للهروب من الضغوط العائلية","answer":"C","topic_question_no":20}],"U5-T4":[{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"يعتبر علم النفس الإيجابي، الذي أسسه مارتن سليجمان عام 1998، تحولاً جذرياً في مسار علم النفس التقليدي، حيث يتميز بأنه ينقل التركيز من دراسة الأمراض وكيفية إصلاح العيوب (مجرد التعافي)، إلى","A":"أ) الاعتماد على الخيال والشعارات السطحية لرفع الروح المعنوية","B":"ب) الدراسة العلمية الصارمة لنقاط القوة والفضائل التي تمكن الأفراد من الازدهار والرفاه الفائق","C":"ج) إنكار وجود الحزن أو المشكلات في حياة الإنسان والتعامل بإيجابية سامة","D":"د) استخدام الحيل الدفاعية للهروب من الواقع المحبط وتزيين الحقائق","answer":"B","topic_question_no":1},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"إحدى الركائز العلمية التي تميز \"علم النفس الإيجابي\" عن كتب المساعدة الذاتية التجارية (التنمية البشرية السطحية) هي أنه","A":"أ) يبني نظرياته على الحدس الشخصي والتجارب الفردية العابرة للمؤلفين","B":"ب) ينكر وجود الألم النفسي ويطالب الفرد بابتسامة دائمة غير واقعية","C":"ج) يرتكز على منهجية علمية صارمة مبنية على التجارب، الدراسات الطولية، وقياس النشاط العصبي","D":"د) يعتمد حصرياً على المقارنات الاجتماعية لتحفيز الإنـجاز المادي السريع","answer":"C","topic_question_no":2},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"وفقاً لنموذج سليجمان للازدهار النفسي (PERMA)، فإن قدرة الفرد على الانفصال التام عن القلق، والاستغراق الكامل والعميق في أداء مهارة أو عمل يحبه لدرجة نسيان الوقت وما يحيط به، تُمثل عنصر","A":"أ) المعنى والرسالة الأكبر","B":"ب) العلاقات الإيجابية الداعمة","C":"ج) الإنـجاز وتحقيق الأهداف المادية","D":"د) الاندماج (حالة التدفق Flow)","answer":"D","topic_question_no":3},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"يشعر طبيب متطوع في مناطق الكوارث برضا نفسي هائل وازدهار داخلي يفوق ما يشعر به في عيادته الخاصة الفاخرة المربحة. يفسر نموذج (PERMA) هذه الحالة بأن الطبيب قد حقق عنصراً أساسياً للازدهار وهو","A":"أ) المشاعر الإيجابية اللحظية العابرة كالفرح السطحي","B":"ب) المعنى (الإحساس برسالة تخدم غاية إنسانية كبرى تتجاوز المنفعة الذاتية)","C":"ج) الانخراط في مقارنات اجتماعية صاعدة لتحقيق السلطة","D":"د) التمتع بمستوى عالٍ من الانفتاح على الخبرات الرقمية","answer":"B","topic_question_no":4},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"تتضمن \"الفضائل الإنسانية الست الكبرى\" في علم النفس الإيجابي فضيلة \"الاعتدال\". وتتجسد هذه الفضيلة عملياً في قدرة الإنسان وتدريبه على ممارسة","A":"أ) الإبداع والفضول والتفكير الناقد في استيعاب المعلومات المعقدة","B":"ب) الجرأة في قول الحق، والمثابرة والإصرار وقت الشدائد","C":"ج) التسامح والتواضع، التنظيم الذاتي وضبط الرغبات المندفعة والتروي قبل الحكم","D":"د) تذوق الجمال، الأمل المفرط وعاطفة المرح وروح الدعابة في كل الأوقات","answer":"C","topic_question_no":5},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"قرر مدير مدرسة تغيير بيئة التعليم لتتوافق مع تطبيقات \"علم النفس الإيجابي\". الخطوة الاستراتيجية الأولى التي يجب عليه اتخاذها لتحويل بيئة التعلم لبيئة \"مزدهرة\" هي","A":"أ) تكثيف التركيز على تصيد الأخطاء ومعاقبة الطلاب الضعفاء لضبط النظام","B":"ب) الاعتماد الكلي على اختبارات ورقية موحدة تقيس الذكاء المنطقي وإلغاء الأنشطة الفنية","C":"ج) الانتقال لتصميم أنشطة تُركز على اكتشاف نقاط القوة والذكاءات المتعددة لكل طالب وتوزيع الأدوار وفقاً لها لاستثمار الميزة الفريدة","D":"د) إجبار الطلاب المتفوقين على إخفاء قدراتهم لضمان مساواة صورية تمنع تنمر الأقران","answer":"C","topic_question_no":6},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"\"القيادة الإيجابية\" لا تعني تساهل المدير أو تسيبه، بل تعني تبني أسلوب إداري يحقق الازدهار لفريق العمل من خلال ممارسات محددة أهمها","A":"أ) استخدام السلطة القهرية لضمان الطاعة العمياء وتسريع الإنـجاز","B":"ب) توفير رسالة ملهمة للعمل، الاحتفال بالإنـجازات الصغيرة، وخلق بيئة عمل عادلة يشعر فيها الموظف بالأمان النفسي","C":"ج) تعزيز المنافسة الشرسة بين الموظفين والاعتماد على المقارنات النقدية اللاذعة لاكتشاف الأفضل","D":"د) كبت مشاعر الموظفين ومنع أي تواصل اجتماعي بينهم أثناء ساعات العمل لزيادة التدفق المهني","answer":"B","topic_question_no":7},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"ممارسة \"التقدير والامتنان الأسري\" تعد من أقوى التطبيقات لبناء روابط أسرية متينة ومزدهرة. التطبيق النفسي السليم للامتنان مع الأبناء يتطلب من الآباء أن يركزوا بشكل رئيسي على","A":"أ) مقارنة إنـجاز الابن المستمرة بإنـجازات زملائه الأفضل منه لدفعه للتفوق (مقارنة صاعدة)","B":"ب) مدح الجهد المبذول والمثابرة ولغة الامتنان الصريحة وتخصيص وقت لاستحضار الممتنات اليومية","C":"ج) ربط التقدير بحصول الابن على الدرجات النهائية فقط دون النظر لجهده أو محاولته","D":"د) استخدام حيلة التعويض لإجبار الابن على تحقيق أحلام الآباء التي فشلوا فيها","answer":"B","topic_question_no":8},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"تضم فضيلة \"الإنسانية\" في علم النفس الإيجابي مجموعة من السمات الراقية التي تحسن التوافق الاجتماعي، من أبرزها","A":"أ) الإبداع المعرفي والفضول لاكتشاف المجهول","B":"ب) العدالة في توزيع الموارد والقيادة المجتمعية المنصفة","C":"ج) المحبة واللطف والرحمة وتقديم المساعدة والذكاء الاجتماعي العاطفي","D":"د) التواضع ونكران الذات والتحكم في الغرائز","answer":"C","topic_question_no":9},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"لكي يحمي الشاب نفسه من الآثار المدمرة لـ \"الاستهلاك الإلكتروني المفرط والمقارنات المفلترة\"، ينصحه علم النفس الإيجابي بتوظيف فضيلتين أساسيتين هما","A":"أ) \"الإبداع\" لتصميم صور مزيفة، و\"المحبة\" للتعاطف مع المتنمرين","B":"ب) \"العدالة\" للمطالبة بالمساواة المطلقة، و\"الشجاعة\" للتشهير بالأصدقاء المخطئين","C":"ج) \"التنظيم الذاتي (الاعتدال)\" لفرض أوقات انقطاع صارمة، و\"الحكمة\" لمقاومة فخ المقارنات السامة وإدراك زيفها","D":"د) \"التسامي\" للهروب من الواقع في أحلام اليقظة، و\"حب التعلم\" لاستهلاك المزيد من الإشعارات","answer":"C","topic_question_no":10},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"مثل تأسيس علم النفس الإيجابي على يد مارتن سليجمان عام 1998 نقلة نوعية في تاريخ التخصص، حيث تجاوز الهدف التقليدي المتمثل في .إصلاح العيوب ومجرد التعافي من الأمراض. ليصل إلى هدف أسمى وأعمق يتمثل في","A":"أ) استخدام الحيل الدفاعية للهروب من الواقع المؤلم وتخيل واقع مثالي بديل","B":"ب) الدراسة العلمية لنقاط القوة والفضائل التي تمكن الأفراد والمجتمعات من الازدهار وتحقيق أعلى مستويات الرفاه","C":"ج) إلغاء الفروق الفردية الوراثية وتوحيد سمات الشخصية لضمان انسجام اجتماعي مثالي","D":"د) الاعتماد الكلي على الشعارات التحفيزية السطحية وتجاهل المنهجية العلمية والقياسات العصبية","answer":"B","topic_question_no":11},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"وفقاً لنموذج سليجمان للازدهار النفسي (PERMA)، عندما يصل الجراح إلى قمة تركيزه أثناء عملية دقيقة، أو يغوص الرسام في تفاصيل لوحته لدرجة ينفصل فيها تماماً عن القلق وينسى مرور الوقت وما يحيط به، فإنه يعيش حالة يصفها النموذج بـ","A":"أ) الإنـجاز وتحقيق الأهداف المادية البحتة للحصول على التقدير الخارجي","B":"ب) المعنى والإحساس برسالة تخدم غاية إنسانية كبرى تتجاوز المنفعة الذاتية اللحظية","C":"ج) الاندماج (حالة التدفق Flow) والاستغراق الكامل في المهارة","D":"د) المشاعر الإيجابية العابرة كالفرح السطحي وتذوق الجمال المؤقت في اللوحة أو المشرط","answer":"D","topic_question_no":12},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"يشعر شاب بالضياع والاكتئاب رغم نـجاحه المهني وتوفره المالي. بالعودة لنموذج (PERMA)، العنصر الجوهري المفقود الذي يجب أن يبحث عنه هذا الشاب ليحمي نفسه من الفراغ الوجودي ويشعر بأن لوجوده قيمة حقيقية تفوق متعته الشخصية هو عنصر","A":"أ) المشاعر الإيجابية التي يمكن تعويضها بالترفيه","B":"ب) المعنى (الإحساس برسالة تخدم قضية أكبر كالتطوع والدفاع عن الحقوق)","C":"ج) الاندماج في أنشطة روتينية لنسيان مشكلاته","D":"د) العلاقات السطحية العابرة لتمضية الوقت وتجنب الوحدة الخانقة","answer":"C","topic_question_no":13},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"فضيلة \"الاعتدال\" في علم النفس الإيجابي ليست مجرد كلمة، بل هي تدريب نفسي شاق ومستمر لكبح الاندفاعات الغريزية. تتجسد هذه الفضيلة عملياً من خلال ممارسات مثل","A":"أ) الجرأة في قول الحق، والمثابرة وقت الشدائد، والصراحة القاسية دون مراعاة للمشاعر","B":"ب) التسامح، التواضع ونكران الذات، الحذر والتروي قبل الحكم، والتنظيم الذاتي الصارم للرغبات","C":"ج) تذوق الجمال الفني، وممارسة الامتنان العميق، والتمسك الدائم بالأمل التفاؤلي المفرط","D":"د) الإبداع، الفضول، التفكير الناقد، وبعد النظر في التعامل مع المعطيات الرقمية الحديثة","answer":"B","topic_question_no":14},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"\"القيادة الإيجابية\" لا تعني ضعف الإدارة أو تراخيها في تطبيق القوانين، بل هي نهج إداري متطور يحقق الازدهار والإنتاجية العالية للفريق عبر استراتيجيات محددة من أهمها","A":"أ) استخدام السلطة القهرية لضمان الطاعة العمياء وتسريع الإنـجاز في أوقات الأزمات الخانقة","B":"ب) تعزيز المنافسة السلبية بين الموظفين والاعتماد على المقارنات النقدية اللاذعة لاستبعاد الأضعف وتصفية الفريق","C":"ج) توفير رسالة ملهمة للعمل، الاحتفال بالإنـجازات الصغيرة، وخلق بيئة عادلة ومساحة آمنة نفسياً لا تخاف التجربة والخطأ","D":"د) كبت مشاعر الموظفين ومنع أي تواصل اجتماعي غير رسمي بينهم أثناء ساعات العمل لزيادة الاندماج والتدفق المهني","answer":"D","topic_question_no":15},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"لكي نبني \"بيئة تعلم مزدهرة\" داخل المدارس تواكب فلسفة علم النفس الإيجابي، يجب أن نحدث ثورة في أسلوب التقييم والتوجيه، تتمثل في الانتقال استراتيجياً من التركيز على أبعاد تقليدية إلى تصميم أنشطة تهدف إلى","A":"أ) تعزيز الذكاء الأكاديمي IQ / تنمية الذكاء الوجداني EQ حصراً باختبارات ورقية موحدة لضمان العدالة في القياس","B":"ب) تصيد الأخطاء وعلاج نقاط الضعف الروتينية / اكتشاف نقاط القوة والذكاءات المتعددة وتوزيع الأدوار لاستثمار الميزة الفريدة لكل طالب","C":"ج) إعفاء الطلاب الضعفاء من المهام الدقيقة لتقليل توترهم / فرض الاندماج المستمر في حالة التدفق Flow لساعات طويلة دون راحة","D":"د) تحفيز الطالب بالجوائز المالية الفورية الملموسة / غرس الكمالية المرضية كمعيار وحيد للنـجاح الأكاديمي والتميز المستقبلي","answer":"D","topic_question_no":16},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"ممارسة \"التقدير والامتنان الأسري\" تعد من أقوى التطبيقات لبناء روابط أسرية متينة وصلابة نفسية للأبناء. التطبيق النفسي والتربوي السليم الذي ينصح به علم النفس الإيجابي لمدح الطفل يتطلب من الآباء التركيز بشكل رئيسي على","A":"أ) مقارنة إنـجاز الابن المستمرة بإنـجازات زملائه المتفوقين أو إخوته الكبار لدفعه للتفوق واستثارة روح التحدي (المقارنة الصاعدة)","B":"ب) مدح الذكاء الفطري الموروث للطفل (أنت عبقري بالفطرة ولست كالباقين) لزيادة ثقته بنفسه دون مجهود وتقوية غروره المحفز","C":"ج) مدح \"الجهد، المثابرة، وطريقة التفكير\" بدلاً من التركيز حصراً على النتيجة أو الدرجة النهائية، وتخصيص وقت يومي للغة الامتنان والتعبير عنها","D":"د) تجنب المدح تماماً إلا إذا وصل الطفل للكمال المطلق والتفوق الساحق الخالي من الأخطاء لتعليمه فضيلة الاعتدال والتروي","answer":"A","topic_question_no":17},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"أثبتت التجارب التي استخدمت أجهزة \"قياس النشاط العصبي\" أن ممارسة تدريب \"دفتر يوميات الممتنات\" (كتابة 3 أشياء جيدة حدثت خلال اليوم بانتظام) لها أثر فسيولوجي إيجابي مذهل، يتمثل في أنها تقوم بـ","A":"أ) تدمير الذاكرة طويلة المدى للأحداث المؤلمة والصدمات بشكل لا رجعة فيه (محو الذاكرة السلبية)","B":"ب) زيادة نشاط الغدتين الكظريتين لإفراز المزيد من الدوبامين العشوائي مما يؤدي للإدمان على المشاعر السطحية","C":"ج) إعادة برمجة مسارات الدماغ للبحث التلقائي عن الإيجابيات وتوسيع مدارك الرضا، مما يقوي المناعة الوجدانية الصلابة النفسية تدريجياً","D":"د) إلغاء عمل القشرة المخية المنطقية المسؤولة عن التفكير الناقد واستبدالها بالتفكير التباعدي الفني حصراً","answer":"B","topic_question_no":18},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"\"المحبة، اللطف، الرحمة، تقديم المساعدة للمحتاجين، وامتلاك ذكاء اجتماعي عاطفي عالٍ\". تندرج هذه السمات النبيلة والراقية التي تعزز التوافق البشري تحت مظلة فضيلة كبرى من فضائل علم النفس الإيجابي الست، وهي فضيلة","A":"أ) العدالة والإنصاف في توزيع الموارد","B":"ب) الحكمة والمعرفة والتفكير الناقد","C":"ج) الإنسانية والرقي الوجداني","D":"د) التسامي والارتقاء الروحي وتذوق الجمال","answer":"A","topic_question_no":19},{"exam_id":"U5-T4","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"يتجلى عنصر \"المشاعر الإيجابية\" (كالفرح، الرضا، الامتنان) في نموذج (PERMA)، ليس كمجرد شعور عابر باللذة أو الترفيه، بل أثبتت الدراسات المعرفية أن هذه المشاعر تلعب دوراً عقلياً حيوياً بالغ الأهمية يتمثل في","A":"أ) تقليل الاعتماد على الدماغ في حل المشكلات لتوفير الطاقة الجسدية المنهكة في الأزمات","B":"ب) حصر الانتباه وتضييق مدارك العقل للتركيز حصراً على المشاعر المكبوتة القديمة وتصفيتها (التطهير)","C":"ج) توسيع مدارك الدماغ الأفقية، وتعزيز المرونة الفكرية، وزيادة القدرة على استكشاف وإيجاد حلول إبداعية مبتكرة للمشكلات المعقدة","D":"د) تحفيز اللوزة الدماغية (Amagdala) لإصدار استجابات غضب سريعة لا واعية للدفاع عن النفس في المواقف الطارئة المربكة","answer":"B","topic_question_no":20}],"U6-T1":[{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"وفقاً لتعريف \"جوردون ألبورت\" لـ علم النفس الاجتماعي كجسر يربط بين الفرد والمجتمع، فإن المحور الأساسي الذي تنطلق منه كافة دراسات هذا العلم هو الإيمان الراسخ بأن","A":"أ) الفرد يولد مزوداً بخبرات اجتماعية جاهزة تغنيه عن الاحتكاك بالبيئة المحيطة","B":"ب) الإنسان كائن الاجتماعي لا يمكن تفسير أو فهم سلوكه الفردي بمعزل عن تأثير الناس المحيطين به والتفاعل المتبادل معهم","C":"ج) المجتمع يمثل كياناً مستقلاً لا يتأثر بأي شكل من الأشكال بمبادرات الأفراد أو إنـجازاتهم الخاصة","D":"د) العوامل البيولوجية والفسيولوجية هي المحرك الوحيد للسلوك بمعزل عن قوانين المجتمع وعاداته","answer":"B","topic_question_no":1},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"يعيش طالب عربي في دولة أجنبية للدراسة، ورغم عدم وجود أسرته أو أصدقائه حوله، فإنه يمتنع تماماً عن القيام ببعض التصرفات المرفوضة في بلده الأم، متمسكاً بعاداته وقيمه الوطنية. نوع التأثير الاجتماعي الذي يوجه سلوك هذا الطالب يعرف بـ","A":"أ) الحضور الفعلي (وجهاً لوجه)","B":"ب) الحضور المتخيل لرد فعل المعلم","C":"ج) الحضور الضمني أو الرمزي للمجتمع والقيم","D":"د) التأثير البيولوجي للاستعداد الانفعالي","answer":"C","topic_question_no":2},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"أثناء نقاش رياضي، عرّف أحد المشجعين نفسه بحماس شديد قائلاً: \"نحن أبناء النادي العريق الذي لا يعرف الهزيمة\"، متجاهلاً ذكر اسمه أو مهنته الشخصية. هذا الجزء من مفهوم الذات الذي يستمده الفرد من الانتماء لمجموعة وما يرافقه من دلالة انفعالية يعرف بـ","A":"أ) الهوية الفردية المستقلة","B":"ب) الاتجاه السلوكي والعملي","C":"ج) الهوية الاجتماعية (حسب هنري تاجفل)","D":"د) المكون المعرفي للاتجاهات","answer":"C","topic_question_no":3},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"تقدم شاب لشغل وظيفة إدارية، ولاحظ مدير الموارد البشرية أن الشاب يتحدث بطلاقة وتأنق شديد في اختيار مفرداته. بناءً على هذه الملاحظة الجيدة فقط، قرر المدير أن الشاب يتمتع أيضاً بالأمانة العالية والقدرة الممتازة على إدارة الأزمات المالية. الخطأ الإدراكي الذي وقع فيه المدير هو","A":"أ) خطأ العزو (تفسير أسباب السلوك)","B":"ب) تأثير الهالة (التعميم الأعمى لسمة بارزة)","C":"ج) القولبة أو الصور النمطية بناءً على المهنة","D":"د) التحيز التأكيدي للخبرات السابقة","answer":"B","topic_question_no":4},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"فشل موظف في تسليم مشروعه في الوقت المحدد، فعزا ذلك إلى \"بطء أجهزة الشركة وسوء بيئة العمل\". في المقابل، عندما تأخر زميله في تسليم مشروعه، اتهمه الموظف الأول بأنه \"شخص مستهتر وكسول بطبعه\". هذا التناقض في التفسير يجسد إحدى التحيزات الذهنية وهي","A":"أ) فرضية الاحتكاك","B":"ب) التحيز التأكيدي","C":"ج) خطأ العزو","D":"د) الصور النمطية","answer":"C","topic_question_no":5},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"لتقليل التحيز والصراع بين فريقين في العمل، قررت الإدارة دمج أعضاء الفريقين معا. وفقاً لـ \"فرضية الاحتكاك\" لـ ألبورت، لكي ينـجح هذا التفاعل المباشر في إزالة التحيزات، فإنه يشترط بالضرورة توفر","A":"أ) سلطة قهرية تجبر أحد الفريقين على التنازل عن آرائه للفريق الآخر","B":"ب) تكافؤ المكانة بين الأعضاء، والسعي لتحقيق أهداف مشتركة بدعم من مؤسسة العمل","C":"ج) تركيز الإدارة على إبراز الأخطاء الفردية لتصحيحها علناً","D":"د) اعتماد كل فريق على الصور النمطية الإيجابية بدلاً من السلبية","answer":"B","topic_question_no":6},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"الاتجاه النفسي يتكون من بناء متكامل (معرفي، وجداني، سلوكي). إذا كان شخص يمتلك معلومات دقيقة حول أضرار التدخين (الشق المعرفي)، وقرر فعلياً الانضمام لحملة توعية ضده (الشق السلوكي)، فإن الشق (الوجداني) المكمل لهذا الاتجاه يتمثل في","A":"أ) قراءة المزيد من الأبحاث الطبية حول أمراض الرئة","B":"ب) الشعور الداخلي بالنفور أو الكراهية العميقة لرائحة وعادة التدخين","C":"ج) جمع التبرعات لعلاج مرضى التدخين","D":"د) تذكر ردود أفعال والديه الغاضبة من التدخين (حضور متخيل)","answer":"B","topic_question_no":7},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"يحذر علماء النفس من خطورة \"التحيز التأكيدي\" عند تكوين الانطباعات عن الآخرين. يتجلى هذا التحيز المدمر عندما يقوم الفرد بـ","A":"أ) التقاط وتذكر المواقف التي تؤكد انطباعه السلبي الأول فقط، وتجاهل أي مواقف لاحقة تثبت إخلاص وتعاون الشخص","B":"ب) تصنيف جميع الأفراد من منطقة جغرافية معينة في قالب جامد ووحيد","C":"ج) تعميم صفة الأناقة لتشمل صفات الذكاء والأمانة","D":"د) تفسير أخطائه الشخصية بأسباب خارجية بحتة لتجنب اللوم","answer":"A","topic_question_no":8},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"رفض مدير شركة توظيف شاب قروي في وظيفة مكتبية متقدمة، مبرراً ذلك في نفسه بأن \"أبناء القرى لا يمتلكون المرونة الكافية لمجاراة سرعة العمل المكتبي التكنولوجي\"، متجاهلاً السيرة الذاتية الممتازة للشاب. الخطأ الإدراكي الذي أعمى المدير هنا هو","A":"أ) تأثير الهالة","B":"ب) القولبة (الصور النمطية)","C":"ج) خطأ العزو","D":"د) المكون الوجداني للاتجاه","answer":"B","topic_question_no":9},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"عند محاولة تغيير اتجاهات سلبية عميقة ومترسخة (كاحتقار مهنة يدوية معينة)، أثبتت الدراسات الاجتماعية أن الاكتفاء بتقديم المحاضرات النظرية والأرقام (تغيير البنية المعرفية) لا يكفي غالباً، بل يجب تعزيزه بقوة من خلال","A":"أ) الاعتماد على الحضور الضمني للعادات والتقاليد القديمة لإجبار الأفراد على التغيير","B":"ب) الاتصال المباشر والتجربة الميدانية لدمج الشباب وإزالة الصورة النمطية بالاحتكاك الحي","C":"ج) استخدام حيلة \"الإسقاط\" النفسي لاتهام المجتمع بالجهل","D":"د) تجاهل المكون السلوكي والتركيز حصراً على الشق المعرفي فقط","answer":"B","topic_question_no":10},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"باحث مهتم بدراسة التغيرات التي طرأت على أسلوب استهلاك الأفراد بعد صدور قوانين بيئية جديدة في الدولة، وفي نفس الوقت يدرس كيف أدت مبادرات هؤلاء الأفراد ومقاطعتهم لبعض السلع إلى إجبار الشركات على تغيير سياساتها. هذا الباحث يطبق المفهوم الدقيق لعلم النفس الاجتماعي كما صاغه جوردون ألبورت والذي يرتكز على","A":"أ) استخدام منهج الاستبطان لوصف المشاعر الاستهلاكية الفردية","B":"ب) تحليل العمليات البيولوجية الدماغية أثناء اتخاذ قرار الشراء","C":"ج) التفاعل المتبادل؛ كيف يُشكل المجتمع سلوك الإنسان، وكيف يؤثر الإنسان في تطوير مجتمعه","D":"د) دراسة الدوافع اللاشعورية التي تحرك الأفراد لشراء السلع","answer":"C","topic_question_no":11},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"أثناء جلوسه وحيداً في غرفة لإجراء اختبار إلكتروني غير مراقب، فكر طالب في الغش، لكنه تذكر فجأة نظرة خيبة الأمل التي سترتسم على وجه والده إذا اكتشف الأمر، فتراجع فوراً واعتمد على نفسه. قوة المجتمع في ضبط سلوك هذا الطالب تحققت هنا عبر آلية","A":"الحضور الضمني للقيم الوطنية","B":"فرضية الاحتكاك والتفاعل المباشر","C":"الحضور المتخيل للآخرين","D":"الحضور الفعلي (وجهاً لوجه)","answer":"C","topic_question_no":12},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"في أول يوم عمل له في شركة أجنبية، ُسئل مهندس مصري عن نفسه، فبدأ حديثه بوصف تاريخ بلده العريق واعتزازه بثقافته وحضارته قبل أن يذكر مؤهلته الهندسية. هذا الجزء العميق من مفهوم ذاته والذي يحمل دلالة انفعالية وفخراً يُعرف علمياً بـ","A":"المكون السلوكي لالاتجاهات","B":"الهوية الفردية المستقلة","C":"الهوية الاجتماعية","D":"التأثير المعلوماتي المكتسب","answer":"C","topic_question_no":13},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"أثناء تقييم أداء المعلمين، لاحظ الموجه أن أحد المعلمين يمتلك صوتاً جهورياً وإلقاءً مسرحياً جذاباً جداً. بناءً على هذه الملاحظة، كتب الموجه في تقريره أن هذا المعلم يتميز بعمق المادة العلمية، والعدالة المطلقة بين الطلاب، والتنظيم الإداري الفائق. الخطأ الإدراكي الفادح الذي ارتكبه الموجه هنا هو","A":"خطأ العزو","B":"القولبة أو الصور النمطية","C":"التحيز التأكيدي","D":"تأثير الهالة (التعميم الأعمى)","answer":"D","topic_question_no":14},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"طالب تأخر عن موعد تسليم بحثه، فذهب للأستاذ غاضباً وقال: مكتبة الجامعة كانت مغلقة، والمراجع غير متوفرة. وفي نفس اليوم، تأخر زميله في تسليم نفس البحث، فقال الطالب للأستاذ: زميلي هذا غير مبالٍ ولا يحب الدراسة أصلاً. هذه الازدواجية في التفسير تجسد حيلة إدراكية تُعرف بـ","A":"تأثير الهالة الإيجابية والسلبية","B":"خطأ العزو (تفسير أسباب السلوك)","C":"المكون المعرفي الخاطئ","D":"فرضية الاحتكاك المباشر","answer":"B","topic_question_no":15},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"لإنهاء خصومة تاريخية بين إدارتين في مستشفى واحد، قرر المدير دمج الأطباء والممرضين من الإدارتين في فريق واحد لإجراء أبحاث طبية مشتركة، مع منح الجميع نفس الصلاحيات وتوفير دعم مالي مكثف للمشروع. استند المدير في قراره الناجح هذا إلى","A":"تطبيق الصور النمطية الإيجابية","B":"فرضية الاحتكاك لألبورت","C":"تغيير الحضور الضمني للحضور الفعلي","D":"تعديل المكون الوجداني بالترهيب","answer":"B","topic_question_no":16},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"أعلم تماماً من خلال قراءاتي الطبية أن السهر الطويل يدمر خلايا الدماغ، ولكنني أشعر بمتعة لا تقاوم وعاطفة إيجابية قوية أثناء السهر تلغي كل قناعاتي الطبية. يوضح هذا المثال صراعاً بين مكونين من مكونات الاتجاه النفسي، حيث تفوق المكون الوجداني على المكون المعرفي","A":"المعرفي / السلوكي","B":"السلوكي / الوجداني","C":"الوجداني / المعرفي","D":"الفسيولوجي / المعرفي","answer":"C","topic_question_no":17},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"محامي يمتلك قناعة مسبقة ومترسخة بأن موكله بريء تماماً. أثناء فحص أوراق القضية، وجد عشرات الأدلة القاطعة التي تدين الموكل، ولكنه تجاهلها كلياً، وركز فقط على إفادة ضعيفة ومشكوك فيها لشاهد واحد تدعم براءة موكله، واعتبرها الحقيقة الوحيدة. هذا المحامي وقع ضحية لـ","A":"خطأ العزو المباشر","B":"التحيز التأكيدي","C":"القولبة الجغرافية","D":"الحضور الرمزي للعدالة","answer":"B","topic_question_no":18},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"رفضت سيدة تأجير شقتها لعائلة لمجرد أنها علمت أنهم ينتمون لمدينة معينة، مبررة ذلك بأن أهل هذه المدينة فوضويون ولا يحترمون الجيران، دون أن تلتقي بالعائلة أو تتحدث معهم. هذا الحكم الجائر يمثل خطأً في الإدراك الاجتماعي يُسمى","A":"تأثير الهالة السلبية","B":"التحيز التأكيدي للخبرات","C":"القولبة أو الصور النمطية","D":"فرضية الاحتكاك السلبي","answer":"C","topic_question_no":19},{"exam_id":"U6-T1","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"حاولت مؤسسة تغيير اتجاهات الشباب الرافضة للعمل المهني اليدوي، فاكتفت بطباعة كتيبات تحتوي على معلومات وإحصائيات حول الأرباح المادية للحرفيين (تغيير البنية المعرفية)، لكن الحملة فشلت. وفقاً لعلم النفس الاجتماعي، لكي يتم التعديل الفعلي للشق الوجداني والسلوكي بعمق، كان يجب على المؤسسة أن","A":"أ) تعزل الشباب عن المجتمع لتغيير هويتهم الفردية أولاً","B":"ب) تتجاهل الشق المعرفي تماماً وتركز على استخدام تأثير الهالة في الإعلانات","C":"ج) تستخدم الاتصال المباشر والتجربة الميدانية لدمج الشباب في ورش عمل حية لإزالة الصورة النمطية بالاحتكاك","D":"د) تعتمد على الحضور الرمزي والقوانين العقابية فقط","answer":"C","topic_question_no":20}],"U6-T2":[{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"عندما يدخل شخص إلى مطعم جديد كلياً ولا يعرف قواعد طلب الطعام فيه، فإنه يقف جانباً ليراقب ما يفعله الزبائن الآخرون ثم يقلدهم بدقة، ظناً منه أنهم يمتلكون المعرفة الصحيحة للنظام. هذا التغير التلقائي في السلوك يصنف علمياً كـ","A":"أ) طاعة عمياء لسلطة قهرية","B":"ب) امتثال مدفوع بـ \"التأثير المعلوماتي\" (الرغبة في الصواب عند الغموض)","C":"ج) تأثير معياري للبحث عن القبول الاجتماعي المتبادل","D":"د) انقياد ناتج عن غسيل دماغ خوارزمي في غرف الصدى","answer":"B","topic_question_no":1},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"يمتنع شاب عن ارتداء ملابس غريبة الأطوار في حفل زفاف تقليدي، رغم حبه الشديد لهذا النوع من الملابس، وذلك فقط ليتجنب نظرات الاستهجان والسخرية من الحاضرين وينال استحسانهم. الدافع الحقيقي خلف امتثال هذا الشاب هو","A":"أ) التأثير المعلوماتي الذي منحه دليلاً على الصواب","B":"ب) السلطة الجنائية والقانونية المنظمة للحفل","C":"ج) التأثير المعياري (الرغبة في التوافق وتجنب الرفض)","D":"د) التفكير النقدي الرقمي وقاعدة التوقف الانفعالي","answer":"C","topic_question_no":2},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"الفرق الجوهري الذي يفصل مفهوم \"الامتثال\" عن مفهوم \"الطاعة\" في ديناميكيات التأثير الاجتماعي، هو أن \"الامتثال\" يحدث استجابة لـ ()، بينما تحدث \"الطاعة\" استجابة لـ ()","A":"أ) أمر مباشر من سلطة أعلى / ضغط أفقي من أقران يساوونك في المكانة","B":"ب) رغبة في الابتكار الإبداعي / قواعد غير مكتوبة للثقافة","C":"ج) ضغط اجتماعي (حقيقي/متخيل) لتطابق المعايير دون أمر صريح / توجيه رأسي صريح من سلطة تمتلك قوة العقاب أو النظام","D":"د) تأثير اللاشعور والغرائز المكبوتة / التحيز التأكيدي للمعلومات","answer":"C","topic_question_no":3},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تُشكل \"جماعة الأقران\" قوة هائلة في صياغة هوية المراهق واستقلاليته. ويؤكد علماء النفس أن السر البيولوجي وراء خضوع الشاب لسطوة الأقران بقوة يرجع إلى أن","A":"أ) الأقران يمتلكون سلطة منح الدرجات الأكاديمية في المدرسة","B":"ب) الدماغ البشري يترجم \"رفض الأقران ونبذهم\" كألم نفسي يعادل ألم الإصابة الجسدية الفعلية","C":"ج) الأقران يعتمدون على التأثير المعلوماتي المبني على الحقائق العلمية دائماً","D":"د) التفاعل معهم يخلو من أي مشاعر عاطفية أو وجدانية ويقتصر على المعرفة","answer":"B","topic_question_no":4},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تتصفح إحدى المنصات الرقمية فتجد إعلاناً لمنتج عادي جداً، ولكن ما لفت انتباهك هو وجود \"مليون إعجاب ومائة ألف مشاركة\" تحت الإعلان، فشعرت فجأة برغبة في شرائه لا شعورياً لاعتقادك أن \"كل هؤلاء الناس لا يمكن أن يخطئوا\". الإستراتيجية النفسية المستخدمة لإقناعك هنا هي","A":"أ) الندرة والاستعجال","B":"ب) السلطة والخبرة العلمية","C":"ج) التخصيص الخوارزمي الموجه","D":"د) الدليل الاجتماعي (الكثرة الوهمية)","answer":"D","topic_question_no":5},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"عبارات تومض باللون الأحمر على شاشة الحجز الإلكتروني مثل: \"الفرصة الأخيرة! تبقى مقعدان فقط وينتهي العرض خلال 5 دقائق!\". تعتمد هذه المنصات على أسلوب الإقناع بالندرة والاستعجال بهدف مباشر وهو","A":"أ) بناء دليل اجتماعي على مصداقية المنصة","B":"ب) منح المستهلك وقتاً أطول للتفكير النقدي والمقارنة","C":"ج) إثارة قلق التفويت (FOMO) لتعطيل المنطق ودفع الفرد لقرار انفعالي مندفع","D":"د) تعزيز الحضور الضمني للقيم المجتمعية الأصيلة","answer":"D","topic_question_no":6},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"\"غرف الصدى (Echo Chambers)\" هي إحدى أخطر الآليات التي تدمر العقل في الفضاء الرقمي، حيث تقوم الخوارزميات فيها بوظيفة خفية تتمثل في","A":"أ) حصر المستخدم في دوامة من المحتوى الذي يوافق آراءه المسبقة فقط، مما يمنع تعرضه لآراء متباينة ويرسخ التعصب الأعمى","B":"ب) تعريض المستخدم باستمرار لآراء المعارضة لاستفزازه وتطوير مرونته النفسية","C":"ج) كشف زيف المعلومات المضللة وتزويد المستخدم بالحقائق والأرقام الموثقة","D":"د) دفع المستخدم لممارسة القراءة المتقاطعة من مصادر محايدة لتقليل التحيز","answer":"A","topic_question_no":7},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تشير الدراسات إلى أن \"الأخبار المزيفة والمضللة\" تنتشر بسرعة النيران في الهشيم مقارنة بالحقائق المملة. الآلية النفسية والعصبية الأولى التي تقف خلف هذا الانتشار المرعب هي","A":"أ) الفلترة الذهنية المعقدة للمحتوى قبل النشر","B":"ب) الاستثارة العاطفية الفائقة (مخاطبة الغضب أو الخوف لتعطيل القشرة المخية المنطقية ودفع الفرد للمشاركة الفورية)","C":"ج) الاعتماد على البحث الأفقي وتعدد المصادر لتأكيد الخبر","D":"د) غياب أي تفاعل وجداني أو عاطفي في صياغة الشائعات","answer":"B","topic_question_no":8},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"كثرة تكرار ظهور كذبة معينة أو شائعة سخيفة من عدة حسابات مختلفة في نفس اليوم، تجعل العقل البشري يميل لا شعورياً لتصديقها وتقبلها مع مرور الوقت. تُعرف هذه الظاهرة النفسية المعرفية بـ","A":"أ) أثر الألفة ووهم الحقيقة (كثرة التكرار تجعل الكذب مألوفاً)","B":"ب) التوقف الانفعالي وفصل العاطفة عن الدليل","C":"ج) التفكير النقدي الرقمي لتفنيد الشائعات","D":"د) تأثير التأثير المعلوماتي في المواقف الواضحة تماماً","answer":"A","topic_question_no":9},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"الخطوة الأولى والأهم في درع \"التفكير النقدي الرقمي\" لحماية الوعي من الاستفزاز والخداع هي تطبيق (قاعدة العشر ثوانٍ). وتعني هذه القاعدة عملياً ما يلي","A":"أ) قراءة الخبر كاملاً في عشر ثوانٍ ثم مشاركته لدعم الدليل الاجتماعي","B":"ب) التوقف الانفعالي فوراً وفصل العاطفة وعدم المشاركة المندفعة لأي خبر يستفز الغضب أو الخوف قبل التفكير","C":"ج) التأكد من عدد الإعجابات التي حصدها الخبر خلال أول عشر ثوانٍ من نشره","D":"د) البحث عن المستفيد المادي من الإعلان خلال فترة زمنية قصيرة لضمان سرعة الاستجابة","answer":"B","topic_question_no":10},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"سائح أجنبي يسير في شوارع القاهرة لأول مرة، ولاحظ أن الناس يتوقفون فجأة وينظرون جميعاً في اتجاه واحد نحو السماء. رغم عدم فهمه لما يحدث، توقف السائح ونظر معهم إلى السماء، معتقداً أن هؤلاء المحليين يمتلكون فكرة عما يجري وأنه من الصواب تقليدهم. هذا التغير التلقائي في سلوكه يرجع إلى","A":"أ) التأثير المعياري للبحث عن القبول.","B":"ب) التأثير المعلوماتي (الدافع المعرفي الفطري للبحث عن الصواب في المواقف الغامضة).","C":"ج) الطاعة العمياء لرجال إنفاذ القانون.","D":"د) تأثير الهالة الإيجابية للمارة.","answer":"B","topic_question_no":11},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"في أول أيام عمله، لاحظ موظف جديد أن جميع زملائه في القسم يستخدمون مصطلحات أجنبية معينة أثناء حديثهم رغم أن لغتهم الأم العربية. ورغم كراهيته لهذا الأسلوب، بدأ في استخدام نفس المصطلحات تجنباً لسخريتهم ولضمان اندماجه في فريقهم. يُفسر هذا السلوك في علم النفس بـ","A":"أ) التأثير المعلوماتي الذي يمنحه دليلاً معرفياً.","B":"ب) الطاعة القانونية والأخلاقية لقواعد المؤسسة.","C":"ج) الامتثال الناتج عن \"التأثير المعياري\" (الرغبة في التوافق وتجنب الرفض).","D":"د) التفكير النقدي الرقمي وتفكيك المصالح.","answer":"C","topic_question_no":12},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"\"عندما تمتثل، فأنت تتأثر بضغط أفقي من أقران يساوونك في المكانة. وعندما تطيع، فأنت تتأثر بتوجيه رأسي من سلطة تمتلك حق العقاب\". هذا التمييز الجوهري يوضح أن الامتثال غالباً ما يكون ، بينما الطاعة غالباً ما تكون","A":"أ) بأمر صريح ومباشر / استجابة لضغط اجتماعي غير مرئي.","B":"ب) استجابة لضغط اجتماعي حقيقي أو متخيل دون أمر صريح / تنفيذاً لتعليمات مباشرة صادرة عن جهة عليا.","C":"ج) للتهرب من القوانين الأخلاقية / للبحث عن القبول الاجتماعي المتبادل.","D":"د) نابعاً من اللوزة الدماغية السريعة / نابعاً من القشرة المخية المنطقية.","answer":"B","topic_question_no":13},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"دراسة سيكولوجية أثبتت أن استبعاد الشاب من مجموعة أصدقائه على منصات التواصل يؤدي إلى إضاءة مراكز الألم في الدماغ تماماً كما يحدث عند تعرضه لحرق في يده. يفسر هذا الاكتشاف البيولوجي لماذا تمتلك \"جماعة الأقران\" سطوة هائلة تجعل المراهق","A":"أ) يمتثل لمعايير الأقران حتى ولو كانت خاطئة (صحبة الهدم) لتجنب ألم العزلة والنبذ.","B":"ب) يميل للطاعة العمياء للقوانين المرورية والمدنية في بلده.","C":"ج) يستخدم \"التوقف الانفعالي\" قبل الموافقة على آراء المجموعة.","D":"د) يتجاهل الدليل الاجتماعي ويتبع السلطة والخبرة الحقيقية فقط.","answer":"A","topic_question_no":14},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تضع بعض المواقع الإلكترونية عداداً يظهر للمتسوق أن \"500 شخص يشاهدون هذه السلعة الآن، و10 ألف قاموا بشرائها اليوم\". الهدف النفسي الخفي (الخوارزمي) من هذا العداد هو شل تفكير المتسوق المنطقي وإقناعه من خلال الاعتماد على استراتيجية","A":"أ) التخصيص الخوارزمي الموجه للفرد.","B":"ب) السلطة المعنوية للمشاهير.","C":"ج) الدليل الاجتماعي (الكثرة الوهمية لإيهام الفرد بتوافق الأغلبية).","D":"د) القراءة المتقاطعة وتعدد المصادر.","answer":"C","topic_question_no":15},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"يتصفح شاب هاتفه في منتصف الليل، فيجد إعلاناً لدورة تدريبية بسعر مخفض، مع ملاحظة تومض باللون الأحمر: \"يُغلق التسجيل بعد 3 دقائق للأبد!\". فشعر بتوتر شديد وقام بالدفع الفوري ببطاقته الائتمانية دون التأكد من جودة الدورة. الاستراتيجية التي نـجحت في اختطاف عقله هنا تُسمى","A":"أ) الندرة والاستعجال لإثارة قلق التفويت (FOMO) ودفع الفرد لقرار مندفع.","B":"ب) التأثير المعياري ومسايرة القطيع لتجنب رفض المنصة.","C":"ج) الدليل الاجتماعي المستند على أرقام المشاهدات العالية.","D":"د) التمييز بين الحقيقة والرأي في المحتوى الإعلاني.","answer":"A","topic_question_no":16},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"الخوارزميات الرقمية الحديثة لا تعرض لك كل شيء، بل تدرس تفضيلاتك السابقة لتعرض لك فقط ما يتوافق مع آرائك السياسية أو الرياضية وتحجب الرأي المعارض تماماً. هذه التقنية التكنولوجية تخلق ظاهرة نفسية كارثية على الوعي تُعرف بـ","A":"أ) أثر الألفة ووهم الحقيقة.","B":"ب) التفكير النقدي الرقمي المحايد.","C":"ج) الاستثارة العاطفية الفائقة المريحة للدماغ.","D":"د) غرف الصدى (Echo Chambers) التي تعزل الفرد وترسخ التعصب.","answer":"D","topic_question_no":17},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"لماذا تنتشر شائعة مرعبة حول \"تلوث مياه الشرب\" في غضون دقائق، بينما لا يشارك أحد التقرير الرسمي الممل الذي يثبت نقاء المياه؟ التفسير الفسيولوجي العصبي لذلك يكمن في أن","A":"أ) الشائعات تُصاغ بلغة هادئة ومنطقية تخاطب القشرة المخية للباحثين.","B":"ب) الاستثارة العاطفية الفائقة (الخوف والذعر) توقف عمل القشرة المخية المنطقية عن التحليل وتدفع للمشاركة الفورية المندفعة.","C":"ج) التقارير الرسمية تعتمد على تأثير الهالة السلبية الذي ينفر المتابعين.","D":"د) الدليل الاجتماعي يعمل فقط في المواقف التي تتطلب طاعة قانونية.","answer":"B","topic_question_no":18},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"\"الميل النفسي الخطير لسرعة تصديق أي خبر أو فيديو يوافق أهواءنا ومخاوفنا السابقة دون أي تدقيق، مع الاستماتة في رفض وتكذيب الحقائق الساطعة والمدعمة بالأدلة إذا خالفت هوانا\". هذا التعريف يجسد آلية التضليل المعتمدة على","A":"أ) التحيز التأكيدي.","B":"ب) غرف الصدى الرقمية.","C":"ج) أثر الألفة ووهم الحقيقة.","D":"د) التأثير المعلوماتي التلقائي.","answer":"A","topic_question_no":19},{"exam_id":"U6-T2","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"إذا شاهدت شائعة تافهة جداً وكذبتها في البداية، لكنك استمررت في رؤيتها تُنشر من عشرات الحسابات المختلفة يومياً لمدة شهر، فإن عقلك قد يميل لا شعورياً مع الوقت لاعتبارها \"معلومة حقيقية\". تُفسر هذه الظاهرة في علم النفس بـ","A":"أ) قاعدة التوقف الانفعالي الطويل.","B":"ب) أثر الألفة ووهم الحقيقة (كثرة التكرار تخلق وهماً بصحتها).","C":"ج) التمييز الدقيق بين الحقيقة (المدعمة بالأرقام) والرأي الشخصي.","D":"د) تأثير القراءة المتقاطعة من مصادر محايدة.","answer":"B","topic_question_no":20}],"U6-T3":[{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"المراهق الذي ينشأ في أسرة تقدر تراثها ووطنها، يطور شعوراً عميقاً بكلمة \"نحن\"، ويمتلك إجابة واضحة عن سؤال \"إلى أي مجتمع وثقافة أنتمي؟\". يُمثل هذا الجانب في علم نفس النمو مفهوم","A":"الهوية الفردية والبصمة الشخصية المستقلة","B":"الهوية الاجتماعية (جذور الانتماء)","C":"البصمة الرقمية والواجهة المفلترة","D":"التأثير المعلوماتي التلقائي","answer":"B","topic_question_no":1},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"يعتقد بعض الآباء خطأ أن تشبث أبنائهم بالعادات الثقافية الوطنية القديمة سيمنعهم من اكتساب المهارات الحديثة والإبداع الفردي في مجالات البرمجة أو الفنون. الرد العلمي على هذا الاعتقاد يكمن في إثبات حقيقة \"التكامل الديناميكي\"، والذي ينص على أن","A":"أ) الهوية الفردية تتطلب بالضرورة ذوبان الشاب في مجتمعات افتراضية أجنبية للتخلص من التخلف الثقافي","B":"ب) اعتزاز الشاب بهويته الثقافية يمنحه أرضية صلبة وأماناً وجدانياً يعزز ثقته لتطوير بصمته الفردية وإبداعه دون صراع أو اغتراب","C":"ج) الإبداع الفردي لا يمكن أن ينمو إلا بالتمرد الكامل على ثقافة المجتمع الأصلي والانعزال عنه","D":"د) الهوية الاجتماعية تلغي الفروق الفردية تماماً لصالح الأغلبية","answer":"B","topic_question_no":2},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"\"الحاجة إلى الانتماء\" ليست مجرد رغبة تكميلية، بل هي حاجة فطرية ونفسية أولية. من أخطر العواقب النفسية التي تصيب الشاب الذي يفشل في تحقيق أي شكل من أشكال الانتماء الإيجابي (سواء للأسرة أو الأصدقاء أو الفرق الرياضية)","A":"أ) اكتمال بناء الهوية الاجتماعية والاعتماد التام على الذكاء الشخصي","B":"ب) انخفاض حاد في التقدير الذاتي، والشعور بالعزلة القاتلة، والاغتراب الاجتماعي الذي قد يدفعه للانحراف","C":"ج) الوصول السريع إلى حالة (التدفق Flow) في أي مهارة يمارسها بمفرده","D":"د) تطور مذهل في قدرات التفكير التباعدي والإبداع بسبب الهدوء","answer":"B","topic_question_no":3},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"مجموعة افتراضية مغلقة على الإنترنت تدعو أعضاءها للتنمر على زملائهم من المدارس الأخرى، وتعتبر أن أي فرد ينتقد أفعالهم هو خائن يجب إقصاؤه. يوفر هذا الكيان للمراهقين إحساساً بالانتماء، ولكنه يُصنف علمياً بأنه","A":"أ) تطبيق عملي لاستراتيجية \"المرونة النفسية\" في مواجهة الضغوط المدرسية","B":"ب) انتماء سلبي تعصبي يمثل أداة هشاشة وتعبية عمياء تلغي إعمال العقل وتغذي الكراهية","C":"ج) تكامل ديناميكي بين الهوية والفردية","D":"د) انتماء إيجابي بناء يعتمد على التكافل المجتمعي","answer":"B","topic_question_no":4},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"تُتيح أدوات تصفية الصور (الفالتر) والذكاء الاصطناعي للمراهق تصميم \"ذات افتراضية\" خالية تماماً من عيوبه الجسدية وحياته البسيطة. الخطر النفسي المدمر (صراع الهوية) يبدأ عندما","A":"أ) ينـجح المراهق في تحويل هذه الذات الافتراضية إلى مصدر للإلهام والتعليم الذاتي","B":"ب) يطبق المراهق مهارة \"التطابق والشفافية\" لحماية البصمة الرقمية للمجتمع","C":"ج) يقتنع المراهق بأن واجهته الافتراضية أصبحت حقيقته، وتتسع الفجوة بينها وبين ذاته الواقعية المليئة بالعيوب، مما يصيبه بالاغتراب والخوف من مواجهة الناس لئلا تُكشف حقيقته","D":"د) تتطابق هذه الذات الافتراضية تماماً مع الذات الواقعية في كل التفاصيل","answer":"C","topic_question_no":5},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"\"ربط القيمة الإنسانية وثقة الشاب بنفسه بـ (عداد الإعجابات) ومعدل التفاعل اللحظي على منشوراته\". هذه الآلية الخبيثة التي تعتمد على استغلال هرمون (الدوبامين) تؤدي بالمراهق إلى حالة من","A":"أ) الاستقلالية في اتخاذ القرارات بعيداً عن ضغط الأقران والمجتمع","B":"ب) الكفاءة الاجتماعية والقدرة على بناء علاقات دافئة ومستقرة في الحياة الواقعية","C":"ج) الصلابة النفسية العميقة التي تحميه من التنمر وتجاهل الآخرين له","D":"د) الهشاشة الرقمية، حيث يصبح مسلوب الإرادة، ترتفع معنوياته بضغطة زر وتنهار حياته إذا تم تجاهله رقمياً","answer":"D","topic_question_no":6},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"فتاة بسيطة تتابع يومياً حسابات لعارضات أزياء يعشن في قصور فارهة ويقضين أوقاتهن في رحلات باهظة التكاليف حول العالم. النتيجة النفسية لهذه المتابعة المستمرة هي شعور الفتاة الدائم بالتعاسة والنقص والتمرد على أهلها. هذا التأثير السلبي يُعرف في نظرية \"ليون فيستنـجر\" بـ","A":"الدليل الاجتماعي الإيجابي للتحفيز المادي","B":"المقارنة الاجتماعية الهابطة لزيادة الغرور","C":"المقارنة الاجتماعية الصاعدة (النظر للأفضل حالاً باستمرار مما يولد الإحباط)","D":"التفريد المعرفي والتعلم المستقل من تجارب الآخرين","answer":"C","topic_question_no":7},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"من أكثر الأخطاء الإدراكية فداحة في عصر السوشيال ميديا ظاهرة \"خداع المقارنة\". يقع الشاب في هذا الخداع السيكولوجي القاسي عندما يقوم بـ","A":"أ) مقارنة المكون الوجداني لاتجاهاته بالمكون المعرفي للأحداث السياسية المحيطة به","B":"ب) مقارنة قدراته الحركية والرياضية بقدرات زملائه ذوي الذكاء اللغوي لتحديد التخصص الجامعي","C":"ج) مقارنة كواليس حياته الواقعية المليئة بالجهد والملل والإخفاقات، بالواجهة المثالية المبرمجة للآخرين والتي صُممت لإخفاء تعبهم وعرض لحظات النـجاح فقط","D":"د) مقارنة إنـجازاته اليوم بإنـجازاته في العام الماضي لقياس مدى تقدمه (المقارنة الطولية السوية)","answer":"C","topic_question_no":8},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"لبناء هوية راسخة ومستقرة في خضم العواصف الرقمية، يقترح علم النفس تطبيق قاعدة \"التطابق والشفافية\". التطبيق العملي والصحي لهذه القاعدة يتمثل في أن يمتلك الفرد شجاعة","A":"أ) تقليد أنماط حياة المشاهير بمهارة فائقة ليثبت قدرته على الاندماج في الثقافة العالمية الحديثة","B":"ب) الانعزال التام عن أي تفاعل رقمي وإلغاء جميع حساباته الافتراضية هرباً من المقارنة","C":"ج) إنشاء حسابات وهمية متعددة ليعبر عن آراء مختلفة دون أن يُحاسب على أي منها","D":"د) إلغاء المسافة الشاسعة بين الواقع والشاشة بالصدق التام، وعدم ادعاء مثالية مزيفة أو ارتداء أقنعة لحصد إعجابات لا تمثل حقيقته الفعلية","answer":"D","topic_question_no":9},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"عند تحليل \"صراع الهوية والمبادئ\" الذي يواجهه المراهق بين تأثير الأقران السلبيين وبين توجيهات أسرته، فإن المهارة النفسية الحاسمة (الصلابة النفسية) تتجلى عندما يمتلك المراهق القدرة والجرأة على","A":"أ) الطاعة العمياء لآراء زعيم الشلة (القائد المباشر) لتجنب العزلة","B":"ب) استخدام التخفي الرقمي لممارسة السلوكيات الخاطئة دون علم أسرته لتقليل الصدام","C":"ج) تقديم تبريرات منطقية لأسرته ليسمحوا له بمسايرة القطيع مؤقتاً","D":"د) قول \"لا\" والتمسك بمبادئه ورفض مسايرة القطيع المفسد رغم التهديد بالنبذ","answer":"D","topic_question_no":10},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"أي شق من الهوية يجيب بصورة أساسية عن سؤال «ما الذي يميزني كإنسان؟»؟","A":"الهوية الاجتماعية المرتبطة بالجماعة والثقافة","B":"الهوية الفردية التي تعبر عن خصائص الشخص ومهاراته المميزة","C":"البصمة الرقمية الناتجة عن استخدام الإنترنت","D":"التأثير المعياري الذي تمارسه الجماعة","answer":"B","topic_question_no":11},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"ما النتيجة النفسية المتوقعة عندما يجمع الشاب بين اعتزازه بثقافته واستقلاله في التفكير والإبداع؟","A":"يتحول الانتماء بالضرورة إلى تعصب","B":"يفقد قدرته على تكوين هوية فردية","C":"يحصل على أرضية من الأمان والانتماء تساعده على تطوير هويته الفردية","D":"يصبح غير قادر على التفاعل مع الثقافات الأخرى","answer":"C","topic_question_no":12},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"أي موقف يمثل انتماءً إيجابيًا صحيًا؟","A":"الطاعة العمياء للجماعة ورفض كل رأي مخالف","B":"الاعتزاز بالجماعة مع احترام الآخرين والعمل لتحقيق هدف مشترك","C":"إقصاء المختلف لحماية هوية الجماعة","D":"ربط قيمة الفرد بالكامل بقبول أعضاء الجماعة له","answer":"B","topic_question_no":13},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"فشل المراهق المستمر في تكوين انتماء إيجابي قد يرتبط أكثر بـ:","A":"ارتفاع التقدير الذاتي تلقائياً","B":"العزلة والاغتراب وانخفاض التقدير الذاتي","C":"زيادة الاستقلالية دون أي ضغوط","D":"اختفاء الحاجة إلى العلاقات الاجتماعية","answer":"B","topic_question_no":14},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"ما الفرق الأساسي بين الهوية الفردية والهوية الاجتماعية؟","A":"الفردية تتعلق بما يميز الشخص، والاجتماعية تتعلق بإحساسه بالانتماء إلى جماعات وثقافات","B":"الفردية رقمية والاجتماعية بيولوجية","C":"الفردية ثابتة تماماً والاجتماعية مؤقتة دائماً","D":"لا يوجد فرق بينهما","answer":"A","topic_question_no":15},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"أي سلوك يدل على تكامل الهوية بدل الصراع بينها؟","A":"رفض الثقافة المحلية لإثبات الاستقلال","B":"تقليد الجماعة في كل شيء","C":"الاعتزاز بالهوية الثقافية مع تطوير مهارات واهتمامات شخصية","D":"إخفاء الخصائص الشخصية حتى لا يختلف الفرد عن الجماعة","answer":"C","topic_question_no":16},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"عندما يرفض الطالب ضغط جماعته لإقصاء زميل مختلف ويحافظ في الوقت نفسه على علاقته الصحية بالجماعة، فهو يطبق:","A":"الانتماء التعصبي","B":"الاستقلالية الواعية داخل الجماعة","C":"الامتثال الأعمى","D":"النبذ الاجتماعي","answer":"B","topic_question_no":17},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"الهوية الراسخة تساعد الفرد على مواجهة الضغوط الرقمية لأنها:","A":"تلغي الحاجة إلى الآخرين","B":"تربط قيمته بالكامل بعدد الإعجابات","C":"توفر أساساً واضحاً للذات والقيم والانتماء","D":"تمنعه من استخدام التكنولوجيا","answer":"C","topic_question_no":18},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"أي ممارسة تساعد المراهق على بناء هوية متوازنة؟","A":"مقارنة نفسه يومياً بحياة المشاهير","B":"قبول كل ما تقترحه المجموعة دون تفكير","C":"التعرف إلى قيمه وقدراته مع الحفاظ على انتماء صحي","D":"إنشاء صورة افتراضية تخفي شخصيته الواقعية","answer":"C","topic_question_no":19},{"exam_id":"U6-T3","unit":6,"topic":"هويتي وانتمائي","question":"الانتماء الصحي لا يعني ذوبان الفرد في الجماعة، بل يعني:","A":"إلغاء الاستقلالية","B":"المشاركة مع الاحتفاظ بالوعي بالذات والمسؤولية","C":"رفض كل قواعد الجماعة","D":"مسايرة الآخرين خوفاً من الرفض","answer":"B","topic_question_no":20}],"U6-T4":[{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"تفتقر بيئة التواصل الرقمي (الدردشات النصية) إلى \"الإشارات غير اللفظية\" التي نعتمد عليها في التواصل المباشر (مثل لغة الجسد، نظرة العين، ونبرة الصوت). هذا النقص الجوهري في بيئة الإنترنت يؤدي غالباً إلى","A":"أ) نقل المعاني والمشاعر بوضوح ودقة متناهية لا تقبل التأويل","B":"ب) تكرار سوء الفهم بين المستخدمين وتفسير الكلمات أو الرموز الجامدة بمحمل عدائي وخاطئ","C":"ج) زيادة مستوى التعاطف الوجداني العميق وتبادل المشاعر الصادقة بعيداً عن التشويش المادي","D":"د) تعزيز مهارات التواصل الفعال وتقليل الحاجة إلى مهارة الاستماع الجيد","answer":"B","topic_question_no":1},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"يفرض التواجد المباشر (وجهاً لوجه) في المجتمع الواقعي التزاماً بالمعايير الأخلاقية خوفاً من المساءلة أو الإحراج. أما في الفضاء الرقمي، فإن إمكانية التخفي وراء الحسابات الوهمية تسهل على الفرد الإساءة للآخرين بلا رادع. تُعرف هذه الظاهرة النفسية الخطيرة بـ","A":"أ) الانفصال الاستراتيجي الواعي من ضغوط العمل لتنظيف الجهاز العصبي","B":"ب) فك الارتباط الأخلاقي والتحلل من الرقابة بسبب التخفي وانعدام المواجهة المباشرة","C":"ج) التفريد المعرفي الذي يتيح للفرد اختبار قدراته بعيداً عن أقرانه","D":"د) الاستقلالية الكاملة للهوية الفردية وتصالح الذات الداخلي بمعزل عن القوانين","answer":"B","topic_question_no":2},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"من أبرز الخصائص التي تجعل التنمر أو الإساءة في الفضاء الافتراضي أشد قسوة وتدميراً من الإساءة في الواقع الميداني، أن السلوك الرقمي يبتسم بـ:","A":"أ) ينتهي أثره النفسي المزعج بمجرد انصراف الحاضرين أو انتهاء النقاش اللفظي في نفس اللحظة.","B":"ب) يخترق الحدود المكانية والزمانية، فالمنشور يصل للملايين بسرعة فائقة ويظل محفوظاً لسنوات (البصمة الدائمة).","C":"ج) يكون دائماً مدعوماً بتغذية راجعة فورية ورؤية واضحة لألم الضحية مما يوقف المتنمر فوراً.","D":"د) يعتمد كلياً على الإشارات غير اللفظية ولغة الجسد لتوصيل الإهانة بشكل غير مباشر ومهذب.","answer":"B","topic_question_no":3},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"شخص يقوم باستخدام منصات التواصل الاجتماعي باحترافية لتسويق منتجات يدوية محلية، ونشر ثقافة بلده الإيجابية للعالم، وإبراز قصص نـجـاح ذوي الإعاقات كشركاء تميز في مجتمعه. يعكس هذا الاستخدام الموجه للإنترنت الجانب الذي يوصف بـ:","A":"أ) المشرق والإيجابي (توظيف الأداة الجبارة لتعزيز الهوية ونشر المبادرات المجتمعية الإيجابية).","B":"ب) المظلم والسلبي (إعادة هندسة الذات المفلترة والتبعية العمياء للقطيع).","C":"ج) التعصبي الإقصائي (نبذ الآخر وتغذية الصراعات الثقافية).","D":"د) التخديري الاستهلاكي (الهروب من مواجهة الواقع عبر التصفح اللانهائي للترفيه).","answer":"A","topic_question_no":4},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"يعرّف علم النفس \"التنمر الرقمي\" بأنه سلوك عدواني، مقصود، ومتكرر عبر الوسائط لإيذاء وإحراج فرد لا يستطيع الدفاع عن نفسه. عند تحليل دوافع المتنمر، نـجد أنه لا يقوم بذلك لامتلاكه قوة حقيقية، بل غالباً لسعيه المريض خلف:","A":"أ) تطوير كفاءته الاجتماعية وبناء علاقات دافئة ومستدامة.","B":"ب) المكانة والشعبية الزائفة، أو الخضوع لضغط الأقران لتجنب نبذه، وإسقاط إحباطاته الشخصية كحيلة دفاعية.","C":"ج) تحقيق الرضا عن الهوية الشخصية والوصول لقمة الازدهار في خماسية سليجمان (PERMA).","D":"د) تعميق الفهم لرسائل التواصل الفعال وتطبيق مبدأ الاحترام المتبادل للاختلاف.","answer":"B","topic_question_no":5},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"من أشكال التنمر الرقمي الخبيثة التي تهدف إلى زيادة عزلة الضحية وتدمير شعورها بالانتماء، تعمد مجموعة من الطلاب طرد زميل لهم من المجموعات الدراسية الافتراضية (الجروبات) بشكل متكرر ومهين. يسمى هذا الشكل بـ:","A":"أ) التحرش اللفظي والصور التعبيرية الساخرة المباشرة.","B":"ب) الإقصاء والنبذ الافتراضي العمدي من المجموعات لفرض العزلة وتطبيق العقاب النفسي.","C":"ج) التشهير واختلاق الشائعات وتزييف الصور لتدمير السمعة المجتمعية.","D":"د) كسر الفقاعة الرقمية الموجه لفتح آفاق الحوار الإجباري وتقليل التحيز التأكيدي.","answer":"B","topic_question_no":6},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"طالب يتعرض لتهديد وابتزاز صريح من حساب مجهول يطالبه بتصرفات غير أخلاقية. درع الصلابة الرقمية ينصح بخطوات حاسمة للمواجهة. تتمثل الخطوة الأهم والأولى لعدم إعطاء المتنمر ما يريده في:","A":"أ) الدخول في حوار طويل ومحاولة استعطافه لتعديل بنيته المعرفية وإيقاظ ضميره.","B":"ب) التجاهل التام وعدم التغذية للانفعال (لأن المتنمر يتغذى على رؤية غضبك وضعفك).","C":"ج) حذف الحساب الشخصي للضحية فوراً ومحاولة إخفاء أي دليل لتجنب الفضيحة الاجتماعية.","D":"د) الرد بتهديد مماثل واستخدام صور مزيفة لإخافة المتنمر وإجباره على التراجع السريع.","answer":"B","topic_question_no":7},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"بعد تجاهل المتنمر، يجب على الضحية اتخاذ خطوة قانونية وميدانية حاسمة لمنع تمادي الإساءة، وتتمثل هذه الخطوة التوثيقية في:","A":"أ) أخذ لقطات شاشة (Screenshots) توثق التهديد كدليل قانوني ثابت، ثم حظر الحساب (البلوك) فوراً والإبلاغ.","B":"ب) نشر التهديد على الصفحة العامة ليقوم المتابعون بالرد على المتنمر وتطبيق الدليل الاجتماعي ضده.","C":"ج) استخدام الحيل الدفاعية كالتبرير النفسي لإقناع الذات بأن المتنمر يمزح ولا يقصد الإيذاء الفعلي.","D":"د) الخضوع المؤقت لمطالب المتنمر لكسب الوقت حتى يتدخل الخبراء في الأمن السيبراني.","answer":"A","topic_question_no":8},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"الإدمان الرقمي (الاستخدام القهري للشاشات) يشكل خطراً فسيولوجياً يبرمج الدماغ عبر إفراز مستمر لهرمون \"الدوبامين\". من أبرز الأعراض الجسدية المباشرة لهذا الإدمان التي تؤثر على جودة الحياة البيولوجية:","A":"أ) العزلة الانطوائية الشديدة داخل الأسرة وتراجع الاهتمام بالمشاركة في الأنشطة العائلية الجماعية.","B":"ب) الفشل المتكرر في تقليل ساعات التصفح، والتوتر والعصبية الشديدة كأعراض انسحابية نفسية عند انقطاع الإنترنت.","C":"ج) أرق مزمن ناتج عن منع الضوء الأزرق لإفراز هرمون النوم الطبيعي، إجهاد العين الحاد، وآلام العمود الفقري.","D":"د) الانهيار الملحوظ في جودة الأداء المدرسي وإهمال الواجبات المدرسية والمشاريع العلمية.","answer":"C","topic_question_no":9},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"يقترح الخبراء \"بروتوكول الانقطاع الرقمي\" كخطة تعافي من الإدمان. إحدى الخطوات الاستراتيجية الفعالة في هذا البروتوكول هي \"خلق مناطق خالية من الشاشات (حرم مقدس)\". الهدف التربوي والنفسي من هذه الخطوة تحديداً هو:","A":"أ) توفير بيئة هادئة لإجبار الدماغ على استخدام التفكير التباعدي المعقد لحل المشكلات طوال فترة التواجد بها.","B":"ب) إجبار الأسرة على النقاشات الحادة لتفريغ شحنات الغضب المكبوتة نتيجة ضغوط العمل والدراسة.","C":"ج) حماية الأوقات المخصصة للروابط العائلية الحقيقية (كطاولة الطعام) والراحة الجسدية العميقة (كغرفة النوم) من التشتت والاستنزاف الرقمي.","D":"د) قياس حجم الساعات الضائعة بدقة عبر استخدام تطبيقات المراقبة والمحاسبة الذاتية الصارمة.","answer":"C","topic_question_no":10},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"عندما يحدث خلاف بين صديقين \"وجهاً لوجه\"، يمكنهما قراءة ملامح بعضهما وملاحظة حزن الطرف الآخر وتدارك الموقف بلغة الجسد والنبرة الهادئة. في المقابل، تشتعل الخلافات وتصل للقطيعة في \"الدردشات النصية الرقمية\" بسرعة مرعبة بسبب","A":"أ) التدخل السريع لخوارزميات التطبيقات لحل النزاعات بين المستخدمين بطريقة الدليل الاجتماعي","B":"ب) ارتفاع مستوى \"الذكاء الوجداني الرقمي\" الذي يجعل الأصدقاء يبالغون في حساسيتهم تجاه بعضهم البعض لدرجة الانفصال","C":"ج) غياب \"الإشارات غير اللفظية\" (كالنبرة والملامح)، مما يجعل النصوص جامدة وعُرضة للتفسير السيء وبمحمل عدائي خاطئ دائماً","D":"د) وضوح الرسائل وتحديد الأهداف المشتركة بدقة متناهية في النصوص","answer":"C","topic_question_no":11},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"طالب يتميز بالأدب الشديد واحترام معلميه داخل الفصل الدراسي، ولكنه يستخدم حساباً وهمياً بلقب مستعار لشتم نفس المعلمين والسخرية منهم بأقذع الألفاظ على الإنترنت. يُطلق علم النفس على هذه الظاهرة الخطيرة (الناتجة عن التخفي الرقمي) مصطلح","A":"أ) التكامل الديناميكي بين الذات الواقعية المنضبطة والذات الافتراضية المتمردة لحفظ التوازن النفسي","B":"ب) الاستقلالية والهوية الفردية التي ترفض القيود المعيارية لثقافة المؤسسات التعليمية القمعية","C":"ج) فك الارتباط الأخلاقي والتحلل التام من الرقابة والضوابط المجتمعية لغياب المواجهة المباشرة والمحاسبة","D":"د) التفريد المعرفي الإبداعي والتفكير التباعدي غير المحدود","answer":"C","topic_question_no":12},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"إذا قام شخص بالاعتداء اللفظي على آخر في الشارع، فإن أثر الإهانة ينحصر في الحاضرين وينتهي بانصرافهم. لكن الإهانة أو التنمر في الفضاء الرقمي أشد قسوة وفتكاً بنفسية الضحية لأن السلوك الرقمي يتميز بـ","A":"أ) اعتماده كلياً على الإشارات غير اللفظية ولغة الجسد لتوصيل الإهانة بشكل غير مباشر ومهذب لا يجرح المشاعر بوضوح","B":"ب) قدرته السريعة على استثارة \"التعاطف الوجداني الفوري\" من قِبَل المتنمر بمجرد أن يرى تأثير منشوره على حساب الضحية ليتراجع فوراً","C":"ج) كونه مقتصراً على أفراد المجموعة المغلقة ولا يمكن لأي شخص خارجها الاطلاع عليه أبداً بفضل الحماية السيبرانية الفائقة","D":"د) اختراق الحدود المكانية والزمانية؛ فالمنشور المسيء ينتشر للملايين في لحظات، ويظل موثقاً ومحفوظاً (البصمة الدائمة التي تطارد الضحية)","answer":"D","topic_question_no":13},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"شخص يتنمر باستمرار على صور زملائه عبر الإنترنت ويُصمم صوراً ساخرة لهم. عند إخضاع هذا المتنمر للتحليل النفسي لاكتشاف دوافعه الحقيقية، نـجد أنه غالباً لا يتصرف بقوة حقيقية، بل تحركه دوافع مريضة أهمها","A":"أ) الرغبة في تعميق الفهم لرسائل التواصل الفعال وتطبيق مبدأ الاحترام المتبادل للاختلاف الفكري","B":"ب) السعي لتحقيق الرضا عن الهوية الشخصية والوصول لقمة الازدهار والاندماج (Flow) في نموذج سليجمان","C":"ج) السعي المريض للمكانة والظهور (شعبية مزيفة)، الخضوع لضغط الأقران لتجنب نبذه، وإسقاط إحباطاته وعقده الشخصية على الأضعف كحيلة دفاعية","D":"د) رغبته في تطوير كفاءته الاجتماعية وبناء حدود واضحة لعلاقاته المستقبلية","answer":"C","topic_question_no":14},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"طالب يجد نفسه فجأة مطروداً ومحذوفاً من كافة المجموعات الدراسية الافتراضية (جروبات الدفعة) بدون سبب واضح، وكلما أنشأ حساباً تم حظره وتجاهله من الجميع باتفاق مسبق. هذا الشكل القاسي من أشكال التنمر الرقمي والذي يهدف للتدمير النفسي يُسمى","A":"أ) كسر الفقاعة الرقمية الموجه لفتح آفاق الحوار الإجباري بالقوة الغاشمة وتقليل التحيز","B":"ب) التشهير واختلاق الشائعات وتزييف الصور الخاصة لتدمير السمعة المجتمعية","C":"ج) الإقصاء والنبذ الافتراضي المهين لفرض العزلة التامة وقطع روابط الانتماء للضحية","D":"د) التحرش اللفظي المباشر والصور التعبيرية الساخرة الموجهة للجسد","answer":"C","topic_question_no":15},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"تعرضت فتاة لرسائل تهديد من زميلة لها على أحد التطبيقات. الخطوة الأولى والأهم في \"درع الصلابة الرقمية\" للمواجهة، والتي تمنع المتنمر من الحصول على \"مكافأته النفسية\"، هي","A":"أ) نشر التهديد على كافة المنصات وطلب تدخل الجميع في شجار علني واسع النطاق للحصول على الدعم الاجتماعي الكاذب","B":"ب) الكبت اللاشعوري للتهديد ومحاولة إقناع نفسها بأنها تستحق هذه الإهانة لأنها ارتكبت خطأ ما في الماضي لتبرير الموقف","C":"ج) التجاهل التام وعدم التغذية للانفعال؛ لأن المتنمر يتغذى نفسياً على رؤية غضبك واستفزازك وضعفك، وحرمانه من هذا الرد يقتله","D":"د) الرد الفوري بنفس أسلوب التهديد والصراخ لإثبات القوة ووقف الهجوم وإخافة المعتدي","answer":"C","topic_question_no":16},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"بعد تجاهل التهديد، يجب على الضحية التحرك ميدانياً وقانونياً لحماية نفسها. الخطوة الصحيحة والموثقة في هذه المرحلة هي","A":"أ) الخضوع المؤقت لمطالب المتنمر لكسب وده وثقته حتى يتدخل وسطاء محايدون لحل النزاع بطرق ودية غير رسمية","B":"ب) استخدام الحيل الدفاعية كالتبرير النفسي لإقناع الذات بأن المتنمر يمزح ولا يقصد الإيذاء الفعلي وأن الأمر سينتهي ودياً مع الوقت","C":"ج) مسح كافة الرسائل المسيئة فوراً وحذف الحساب الشخصي للضحية للهروب من المشكلة وضمان عدم انتشار الفضيحة الافتراضية","D":"د) أخذ لقطات شاشة (Screenshots) توثق التهديد كدليل مادي لا يمكن حذفه، ثم حظر الحساب فوراً، وإبلاغ الجهات القانونية الرسمية (مثل مباحث الإنترنت 108)","answer":"D","topic_question_no":17},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"\"الاستخدام القهري والمفرط وغير المنضبط للشاشات لدرجة فقدان السيطرة، مما يؤدي لتدهور حاد في الوظائف النفسية، الجسدية، والمهنية في الواقع\". هذا هو التعريف الإكلينيكي الدقيق لـ","A":"التفريد المعرفي وتسريع التعلم المستقل","B":"المحاكاة الآمنة للمواقف الطارئة في بيئة افتراضية","C":"الإدمان الرقمي (الاعتماد المرضي على التكنولوجيا)","D":"الذكاء الوجداني الرقمي والتعاطف اللامحدود","answer":"C","topic_question_no":18},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"يعاني المراهق المدمن رقمياً من أضرار بيولوجية مدمرة، من أبرزها \"الأرق المزمن واضطراب النوم القهري\". التفسير الفسيولوجي المباشر لهذه الظاهرة يعود إلى أن","A":"أ) التوتر والعصبية الشديدة كأعراض انسحابية تحدث فقط في الصباح الباكر وتختفي ليلاً","B":"ب) العزلة الانطوائية تسبب آلاماً في العمود الفقري وإجهاداً للعين مما يمنع النوم المريح","C":"ج) الضوء الأزرق المنبعث من الشاشات يخدع الدماغ ويمنعه من إفراز هرمون النوم الطبيعي (الميلاتونين) مما يمنع الجسد من الراحة","D":"د) الخوارزميات تزيد من إفراز هرمون التوتر في الكظرية طوال الليل","answer":"C","topic_question_no":19},{"exam_id":"U6-T4","unit":6,"topic":"سلوكي الرقمي","question":"يقترح بروتوكول التعافي (الانقطاع الرقمي) خطوة استراتيجية هامة تُعرف بـ \"خلق مناطق خالية من الشاشات بالمنزل (حرم مقدس) كطاولة الطعام وغرفة النوم\". الهدف النفسي والاجتماعي العميق من هذه الخطوة هو","A":"أ) تدريب الذاكرة طويلة المدى على استرجاع المعلومات الأكاديمية بدون استعانة بالأجهزة الإلكترونية","B":"ب) إتاحة الفرصة للمراهق للاختباء والتفكير في سلوكياته الرقمية السابقة بشكل انفرادي","C":"ج) استعادة التواصل البشري الحقيقي والعميق بين أفراد الأسرة وتقليل المستويات المرتفعة من التوتر والاستثارة الرقمية","D":"د) توفير بيئة هادئة لإجبار الدماغ على ممارسة التفكير التباعدي المعقد لحل المشكلات طوال فترة التواجد بها لزيادة معدل الذكاء","answer":"C","topic_question_no":20}],"U1-COMPREHENSIVE":[{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"عندما يحاول أحد المفكرين تفسير ظاهرة الأحلام المتكررة لدى الإنسان بالإعتماد كليا على التفكير المجرد، معتقدًا أن هناك جوهرًا خفيا يمثل الروح وهو المحرك الأساسي لكل الأفعال دون الحاجة لإجراء أي تجارب علمية، فإن هذا الموقف يعكس تفكيرًا ينتمي إلى:","A":"أ) مرحلة الاتجاه نحو الاستقلال.","B":"ب) المرحلة الفسيولوجية.","C":"ج) المرحلة الفلسفية القديمة.","D":"د) التأسيس التجريبي لعلم النفس.","answer":"C","topic_question_no":1},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"طلب باحث في معمل علم النفس من المشاركين الضغط على زر معين بمجرد سماعهم لصوت جرس، ثم قام بحساب المدة الزمنية الدقيقة المنقضية منذ انطلاق الصوت وحتى قيام المشارك بالضغط. هذا الموقف البحثي يجسد أحد المجالات التي ركز عليها فيلهلم فونت، وهو:","A":"أ) الطبيعة النفسية للمثيرات الحسية.","B":"ب) زمن الرجع.","C":"ج) عمليات الإدراك الحسي.","D":"د) الخبرة الشعورية الداخلية.","answer":"B","topic_question_no":2},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"في تجربة نفسية، أُطلب من المشارك أن يصف بدقة وتفصيل كل ما يمر به من مشاعر وأفكار داخلية لحظة تعرضه لمثير مخيف، وذلك بهدف تحليل هذه المشاعر إلى عناصرها الأساسية. هذا المنهج البحثي يعد التطبيق المباشر لأفكار:","A":"أ) المدرسة السلوكية.","B":"ب) مدرسة الجشطلت.","C":"ج) المدرسة البنائية.","D":"د) المدرسة الوظيفية.","answer":"C","topic_question_no":3},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"يرى أحد الباحثين أن دراسة العمليات العقلية يجب ألا تتوقف عند مجرد تحليلها ووصفها، بل يجب أن تركز بالأساس على الفائدة العملية لهذه العمليات في مساعدة الإنسان على البقاء ومواجهة تحديات البيئة المحيطة. يتوافق هذا الرأي مع مبادئ:","A":"أ) المدرسة الوظيفية.","B":"ب) مدرسة التحليل النفسي.","C":"ج) علم النفس الإنساني.","D":"د) المدرسة البنائية.","answer":"A","topic_question_no":4},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"صمم معلم بيئة صفية تعتمد كليا على نظام صارم من المكافآت والعقوبات لتعديل سلوك الطلاب، معتقدًا أن الظروف المحيطة بالطلاب والتدريب المستمر هي العوامل الوحيدة التي تشكل شخصياتهم بعيدًا عن أي استعدادات فطرية. يعكس هذا الموقف مبادئ:","A":"أ) المدرسة المعرفية.","B":"ب) علم النفس الإنساني.","C":"ج) مدرسة الجشطلت.","D":"د) المدرسة السلوكية.","answer":"D","topic_question_no":5},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"عند استماعك لمقطوعة موسيقية، فإنك تستمتع باللحن العام المتناغم ولا تركز على كل نوتة موسيقية بشكل منفصل، حيث يرى عقلك أن هذا اللحن يمثل كيانًا يتجاوز مجرد إضافة الأصوات لبعضها. هذا التفسير الإدراكي يمثل جوهر فكر:","A":"أ) المدرسة البنائية.","B":"ب) المدرسة السلوكية.","C":"ج) مدرسة الجشطلت.","D":"د) مدرسة التحليل النفسي.","answer":"C","topic_question_no":6},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"يعاني شاب من ردود أفعال غاضبة ومبالغ فيها تجاه مواقف بسيطة، وعند خضوعه لجلسات نفسية، ركز المعالج على البحث في تجارب الطفولة المبكرة لهذا الشاب والدوافع الخفية التي لا يدركها عقله الواعي. يعتمد هذا المعالج في تفسيره على:","A":"أ) مدرسة التحليل النفسي.","B":"ب) المدرسة المعرفية.","C":"ج) علم النفس الإنساني.","D":"د) المدرسة الوظيفية.","answer":"A","topic_question_no":7},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"يدرس فريق من الباحثين الطريقة التي يستقبل بها العقل البشري المعلومات، ثم كيف يقوم بترميزها وتخزينها لاسترجاعها عند الحاجة، معتمدين في ذلك على تشبيه العقل بنموذج عمل الحاسوب. ينتمي هذا الفريق البحثي إلى:","A":"أ) المدرسة البنائية.","B":"ب) المدرسة المعرفية.","C":"ج) مدرسة الجشطلت.","D":"د) المدرسة السلوكية.","answer":"B","topic_question_no":8},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"بينما ركزت المدرسة البنائية على دراسة الخبرة الشعورية وتحليلها إلى عناصر أساسية كالإحساس والتفكير، اختلفت معها المدرسة الوظيفية في الهدف من دراسة هذه العمليات، حيث ركزت الوظيفية على:","A":"أ) ربط العمليات العقلية بالغرائز المكبوتة وتجارب الطفولة.","B":"ب) دراسة دور العمليات العقلية في مساعدة الفرد على التكيف مع البيئة.","C":"ج) الاكتفاء بدراسة السلوك الظاهر القابل للقياس والملاحظة.","D":"د) فهم العمليات العقلية ككل متكامل لا يقبل التجزئة.","answer":"B","topic_question_no":9},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"حاول طبيب نفسي استخدام منهج يطلب فيه من مرضاه الذين يعانون من اضطرابات عقلية شديدة ومعقدة وصف مشاعرهم الداخلية بدقة، لكنه واجه صعوبة بالغة في الاعتماد على نتائجهم لصعوبة التحقق منها. هذا الموقف يفسر تاريخيا:","A":"أ) سبب تراجع الاعتماد على منهج الاستبطان.","B":"ب) نشأة مرحلة الاتجاه نحو الاستقلال.","C":"ج) ظهور نموذج جبل الجليد لمستويات النفس.","D":"د) أسباب تأسيس علم النفس التجريبي في ليبزيج.","answer":"A","topic_question_no":10},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"باحث في علم النفس يراقب تصرفات مجموعة من الأفراد في بيئة عمل مزدحمة، ويصر على تسجيل ما تراه عيناه فقط من حركات وإيماءات مادية، رافضاً تماماً توجيه أي أسئلة للعمال حول مشاعرهم أو أفكارهم الداخلية. هذا الباحث يتبنى في دراسته مبادئ","A":"أ) المدرسة البنائية التي تعتمد على الاستبطان","B":"ب) المدرسة السلوكية التي ترفض دراسة الخبرة الشعورية المخفية","C":"ج) مدرسة التحليل النفسي التي تركز على الدوافع اللاشعورية","D":"د) مدرسة الجشطلت التي تدرس الظواهر ككل متكامل","answer":"B","topic_question_no":11},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"أثناء دراسة ظاهرة الأحلام، افترض أحد المفكرين أن هذه الظاهرة لا علاقة لها بالجسد المادي، بل هي انعكاس لجوهر الإنسان ومصدر سلوكه غير الملموس الذي يحرك كافة عملياته العقلية. هذا التفسير يعكس فكر علم النفس في","A":"أ) مرحلة الاتجاه نحو الاستقلال","B":"ب) مرحلة التأسيس التجريبي في جامعة ليزبيج","C":"ج) المرحلة الفسيولوجية وارتباطها بوظائف الأعضاء","D":"د) المرحلة الفلسفية اليونانية القديمة","answer":"D","topic_question_no":12},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"تعرض طالب لموقف محرج في طفولته المبكرة نسي تفاصيله تماماً، لكنه أصبح يعاني من خوف غير مبرر عند التحدث أمام الجمهور. المعالج النفسي الذي يفسر هذا الخوف بأنه الناتج عن رغبات مكبوتة ومحرك خفي للسلوك يعتمد على مفهوم","A":"أ) ما قبل الشعور ضمن نموذج جبل الجليد","B":"ب) اللاشعور الذي يضم الغرائز والتجارب المكبوتة","C":"ج) الأنا الأعلى المنظم للقيم والأخلاق","D":"د) الشعور الذي يمثل الأفكار الحالية الظاهرة","answer":"B","topic_question_no":13},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"في تجربة معملية، طلب باحث من المشارك الاستماع إلى مقطوعة موسيقية، ثم طلب منه أن يصف بدقة وعمق كل ما يمر به من أفكار ومشاعر داخلية وانطباعات حسية أثناء استماعه للموسيقى. المنهج المستخدم في هذه التجربة هو","A":"أ) الملاحظة والتجربة المباشرة","B":"ب) منهج الاستبطان لوصف الخبرة الشعورية","C":"ج) قياس زمن الرجع بين المثير والاستجابة","D":"د) تحليل العمليات العقلية الوسيطة بنموذج الحاسوب","answer":"B","topic_question_no":14},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"من الفلسفة إلى المعمل: كيف نشأ علم النفس؟","question":"يعاني شاب من صراع داخلي؛ فهو يرغب بشدة في الاستيلاء على شيء لا يملكه لتلبية رغبة ملحة، لكنه يتراجع في اللحظة الأخيرة لشعوره الشديد بالذنب وتذكره لتربيته. وفقاً لمكونات الشخصية في مدرسة التحليل النفسي، فإن هذا التراجع تم بفضل","A":"أ) الهو الذي يسعى لتلبية الغرائز","B":"ب) الأنا الأعلى الذي يمثل الجانب الأخلاقي والقيمي","C":"ج) الأنا الذي يمثل الجانب اللاواعي","D":"د) اللاشعور الذي يحرك السلوك بخفاء","answer":"B","topic_question_no":15},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"لاحظت إحدى المعلمات أن طالبًا يجلس بهدوء تام دون أي حركة واضحة أو تفاعل مع زملائه، فظنت أنه لا يمارس أي نشاط، لكن الطالب كان في الواقع مندمجًا في محاولة تذكر قاعدة نحوية لحل سؤال في ذهنه. هذا الموقف يؤكد أن السلوك الإنساني في علم النفس:","A":"أ) يقتصر على الأفعال الظاهرة القابلة للقياس المباشر بالكلام.","B":"ب) يشمل العمليات الداخلية المخفية كالتفكير والتذكر.","C":"ج) ينتج دائمًا عن مثيرات خارجية قادمة من البيئة المحيطة.","D":"د) يمثل استجابة آلية ومباشرة لا تتأثر بالحالة النفسية.","answer":"B","topic_question_no":1},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"أثناء جلوس أحد الأفراد في غرفته المظلمة للقراءة، شعر فجأة بانقباضات شديدة في معدته نتيجة عدم تناوله الطعام لساعات طويلة، مما دفعه لترك الكتاب والتوجه لإعداد وجبة. العامل الذي أدى إلى تغيير سلوك هذا الفرد يصنف في علم النفس على أنه:","A":"أ) مثير خارجي.","B":"ب) نشاط اجتماعي.","C":"ج) مثير داخلي.","D":"د) عملية عقلية.","answer":"C","topic_question_no":2},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"تلقى موظفان رسالة بريد إلكتروني تحمل نفس النقد القاسي من مديرهما. الأول شعر بالإحباط الشديد وترك العمل، بينما قرأ الثاني الرسالة بهدوء وبدأ في تصحيح الأخطاء المطلوبة. يثبت هذا التباين أن الاستجابة الإنسانية:","A":"أ) عملية آلية تحدث دائمًا بنفس الطريقة عند ثبات المثير.","B":"ب) تتأثر بالخبرات السابقة والحالة النفسية والتفكير.","C":"ج) تنتج حصريا عن الحاجات العضوية والبيولوجية للفرد.","D":"د) لا يمكن فهمها إلا من خلال الملاحظة العادية العشوائية.","answer":"B","topic_question_no":3},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"في إحدى المباريات النهائية، نـجح لاعب في التنسيق مع زملائه لتسجيل هدف حاسم، فشعر بفرحة غامرة وسعادة بالغة، ثم بدأ يفكر في كيفية الحفاظ على هذا التقدم. الشعور بـ \"الفرحة الغامرة\" في هذا الموقف يمثل أحد أنماط السلوك وهو:","A":"أ) الأنشطة الاجتماعية.","B":"ب) الأنشطة العقلية.","C":"ج) الأنشطة الحركية.","D":"د) الأنشطة الانفعالية.","answer":"D","topic_question_no":4},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"قضى باحث أسابيع في تتبع سلوك مجموعة من الأطفال في فناء المدرسة، واكتفى بتسجيل عدد مرات حدوث الشجار بينهم، وتحديد الأوقات التي يزداد فيها هذا السلوك، دون أن يتدخل أو يطرح أي تفسير لسبب حدوثه. هذا الباحث يطبق الهدف الأساسي لعلم النفس المتمثل في:","A":"أ) الضبط.","B":"ب) التنبؤ.","C":"ج) الفهم.","D":"د) الوصف.","answer":"D","topic_question_no":5},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"بعد دراسة حالة طالب يعاني من تراجع مستمر في درجاته، توصل الأخصائي النفسي إلى أن السبب يرجع إلى وجود خلافات أسرية حادة داخل منزله أثرت على قدرته على التركيز. النتيجة التي توصل إليها الأخصائي تعبر عن مرحلة:","A":"أ) الوصف وتسجيل السلوك بدقة.","B":"ب) التنبؤ بما سيحدث مستقبلاً.","C":"ج) التحكم في العوامل لتعديل السلوك.","D":"د) الفهم ومعرفة الأسباب والعوامل.","answer":"D","topic_question_no":6},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"كان السائق يقود سيارته في طريق مظلم عندما ومض ضوء ساطع جدًا من سيارة مقابلة، مما جعله يرفع يده تلقائيا لحماية عينيه ويخفف سرعته. الضوء الساطع في هذا الموقف يعد:","A":"أ) مثير خارجي.","B":"ب) مثير داخلي.","C":"ج) استجابة شرطية.","D":"د) نشاط عقلي.","answer":"A","topic_question_no":7},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"يجلس لاعب شطرنـج أمام الرقعة لمدة ربع ساعة دون أن يحرك قطعة واحدة، حيث يقوم بتحليل المواقع وتخيل حركات الخصم القادمة لضمان الفوز. هذا السكون الظاهري يصنف نفسياً على أنه تفاعل يعتمد على","A":"أ) الأنشطة العقلية","B":"ب) المثيرات الخارجية","C":"ج) الأنشطة الاجتماعية","D":"د) الأنشطة الانفعالية","answer":"A","topic_question_no":8},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"بناءً على دراسات سابقة، أكد أحد الخبراء التربويين أنه إذا استمر تعرض الطفل للتنمر اللفظي بشكل يومي، فإنه سيميل إلى الانطواء ورفض الذهاب للمدرسة في غضون شهر. هذا التصريح يمثل انتقالاً صريحاً من مجرد فهم السلوك إلى","A":"أ) وصف السلوك وتسجيله","B":"ب) التنبؤ بما سيحدث مستقبلاً","C":"ج) الضبط والتحكم المباشر","D":"د) تحليل الأنشطة الحركية","answer":"B","topic_question_no":9},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"لاحظ مدير مصنع أن الإضاءة الخافتة والضوضاء المستمرة تسبب ضعفاً في إنتاجية العمال وتزيد من الأخطاء. فقام بتركيب إضاءة مريحة وعوازل للصوت، مما أدى لارتفاع جودة العمل. الإجراء الذي اتخذه المدير يعد تطبيقاً لهدف","A":"أ) الضبط والتحكم في العوامل","B":"ب) وصف المشكلة وتحديد خصائصها","C":"ج) التنبؤ بانخفاض الإنتاجية","D":"د) تفسير العوامل الداخلية للعمال","answer":"A","topic_question_no":10},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"أثناء مشاهدتك لفيلم وثائقي، شعرت فجأة بتقلصات شديدة في معدتك نتيجة عدم تناولك للطعام لفترة طويلة، مما دفعك للنهوض والبحث عن وجبة. المثير الذي حرك سلوكك في هذا الموقف يُصنف على أنه","A":"أ) مثير خارجي نشأ من البيئة المحيطة","B":"ب) مثير داخلي نشأ نتيجة حاجة عضوية","C":"ج) نشاط انفعالي يتمثل في البحث عن الطعام","D":"د) نشاط عقلي ناتج عن التفكير في الفيلم","answer":"B","topic_question_no":11},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"تعرض شخص لموقف مفاجئ حيث سمع دوي انفجار قوي في الشارع، فشعر برعب شديد، وتذكر فوراً حادثة مشابهة سابقة، ثم ركض مسرعاً للاستعاد عن المكان. النشاط الذي يمثل الاستجابة الانفعالية في هذه السلسلة هو","A":"أ) سماع دوي الانفجار القوي","B":"ب) تذكر الحادثة المشابهة السابقة","C":"ج) الركض مسرعاً للابتعاد عن المكان","D":"د) الشعور بالرعب الشديد","answer":"D","topic_question_no":12},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"أراد باحث دراسة ظاهرة التنمر المدرسي، فقام بتسجيل أوقات حدوث التنمر، وعدد مرات تكراره خلال الفسحة المدرسية، والفئات العمرية التي تمارسه، دون أن يتدخل أو يقدم أي تفسير لأسباب هذا السلوك. هذا الباحث يطبق الهدف الأول من أهداف علم النفس وهو","A":"أ) الفهم والتفسير","B":"ب) الوصف","C":"ج) الضبط والتحكم","D":"د) التنبؤ بالمستقبل","answer":"B","topic_question_no":13},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"لاحظت إدارة مدرسة أن الطلاب الذين يعانون من قلق مفرط بسبب توقعاتهم السلبية للفشل يميلون للغياب المتكرر. قررت الإدارة وضع برامج إرشادية لتعديل هذه الأفكار وتحسين نسبة الحضور وتوجيه سلوكهم إيجابياً. الإجراء الذي اتخذته الإدارة يمثل مرحلة","A":"أ) الوصف الدقيق لخصائص السلوك","B":"ب) الفهم ومعرفة العوامل الداخلية","C":"ج) التنبؤ بما سيحدث مستقبلاً","D":"د) الضبط والتحكم في العوامل المؤثرة","answer":"D","topic_question_no":14},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"أنت لست مجرد رد فعل: سر المثير والاستجابة","question":"يسعى فريق من العلماء لإصدار تعميمات تخدم كافة فروع علم النفس، من خلال دراسة العمليات الأساسية التي يشترك فيها جميع البشر كالإدراك والتعلم والانفعالات. المجال النظري الذي يهتم بهذا النوع من الدراسات هو","A":"أ) علم نفس الفروق الفردية","B":"ب) علم النفس العام","C":"ج) علم النفس المعرفي","D":"د) علم النفس الاجتماعي","answer":"B","topic_question_no":15},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"باحث يكرس وقته لدراسة الأسباب التي تجعل بعض الناس أكثر عرضة للقلق والانفعال من غيرهم، بهدف صياغة قوانين عامة تفسر هذا التباين والاختلاف دون أن يتدخل لعلاج أي حالة. يصنف هذا البحث ضمن","A":"أ) المجالات التطبيقية","B":"ب) المجالات النظرية","C":"ج) علم النفس الإكلينيكي","D":"د) علم النفس الإرشادي","answer":"B","topic_question_no":1},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"فسر أحد العلماء ظاهرة الخوف من التحدث أمام الجمهور بأنها ناتجة بشكل أساسي عن تسارع ضربات القلب وإفراز هرمونات معينة في الدم تزيد من حدة التوتر الجسدي. يعتمد هذا العالم في تفسيره على","A":"أ) علم النفس العام","B":"ب) علم النفس المعرفي","C":"ج) علم النفس الفسيولوجي","D":"د) علم النفس الاجتماعي","answer":"C","topic_question_no":2},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"طالب يشعر بالتوتر الشديد قبل الامتحانات، وعند استشارة أخصائي، أخبره أن المشكلة تكمن في طريقة تفكيره وتفسيره للموقف، وترديده المستمر لأفكار سلبية مثل \"سأفشل حتماً\". يعكس هذا التفسير منظور","A":"أ) علم النفس التربوي","B":"ب) علم النفس المعرفي","C":"ج) علم النفس الفسيولوجي","D":"د) علم نفس الفروق الفردية","answer":"B","topic_question_no":3},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"لاحظت أم أن طفلها يرفض اللعب بمفرده ويشعر بالقلق فقط عندما يتواجد ضمن جماعة من زملائه، حيث يتأثر بشدة بتقييمهم له. لفهم تأثير هؤلاء الزملاء على أفكار الطفل وسلوكه، يجب اللجوء إلى","A":"أ) علم النفس البيئي","B":"ب) علم نفس الشخصية","C":"ج) علم النفس الاجتماعي","D":"د) علم النفس الصناعي","answer":"C","topic_question_no":4},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"تم تكليف لجنة علمية بوضع مناهج دراسية جديدة تتناسب مع قدرات الطلاب في كل مرحلة عمرية، مع مراعاة الفروق بينهم وتصميم أساليب لزيادة الدافعية للتعلم وتقليل التوتر داخل الفصل. تستند هذه اللجنة في عملها إلى إسهامات","A":"أ) علم النفس الإكلينيكي","B":"ب) علم النفس التربوي","C":"ج) علم النفس الفسيولوجي","D":"د) علم النفس التجاري","answer":"B","topic_question_no":5},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"شخص يعاني من اضطراب نفسي حاد واكتئاب شديد يعيقه عن ممارسة حياته اليومية بشكل طبيعي، ويحتاج إلى تدخل لتشخيص حالته وتعديل أفكاره السلبية العميقة. الجهة أو التخصص الأنسب للتعامل مع هذه الحالة هو","A":"أ) علم النفس الإرشادي","B":"ب) علم النفس الإكلينيكي (العيادي)","C":"ج) علم النفس الفسيولوجي","D":"د) علم نفس الفروق الفردية","answer":"B","topic_question_no":6},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"يواجه شاب حيرة شديدة في اتخاذ قرار بشأن اختيار تخصصه الجامعي الذي يتناسب مع ميوله، وشعر بحاجة لمن يدعمه في ترتيب أفكاره واتخاذ القرار بنفسه بثقة دون وجود أي اضطراب نفسي لديه. هذا الشاب يحتاج إلى تدخل من","A":"أ) علم النفس المعرفي","B":"ب) علم النفس الإكلينيكي","C":"ج) علم النفس الإرشادي","D":"د) علم نفس النمو","answer":"C","topic_question_no":7},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"قررت إحدى الشركات الكبرى إعادة توزيع الموظفين على الأقسام المختلفة بناءً على قدراتهم ومهاراتهم الشخصية، وتقديم برامج تدريبية لهم بهدف رفع مستوى الإنتاجية وتحقيق الرضا الوظيفي. هذا الإجراء يعد تطبيقاً مباشراً لـ","A":"أ) علم النفس الصناعي والتنظيمي","B":"ب) علم النفس التربوي","C":"ج) علم النفس التجاري","D":"د) علم النفس البيئي","answer":"A","topic_question_no":8},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"تختلف المجالات النظرية عن المجالات التطبيقية في علم النفس من حيث الهدف الأساسي؛ فبينما تسعى المجالات التطبيقية إلى التدخل واستخدام النتائج لحل المشكلات، فإن المجالات النظرية تكتفي بـ","A":"أ) علاج الاضطرابات النفسية وتعديل السلوك","B":"ب) الفهم والتفسير والتنبؤ بالسلوك دون التدخل","C":"ج) تحسين البيئة المادية لرفع مستوى الراحة","D":"د) تقديم الدعم للمشكلات الحياتية واتخاذ القرارات","answer":"B","topic_question_no":9},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"يدرس باحث الأسباب التي تجعل بعض الأفراد يتميزون بقدرات قيادية بالفطرة مقارنة بغيرهم ممن يفضلون التبعية، مركزاً على الاختلافات في السمات والقدرات بين هؤلاء الأفراد. ينتمي هذا البحث إلى","A":"أ) علم النفس الاجتماعي","B":"ب) علم نفس الفروق الفردية","C":"ج) علم النفس العام","D":"د) علم نفس النمو","answer":"B","topic_question_no":10},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"فسر طبيب نفسي سلوك العنف لدى المراهقين بأنه أمر طبيعي يرتبط بالتغيرات الجسدية والنفسية التي يمرون بها في هذه المرحلة العمرية المحددة. هذا التفسير يعتمد بشكل مباشر على مبادئ","A":"أ) علم نفس الشخصية","B":"ب) علم النفس الإكلينيكي","C":"ج) علم نفس النمو","D":"د) علم النفس الفسيولوجي","answer":"C","topic_question_no":11},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"طلب صاحب متجر ضخم دراسة العوامل التي تدفع الزبائن لتفضيل منتجات معينة على غيرها، وكيف تتأثر قراراتهم بالإعلانات وطريقة عرض السلع لتبسيط خياراتهم. المجال الأنسب للقيام بهذه الدراسة هو","A":"أ) علم النفس الصناعي والتنظيمي","B":"ب) علم النفس الاجتماعي","C":"ج) علم النفس التجاري","D":"د) علم النفس البيئي","answer":"C","topic_question_no":12},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"عند دراسة ظاهرة \"التنمر\"، اهتم الباحث الأول بمعرفة كيف تساهم جماعة الأصدقاء في تشجيع الفرد على التنمر، بينما ركز الباحث الثاني على الأنماط الثابتة والسمات المميزة لشخصية المتنمر نفسه. يمثل الباحثان على الترتيب مجالي","A":"أ) علم النفس الاجتماعي / علم نفس الشخصية","B":"ب) علم نفس الفروق الفردية / علم النفس العام","C":"ج) علم النفس المعرفي / علم نفس الشخصية","D":"د) علم النفس الاجتماعي / علم نفس النمو","answer":"A","topic_question_no":13},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"لاحظ مهندس معماري أن السكان في أحد المجمعات يشعرون بضغوط نفسية مستمرة، فاكتشف أن تصميم المباني وضيق المساحات وزيادة الضوضاء هي السبب. هذا الاستنتاج يربط بين التصميم المادي وراحة الفرد بناءً على","A":"أ) علم النفس الصناعي والتنظيمي","B":"ب) علم النفس البيئي","C":"ج) علم النفس الاجتماعي","D":"د) علم النفس الإرشادي","answer":"B","topic_question_no":14},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"مجالات علم النفس","question":"يسعى علم النفس العام إلى وضع قواعد شاملة للعمليات الأساسية كالإدراك والتعلم، ويعتبر بالنسبة لبقية المجالات النظرية والتطبيقية بمثابة","A":"أ) الفرع الذي يركز فقط على ذوي الاحتياجات الخاصة","B":"ب) المجال الوحيد القادر على علاج الأمراض","C":"ج) الأساس الذي تنطلق منه وتعتمد عليه بقية المجالات","D":"د) البديل الشامل لعلم النفس الفسيولوجي","answer":"C","topic_question_no":15},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"أراد مدير مدرسة تقييم سلوك الطلاب في الفناء، فقام بالوقوف والمراقبة معتمدًا على ما يلفت انتباهه من تصرفات لبعض الطلاب دون خطة مسبقة لتحديد نوع السلوك المطلوب رصده. يصنف هذا الإجراء منهجيا على أنه","A":"أ) ملاحظة علمية دقيقة وموضوعية","B":"ب) ملاحظة منظمة تعتمد على أدوات القياس","C":"ج) ملاحظة غير مباشرة لجمع البيانات","D":"د) ملاحظة عادية تتأثر بالانطباعات الشخصية","answer":"D","topic_question_no":1},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"يدرس فريق من الباحثين ظاهرة استخدام الشباب لمنصات التواصل، ويحتاجون إلى جمع بيانات ضخمة من آلاف الأفراد في عدة مدن مختلفة خلال فترة زمنية قصيرة جدًا. الأداة البحثية الأنسب لتحقيق هذا الهدف هي","A":"أ) بطاقة الملاحظة","B":"ب) الاستبيان","C":"ج) المقابلة المنظمة","D":"د) الاختبارات النفسية","answer":"B","topic_question_no":2},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"لاحظ أخصائي نفسي أن أحد المراجعين يتردد في الحديث عن مخاوفه ويخفي بعض أفكاره العميقة، فقرر استخدام أداة تعتمد على الحوار المباشر وطرح أسئلة متدرجة لاختراق هذه الحواجز. هذه الأداة هي","A":"أ) الملاحظة العادية","B":"ب) الاستبيان المكتوب","C":"ج) المقابلة","D":"د) المنهج الوصفي","answer":"C","topic_question_no":3},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"إذا قام باحث بتسجيل نتائج تدعم نظريته الشخصية وتجاهل متعمدًا تسجيل بعض الاستجابات التي تتعارض مع ما يؤمن به لضمان نـجـاح بحثه. فإن هذا الباحث قد خالف إحدى أخلاقيات البحث العلمي وهي","A":"أ) الخصوصية وسرية المعلومات","B":"ب) الأمانة العلمية والموضوعية","C":"ج) احترام المشاركين وعدم إلحاق الضرر","D":"د) استخدام المنهج شبه التجريبي","answer":"B","topic_question_no":4},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"تم تكليف باحثة بدراسة تطور لغة الأطفال في مرحلة رياض الأطفال، فاكتفت بتسجيل معدلات نطق الكلمات وتحديد متى تظهر الجمل المعقدة دون أن تتدخل في البيئة أو تحاول تغييرها. المنهج الذي اتبعته الباحثة هو","A":"أ) المنهج التجريبي","B":"ب) المنهج الوصفي","C":"ج) المنهج الارتباطي","D":"د) المنهج شبه التجريبي","answer":"B","topic_question_no":5},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"أظهرت دراسة نفسية أنه كلما زادت ساعات ممارسة الرياضة أسبوعيا، انخفضت معدلات التوتر والقلق لدى المراهقين بشكل ملحوظ. تعبر هذه النتيجة عن استخدام المنهج الارتباطي في تحديد علاقة","A":"أ) ارتباطية موجبة (طردية)","B":"ب) سببية بحتة","C":"ج) ارتباطية صفرية","D":"د) ارتباطية سالبة (عكسية)","answer":"D","topic_question_no":6},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"استخدم معلم طريقة تدريس جديدة مع فصله الدراسي (متغير مستقل)، وقام بعزل وتثبيت كافة العوامل الأخرى كدرجة صعوبة الامتحان ووقت الحصة، ثم قاس أثر هذه الطريقة على تحصيل الطلاب (متغير تابع). يجسد هذا الموقف تطبيقًا لـ","A":"أ) المنهج التجريبي","B":"ب) المنهج الوصفي","C":"ج) بطاقة الملاحظة","D":"د) المنهج الارتباطي","answer":"A","topic_question_no":7},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"أراد باحث دراسة أثر إدمان المخدرات على سرعة الاستجابة الحركية، ولأنه لا يمكنه أخلاقيا إجبار أشخاص أصحاء على تعاطي المخدرات، فإنه سيقوم بمقارنة سرعة استجابة مدمنين فعليين بأشخاص أصحاء في ظروفهم الواقعية. هذا يمثل استخدامًا لـ","A":"أ) المنهج الارتباطي الموجب","B":"ب) المنهج شبه التجريبي","C":"ج) المنهج التجريبي الدقيق","D":"د) أداة الاختبارات النفسية المقننة","answer":"B","topic_question_no":8},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"يكمن الفارق الجوهري بين المنهج التجريبي والمنهج الارتباطي في علم النفس في قدرة أحدهما على تحديد مسار العلاقة بشكل قاطع؛ حيث يتميز المنهج التجريبي عن الارتباطي بقدرته على","A":"أ) دراسة قوة واتجاه العلاقة دون التدخل لتغييرها","B":"ب) إثبات أن أحد المتغيرين هو السبب الحقيقي والحصري للآخر","C":"ج) دراسة الظاهرة كما هي في الواقع ووصف تكرارها","D":"د) جمع البيانات من عدد كبير من الأفراد في وقت قصير","answer":"B","topic_question_no":9},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"لتجنب التحيز البشري أثناء مراقبة السلوك العدواني في ساحة المدرسة، صمم أخصائي أداة تسجل عناصر محددة مثل (طبيعة الموقف، مدة السلوك، وعدد مرات تكراره) لتتحول الملاحظة إلى بيانات دقيقة. هذه الأداة تُعرف بـ","A":"أ) الاختبار النفسي المقنن","B":"ب) بطاقة الملاحظة","C":"ج) المقابلة العيادية","D":"د) الاستبيان المفتوح","answer":"B","topic_question_no":10},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"أثناء حضوره لمباراة رياضية، لاحظ شخص أن مشجعي الفريق الخاسر يميلون للغضب والصراخ، فاستنتج سريعاً أن الرياضة تزيد من العنف، دون أن يسجل أي بيانات دقيقة أو يضع خطة مسبقة لملاحظاته. هذا الاستنتاج يعاني من قصور علمي لأنه اعتمد على:","A":"أ) الملاحظة العلمية التي تتسم بالدقة والتسجيل الفوري","B":"ب) المنهج الوصفي الذي يكتفي بدراسة الظاهرة كما هي دون تدخل","C":"ج) الملاحظة العادية التي تتسم بالعشوائية والتأثر بالانطباعات الشخصية","D":"د) المنهج الارتباطي الذي يدرس اتجاه العلاقة بين متغيرين","answer":"C","topic_question_no":11},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"كُلف باحث بدراسة مستوى القلق لدى طلاب الثانوية العامة، ولضيق الوقت وصعوبة مقابلة آلاف الطلاب فردياً، احتاج إلى أداة تمكنه من جمع كمية هائلة من البيانات المكتوبة حول مشاعرهم في فترة زمنية قصيرة. الأداة الأنسب التي يجب أن يستخدمها هي:","A":"أ) المقابلة الشخصية المقننة","B":"ب) الاستبيان المكتوب","C":"ج) بطاقة الملاحظة المباشرة","D":"د) الاختبارات النفسية لقياس الذكاء","answer":"B","topic_question_no":12},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"قرر باحث دراسة العلاقة بين \"ساعات استخدام الهواتف الذكية\" و\"مستوى التحصيل الدراسي\"، وتوصل إلى أنه كلما زادت ساعات الاستخدام، انخفض التحصيل الدراسي. نوع الارتباط الذي اكتشفه الباحث في هذه الدراسة هو:","A":"أ) ارتباط موجب/طردي","B":"ب) ارتباط صفري لا توجد فيه علاقة","C":"ج) ارتباط سالب/عكسي","D":"د) ارتباط تجريبي يثبت السببية","answer":"C","topic_question_no":13},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"أرادت أخصائية نفسية دراسة سلوك الأطفال المصابين بالتوحد داخل فصولهم الدراسية للحد من تحيزها الشخصي وتحويل مراقبتها إلى بيانات دقيقة. لذلك، اعتمدت على أداة منظمة وفق عناصر محددة تشمل تسجيل الموقف، ومدة السلوك، وتكراره. هذه الأداة هي:","A":"أ) الاختبارات النفسية","B":"ب) المقابلة المنظمة","C":"ج) الاستبيان","D":"د) بطاقة الملاحظة","answer":"D","topic_question_no":14},{"exam_id":"U1-COMPREHENSIVE","unit":1,"topic":"كيف يفكر عالم النفس؟: أدوات ومناهج البحث","question":"عند إجراء دراسة على مجموعة من المرضى النفسيين، التزم الباحث بعدم الكشف عن أسمائهم أو أي تفاصيل قد تدل على هويتهم في نتائج بحثه المنشورة. المبدأ الأخلاقي الذي التزم به الباحث هنا يُعرف بـ:","A":"أ) الموضوعية وتجنب التحيز","B":"ب) الدقة في تسجيل البيانات","C":"ج) الخصوصية والحفاظ على السرية","D":"د) الأمانة العلمية في عرض النتائج","answer":"C","topic_question_no":15}],"U2-COMPREHENSIVE":[{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"يرى طالب زملاءه يتحدثون بصوت خافت في آخر الصف، ورغم أن الموجات الصوتية تصل إلى أذنيه، إلا أنه لا يستطيع تمييز كلامهم أو سماعه بوضوح، مما يمنعه من تكوين أي رد فعل. التفسير العلمي لعدم حدوث الإحساس هنا هو أن شدة المثير لم تتجاوز","A":"أ) العتبة القصوى","B":"ب) العتبة المطلقة","C":"ج) العتبة الفارقة","D":"د) مرحلة تحويل الطاقة","answer":"B","topic_question_no":1},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"تعتبر العملية التي يتم من خلالها استقبال المثيرات من البيئة الخارجية أو من داخل الجسم عبر أعضاء الحس هي الخطوة التأسيسية للسلوك الإنساني. تُعرف هذه العملية بـ","A":"أ) الإدراك الحسي","B":"ب) الانتباه الانتقائي","C":"ج) الإحساس","D":"د) التفسير العقلي","answer":"C","topic_question_no":2},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"يجلس طالب في قاعة محاضرات تعج بالضوضاء والعديد من الأصوات الجانبية للطلاب، ورغم وصول جميع هذه المثيرات إلى أذنيه، إلا أنه لا يدركها ولا يفسر كلامهم لأنه لا يوجه تركيزه سوى لصوت المحاضر. يفسر هذا الموقف حقيقة أن:","A":"أ) السلوك الإنساني هو استجابة الآلية ومباشرة لكافة المثيرات.","B":"ب) الإحساس بمفرده يكفي لتفسير السلوك الإنساني المعقد.","C":"ج) كل المثيرات تصل إلى وعينا ويتم التعامل معها بنفس الطريقة.","D":"د) الإحساس مجرد استقبال أولي، ولا ندرك من المثيرات إلا ما ننتبه إليه.","answer":"B","topic_question_no":3},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"المرحلة الفسيولوجية في عملية الإحساس تتضمن دوراً حاسماً للمستقبلات الحسية، حيث لا يستطيع الدماغ التعامل المباشر مع طاقة الضوء أو الصوت. لذا تقوم المستقبلات بتحويل هذه الطاقة إلى إشارات:","A":"أ) كيميائية فقط تتجه للمراكز الحسية.","B":"ب) فيزيائية تزيد من شدة العتبة المطلقة.","C":"ج) عصبية (كهروكيميائية) ليفهمها المخ.","D":"د) نفسية تسجل الإحساس الواعي.","answer":"B","topic_question_no":4},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"لاعب جمباز يؤدي حركات بهلوانية معقدة في الهواء تتطلب منه معرفة وضعية جسمه وحركته بدقة فائقة ليتمكن من الهبوط بسلام. الحاسة التي توفر له الإحساس بعضلاته ومفاصله لمعرفة وضعية الجسم هي الإحساس:","A":"أ) بالتوازن (في الأذن الداخلية).","B":"ب) بالحركة.","C":"ج) بالضغط الجسدي.","D":"د) اللمسي.","answer":"B","topic_question_no":5},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"يضع طبيب العيون قطرة في عين المريض لتوسيع الحدقة، ويطلب منه عدم النظر مباشرة لأشعة الشمس القوية فور خروجه، لأن شدة هذا المثير الضوئي قد يعجز عضو الحس عن الاقتراب منها وتسبب له الأذى والتلف. هذا المستوى من شدة المثير يعرف بـ:","A":"أ) العتبة المطلقة للإحساس.","B":"ب) العتبة الفارقة للمثيرين.","C":"ج) العتبة القصوى.","D":"د) طاقة المثير الأصلي.","answer":"B","topic_question_no":6},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"الدافعية ليست مجرد رغبة سطحية، بل ترتبط ارتباطاً وثيقاً بالإحساس كقوة داخلية تدفع السلوك. وفقاً لخطوات تكون الدافعية، فإن الخطوة التي يتحول فيها الإحساس بالمثير إلى تنبيه عصبي ينشط مراكز معينة في الدماغ تُسمى:","A":"أ) الحاجة (كالجوع أو الرغبة).","B":"ب) الاستثارة.","C":"ج) الدافع (الحافز وحالة التوتر).","D":"د) السلوك (الاستجابة العملية).","answer":"A","topic_question_no":7},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"في مسابقة موسيقية، استطاع أحد الحكام التمييز بين نغمتين متقاربتين جداً في درجة الصوت، بينما لم يلاحظ الجمهور أي فرق بينهما. قدرة هذا الحكم العالية على التمييز تعني أنه يمتلك درجة حساسة ومتقدمة فيما يعرف بـ:","A":"أ) العتبة المطلقة.","B":"ب) مرحلة التنبيه والاستقبال.","C":"ج) العتبة الفارقة.","D":"د) مرحلة تحويل الطاقة.","answer":"B","topic_question_no":8},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"يعتبر الإحساس الخطوة الأولى في بناء السلوك وأولى العمليات المعرفية، وترجع أهميته القصوى في علم النفس المعرفي إلى أن:","A":"أ) كافة العمليات المعرفية اللاحقة كالانتباه والإدراك تعتمد عليه بشكل أساسي.","B":"ب) الإحساس بمفرده يعني الفهم الكامل للموقف الخارجي.","C":"ج) يقتصر دوره على استقبال المثيرات الداخلية الناتجة عن الحاجات كالجوع.","D":"د) يعمل كعملية نفسية بحتة دون تدخل من الجهاز العصبي.","answer":"B","topic_question_no":9},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"إذا قام شخص بحمل وزن مقداره 100 جرام، فلن يشعر بأي تغيير إذا أضفنا له 1 جرام فقط، لكنه سيشعر بزيادة الوزن إذا أضفنا 10 جرامات. الدرجة التي مكنت الفرد من التمييز بين المثيرين المختلفين تسمى العتبة الفارقة وهي تقع ضمن مرحلة:","A":"أ) تسجيل الإحساس.","B":"ب) تحويل الطاقة الكهروكيميائية.","C":"ج) التنبيه والاستقبال (الفيزيائية/الكيميائية).","D":"د) التفسير العقلي والخبرة.","answer":"C","topic_question_no":10},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"أثناء سيرك في طريق مظلم، لم تدرك وجود قطة صغيرة مختبئة إلا بعد أن أصدرت صوتاً تجاوز حداً معيناً من الشدة سمح لأذنك باستقباله. يطلق على هذا الحد الأدنى لشدة المثير الذي مكّن حاسة السمع من العمل:","A":"أ) العتبة القصوى.","B":"ب) العتبة الفارقة.","C":"ج) العتبة المطلقة.","D":"د) مرحلة تحويل الطاقة.","answer":"C","topic_question_no":11},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"تلعب إحدى الحواس دوراً حيوياً في تنبيه الإنسان للابتعاد عن مصادر الخطر المادي، حيث تختص باستقبال الإحساس بالأشياء الضارة والأنسجة التالفة في الجسم. هذه الحاسة هي الإحساس:","A":"أ) اللمسي.","B":"ب) بالضغط.","C":"ج) بالحركة.","D":"د) بالألم.","answer":"D","topic_question_no":12},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"يجلس طالب في قاعة محاضرات تعج بالضوضاء والعديد من الأصوات الجانبية للطلاب، ورغم وصول جميع هذه المثيرات إلى أذنيه، إلا أنه لا يدركها ولا يفسر كلامهم لأنه لا يوجه تركيزه سوى لصوت المحاضر. يفسر هذا الموقف حقيقة أن:","A":"أ) السلوك الإنساني هو استجابة الآلية ومباشرة لكافة المثيرات.","B":"ب) الإحساس بمفرده يكفي لتفسير السلوك الإنساني المعقد.","C":"ج) كل المثيرات تصل إلى وعينا ويتم التعامل معها بنفس الطريقة.","D":"د) الإحساس مجرد استقبال أولي، ولا ندرك من المثيرات إلا ما ننتبه إليه.","answer":"D","topic_question_no":13},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"المرحلة الفسيولوجية في عملية الإحساس تتضمن دوراً حاسماً للمستقبلات الحسية، حيث لا يستطيع الدماغ التعامل المباشر مع طاقة الضوء أو الصوت. لذا تقوم المستقبلات بتحويل هذه الطاقة إلى إشارات:","A":"أ) كيميائية فقط تتجه للمراكز الحسية.","B":"ب) فيزيائية تزيد من شدة العتبة المطلقة.","C":"ج) عصبية (كهروكيميائية) ليفهمها المخ.","D":"د) نفسية تسجل الإحساس الواعي.","answer":"C","topic_question_no":14},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف يبدأ السلوك؟: الأسس البيولوجية والمعرفية والإحساس","question":"لاعب جمباز يؤدي حركات بهلوانية معقدة في الهواء تتطلب منه معرفة وضعية جسمه وحركته بدقة فائقة ليتمكن من الهبوط بسلام. الحاسة التي توفر له الإحساس بعضلاته ومفاصله لمعرفة وضعية الجسم هي الإحساس:","A":"أ) بالتوازن (في الأذن الداخلية).","B":"ب) بالحركة.","C":"ج) بالضغط الجسدي.","D":"د) اللمسي.","answer":"B","topic_question_no":15},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"أثناء شرح المعلم لموضوع معقد، انشغل أحد الطلاب لثوانٍ معدودة في تدوين ملاحظة جانبية في دفتره، وعندما عاد لمتابعة الشرح وجد نفسه عاجزًا عن فهم الفكرة واعتبرها صعبة للغاية رغم وضوحها لباقي زملائه. التفسير النفسي الدقيق لقصور الفهم لدى هذا الطالب يرجع إلى","A":"أ) صعوبة المادة العلمية وتجاوزها لمدى إدراكه","B":"ب) غياب عملية الانتباه الانتقائي لجزء من المثيرات أثناء الشرح","C":"ج) عجز حواسه عن استقبال المثيرات الصوتية للمعلم","D":"د) اعتماده على الانتباه اللإرادي بدلاً من التهيؤ الذهني","answer":"B","topic_question_no":1},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يجلس شخص في مقهى يعج بالأصوات المتداخلة والموسيقى وأحاديث المارة، ورغم ذلك ينـجح في متابعة حديث صديقه الجالس أمامه بوضوح تام، متجاهلاً كل الضجيج المحيط به. تُعرف العملية العقلية التي مكنته من هذا العزل والتركيز بـ","A":"أ) الإدراك الحسي","B":"ب) الانتباه الانتقائي","C":"ج) قانون الغلق الإدراكي","D":"د) قانون الشكل والأرضية","answer":"B","topic_question_no":2},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"بينما كان مهندس مندمجًا بتركيز شديد في رسم مخطط معقد يتطلب مجهودًا واعيا وتخطيطًا مسبقًا، سقطت لوحة زجاجية ضخمة بجواره محدثة صوتًا مدويا جعله يلتفت إليها فورًا دون تفكير. يمثل التفات المهندس لصوت الزجاج تطبيقًا لـ","A":"أ) الانتباه الإرادي","B":"ب) التهيؤ الذهني","C":"ج) الانتباه اللإرادي","D":"د) الخداع الإدراكي","answer":"A","topic_question_no":3},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يواجه مراقب الكاميرات الأمنية صعوبة بالغة في متابعة عشرين شاشة في نفس اللحظة بوضوح ووعي كامل، مما يجعله يفقد بعض التفاصيل الهامة إذا حدثت في وقت متزامن. هذا القصور يفسر في علم النفس بمفهوم","A":"أ) الخداع الإدراكي","B":"ب) التحيز الإدراكي","C":"ج) مدى الانتباه","D":"د) قانون التقارب","answer":"B","topic_question_no":4},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"اعتاد حارس ليلي على سماع صوت طنين رتيب ومستمر يصدر عن مولد الكهرباء دون أن يعيره اهتمامًا، ولكن عندما انقطع هذا الطنين وتوقف المولد فجأة، انتبه الحارس فورًا وتوجه لتفقد الأمر. العامل الخارجي الذي وجه انتباه الحارس هنا هو","A":"أ) حداثة المثير","B":"ب) تباين المثير","C":"ج) تغير المثير","D":"د) شدة المثير","answer":"C","topic_question_no":5},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"طالب ينتظر بشغف إعلان نتائج المسابقة التي شارك فيها، وعندما سمع صوت المذيع عبر الإذاعة المدرسية، التفت فورًا منصتًا بكل حواسه قبل حتى أن يذكر المذيع اسم الفائز. العامل الداخلي الذي سرّع من انتباه الطالب في هذا الموقف هو","A":"أ) الدوافع والميول","B":"ب) التهيؤ الذهني والتوقع","C":"ج) الحالة الجسدية","D":"د) الحاجات العضوية","answer":"A","topic_question_no":6},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"تصل الإشارات العصبية القادمة من العين إلى القشرة المخية كإشارات مجردة لا معنى لها، حتى يتدخل العقل ليعطيها دلالة ومغزى بناءً على خبرات الشخص السابقة ليعرف أن ما يراه هو سيارة أو شجرة. العملية المعرفية المسؤول عن إعطاء هذا المعنى هي","A":"أ) الإحساس","B":"ب) الإدراك","C":"ج) الانتباه","D":"د) الترميز","answer":"D","topic_question_no":7},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يسهل على القارئ تمييز الكلمات المكتوبة بخط أسود عريض عندما تُطبع على ورق أبيض ناصع، بينما يجد صعوبة في قراءتها إذا كُتبت بخط رمادي على ورق فضي. يعكس هذا الموقف أحد قوانين الإدراك وهو","A":"أ) قانون الغلق","B":"ب) قانون التقارب","C":"ج) قانون حداثة المثير","D":"د) قانون الشكل والأرضية","answer":"C","topic_question_no":8},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"صمم أحد المعلنين لوحة إعلانية بيضاء تمامًا، ووضع في منتصفها نقطة حمراء صغيرة جدًا ومضيئة، فلاحظ أن أعين المارة تنـجذب فورًا نحو هذه النقطة رغم صغر حجمها. يعتمد نـجـاح هذا الإعلان على عامل","A":"أ) تغير المثير","B":"ب) تكرار المثير","C":"ج) تباين المثير","D":"د) حركة المثير","answer":"D","topic_question_no":9},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يسير ثلاثة أصدقاء في الشارع؛ الأول يشعر بجوع شديد فجذبته رائحة مطعم قريب، والثاني طبيب انتبه لصوت سيارة إسعاف، والثالث منزعج ومنهك فلم يلتفت لشيء. العوامل الذاتية التي وجهت انتباههم على الترتيب هي","A":"أ) الحاجات العضوية، الخبرة السابقة والاهتمامات، الحالة النفسية والجسدية","B":"ب) الدوافع والميول، التهيؤ الذهني، الحاجات العضوية","C":"ج) الخبرة السابقة، الحاجات العضوية، الدوافع والميول","D":"د) الحاجات العضوية، التهيؤ الذهني، الدوافع والميول","answer":"B","topic_question_no":10},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"أثناء شرح المعلم لدرس معقد، يركز الطالب بكل وعي وإرادة على كلمات المعلم رغم شعوره بالتعب ومحاولته الجادة لعدم الانشغال بمن حوله. هذا النوع من التركيز يمثل","A":"انتباهاً لا إرادياً ينـجذب فيه تلقائياً","B":"انتباهاً إرادياً يختار فيه التركيز بوعي وإرادة","C":"عملية الإدراك التي تضفي المعنى","D":"قانون الغلق في تنظيم المثيرات","answer":"B","topic_question_no":11},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"بينما كان الموظفون يعملون في هدوء تام داخل المكتب، صدر فجأة صوت إنذار حريق مدوٍ جعل الجميع يلتفتون نحوه بلا تفكير وراء مصدر الصوت. هذا الموقف يجسد حالة من","A":"الانتباه الإرادي المخطط له","B":"الإدراك التحيزي للمثيرات","C":"الانتباه اللا إرادي لمثير قوي مفاجئ","D":"الخداع الإدراكي الحسي","answer":"C","topic_question_no":12},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"يعتمد مصممو الإعلانات الطرقية على استخدام ألوان فاقعة وإضاءات مبهرة جداً مقارنة باللوحات العادية لجذب عيون المارة بسرعة. العامل الخارجي الموجه للانتباه والمستخدم في هذا التكتيك هو","A":"تغير المثير وانقطاعه","B":"حركة المثير","C":"حداثة المثير","D":"شدة المثير","answer":"D","topic_question_no":13},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"ينتظر مسافر في صالة المطار المزدحمة إعلان رحلته رقم 505 وسط عشرات النداءات المختلفة، لم ينتبه إلا للنداء الذي ذكر رقم رحلته. العامل الداخلي الذي جعله أسرع انتباهاً لهذا المثير تحديداً هو","A":"الدوافع والميول","B":"الحالة النفسية والجسدية كالتعب","C":"التهيؤ الذهني (التوقع والانتظار)","D":"الحاجات العضوية والبيولوجية","answer":"C","topic_question_no":14},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"لماذا أرى الأشياء بطريقتي؟: أسرار الانتباه والإدراك","question":"تميل بعض المحالات التجارية إلى وضع نقطة حمراء كبيرة وسط صفحة إعلانية بيضاء فارغة تماماً، مما يجبر القارئ على الانتباه لها فوراً. يعتمد هذا الأسلوب على أحد العوامل الخارجية لتوجيه الانتباه وهو","A":"تباين المثير وبروزه واختلافه التام عما حوله","B":"تكرار المثير بشكل رتيب","C":"حداثة المثير لكونه شيئاً غير مألوف","D":"حركة المثير وانتقاله","answer":"A","topic_question_no":15},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يسير شخص في شارع مزدحم يعج بمئات السيارات والمارة واللافتات، وتلتقط عيناه كل هذه التفاصيل لثوانٍ معدودة، لكنه إذا سُئل بعد دقيقة عن لون سيارة مرت بجانبه فإنه يعجز عن التذكر. التفسير النفسي الدقيق لفقدان هذه المعلومة هو","A":"أ) أن الذاكرة طويلة المدى رفضت تخزين المعلومة لعدم أهميتها","B":"ب) أن سعة الذاكرة الحسية أصغر من أن تستوعب هذه المثيرات","C":"ج) أن المعلومة تلاشت من الذاكرة الحسية لعدم توجيه الانتباه إليها","D":"د) أن الانفعالات الشديدة في الشارع أعاقت عملية الترميز","answer":"C","topic_question_no":1},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"إذا كان التعلم يمثل عملية اكتساب الطالب لقاعدة رياضية جديدة لأول مرة، فإن قدرة هذا الطالب على استخدام نفس القاعدة في حل مسألة معقدة في الامتحان النهائي بعد عدة أشهر تمثل","A":"أ) المعالجة السطحية للمعلومات","B":"ب) الدور الوظيفي للذاكرة في الاحتفاظ والاسترجاع","C":"ج) السعة المحدودة للذاكرة العاملة","D":"د) النقل المباشر للمعلومات من الحواس","answer":"B","topic_question_no":2},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"طلب منك زميلك الاتصال برقم هاتف فأخبرك به، وقبل أن تقوم بكتابته على هاتفك، قاطعك شخص آخر بسؤال استغرق دقيقة واحدة. عندما حاولت كتابة الرقم وجدت أنك نسيته تماماً. هذا الموقف يثبت علمياً أن الذاكرة قصيرة المدى","A":"أ) تحتفظ بالمعلومات لفترة تتراوح بين 15 إلى 30 ثانية وتتأثر بالمشتتات","B":"ب) تستطيع الاحتفاظ بالبيانات لساعات إذا تم استقبالها عبر السمع","C":"ج) لا ترتبط بعملية الانتباه بل تعتمد على الإدراك العميق","D":"د) تفقد معلوماتها في أقل من 4 ثوان كحد أقصى","answer":"A","topic_question_no":3},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"لتسهيل تذكر تاريخ اندلاع الثورة الفرنسية (1789)، قام طالب بربط هذا الرقم في ذهنه بسنة ميلاد جده مضافاً إليها رقم معين ليعطيه دلالة خاصة لا تُنسى. العملية العقلية التي قام بها الطالب لتحويل المعلومة لصورة يقبلها العقل تسمى","A":"أ) عملية الاسترجاع","B":"ب) عملية التخزين","C":"ج) الذاكرة الحسية","D":"د) عملية الترميز","answer":"D","topic_question_no":4},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"قضى طالبان نفس الوقت (ساعتين) في دراسة فصل من الكتاب؛ الأول اكتفى بقراءة النصوص بعينيه، بينما قام الثاني برسم خريطة ذهنية تلخص العلاقات بين الأفكار. تفوق الطالب الثاني في الامتحان يبرهن على أن قوة التخزين تعتمد على","A":"أ) طول الوقت المستغرق في المذاكرة","B":"ب) جودة التعامل مع المعلومة وتنظيمها أثناء التعلم","C":"ج) سعة الذاكرة الحسية لدى كل طالب","D":"د) الحالة الانفعالية الشديدة أثناء الاسترجاع","answer":"B","topic_question_no":5},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"رغم استعداده الجيد، دخل طالب إلى لجنة الامتحان وهو يشعر برعب شديد وخوف من الفشل، وعندما قرأ السؤال الأول عجز تماماً عن تذكر الإجابة رغم شعوره بأنها على طرف لسانه. التفسير النفسي لهذه الظاهرة هو","A":"أ) أن الانفعالات المعتدلة تزيد من التركيز","B":"ب) أن الانفعالات الشديدة الحادة تؤدي لتشتت الانتباه وضعف الاسترجاع","C":"ج) أن المعلومة لم تتجاوز مرحلة الذاكرة الحسية","D":"د) أن الطالب لم يمتلك أي دافع داخلي للتعلم","answer":"B","topic_question_no":6},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يرفض أحد المعلمين أن يكتفي طلابه بقراءة الدرس، ويطلب منهم دائماً إغلاق الكتب ومحاولة تسميع ما فهموه بصوت عال أو كتابته من الذاكرة. تعتمد استراتيجية هذا المعلم على مبدأ","A":"أ) ربط المعلومة الجديدة بخبرة حياتية سابقة","B":"ب) تنظيم المعلومات في هيئة نقاط","C":"ج) الفهم السطحي قبل الحفظ","D":"د) التدريب على الاسترجاع النشط","answer":"D","topic_question_no":7},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يختلف مسار المعلومات داخل العقل البشري باختلاف العمليات المعرفية المرتبطة بها؛ فبينما ترتبط الذاكرة قصيرة المدى ارتباطاً وثيقاً بعملية الانتباه، فإن الذاكرة طويلة المدى ترتبط ارتباطاً وثيقاً بعملية","A":"أ) الاستقبال الحسي للمثيرات","B":"ب) الإدراك وعمق المعالجة","C":"ج) الاحتفاظ المؤقت للمعلومات","D":"د) التشتت الانفعالي الحاد","answer":"B","topic_question_no":8},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يكمن الفارق الجوهري في انتقال المعلومات بين مستويات الذاكرة في أن تجاوز المعلومة لمرحلة الذاكرة الحسية وانتقالها إلى الذاكرة قصيرة المدى يشترط بالضرورة","A":"أ) توجيه الانتباه إلى المثير الحسي","B":"ب) الفهم العميق والتحليل المعقد للمثير","C":"ج) الاسترجاع النشط والتسميع المستمر","D":"د) ربط المثير بالخبرات الحياتية السابقة","answer":"A","topic_question_no":9},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يدرس طالب مادة التاريخ بسطحية تامة لمجرد الرغبة في اجتياز الامتحان، بينما يدرس مادة الأحياء بتعمق وشغف لأنه يحلم بأن يصبح طبيباً. هذا التباين في عمق معالجة المعلومات يوضح الدور الحاسم لـ","A":"أ) الذاكرة العاملة المؤقتة","B":"ب) الانفعالات الحادة كالقلق والتوتر","C":"ج) الدافعية الداخلية للتعلم","D":"د) سعة الذاكرة الحسية البصرية","answer":"C","topic_question_no":10},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"يعتقد بعض الطلاب أن حفظ المعلومات يعتمد فقط على كمية الوقت المقضي في المراجعة. لكن علم النفس يؤكد أن الاحتفاظ بالمعلومات بنـجاح يعتمد بشكل أساسي على:","A":"أ) قوة الذاكرة الحسية واستقبالها المباشر.","B":"ب) الحالة الانفعالية الشديدة الحادة وقت التعلم.","C":"ج) كيفية عمل العقل وطريقة تعامله ومعالجته للمعلومة.","D":"د) التكرار الآلي السطحي دون ربط أو تحليل.","answer":"C","topic_question_no":11},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"المستوى الأول من مستويات الذاكرة والذي يستقبل المعلومات مباشرة عن طريق الحواس، ويحتفظ بها لزمن قصير جداً (من أجزاء من الثانية إلى 4 ثوان كحد أقصى) يُسمى:","A":"أ) الذاكرة طويلة المدى.","B":"ب) الذاكرة العاملة (قصيرة المدى).","C":"ج) الذاكرة الحسية.","D":"د) الذاكرة الإدراكية.","answer":"C","topic_question_no":12},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"أثناء جلوسك في غرفة الانتظار، سمعت رقم تذكرتك، فاحتفظت به في ذهنك لمدة 20 ثانية حتى وصلت إلى الموظف لتسجيله ثم نسيته. الذاكرة التي اعتمدت عليها في هذا الموقف والتي ترتبط ارتباطاً وثيقاً بعملية الانتباه هي:","A":"أ) الذاكرة قصيرة المدى (العاملة).","B":"ب) الذاكرة الحسية.","C":"ج) الذاكرة طويلة المدى.","D":"د) ذاكرة التخزين الإدراكي العميق.","answer":"A","topic_question_no":13},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"لكي تنتقل المعلومة من الذاكرة قصيرة المدى لتستقر في الذاكرة طويلة المدى لأيام أو أعوام، فإنها تتطلب معالجة عميقة ترتبط ارتباطاً وثيقاً بعملية معرفية سابقة هي:","A":"أ) الإحساس الحسي المباشر.","B":"ب) الانتباه اللاإرادي.","C":"ج) الإدراك وعمق المعالجة.","D":"د) التخزين السطحي الرتيب.","answer":"C","topic_question_no":14},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نتعلم ونحتفظ بالمعلومات؟: أسرار الذاكرة","question":"مرحلة التشفير التي لا تحفظ المعلومة كما هي بل تقوم بتحويلها لصورة يقبلها العقل ويتعامل معها (كمعنى أو صورة ذهنية أو ربطها بمعلومة سابقة) تُعرف باسم:","A":"أ) مرحلة الاسترجاع","B":"ب) مرحلة التخزين","C":"ج) الذاكرة الحسية.","D":"د) مرحلة الترميز","answer":"D","topic_question_no":15},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يواجه شاب مشكلة مالية تتمثل في تراجع دخله الشهري، وبدلاً من الاستسلام للإحباط، بدأ في جمع بيانات حول نفقاته، ثم حاول تخيل النتائج المحتملة لتقليل بعض المصروفات أو البحث عن عمل إضافي للوصول إلى قرار يحقق له الاستقرار المالي. هذا المسار الذي اتخذه الشاب يمثل تجسيداً لمفهوم","A":"أ) التفكير الإبداعي الذي يعتمد على الأصالة والجدة","B":"ب) التفكير كعملية ونشاط عقلي مركب لفهم الموقف والبحث عن بدائل","C":"ج) الخداع الإدراكي في تفسير الأسباب الحقيقية للأزمة","D":"د) التهيؤ الذهني لتقبل النتيجة مهما كانت","answer":"B","topic_question_no":1},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يعتمد الطبيب عند تشخيص حالة مريض جديد على استرجاع الحالات المشابهة التي درسها أو علاجها في الماضي، ولا يعتمد فقط على ما يراه أمامه من أعراض جسدية مباشرة. يعكس هذا الموقف إحدى خصائص عملية التفكير وهي أنها","A":"أ) نشاط عقلي غير مباشر يعتمد على المعلومات والخبرات المخزنة في الذاكرة","B":"ب) عملية فطرية تولد مع الإنسان وتعمل بشكل منفصل عن الإدراك","C":"ج) تعتمد كلياً على الاختصارات العقلية لتسريع القرار","D":"د) قدرة لا واعية يوجهها الانفعال والخوف من الفشل","answer":"A","topic_question_no":2},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"لاحظ باحث اجتماعي أن ظاهرة التسرب المدرسي في عدة قرى ترتبط ارتباطاً وثيقاً بمستوى الدخل الاقتصادي الأسري، فقام بصياغة قاعدة عامة تفسر العلاقة بين الفقر والتعليم في المجتمعات الريفية. هذه القدرة على تجاوز الحالات الفردية لصياغة مبدأ عام تدل على أن التفكير","A":"أ) يتجنب استخدام اللغة كأداة للتعبير","B":"ب) يرتكز ويبنى على المعارف والقوانين والمبادئ العامة المنظمة للظواهر","C":"ج) يعتمد على التنبؤ المستقبلي دون فهم للأسباب","D":"د) يعكس دائماً انحيازات شخصية وتحيزات إدراكية","answer":"B","topic_question_no":3},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"استمع قاض لشهادة أحد الشهود الذي بدأ في سرد تفاصيل كثيرة لا علاقة لها بالحادثة محل النزاع، فطلب منه القاضي التوقف والتركيز فقط على الأفعال التي تخص الحادثة مباشرة متجاهلاً التفاصيل الجانبية. الخاصية الفكرية التي استخدمها القاضي هنا هي","A":"أ) تجاوز الخبرة الحسية المباشرة ليصل إلى مستويات التجريد والتعميم والتمييز بين الجوهري والثانوي","B":"ب) التعبير عن نواتج التفكير في صور لفظية أو رمزية دقيقة","C":"ج) الاعتماد على الاستدلالات العقلية السريعة لحسم القضية","D":"د) الانتباه اللاإرادي للمثيرات السمعية أثناء الشهادة","answer":"A","topic_question_no":4},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"أثناء قراءة مقال يهاجم تقنية الذكاء الاصطناعي، لاحظ القارئ أن الكاتب بنى هجومه على فكرة أن الآلات ستدمر البشرية حتماً، فأدرك القارئ أن هذه الفكرة ليست حقيقة علمية مثبتة بل مجرد تخيل يحتاج إلى دليل. المهارة التي استخدمها القارئ تنتمي للتفكير النقدي وهي","A":"أ) التعرف إلى الافتراضات والتمييز بين الحقائق المثبتة والمسلمات","B":"ب) تقييم الحجج القوية والضعيفة","C":"ج) الاستنباط وتطبيق القاعدة العامة","D":"د) التفسير وإيجاد الأسباب المنطقية","answer":"B","topic_question_no":5},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"في نقاش حول أسباب التلوث، قدم أحد الحاضرين إحصائيات دقيقة وموثقة لنسب الانبعاثات الصناعية، بينما قدم آخر قصة شخصية عن إصابة جاره بالربو كدليل وحيد على التلوث. قدرتك على إدراك أن الدليل الأول صلب والثاني ضعيف تعكس مهارتك في","A":"أ) الاستنباط المنطقي","B":"ب) الطلاقة الفكرية","C":"ج) الاستقراء الجزئي","D":"د) تقييم الحجج والتمييز بين ذات الصلة الوثيقة وغير ذات الصلة","answer":"D","topic_question_no":6},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"ُطلب من مجموعة مهندسين إيجاد حلول لأزمة المرور الخانقة، فقدم المهندس الأول ثلاثة حلول تقليدية، بينما قدم المهندس الثاني عشرين حلاً مختلفاً ومبتكراً في نفس الوقت المتاح. يتفوق المهندس الثاني بوضوح في إحدى مهارات التفكير الإبداعي وهي","A":"أ) المرونة الفكرية","B":"ب) الأصالة والجدة","C":"ج) الطلاقة والقدرة الفائقة على إنتاج أكبر كم من الأفكار","D":"د) الاستنباط والاستقراء","answer":"C","topic_question_no":7},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"حاول مدير تسويق زيادة المبيعات باستخدام الإعلانات الورقية مراراً وتكراراً دون جدوى، حتى قرر التخلي تماماً عن هذه الفكرة الثابتة، وتبنى زاوي رؤية مختلفة بالتوجه نحو التسويق الرقمي التفاعلي مما حقق نـجـاحاً باهراً. يعكس هذا التحول امتلاك المدير لمهارة","A":"أ) الأصالة","B":"ب) المرونة والقدرة على تغيير أسلوب التفكير والتغلب على الجمود النمطي","C":"ج) الطلاقة اللفظية","D":"د) التعرف على الافتراضات","answer":"B","topic_question_no":8},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"ينص قانون الفيزياء على أن المعادن تتمدد بالحرارة، وعندما واجه حداد مشكلة في فك صامولة حديدية عالقة، قام بتسخينها بالنار بناءً على هذه القاعدة لتسهيل فكها. هذا التطبيق العلمي للقاعدة العامة على موقف محدد يعرف في التفكير النقدي بـ","A":"أ) التفسير","B":"ب) الاستقراء","C":"ج) الاستنباط","D":"د) الطلاقة","answer":"C","topic_question_no":9},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يواجه مصنع أزمة تتمثل في تأخر تسليم الطلبيات للعملاء، فقام الخبير الإداري فوراً بالفصل الدقيق بين أعراض المشكلة (كغضب العملاء) وبين الأسباب الجذرية (كتعطل خطوط الإنتاج). الخطوة المنظمة التي يقوم بها الخبير لحل المشكلة هي","A":"أ) جمع المعلومات والخبرات السابقة","B":"ب) تحديد المشكلة وصياغتها بوضوح والابتعاد عن السطحية","C":"ج) تقييم الحلول ودراسة إيجابياتها","D":"د) اقتراح الحلول وتوليد البدائل","answer":"B","topic_question_no":10},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"أثناء مواجهة مدير لشركة أزمة مالية طارئة، لم يكتفِ باستدعاء المعارف المجردة التي درسها في الإدارة، بل قام بتحليل معطيات الواقع، ومقارنة البدائل المتاحة، وربطها بالخبرات السابقة للشركة للخروج بحل عملي. يعكس هذا الموقف المفهوم الشامل لعملية التفكير باعتبارها:","A":"أ) استجابة حسية مباشرة للمثيرات البيئية دون معالجة.","B":"ب) عملية عقلية تقتصر على الفهم المجرد بعيداً عن الواقع.","C":"ج) نشاطاً عقلياً مركباً يُستخدم لتفسير المواقف واتخاذ القرارات بشأنها.","D":"د) اختصاراً عقلياً يعتمد على الانفعالات السريعة لتجاوز الأزمة.","answer":"C","topic_question_no":11},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يعجز الإنسان عن التفكير في حل لمشكلة ما إذا لم يكن يمتلك أي معلومات سابقة عنها؛ وذلك لأن عملية التفكير بطبيعتها تتميز بأنها:","A":"أ) نشاط يتجاوز مستويات التجريد والتعميم ليصل للخبرة المباشرة.","B":"ب) نشاط عقلي غير مباشر يعتمد على المعلومات والخبرات المخزنة في الذاكرة.","C":"ج) عملية تعتمد بشكل حصري على الاستدلالات والتحيزات الذهنية.","D":"د) استجابة فسيولوجية سريعة تحدث قبل اكتمال التحليل المنطقي.","answer":"B","topic_question_no":12},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"عندما يشاهد عالم نبات شجرة معينة، فإنه لا يراها مجرد جذع وأوراق كما يراها الشخص العادي، بل يصنفها فوراً ضمن فصيلة معينة بناءً على القوانين العلمية. يشير هذا إلى إحدى خصائص التفكير وهي:","A":"أ) الاعتماد على الاختصارات العقلية لتسريع الحكم.","B":"ب) تجاوز الخبرة الحسية للتمييز بين الجوهري والثانوي.","C":"ج) الارتكاز والبناء على المعارف والقوانين والمبادئ العامة.","D":"د) التعبير عن نواتج التفكير في صور لفظية أو رمزية.","answer":"C","topic_question_no":13},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"يلجأ بعض الأفراد في المواقف اليومية المتسارعة إلى اتخاذ قرارات سريعة بناءً على قواعد مبسطة أو استنتاجات سريعة لتوفير الجهد العقلي، ولكنهم قد يقعون ضحية لأحكام غير دقيقة. يُعرف هذا الأسلوب في خصائص التفكير بـ:","A":"أ) التفكير الإبداعي الأصيل.","B":"ب) التجريد والتعميم.","C":"ج) الاختصارات العقلية أو الاستدلالات.","D":"د) التفكير النقدي التفسيري.","answer":"C","topic_question_no":14},{"exam_id":"U2-COMPREHENSIVE","unit":2,"topic":"كيف نفكر ونتخذ قراراتنا؟","question":"عند قراءة مقال يروج لمنتج صحي جديد، قام القارئ بفصل الادعاءات التي لا تستند إلى دليل علمي عن الحقائق المثبتة بالتجارب، ورفض تصديق المقال لمجرد أنه مكتوب بأسلوب جذاب. المهارة التي استخدمها القارئ هنا من مهارات التفكير النقدي هي:","A":"أ) التعرف إلى الافتراضات وتمييزها عن الحقائق المثبتة.","B":"ب) الاستنباط وتطبيق قاعدة عامة على حالة محددة.","C":"ج) الاستقراء والوصول لقاعدة عامة من حالات جزئية.","D":"د) التفسير وإيجاد أسباب منطقية للمشكلة.","answer":"A","topic_question_no":15}],"U3-COMPREHENSIVE":[{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"يعتقد بعض الآباء أن نمو طفلهم يسير بشكل ممتاز بمجرد ملاحظة زيادة مستمرة في وزنه وطوله مع مرور الأشهر. هذا الاعتقاد يمثل نظرة قاصرة لأنه يركز فقط على جانب واحد من التغيرات ويغفل أن النمو الحقيقي هو عملية متكاملة تشمل بالضرورة","A":"أ) النضج والارتقاء في كافة الجوانب الجسمية، العقلية، الانفعالية، والاجتماعية","B":"ب) التغير السطحي في السلوك نتيجة مرور الزمن","C":"ج) التغيرات الكيفية في قدرة الجهاز العصبي بعيداً عن الجانب الاجتماعي","D":"د) زيادة العمليات النفسية والانفعالية على حساب النمو العضوي","answer":"A","topic_question_no":1},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"انتقل طالب للعيش في مدينة جديدة، فتغيرت طريقة حديثه واكتسب بعض المصطلحات المحلية السطحية لإرضاء زملائه الجدد دون أن يغير ذلك من طريقة تفكيره أو قيمه العميقة. يصنف هذا التحول في علم نفس النمو على أنه","A":"أ) نمو عضوي تكويني","B":"ب) نمو حقيقي متكامل","C":"ج) تغير سطحي لا يؤثر في السلوك بعمق","D":"د) طفرة نمائية كيفية","answer":"C","topic_question_no":2},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"عندما يتعلم الطفل الرضيع الحبو، ثم يطور مهارته للوقوف، ثم يبدأ في المشي، وأخيراً الجري بطلاقة. هذا التسلسل الحركي يجسد أحد قوانين النمو الذي يؤكد أن النمو","A":"أ) يتدرج من العام إلى الخاص","B":"ب) عملية مستمرة يأخذ فيها التغير شكلاً كيفياً متسلسلاً","C":"ج) تختلف سرعته من فرد لآخر","D":"د) يعتمد كلياً على العوامل الخارجية والبيئية","answer":"B","topic_question_no":3},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"إذا لاحظ معلم رياض الأطفال أن طفلاً يقوم بتحريك ذراعه بالكامل وبشكل عشوائي لمحاولة الإمساك بقلم التلوين، وبعد عدة أشهر أصبح قادراً على التحكم الدقيق في أصابعه ليمسك القلم ببراعة. يعكس هذا التطور مبدأ أن النمو","A":"أ) يسير في مراحل لا ترتبط ببعضها","B":"ب) يتدرج من الخاص والدقيق إلى العام","C":"ج) يسير من العام الشامل إلى الخاص والمحدد","D":"د) يتأثر حصراً بنوعية الغذاء المقدم له","answer":"C","topic_question_no":4},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"اكتشف طبيب أطفال أن تأخر طفل في النطق والتواصل الاجتماعي لا يرجع لأسباب بيئية، بل يعود إلى معاناته من نقص حاد في التغذية في أشهره الأولى أثر على نمو دماغه. يثبت هذا التشخيص أن مظاهر النمو","A":"أ) تسير بسرعات متباينة لا تلتقي","B":"ب) ترتبط ارتباطاً وثيقاً ولا يمكن عزل النمو الجسمي عن اللغوي والعقلي","C":"ج) تعتمد على الوراثة كعامل حاسم بمعزل عن البيئة","D":"د) تتغير نوعياً دون أن تترك أثراً في المراحل اللاحقة","answer":"B","topic_question_no":5},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"أُصيب طفل بنقص في إفراز إحدى الغدد الصماء، مما أدى إلى خمول شديد، تأخر في النمو العقلي، ومستوى طاقة منخفض جداً رغم جودة تغذيته. الجهة المسؤولة عن هذا الخلل هي الغدد التي","A":"أ) تصب إفرازاتها في قنوات كالغدد اللعابية","B":"ب) لا تؤثر في الانفعال أو النضج الجنسي","C":"ج) تفرز هرموناتها مباشرة في الدم وتلعب دوراً أساسياً في التنظيم","D":"د) تستمد قوتها من البيئة الثقافية المحيطة حصراً","answer":"C","topic_question_no":6},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"يمتلك الطفل (أ) قدرة عقلية عالية وسرعة بديهة ورثها عن والديه، لكنه نشأ في بيئة قاسية تهمل التعليم. بينما يمتلك الطفل (ب) قدرة متوسطة ورثها، لكنه حظي ببيئة تعليمية داعمة حفزت إمكانياته وتفوق. يؤكد هذا المثال على أن","A":"أ) البيئة وحدها تخلق الذكاء من العدم","B":"ب) الوراثة تمنح الاستعداد فقط، وتتفاعل مع البيئة لإظهاره","C":"ج) التكوين الغدي أقوى من التعليم الأسري","D":"د) الثقافة والمجتمع يلغيان الجانب الوراثي تماماً","answer":"B","topic_question_no":7},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"طفل في الرابعة من عمره ينظر إلى العالم من منظوره الشخصي فقط، وعندما يتحدث مع أمه عبر الهاتف يخبرها بأن تنظر إلى اللعبة التي يمسكها بيده معتقداً أنها ترى ما يراه هو. يعود هذا السلوك إلى أن التفكير في مرحلة الطفولة المبكرة يتسم بـ","A":"أ) القدرة على التصنيف وإدراك العلاقات","B":"ب) التفكير المنطقي الذي ينظم المعلومات","C":"ج) الحدسية والتمركز التام حول الذات","D":"د) استخدام لغة اجتماعية دقيقة واختصار","answer":"C","topic_question_no":8},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"في حصة التربية البدنية لطالب الصف الثاني الابتدائي (7 سنوات)، لاحظ المعلم أن الطلاب قادرون على التحكم في حركاتهم الدقيقة للرسم وتنسيق خطواتهم ببطء وتوازن مقارنة بالسنوات السابقة. السمة الجسمية لهذه المرحلة (الطفولة المتوسطة) هي","A":"أ) نمو متدرج سريع مع تحسن القدرات الحسية","B":"ب) استمرار النمو بمعدل بطيء وظهور الفروق بين الجنسين بقوة","C":"ج) طفرة نمائية فجائية استعداداً للبلوغ","D":"د) استمرار النمو بشكل بطيء ومتوازن مع تحسن التناسق الحركي الدقيق","answer":"D","topic_question_no":9},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"لاحظت أم أن طفلها البالغ من العمر 11 عاماً أصبح يرفض التدليل الزائد أمام أقاربه، ويفضل قضاء معظم وقته مع زملائه، مع حرصه الشديد على تحقيق درجات عالية لنيل التقدير. هذه الخصائص النفسية تميز مرحلة","A":"أ) الطفولة المبكرة","B":"ب) المراهقة المبكرة","C":"ج) الطفولة المتأخرة","D":"د) الطفولة المتوسطة","answer":"C","topic_question_no":10},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"لاحظت أم أن طفلها بدأ يستخدم جملاً أكثر تعقيداً ويسأل عن أسباب الأشياء بشكل مستمر، وفي نفس الوقت لاحظت زيادة في طوله وقدرته على الجري بتوازن. هذا الترابط بين التغيرات الجسدية والعقلية يثبت أن النمو الإنساني هو عملية:","A":"أ) تقتصر على الزيادة الكمية في الوزن والطول فقط.","B":"ب) شاملة ومتكاملة تتضمن تغيرات كمية وكيفية في كافة الجوانب.","C":"ج) تعتمد على تغيرات سطحية لا تؤثر في شخصية الفرد وقدراته.","D":"د) عشوائية تحدث بشكل منفصل في كل جانب نمائي على حدة.","answer":"B","topic_question_no":11},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"تعرض مراهق لموقف صعب أدى لظهور رد فعل عدواني مؤقت تجاه زملائه سرعان ما اختفى بعد زوال الموقف دون أن يترك أثراً على شخصيته أو طريقة تفكيره المستقبلية. هذا التحول العابر يُصنف في علم النفس النمائي على أنه:","A":"أ) نمو حقيقي ناضج.","B":"ب) مظهر من مظاهر النمو الوظيفي الدائم.","C":"ج) مجرد تغير سطحي لا يؤثر في السلوك بعمق.","D":"د) انتقال لمستوى أكثر وعياً وضبطاً للانفعالات.","answer":"C","topic_question_no":12},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"إذا كان التطور العضوي للطفل يسير بشكل سليم فتنمو أعضاؤه ويزداد وزنه وطوله، فإن قدرته على استخدام هذه الأعضاء للتفكير وحل المشكلات والتفاعل الاجتماعي بنـجاح تندرج تحت مظاهر:","A":"أ) التغير السطحي.","B":"ب) النمو الوظيفي.","C":"ج) النمو العضوي (التكويني).","D":"د) التكوين الغدي اللاقنوي.","answer":"B","topic_question_no":13},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"اكتشف معلم أن أحد طلابه يتميز بقدرة مذهلة على الفهم السريع للمسائل الرياضية المعقدة مقارنة بزملاؤه الذين يحتاجون وقتاً أطول وشرحاً مفصلاً لتعلم نفس المسائل. وفقاً لمفهوم \"الفروق الفردية في النمو\"، فإن بطء بعض الطلاب في التعلم يدل على:","A":"أ) عدم وجود أي استعداد وراثي لديهم للتعلم.","B":"ب) اختلاف طبيعي في سرعة التعلم يستلزم مراعاته لتنمية قدراتهم وليس مؤشراً وحيداً للقدرة.","C":"ج) وجود خلل في التكوين الغدي يمنع النمو المعرفي.","D":"د) أن النمو لا يسير في مراحل متتابعة لديهم.","answer":"B","topic_question_no":14},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"من الطفولة إلى المراهقة: كيف أتغير؟","question":"يُعد انتقال الطفل من مرحلة الحبو إلى المشي ثم الجري دليلاً واضحاً على أحد قوانين النمو الذي يشير إلى أن التغيرات تأخذ تسلسلاً (كيفياً)، وهو يندرج تحت مبدأ أن النمو:","A":"أ) يسير من العام إلى الخاص.","B":"ب) يتأثر بالبيئة الثقافية فقط.","C":"ج) عملية مستمرة ومتدرجة ومترابطة.","D":"د) يختلف في سرعته من فرد لآخر بشكل عشوائي.","answer":"C","topic_question_no":15},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"لاحظت أم أن ابنها البالغ من العمر ثلاثة عشر عاماً قد حدثت له تغيرات فسيولوجية سريعة تمثلت في خشونة صوته وظهور بعض ملامح النضج العضوي، فاعتقدت أنه أصبح ناضجاً تماماً وقادراً على اتخاذ قراراته المصيرية بشكل متكامل. هذا الاعتقاد يعد قاصراً في علم النفس لأن الأم خلطت بين مرحلة المراهقة الشاملة وبين","A":"أ) مرحلة الرشد التي تسبق المراهقة","B":"ب) طفرة النمو الإدراكي الحسي","C":"ج) البلوغ الذي يقتصر على الجانب البيولوجي فقط","D":"د) الاستكشاف كأولى مراحل تكوين الهوية","answer":"C","topic_question_no":1},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يعاني أحد المراهقين من تذبذب حاد في مشاعره خلال اليوم الواحد؛ فتارة يبدو في قمة الحماس والنشاط لمشروع مدرسي، وبعد ساعات قليلة يسيطر عليه إحباط شديد وغضب لأتفه الأسباب دون مبرر واضح. يعزى هذا التغير السريع إلى","A":"أ) اكتمال النضج العضوي والجسمي","B":"ب) التقلب الانفعالي المرتبط بالتغيرات الداخلية وعدم استقرار صورة الذات","C":"ج) الانتقال من مرحلة الاختيار إلى مرحلة الالتزام","D":"د) وصوله إلى المرحلة النهائية في تكوين الهوية","answer":"B","topic_question_no":2},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"طلب معلم من طلابه في المرحلة الإعدادية إبداء رأيهم في قضية اجتماعية، فلاحظ أن أحدهم غير رأيه تماماً بمجرد أن سمع آراء أصدقائه في الفصل، رغم أنه كان مقتنعاً برأيه الأول. الدافع النفسي الذي يفسر هذا السلوك في مرحلة المراهقة هو","A":"أ) السعي القوي للاستقلال عن الأسرة","B":"ب) الرغبة في التمرد على القواعد المدرسية","C":"ج) البحث عن القبول والانتماء للمجموعة وتجنب الرفض","D":"د) الانتقال التدريجي نحو النضج العقلي الكامل","answer":"C","topic_question_no":3},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"إذا قمنا بمقارنة التطور الجسمي بين أخ وأخته التوأم في سن الرابعة عشرة، فإننا سنلاحظ غالباً اختلافات واضحة في معدلات النمو وفقاً لخصائص طفرة النمو في هذه المرحلة. التفسير العلمي الأقرب لهذه الاختلافات هو","A":"أ) وصول كلاهما للطول النهائي في نفس التوقيت المتمثل في سن الرابعة عشرة","B":"ب) تأخر الطفرة لدى البنين حيث تبلغ أقصى سرعتها في سن 14، بينما تبدأ مبكراً لدى البنات","C":"ج) تفوق البنات في زيادة الوزن بنهاية المراهقة بسبب نمو العضلات والعظام","D":"د) توقف الطول لدى البنات في سن الثانية عشرة تماماً واستمراره للبنين","answer":"B","topic_question_no":4},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يقضي شاب مراهق ساعات طويلة أمام المرآة قبل الخروج، ويقوم بتعديل ملابسه وتصفيفة شعره مراراً وتكراراً، معتقداً أن جميع من في الشارع سيلاحظون أي عيب بسيط في مظهره. تعكس هذه الحالة إحدى الخصائص الاجتماعية والانفعالية وهي","A":"أ) الحساسية الشديدة تجاه آراء الآخرين ونظرتهم وتقييمهم","B":"ب) السعي لإثبات الهوية المهنية المستقبلية","C":"ج) التمرد على توجيهات الوالدين وقراراتهم","D":"د) دقة الإدراك الحسي وتمييز التفاصيل السمعية","answer":"A","topic_question_no":5},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"شارك مراهق في أنشطة متعددة؛ فانضم لنادي التصوير شهراً، ثم تركه ليتعلم البرمجة، ثم قرر الانضمام لفريق رياضي، محاولاً اكتشاف ما يثير شغفه الحقيقي وتجربة أنماط مختلفة من الأفكار. هذه التصرفات تضعه ضمن أولى مراحل تكوين الهوية وهي","A":"أ) مرحلة الالتزام بالمبادئ","B":"ب) مرحلة الاختيار بين البدائل","C":"ج) مرحلة الاستكشاف وتجربة الأدوار","D":"د) مرحلة النضج المتكامل","answer":"C","topic_question_no":6},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يرفض مراهق السماح لوالده بمساعدته في اختيار مواده الدراسية الاختيارية، ويصر على اتخاذ القرار بمفرده تماماً، قائلاً إنه أصبح كبيراً بما يكفي ليتحمل مسؤولية اختياراته. السمة الانفعالية التي تحرك هذا المراهق هي","A":"أ) التقلب الانفعالي الحاد","B":"ب) السعي إلى الاستقلال والميل للاعتماد على النفس لإثبات الذات","C":"ج) البحث عن الانتماء لمجموعة الأقران","D":"د) المعاناة من ضغوط المقارنة بالآخرين","answer":"B","topic_question_no":7},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"ينتقل المراهق من القدرة على ملاحظة الأشياء البسيطة إلى القدرة على ربط وفهم العلاقات المعقدة بين المثيرات الحسية المختلفة التي يستقبلها، متأثراً بقوة بخبراته السابقة. هذا التحول يمثل خاصية من خصائص","A":"أ) النمو الإدراكي الحسي والانتقال للإدراك المنظم","B":"ب) النضج الفسيولوجي للغدد الجنسية","C":"ج) التطور الانفعالي والتقلب المزاجي","D":"د) طفرة النمو الجسمي وتناسق الأطراف","answer":"A","topic_question_no":8},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"واجه شاب حيرة كبيرة؛ فهو يرغب في قضاء عطلة نهاية الأسبوع في دراسة مادة يفضلها، لكن أصدقاءه ألحوا عليه بشدة للخروج معهم، فشعر بضغط داخلي يمزقه بين تلبية رغبته أو إرضاء أصدقائه. يجسد هذا الموقف أحد تحديات تكوين الهوية وهو","A":"أ) غياب الرؤية الواضحة للمستقبل","B":"ب) صراع الاستقلال والانتماء","C":"ج) المقارنة المستمرة بالآخرين","D":"د) الدخول في مرحلة الالتزام الفكري","answer":"B","topic_question_no":9},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"بعد فترة طويلة من التردد وتجربة عدة اهتمامات رياضية وفنية، استقر مراهق أخيراً على تبني قناعات فكرية محددة تركز على العمل التطوعي، وبدأ يدافع عن هذه القناعات بثبات في نقاشاته مع عائلته. هذا الاستقرار النسبي يعني وصوله لمرحلة","A":"أ) التمرد السلوكي","B":"ب) الاستكشاف العشوائي","C":"ج) الالتزام بتبني الأفكار المختارة والدفاع عنها","D":"د) الإدمان الرقمي بحثاً عن الانتماء","answer":"A","topic_question_no":10},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"لاحظت أم أن ابنتها البالغة من العمر 11 عاماً بدأت تظهر عليها تغيرات جسدية سريعة ونمو في غدد معينة، فاعتقدت أن ابنتها قد وصلت إلى النضج الكامل. وفقاً لـ علم نفس النمو، التفسير الدقيق لحالة هذه الفتاة هو أنها تمر بمرحلة","A":"أ) النضج العقلي الذي يسبق التغيرات الجسدية في مرحلة الرشد","B":"ب) الطفولة المتأخرة التي تتميز بالاستقرار الجسدي التام وغياب التغيرات","C":"ج) البلوغ الذي يقتصر على الجانب البيولوجي ويُعد أول دلائل الدخول في المراهقة","D":"د) المراهقة التي تمثل النضج المتكامل في كافة الجوانب النفسية والاجتماعية","answer":"C","topic_question_no":11},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"يعاني مراهق من تعثر في دراسته، وعندما نصحه والده بتغيير طريقة استذكاره، رفض المراهق بشدة وأصر على اتخاذ قراراته الدراسية بنفسه دون أي تدخل، محاولاً إثبات قدرته على إدارة شؤونه. يعكس هذا السلوك إحدى خصائص النمو الاجتماعي للمراهق وهي","A":"الحساسية المفرطة تجاه آراء الآخرين","B":"السعي القوي للقبول والانتماء لمجموعة","C":"السعي إلى الاستقلال والاعتماد على النفس","D":"التقلب الانفعالي والتغير السريع في المشاعر","answer":"C","topic_question_no":12},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"أثناء رحلة مدرسية، طلب المعلم من الطلاب وصف مشهد طبيعي. لاحظ المعلم أن أحد الطلاب المراهقين لم يكتفِ بوصف الأشياء بشكل سطحي، بل قام بتمييز التفاصيل الدقيقة، وربط العلاقات بين مكونات المشهد بطريقة منظمة. هذا التطور يعود إلى خصائص النمو","A":"الفسيولوجي المتمثل في طفرة النمو","B":"الإدراكي الحسي المتمثل في الانتقال إلى \"الإدراك المنظم\"","C":"الاجتماعي المتمثل في البحث عن الانتماء","D":"الانفعالي المتمثل في عدم استقرار صورة الذات","answer":"B","topic_question_no":13},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"تشهد مرحلة المراهقة طفرة نمو جسدية سريعة ومفاجئة، ولكن هذه الطفرة تختلف بين الجنسين. إذا قمنا بمقارنة سرعة النمو بين فتاة تبلغ من العمر 12 عاماً وصبي في نفس العمر، فإن الملاحظة العلمية الدقيقة ستشير إلى أن","A":"أ) التغيرات الفسيولوجية لديهما ستتوقف تماماً عند سن 14 عاماً","B":"ب) كلاهما سيمر بطفرة النمو في نفس اللحظة ونفس المعدل الزمني","C":"ج) الفتاة ستبلغ أقصى سرعة في النمو الجسدي في هذا السن تقريباً بينما تتأخر طفرة الصبي","D":"د) الصبي سيتفوق في الطول والوزن لأن طفرة الذكور تبدأ مبكراً","answer":"C","topic_question_no":14},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"المراهقة وتكوين الهوية: من أنا؟","question":"شاب في المرحلة الثانوية يمر بحالة من الحيرة الشديدة؛ فهو يحاول تجربة أنماط مختلفة من الأفكار، وينضم لعدة أنشطة مدرسية متنوعة ليتعرف على ميوله الحقيقية وما يناسب شخصيته. يمر هذا الشاب بإحدى مراحل تكوين الهوية وهي مرحلة","A":"الاستكشاف للتعرف على الميول والأدوار","B":"الالتزام والدفاع عن الأفكار بثبات","C":"الاختيار والمفاضلة بين البدائل المتاحة","D":"التوافق النفسي النهائي مع متطلبات المجتمع","answer":"A","topic_question_no":15},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يرى طالب أنه فشل في امتحان الرياضيات لأن المادة معقدة ولا يمكن فهمها، فشعر بالغضب والإحباط. بينما رأى زميله أن الدرجة المنخفضة هي فرصة لمعرفة نقاط ضعفه وتداركها، فشعر بحماس للتعويض. العامل الحاسِم الذي أدى لاختلاف الانفعال بينهما تجاه نفس الموقف هو","A":"أ) التغيرات الفسيولوجية العضوية.","B":"ب) الخبرة السابقة في امتحانات أخرى.","C":"ج) تفسير الموقف والمعنى الذي أعطاه كل منهما للحدث.","D":"د) الانفعالات الفطرية الأساسية.","answer":"C","topic_question_no":1},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"أثناء سير شخص في غابة، ظهر أمامه ثعبان ضخم، فجأة تسارعت ضربات قلبه وتوترت عضلاته وبدأت يداه في التعرق قبل حتى أن يقرر ما سيفعله. هذه الاستجابات الجسدية المرافقة للانفعال تُصنف ضمن","A":"أ) العمليات المعرفية وتفسير المواقف.","B":"ب) المظاهر السلوكية الخارجية المباشرة.","C":"ج) الاستجابات الفسيولوجية والعضوية.","D":"د) الانفعالات المركبة المكتسبة.","answer":"C","topic_question_no":2},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"الطفل الذي يولد في أي ثقافة حول العالم، سواء في الشرق أو الغرب، يظهر نفس تعبيرات الوجه التي تدل على الفرح أو الخوف منذ أشهره الأولى دون أن يتعلمها من أحد. هذا يثبت أن هذه الانفعالات هي","A":"أ) انفعالات مركبة تتشكل ببطء.","B":"ب) انفعالات أساسية فطرية ترتبط بآليات عصبية للحماية والبقاء.","C":"ج) انفعالات ناتجة عن تقييم الفرد لذاته.","D":"د) مجرد خبرات شعورية عابرة لا علاقة لها بالتكيف.","answer":"B","topic_question_no":3},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يشعر مراهق بالخجل الشديد عندما يضطر للتحدث أمام أقاربه، وذلك لإحساسه بأنه لا يمتلك اللباقة الكافية مقارنة بابن عمه الذي يجيد الحديث. يصنف \"الخجل\" في هذه الحالة على أنه انفعال","A":"أ) فطري يولد به الإنسان لحماية نفسه.","B":"ب) أساسي يظهر بصورة تلقائية وسريعة.","C":"ج) مركب يتشكل نتيجة للتفكير والمقارنة بالمعايير الاجتماعية.","D":"د) بيولوجي ناتج عن التغيرات العضوية فقط.","answer":"C","topic_question_no":4},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"تلقى موظف انتقادًا للاذعًا من مديره أمام زملائه. فبدلًا من الرد الفوري أو الصراخ، أخذ نفسًا عميقًا، وقرر تأجيل مناقشة الأمر مع المدير في مكتبه لاحقًا وبأسلوب مهني. الخطوة الاستراتيجية التي طبقها الموظف في التنظيم الانفعالي هي","A":"أ) كبت المشاعر ومنع ظهورها تمامًا.","B":"ب) إعادة تفسير الموقف واعتباره فرصة.","C":"ج) الوعي بالانفعال والتمييز بين التوتر والغضب.","D":"د) التحكم في الاستجابة الانفعالية وإيقاف رد الفعل التلقائي مؤقتًا.","answer":"D","topic_question_no":5},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يعاني شخص من نوبات غضب متكررة تدمر علاقاته، وعندما يسأله صديقه عما يغضبه، يقول: \"لا أعرف، أنا فقط أنفجر\". هذا الشخص يفتقر بشكل خطير إلى أولى خطوات التنظيم الانفعالي وهي","A":"أ) الوعي بالانفعال والإدراك الدقيق لما يشعر به حقًا.","B":"ب) التعبير المندفع عن المشاعر في أي وقت.","C":"ج) كبح التغيرات الفسيولوجية كنبض القلب.","D":"د) استخدام الانفعالات الفطرية بشكل مباشر.","answer":"A","topic_question_no":6},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يرفض علم النفس الحديث فكرة أن الانفعال (كالحزن أو الغضب) هو مشكلة بحد ذاته أو مرض يجب التخلص منه، ويؤكد بدلًا من ذلك أن المشكلة الحقيقية تكمن في","A":"أ) ظهور المظاهر السلوكية الخارجية كالبكاء.","B":"ب) عدم فهم الانفعال أو عدم القدرة على إدارته وتنظيمه بوعي.","C":"ج) ارتباطه بآليات عصبية فطرية في الجهاز العصبي.","D":"د) تحوله من انفعال مركب إلى انفعال أساسي.","answer":"B","topic_question_no":7},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"تعرض طالب لحادث بسيط أثناء ركوبه الدراجة في الشارع، ورغم أنه لم يصب بأذى، إلا أنه أصبح يشعر برعب شديد كلما رأى دراجة، ويرفض ركوبها مجددًا. العامل الذي يحدد استجابته الانفعالية الحالية والمستقبلية تجاه الدراجات هو","A":"أ) الحالة الداخلية الجسدية وقت الحدث.","B":"ب) تفسير الموقف كفرصة جديدة للتحدي.","C":"ج) الخبرة السابقة وتجاربه الماضية المؤلمة.","D":"د) غياب الانفعالات الأساسية الفطرية.","answer":"C","topic_question_no":8},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"عند تحليل الانفعال كعملية مركبة، فإن الطريقة التي نتحدث بها، وتعبيرات الوجوه التي نظهرها للآخرين أثناء الفرح أو الحزن، تُمثل الجانب","A":"أ) الفسيولوجي المتمثل في تسارع التنفس.","B":"ب) المعرفي المرتبط بتفسير المثير.","C":"ج) السلوكي الخارجي الذي يرافق الانفعال.","D":"د) العصبي الفطري.","answer":"C","topic_question_no":9},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"كتمان الفرد لغضبه الشديد تجاه زميله لأسابيع طويلة دون محاولة الحديث معه أو حل المشكلة، معتقدًا أنه بذلك يتجنب المشاكل. هذا السلوك يعد خطيرًا نفسيا لأنه يمثل حالة من","A":"أ) التعبير الواعي الهادئ.","B":"ب) الكبت الذي يولد ضغطًا داخليا واستجابات غير تكيفية لاحقًا.","C":"ج) التحكم الإيجابي في الاستجابة الانفعالية.","D":"د) إعادة تفسير الموقف بوعي ومرونة.","answer":"B","topic_question_no":10},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"أثناء مشاهدته لفيلم رعب، لاحظ شخص أن ضربات قلبه تتسارع، وأن عضلاته تتوتر بشكل ملحوظ. هذه التغيرات التي يمر بها الفرد تمثل أحد جوانب عملية الانفعال وهو","A":"التغير في العمليات المعرفية وتفسير المواقف","B":"الاستجابة الفسيولوجية والعضوية","C":"المظاهر السلوكية الخارجية كنبرة الصوت","D":"الاستجابة الإدراكية المنظمة","answer":"B","topic_question_no":11},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يعتقد بعض الأفراد أن الشعور بالغضب هو في حد ذاته مشكلة نفسية يجب التخلص منها تماماً. يرفض علم النفس هذا الاعتقاد مؤكداً أن الانفعال ليس مشكلة أبداً، بل تكمن المشكلة الحقيقية في","A":"ظهور الانفعالات بصورة تلقائية وسريعة","B":"ارتباط الانفعالات بآليات عصبية فطرية","C":"عدم فهم الانفعال أو عدم القدرة على تنظيمه وإدارته","D":"اقتصار الانفعال على تغيرات في معدل التنفس فقط","answer":"C","topic_question_no":12},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"الانفعالات الأساسية (كالفرح والخوف) تتميز بأنها تشترك فيها معظم الثقافات البشرية، وتظهر بصورة تلقائية وسريعة جداً. السبب العلمي الذي يفسر هذا التشابه العالمي هو ارتباط هذه الانفعالات بـ","A":"تقييم الفرد لذاته مقارنة بالمعايير الاجتماعية المعقدة","B":"خبرات الطفولة المكبوتة في اللاشعور","C":"آليات عصبية فطرية في الجهاز العصبي تهدف للحماية والبقاء والتكيف","D":"التفكير المنطقي البطيء الذي يسبق ظهور المشاعر","answer":"C","topic_question_no":13},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"يشعر موظف بـ \"الغيرة\" الشديدة من زميله الذي حصل على ترقية. هذا الانفعال لا يظهر بشكل فطري أو مباشر كخوف الإنسان من خطر جسدي، بل احتاج إلى وقت ليتشكل بناءً على التفكير والمقارنة الاجتماعية. يُصنف هذا الشعور ضمن","A":"الانفعالات الأساسية الفطرية","B":"الانفعالات المركبة","C":"الاستجابات الفسيولوجية البحتة","D":"المظاهر السلوكية الإيجابية","answer":"B","topic_question_no":14},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"الانفعالات وتنظيمها: كيف أفهم مشاعري؟","question":"طالبان حصلا على نفس الدرجة المنخفضة في الامتحان. الأول شعر بـ \"الخوف\" لاعتقاده بأن الدرجة تمثل تهديداً لمستقبله، والثاني شعر بـ \"الحماس\" واعتبرها فرصة لمعرفة نقاط ضعفه وتحدياً للتحسين. العامل الأساسي الذي أدى لاختلاف انفعالهما رغم وحدة الموقف هو","A":"الحالة الداخلية الجسدية وقت الحدث","B":"تفسير الموقف والمعنى المعطى له","C":"الخبرة السابقة والنـجاح في مواقف مماثلة","D":"الاستجابات العضوية وتوتر العضلات","answer":"B","topic_question_no":15},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يواجه شاب صعوبات كبيرة في التأقلم مع بيئة عمله الجديدة بسبب اختلاف الطباع، فقرر الانعزال تمامًا عن زملائه وتجنب أي نقاش معهم، معتقدًا أنه بذلك قد حقق السلام الداخلي وتكيف مع الوضع. وفقًا لعلم النفس، يعد هذا الاعتقاد خاطئًا لأن التكيف النفسي الحقيقي يعني","A":"أ) القدرة على مواجهة التغيرات والضغوط بأساليب متوازنة وليس الهروب منها.","B":"ب) الامتثال الأعمى لقواعد الزملاء لتجنب الصراعات.","C":"ج) استخدام الحيل الدفاعية كالكبت لتجنب القلق.","D":"د) غياب المرض النفسي والعافية الجسدية التامة.","answer":"A","topic_question_no":1},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يمتلك أحد الطلاب قدرة فائقة على فهم نفسه وتحديد نقاط قوته، بالإضافة إلى قدرته على التواصل الإيجابي مع من حوله وتحقيق التوازن بين متطلباته وتوقعات والديه. تُعرف هذه القدرات والأدوات المكتسبة التي يستخدمها الطالب بـ","A":"أ) التكيف البيولوجي الفطري.","B":"ب) مهارات الحياة الأساسية.","C":"ج) الخداع الإدراكي للمواقف.","D":"د) التغيرات الفسيولوجية.","answer":"B","topic_question_no":2},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"في نقاش محتدم بين صديقين، حرص أحدهما على اختيار كلماته بدقة، وتعديل نبرة صوته ليوضح أفكاره ومشاعره بوضوح تام ودون أن يوجه أي إساءة أو يستخدم عبارات غامضة. المهارة التي طبقها هذا الصديق هي إحدى مهارات التواصل الفعال وتُسمى","A":"أ) الاستماع الفعال.","B":"ب) التعبير عن الذات.","C":"ج) إعادة التفسير المعرفي.","D":"د) تقسيم الموقف وتحديد الأولويات.","answer":"B","topic_question_no":3},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يتحدث طالب مع الأخصائي الاجتماعي عن مشكلة يعاني منها في المنزل، فقام الأخصائي بالتركيز التام معه، محاولًا إدراك المعنى الخفي والمشاعر التي تقف خلف كلماته، مع الحرص على عدم مقاطعته حتى ينهي حديثه. يجسد هذا السلوك تطبيقًا لمهارة","A":"أ) بناء الحدود الشخصية.","B":"ب) تقبل التغير المستمر.","C":"ج) الاستماع الفعال الذي يقلل من سوء الفهم.","D":"د) التعبير الذاتي الواضح.","answer":"C","topic_question_no":4},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يعتقد الكثير من الناس أن الضغوط الحياتية والمتطلبات الصعبة هي عوامل سلبية دائمًا تؤدي إلى الانهيار وتدمير الصحة النفسية. يفند علم النفس هذا الاعتقاد مؤكدًا أن الضغوط قد تكون","A":"أ) سببًا وحيدًا للاضطرابات الإكلينيكية المستعصية.","B":"ب) دافعًا يحفز الإنـجاز إذا تمت إدارتها بشكل جيد.","C":"ج) مؤشرًا على نقص مهارات التواصل الفعال.","D":"د) ناتجة حصريا عن التوقعات الاجتماعية المنخفضة.","answer":"B","topic_question_no":5},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يعاني موظف من ضغط نفسي شديد، وللتعامل معه بفعالية، طلب منه المرشد المهني أن يحدد بدقة ما إذا كان هذا الضغط نابعًا من صعوبة المهام ذاتها، أم من رغبته في إنـجازها بمثالية مفرطة تفوق قدراته. الخطوة التي يطبقها المرشد هنا هي","A":"أ) فهم مصدر الضغط للتمييز بين ما يمكن تغييره وما يحتاج للتكيف.","B":"ب) التعبير الآمن عن الغضب المكبوت.","C":"ج) الاستمرار في العمل وتجاهل المشاعر السلبية.","D":"د) تقسيم الموقف إلى خطوات صغيرة.","answer":"A","topic_question_no":6},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"تعرض رياضي لإصابة بالغة أبعدته عن الملاعب لعدة أشهر، وبدلًا من الاستسلام لليأس، حافظ على توازنه وبدأ رحلة تأهيل شاقة للعودة مجددًا لمستواه. قدرة هذا الرياضي على التكيف الناجح مع هذه التجربة الصعبة تُمثل العملية التي تعرفها جمعية علم النفس الأمريكية (APA) بـ","A":"أ) مهارة التوكيدية.","B":"ب) المرونة النفسية.","C":"ج) الانتباه الانتقائي اللارادي.","D":"د) التعبير عن الذات.","answer":"B","topic_question_no":7},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"تنشأ العديد من الخلافات في بيئة العمل نتيجة رغبة كل موظف في إثبات صحة رأيه وتسفيه آراء الآخرين. المهارة الأساسية التي تعالج هذا الخلل وتضمن توفير بيئة تعبير آمنة للجميع هي","A":"أ) التوازن في أخذ وعطاء الدعم المادي.","B":"ب) الاحترام المتبادل والاعتراف بحق الآخرين في الاختلاف.","C":"ج) تقبل التغير المستمر في سياسات العمل.","D":"د) الاعتماد المتبادل وإلغاء الاستقلالية.","answer":"B","topic_question_no":8},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يكمن الفارق الدقيق بين \"التعبير عن الذات\" و\"الاستماع الفعال\" كعنصرين مكملين لمهارة التواصل؛ في أن الأول يركز على إرسال الرسالة بوضوح وتجنب الإساءة، بينما يركز الثاني بشكل أساسي على","A":"أ) استخدام الحجج المنطقية لإسكات الطرف الآخر.","B":"ب) استنباط المعاني والمشاعر الكامنة خلف الكلمات دون مقاطعة.","C":"ج) تحديد مصدر الضغط النفسي الذي يواجه المتحدث.","D":"د) فرض التوازن في العلاقة بالقوة.","answer":"B","topic_question_no":9},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يواجه شاب قرارًا مفاجئًا بنقل مكان عمله لمدينة أخرى، فقرر التعامل مع هذا الانتقال كجزء طبيعي من مسار حياته المهنية وبدأ في التعرف على المدينة الجديدة بدلًا من الرفض والغضب. يطبق هذا الشاب إحدى مهارات المرونة النفسية وهي","A":"أ) الاستماع الفعال للآخرين.","B":"ب) تقبل التغير والتكيف معه.","C":"ج) فهم مصدر الضغط الناتج عن التوقعات.","D":"د) بناء الحدود في العلاقات السوية.","answer":"B","topic_question_no":10},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"يُفهم التكيف النفسي بشكل خاطئ أحياناً على أنه الاستسلام أو الهروب من المشكلات. المفهوم العلمي الصحيح للتكيف يؤكد أنه:","A":"أ) الاستجابة التلقائية المندفعة التي تتجاهل متطلبات البيئة","B":"ب) التنازل التام عن الأهداف الشخصية لتحقيق الاستقرار الداخلي المطلق","C":"ج) قدرة الفرد على مواجهة التغيرات والضغوط بأساليب متوازنة للتعامل مع المشكلات بشكل سوي","D":"د) قدرة الفرد على تجنب كافة الضغوط والتحديات والعيش بلا صراعات","answer":"C","topic_question_no":11},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"مهارات الحياة ليست مجرد معارف نظرية، بل هي أدوات أساسية مكتسبة تهدف في مرحلة المراهقة بشكل رئيسي إلى ما يلي:","A":"أ) تغيير السمات الوراثية الجينية للفرد ليتكيف بيولوجياً","B":"ب) رفع معدل الذكاء الأكاديمي والتحصيل الدراسي حصراً","C":"ج) مساعدة المراهق على إدارة حياته بكفاءة والتواصل الإيجابي وتحقيق التوازن مع مجتمعه","D":"د) ضمان عدم التعرض لأي أزمات أو صراعات مستقبلية","answer":"C","topic_question_no":12},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"غالباً ما تنشأ المشكلات في العلاقات الإنسانية ليس من الموقف نفسه بل من سوء التعبير أو الفهم. بناءً على ذلك، تُعرف \"مهارة التواصل الفعال\" بأنها ليست مجرد كلام، بل هي بالأساس مهارة تتمثل في:","A":"فرض الرأي على الآخرين بقوة","B":"إدارة الاختلاف والتوضيح التام دون إساءة","C":"السكوت التام لتجنب أي صدام محتمل","D":"استخدام الحيل الدفاعية للتهرب من الحوار","answer":"B","topic_question_no":13},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"أثناء نقاش بين زميلين، كان الأول يتحدث بحماس بينما الثاني صامت تماماً، لكنه يجهز في عقله رداً مفحماً فور انتهاء الأول من كلامه دون أن يركز في المعاني خلف الكلمات. هذا الموقف يفتقر إلى أحد عناصر التواصل الفعال وهو ما يلي:","A":"أ) تجنب المقارنات الاجتماعية المباشرة","B":"ب) اختيار نبرة الصوت المناسبة للهجوم","C":"ج) الاستماع الفعال الذي يتطلب تركيزاً وانتباهاً لما يُقال لمحاولة إدراك المعنى","D":"د) التعبير عن الذات بوضوح","answer":"C","topic_question_no":14},{"exam_id":"U3-COMPREHENSIVE","unit":3,"topic":"مهارات الحياة والتكيف النفسي","question":"واجه طالب فترة امتحانات متتالية شكلت له ضغطاً كبيراً، لكنه بدلاً من الانهيار، استخدم هذا الضغط كدافع قوي لتنظيم وقته والمذاكرة بتركيز مضاعف لتحقيق التفوق. هذا الموقف يثبت أن الضغوط تكون:","A":"أ) ناتجة دائماً عن توقعات الآخرين المرتفعة وليس من الموقف نفسه","B":"ب) قد تكون محفزة للإنـجاز ولا تتحول لمشكلة إلا إذا لم تُدار جيداً","C":"ج) يجب تجنبها والهروب منها كاستراتيجية أولى للتكيف","D":"د) سلبية دائماً وتؤدي حتماً لانهيار القدرات العقلية","answer":"B","topic_question_no":15}],"U4-COMPREHENSIVE":[{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"يلاحظ المعلم أن أحد طلابه يتمتع بذاكرة بصرية مذهلة تمكنه من حفظ الخرائط الجغرافية بدقة، لكنه يعاني بشدة عند محاولة استيعاب القواعد النحوية المجردة. هذا التباين الواضح في مستوى القدرات يمثل علميا:","A":"أ) فروقًا بين الأفراد.","B":"ب) انعدامًا للميول الفطرية.","C":"ج) فروقًا داخل الفرد نفسه.","D":"د) تغيرات نوعية في السمات الانفعالية.","answer":"C","topic_question_no":1},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"يرى أحد المديرين أن جميع الموظفين يمتلكون قدرة على التفكير الإبداعي وحل المشكلات، لكن الاختلاف بينهم يكمن فقط في مستوى هذه القدرة ومقدار ما يمتلكونه منها. تتطابق هذه الرؤية مع إحدى الخصائص العامة لـ الفروق الفردية وهي أنها:","A":"أ) سريعة التغير وتتعدل بالبيئة.","B":"ب) تتوزع بشكل متطرف لدى الأغلبية.","C":"ج) صفات كمية تختلف في المقدار وليست نوعية.","D":"د) أكثر ثباتًا من السمات الجسمية.","answer":"C","topic_question_no":2},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"عند تتبع نمو شخصيتين منذ الطفولة وحتى الرشد، نـجد أن التغير في مستوى ذكائهما وسرعة بديهتهما يحدث بمعدلات مقبولة ومرنة، بينما يظل لون أعينهما وطولهما النسبي ثابتًا تقريبًا طوال حياتهما. هذا التباين يوضح خاصية:","A":"أ) التوزيع الاعتدالي الجرسي للصفات.","B":"ب) اختلاف معدل ثبات الفروق الفردية باختلاف السمة.","C":"ج) تأثير البيئة في تغيير الميول والاهتمامات.","D":"د) الكمية المتساوية للقدرات داخل الفرد.","answer":"B","topic_question_no":3},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"إذا قمنا بتطبيق اختبار دقيق لقياس مهارة \"الطلاقة اللغوية\" على عينة عشوائية تضم عشرة آلاف شخص من مجتمع معين، فإن النتائج وفقًا لـ \"المنحنى الجرسي\" ستظهر أن:","A":"أ) الأغلبية الساحقة ستحصل على أعلى الدرجات.","B":"ب) حوالي 68% من الأشخاص سيحصلون على درجة متوسطة.","C":"ج) جميع الأفراد سيمتلكون نفس المقدار بدقة متناهية.","D":"د) 16% فقط سيحصلون على درجة متوسطة والأغلبية في الأطراف.","answer":"B","topic_question_no":4},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"يقضي شاب ساعات طويلة في تفكيك وتركيب الأجهزة الإلكترونية القديمة في غرفته، ويشعر بمتعة عميقة ورضا تام أثناء قيامه بذلك رغم المجهود البدني والذهني الذي يبذله دون مقابل مادي. يصنف هذا المحرك الخفي لسلوكه في علم النفس على أنه:","A":"أ) سمة جسمية ثابتة.","B":"ب) قدرة عقلية مجردة.","C":"ج) ميل أو استعداد نفسي داخلي يوجه الانتباه.","D":"د) فروق فردية كمية.","answer":"C","topic_question_no":5},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"وُلد طفل بـ \"أذن حساسة للإيقاع\" وقدرة على تمييز الأصوات (استعداد فطري)، لكنه نشأ في بيئة قاسية لا تعير الفنون أي اهتمام ولم توفر له أي آلة موسيقية، فاندثرت هذه القدرة ولم تتحول لشغف. يثبت هذا المثال أن تشكيل الميول يتطلب حتمًا تضافر الاستعدادات الفطرية مع:","A":"أ) السمات الانفعالية الثابتة.","B":"ب) التنشئة والبيئة المكتسبة التي توفر الفرص.","C":"ج) الفروق الجسمية بين الأفراد.","D":"د) الوراثة الجينية لمرض عمى الألوان.","answer":"B","topic_question_no":6},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"يعاني طالب من إحباط مستمر بسبب حصوله على درجات منخفضة في مادة الفيزياء رغم اجتهاده، بينما يتفوق بامتياز في كتابة القصة القصيرة. لفهم حالته، يجب أن يدرك أن تعثره في الفيزياء لا يعني الفشل بل يعني أنه:","A":"أ) يمثل غباءً عامًا وضعفًا في الذكاء الكلي.","B":"ب) يدل على وجود خلل في التكوين العضوي للغدد.","C":"ج) في مسار لا يتوافق مع طبيعته وبصمته النفسية.","D":"د) ناتج عن انعدام الميول الفطرية بشكل عام.","answer":"C","topic_question_no":7},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"تنظم إحدى الجمعيات الخيرية فعالية كبرى، فقامت بتكليف الشاب (أ) ذو الكاريزما بالتحدث للجمهور، والشاب (ب) الدقيق بحساب التبرعات، والشاب (ج) المبدع بتصميم اللافتات. يعكس هذا التوزيع إدراك الإدارة لأهمية الفروق الفردية في:","A":"أ) تصنيف الأشخاص إلى أفضل وأسوأ.","B":"ب) التسامح مع أخطاء الموظفين وتقليل الصدام.","C":"ج) توجيه الأفراد للأنشطة التي تلائم قدراتهم لتحقيق التكامل.","D":"د) إثبات أن الفروق بين الأفراد نوعية وليست كمية.","answer":"C","topic_question_no":8},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"هناك فارق جوهري بين \"الفروق بين الأفراد\" و\"الفروق داخل الفرد نفسه\"؛ فإذا كنا نقارن بين سرعة استجابة لاعب كرة القدم لتعليمات المدرب وبين قدرة نفس اللاعب على ضبط انفعالاته عند الخسارة، فنحن بصدد دراسة:","A":"أ) الفروق النوعية في السمات الجسمية.","B":"ب) التوزيع الاعتدالي للمنحنى الجرسي.","C":"ج) الفروق داخل الفرد نفسه لمستويات قدراته وسماته.","D":"د) الفروق بين الأفراد في الخصائص العقلية.","answer":"C","topic_question_no":9},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"يرى علماء النفس أن العبارة القائلة بأن \"فلان شخص متوسط الذكاء\" لا يجب أن تُعتبر إهانة أو تقليلاً من الشأن، وذلك استنادًا إلى حقيقة إحصائية تؤكد أن:","A":"أ) الذكاء سمة انفعالية سريعة التغير.","B":"ب) القدرات العقلية لا تخضع للقياس الكمي.","C":"ج) التوسط هو حقيقة علمية تطبق على الأغلبية (68%) من البشر.","D":"د) الفائقين يشكلون النسبة الأكبر في أي مجتمع.","answer":"C","topic_question_no":10},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"يشير مفهوم الفروق الفردية إلى الاختلافات بين الأفراد في الصفات المختلفة مقارنة بـ .المتوسط العام. لأقرانهم. هذا يعني علمياً أن هذه الفروق تعتبر","A":"حالة نادرة وشاذة تخرج عن القاعدة الأساسية للكون","B":"القاعدة الأساسية التي تحكم الكون وأن التشابه التام هو الاستثناء","C":"اختلافات كيفية بحتة تعني انعدام وجود الصفة لدى البعض","D":"اختلافات موجودة فقط في الجوانب الجسدية دون الجوانب العقلية","answer":"B","topic_question_no":11},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"دراسة الفروق الفردية لا تهدف أبداً إلى تصنيف الأشخاص بين .أفضل. أو .أسوأ.، بل تهدف بالأساس إلى تحقيق غاية أعمق تتمثل في","A":"أ) إثبات أن الذكاء هو العامل الوحيد المحدد للنـجاح المهني","B":"ب) فهم تميز كل فرد ووضعه في المكان والمسار الذي تزدهر فيه قدراته الطبيعية","C":"ج) إجبار الأفراد على امتلاك نفس الميول والاتجاهات","D":"د) فرض بيئة تعليمية واحدة لتوحيد قدرات الجميع","answer":"B","topic_question_no":12},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"تمتلك سارة قدرة فائقة على الحفظ السريع وذاكرة قوية، لكنها تواجه صعوبة بالغة في التفاعل الاجتماعي وبناء العلاقات، بينما تجيد أختها التفاعل الاجتماعي لكن ذاكرتها ضعيفة. يُطلق على هذا الاختلاف في القدرات داخل شخصية سارة نفسها مصطلح","A":"فروق بين الأفراد","B":"فروق داخل الفرد نفسه","C":"الانحراف المعياري","D":"التوزيع الاعتدالي لأقلية","answer":"B","topic_question_no":13},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"أحد أهم خصائص الفروق الفردية أنها .كمية وليست نوعية.، وهذا التعبير العلمي الدقيق يعني أن","A":"أ) السمات الانفعالية أكثر ثباتاً من السمات الجسدية والعقلية","B":"ب) الفروق بين الناس تُقاس بأنواع مختلفة للصفات وليس بالدرجات","C":"ج) الصفات النفسية موجودة عند جميع البشر (نفس النوع)، والاختلاف يكمن فقط في المقدار أو الكمية التي يمتلكونها","D":"د) بعض البشر يفتقرون للذكاء تماماً ويمتلكون نوعاً آخر من العقول","answer":"C","topic_question_no":14},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الفروق الفردية بين الناس","question":"إذا قمنا بمقارنة مدى ثبات واستقرار الفروق الفردية بمرور الوقت، سنـجد أن هناك سمات قابلة للتعديل والتدريب بسهولة نسبياً متأثرة بالبيئة، وهي","A":"السمات الجسمية (كالطول ولون العينين)","B":"السمات العقلية والمعرفية (كالذكاء)","C":"السمات التكوينية العضوية","D":"السمات الانفعالية (كالقلق أو الخجل)","answer":"D","topic_question_no":15},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"اعتمدت المدارس لسنوات طويلة على مقياس موحد يعطي الطالب \"رقمًا نهائيا\" يحدد مستوى ذكائه بناءً على قدرته على حل المسائل الرياضية واللغوية فقط، مما أدى لتصنيف المبدعين في الرياضة أو الفنون كأشخاص غير أذكياء. هذا النهج الإقصائي يمثل جوهر مفهوم:","A":"أ) نظرية الذكاءات المتعددة.","B":"ب) المنظور الأحادي (التقليدي) للذكاء.","C":"ج) مفهوم الذكاء الوجداني.","D":"د) التفكير الإبداعي التباعدي.","answer":"B","topic_question_no":1},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يرى هوارد جاردنر أن العقل البشري ليس كتلة واحدة جامدة، بل هو يمتلك منظومة من القدرات التي يمكن تنميتها وتطويرها إذا وجدت البيئة المناسبة للتدريب. هذه الرؤية تؤكد أن الذكاء في نظرية الذكاءات المتعددة هو:","A":"أ) قدرة فطرية ووحيدة.","B":"ب) موروث بيولوجي لا يقبل التغيير.","C":"ج) ديناميكي ومرن وقابل للنمو.","D":"د) مقتصر على حل المشكلات الرياضية حصريا.","answer":"C","topic_question_no":2},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"استطاع أحد السياسيين في خطابه إقناع الجماهير بوجهة نظره، معتمدًا على اختياره الدقيق للمفردات، والتلاعب بمعاني الكلمات، وضبط إيقاع جمله ببراعة. يمتلك هذا السياسي مستوى مرتفعًا من نوع الذكاء:","A":"أ) الذكاء المنطقي.","B":"ب) الذكاء الشخصي.","C":"ج) الذكاء اللغوي.","D":"د) الذكاء المكاني.","answer":"C","topic_question_no":3},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يواجه مبرمج حاسوب مشكلة معقدة في بناء تطبيق جديد، فبدأ في تتبع الأكواد المتسلسلة، واكتشاف الأنماط المتكررة، واستنتاج العلاقة بين السبب والنتيجة لمعالجة الخلل. تعكس قدرة هذا المبرمج اعتماده المباشر على الذكاء:","A":"أ) البصري / المكاني.","B":"ب) المنطقي / الرياضي.","C":"ج) الطبيعي (البيئي).","D":"د) الذكاء الوجداني.","answer":"B","topic_question_no":4},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"تم تكليف مصمم داخلي (مهندس ديكور) بتجديد شقة صغيرة الحجم، فقام بتخيل الأبعاد والزوايا في ذهنه قبل رسمها، واستخدم تمييزه الفائق لألوان ليخلق شعورًا بصريا باتساع المكان. يعتمد إبداع هذا المصمم بشكل أساسي على الذكاء:","A":"أ) الذكاء اللغوي.","B":"ب) الذكاء الاجتماعي.","C":"ج) الذكاء البصري / المكاني.","D":"د) الذكاء الحركي / الجسمي.","answer":"C","topic_question_no":5},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يتميز الجراح الماهر بقدرته على إجراء عمليات دقيقة تتطلب تآزرًا عضليا وعصبيا فائقًا، واستخدام أصابعه بمنتهى الدقة والحذر داخل الأنسجة الدقيقة للمريض. تُصنف هذه البراعة الاستثنائية ضمن الذكاء:","A":"أ) الذكاء المنطقي / الرياضي.","B":"ب) الذكاء الحركي / الجسمي.","C":"ج) الذكاء الطبيعي.","D":"د) الذكاء الشخصي.","answer":"B","topic_question_no":6},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يعمل شخص في مجال المبيعات، ويتميز بقدرة مذهلة على قراءة تعبيرات وجوه العملاء ونبرات أصواتهم، وفهم دوافعهم الخفية للشراء، مما يجعله مفاوضًا ناجحًا جدًا. هذه الكفاءة في إدارة العلاقات تمثل الذكاء:","A":"أ) الذكاء الاجتماعي.","B":"ب) الذكاء الوجداني في مكون الدافعية.","C":"ج) الذكاء اللغوي فقط.","D":"د) الذكاء الشخصي والتأمل الذاتي.","answer":"A","topic_question_no":7},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"يمتلك طالب وعيا عميقًا بانفعالاته، فهو يدرك تمامًا أن قدرته على التركيز تتشتت في الأماكن المزدحمة، لذا يقرر دائمًا بقرار مستقل أن يدرس بمفرده في المكتبة لتحقيق أهدافه الأكاديمية. هذا الوعي بنقاط الضعف والقوة يجسد بوضوح الذكاء:","A":"أ) الذكاء البصري / المكاني.","B":"ب) الذكاء الاجتماعي.","C":"ج) الذكاء الشخصي.","D":"د) الذكاء المنطقي.","answer":"C","topic_question_no":8},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"عند دراسة النظم البيئية في غابة استوائية، لاحظ باحث التفاصيل الدقيقة التي تميز بين فصيلتين من النباتات تبدوان متطابقتين للأشخاص العاديين، وقام بتصنيفهما بدقة. الباحث هنا يعتمد على الذكاء:","A":"أ) الذكاء البصري المحض.","B":"ب) الذكاء المنطقي الاستنباطي.","C":"ج) الذكاء الطبيعي (البيئي).","D":"د) الذكاء الشخصي الداخلي.","answer":"C","topic_question_no":9},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"قدم \"دانيال جولمان\" مفهومًا هامًا يعد مكملاً ضروريا للذكاء العقلي (IQ) في التنبؤ بنـجـاح الفرد المهني والشخصي، وركز فيه على القدرة الواعية على إدارة المشاعر وبناء العلاقات تحت الضغط. هذا المفهوم يعرف بـ اسم:","A":"أ) الذكاء المنطقي.","B":"ب) الذكاء الوجداني (EQ).","C":"ج) الذكاء الاجتماعي (منفردًا).","D":"د) التفكير التباعدي الإبداعي.","answer":"B","topic_question_no":10},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"عانى أحد المبدعين في مجال الفنون التشكيلية من تهميش في مدرسته قديماً، حيث كان يُصنف بأنه غير ذكي بسبب درجاته المنخفضة في اختبارات الرياضيات واللغة. هذا التصنيف الظالم الذي حصر قدراته في نطاق ضيق كان نتيجة مباشرة للاعتماد على:","A":"أ) الكفاءة في إدارة العلاقات والتفاوض ضمن الذكاء الاجتماعي","B":"ب) الذكاء البصري المكاني الذي يميز مصممي الديكور","C":"ج) المنظور الأحادي (التقليدي) الذي يقيس الذكاء كقدرة عقلية عامة باختبار ورقي","D":"د) نظرية الذكاءات المتعددة لهوارد جاردنر","answer":"C","topic_question_no":11},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"اقترح \"هوارد جاردنر\" في كتابه \"أطر العقل\" مفهوماً ثورياً للذكاء، معتمداً على أبحاث الدماغ ليؤكد أن الإنسان لا يمتلك ذكاءً واحداً جامداً، بل يمتلك في حقيقة الأمر:","A":"أ) قدرة أحادية تعتمد على المهارات المنطقية وحل المشكلات الرياضية فقط","B":"ب) ذكاءً وجدانياً يقتصر فقط على التعاطف العميق مع مشاعر الآخرين","C":"ج) قدرة بيولوجية فطرية لا يمكن نموها أو تطويرها حتى لو توفرت البيئة المحفزة","D":"د) حزمة متكاملة من الذكاءات المستقلة نسبياً التي تعمل بتناغم وتنسيق فريد داخل كل فرد","answer":"D","topic_question_no":12},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"أثناء ورشة عمل لتدريب المحامين، ركز المدرب على ضرورة امتلاك المحامي لحساسية فائقة تجاه معاني الكلمات، وترتيبها المنطقي، واستخدام الإيقاع اللفظي بدقة متناهية لإقناع هيئة المحلفين. هذا التدريب يستهدف بشكل مباشر تطوير:","A":"الذكاء الشخصي","B":"الذكاء المنطقي / الرياضي","C":"الذكاء اللغوي","D":"الذكاء الاجتماعي","answer":"C","topic_question_no":13},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"لاحظ معلم أن أحد طلابه لا يهتم كثيراً بالاستماع للشرح الشفهي أو قراءة النصوص الطويلة، لكنه يبدع فوراً عندما يُطلب منه تحويل الدرس إلى خرائط ذهنية، أو تخيل أبعاد المجسمات الهندسية ورسمها بدقة. المسار التعليمي الأفضل لهذا الطالب يجب أن يعتمد على:","A":"الذكاء الحركي / الجسمي","B":"الذكاء البصري / المكاني","C":"الذكاء الطبيعي (البيئي)","D":"الذكاء الموسيقي / الإيقاعي","answer":"B","topic_question_no":14},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاءات المتعددة: كيف نكون أذكياء بطرق مختلفة؟","question":"في بيئة العمل، نـجح أحد المديرين في بناء فريق متماسك، وقدرته على إنهاء الشجارات بين الموظفين، وإدارة جلسات التفاوض بنـجاح، مستعيناً بقدرته الفائقة على قراءة لغة الجسد وفهم دوافع من حوله. يتميز هذا المدير بارتفاع ملحوظ في:","A":"الذكاء الاجتماعي","B":"الذكاء الشخصي","C":"الذكاء المنطقي","D":"الذكاء الوجداني (EQ) في مكون التنظيم الذاتي فقط","answer":"A","topic_question_no":15},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يظن بعض الآباء أن مجرد قدرة ابنهم على قضاء ساعات طويلة أمام الشاشات وتصفح التطبيقات المختلفة بسرعة يجعله عبقرياً في استخدام التكنولوجيا. هذا الفهم يتناقض مع التعريف العلمي لـ الذكاء الرقمي الذي يشترط أن يكون الاستخدام مبنياً على","A":"أ) استهلاك أكبر قدر ممكن من المحتوى الترفيهي","B":"ب) توظيف التكنولوجيا بوعي ومسؤولية لحل مشكلات الواقع وتطوير القدرات","C":"ج) استبدال العقل البشري بالآلة لإنـجاز المهام","D":"د) الانعزال التام عن الهوية الإنسانية للاندماج في العالم الافتراضي","answer":"B","topic_question_no":1},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يحرص أحد الصحفيين قبل مشاركة أي خبر مثير للجدل على منصاته، على فحص مصدر المعلومة والبحث عن أدلة تدعمها متجنباً الانـجراف خلف العناوين البراقة. هذه الممارسة العملية تعكس امتلاكه لإحدى ركائز الذكاء الرقمي وهي","A":"أ) التنقل المعلوماتي ومحو الأمية الرقمية","B":"ب) التفكير الناقد وفرز الشائعات والمعلومات المزيفة","C":"ج) الأمن السيبراني وحماية البصمة الرقمية","D":"د) الذكاء الوجداني الرقمي والتعاطف","answer":"B","topic_question_no":2},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"لاحظت فتاة أن المواقع التي تتصفحها بدأت تعرض لها إعلانات ومحتويات تتطابق تماماً مع ما كانت تبحث عنه بالأمس، فأدركت أن هناك برمجيات تدرس سلوكها لتوجيه اختياراتها. الفهم الدقيق لآلية عمل هذه البرمجيات يصنف ضمن ركيزة","A":"أ) الذكاء الوجداني الرقمي","B":"ب) التفكير الناقد وفرز الشائعات","C":"ج) الأمن السيبراني وحماية الخصوصية","D":"د) التنقل المعلوماتي وفهم الخوارزميات","answer":"D","topic_question_no":3},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"قرأ شاب تعليقاً قاسياً ومسيئاً موجهاً لأحد أصدقائه على منصة عامة، فقرر التدخل برسالة خاصة داعمة لصديقه، ممتنعاً تماماً عن الرد بالإساءة أو التجريح للمتنمر. يعكس هذا السلوك الراقي التزاماً بركيزة","A":"أ) الذكاء الوجداني الرقمي الذي يدرك إنسانية ومشاعر الآخرين عبر الشاشات","B":"ب) محو الأمية الرقمية واختيار التطبيق الأنسب","C":"ج) الأمن السيبراني وحماية المعلومات المالية","D":"د) التفكير الناقد والتشكيك العلمي","answer":"A","topic_question_no":4},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"استخدم معلم الجغرافيا تطبيقاً يعتمد على تقنية «الواقع المعزز» ليسمح لطلابه بالتجول افتراضياً داخل المجموعة الشمسية ورؤية الكواكب بأبعادها الثالثية. هذا التطبيق يخدم بشكل مباشر الطلاب الذين يتميزون بـ","A":"أ) الذكاء اللغوي","B":"ب) الذكاء الموسيقي","C":"ج) الذكاء البصري / المكاني","D":"د) الذكاء الشخصي","answer":"C","topic_question_no":5},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يعاني طالب من خجل شديد يمنعه من طرح الأسئلة داخل الفصل إذا لم يفهم نقطة معينة خوفاً من نظرات زملائه. لكنه وجد ضالته في منصات التعلم الرقمية حيث يمكنه إعادة المقطع عشر مرات دون حرج. هذه الفرصة التي وفرتها التكنولوجيا تُعرف بـ","A":"أ) المحاكاة الآمنة للمواقف","B":"ب) اقتصاد العمل الحر والاستقلالية","C":"ج) التفريد المعرفي والتعلم بالسرعة الذاتية","D":"د) التشتت الذهني والإثارة اللحظية","answer":"C","topic_question_no":6},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يتابع أحد الأفراد صفحات سياسية تتبنى وجهة نظر واحدة فقط، ومع مرور الوقت أصبحت المنصة لا تعرض له سوى الآراء التي تؤكد معتقداته، مما جعله يعتقد أن العالم كله يتفق معه ويرفض أي رأي مخالف. هذه المخاطرة الرقمية تُسمى","A":"أ) الكسل المعرفي وفقدان الذاكرة طويلة المدى","B":"ب) غسيل الدماغ الخوارزمي والانحباس في فقاعة معلوماتية","C":"ج) العزلة وتدهور الذكاء الوجداني","D":"د) المحاكاة الآمنة للمواقف المعقدة","answer":"B","topic_question_no":7},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يقضي مراهق وقتاً طويلاً في استخدام برامج الطباعة ثلاثية الأبعاد لتحويل أفكاره وتصميماته الهندسية إلى مجسمات ملموسة. هذا الاستخدام يمثل توظيفاً ذكياً للتكنولوجيا لتعزيز","A":"أ) الذكاء الاجتماعي","B":"ب) الذكاء الحركي / الجسمي","C":"ج) الذكاء اللغوي","D":"د) الذكاء الطبيعي","answer":"B","topic_question_no":8},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"تكمن الخطورة الحقيقية لغياب التفكير الناقد في العالم الرقمي في أن المستخدم يصبح ضحية لـ «التزييف العميق»؛ وهو ما يجعله عاجزاً تماماً عن","A":"أ) فهم الخوارزميات التي ترشح له المحتوى","B":"ب) التمييز الصارم بين الحقائق الموثقة والمصالح الشخصية","C":"ج) استخدام برامج الهندسة الصوتية","D":"د) إنشاء مذكرات رقمية للتأمل الذاتي","answer":"B","topic_question_no":9},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يمثل «قانون المواطنة الرقمية» امتداداً طبيعياً للأخلاق الإنسانية، وهو يفرض على المستخدم الوعي التام بحقيقة أن الشاشة","A":"أ) تمثل ستاراً آمناً للاختباء وتفريغ الغضب","B":"ب) تلغي الحاجة للتفكير الناقد وفرز الشائعات","C":"ج) ليست ستاراً للاختباء وأن الأخلاق هي الهوية الحقيقية في الفضاء الإلكتروني","D":"د) تبرر مشاركة البيانات المالية بحرية لتبادل الثقة","answer":"C","topic_question_no":10},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"يُعرف الذكاء الرقمي بأنه ليس مجرد قضاء ساعات أمام الشاشات، بل هو قدرة الفرد على توظيف التكنولوجيا بوعي لحل المشكلات وتطوير القدرات. الشرط النفسي الأهم في هذا التعريف لضمان عدم تحول التكنولوجيا لضرر هو","A":"استبدال العقل البشري بالآلة كلياً لضمان سرعة الإنـجاز","B":"الحفاظ على الهوية الإنسانية وتحمل المسؤولية أثناء توظيف الأداة الرقمية","C":"إتقان جميع لغات البرمجة وتصميم المواقع الإلكترونية المعقدة","D":"العزلة التامة عن الواقع لرفع مستوى التركيز في الفضاء الافتراضي","answer":"B","topic_question_no":11},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"واجه طالب مشكلة في العثور على مراجع دقيقة لبحثه، فقضى وقتاً طويلاً في تصفح مواقع عشوائية غير موثوقة حتى أُصيب بالإحباط. هذا الطالب يفتقر إلى إحدى الركائز الأربع للذكاء الرقمي وهي","A":"الأمن السيبراني وحماية البصمة الرقمية","B":"الذكاء الوجداني الرقمي والتعاطف","C":"التنقل المعلوماتي ومحو الأمية الرقمية (البحث الدقيق واختيار الأنسب)","D":"التفكير الناقد وفرز الشائعات والمصالح","answer":"C","topic_question_no":12},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"تنتشر في الفضاء الإلكتروني صور ومقاطع فيديو تم التلاعب بها بمهارة لتبدو حقيقية (التزييف العميق). القدرة على التشكيك العلمي، والتحقق من المصادر، والتمييز الصارم بين الحقائق الموثقة والمصالح الشخصية تندرج تحت ركيزة","A":"التنقل المعلوماتي وفهم الخوارزميات","B":"التفكير الناقد وفرز الشائعات","C":"الأمن السيبراني وحماية الخصوصية","D":"التفريد المعرفي والتعلم الذاتي","answer":"B","topic_question_no":13},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"قانون \"المواطنة الرقمية\" يؤكد أن الشاشة ليست ستاراً للاختباء، وأن أخلاقك وهويتك الحقيقية يجب أن تظهر في الفضاء الإلكتروني كالواقع. هذا القانون يرتبط ارتباطاً وثيقاً بضرورة التمتع بـ","A":"الذكاء الوجداني الرقمي (الامتناع عن التنمر وإدراك مشاعر الآخرين)","B":"الكسل المعرفي والاعتماد الكلي على الأدوات","C":"غسيل الدماغ الخوارزمي في غرف الصدى","D":"المحاكاة الآمنة وتجربة المواقف المعقدة","answer":"A","topic_question_no":14},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الذكاء الرقمي: كيف نستخدم قدراتنا في عالم التكنولوجيا؟","question":"شاب يهوى تصميم الديكورات وتنسيق المنازل، واستطاع توظيف برامج \"الواقع المعزز\" لتصميم منازل وتخيلها قبل تنفيذها في الواقع، واستخدام أدوات التوليد البصري باحترافية. هذا الشاب استخدم الأداة الرقمية لتعزيز ذكائه","A":"المنطقي / الرياضي","B":"اللغوي وحساسية المفردات","C":"البصري / المكاني","D":"الشخصي لتنظيم الوقت","answer":"C","topic_question_no":15},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يعتقد بعض المربين أن الطفل الذي يولد بقدرة فطرية استثنائية سيصبح مبدعاً لا محالة دون الحاجة لأي تدخل أو تدريب، متجاهلين بذلك أن الموهبة هي","A":"أ) مهارة مكتسبة بالكامل ولا تعتمد على الفطرة","B":"ب) نقطة انطلاق قوية وبذرة كامنة تحتاج لتدريب مستمر ورعاية بيئية لتتحول إلى إبداع","C":"ج) محرك عقلي عام يستخدم لحل كافة المشكلات","D":"د) تتشكل حصرياً من خلال التنشئة دون أي أساس عصبي","answer":"B","topic_question_no":1},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يمتلك طفل قدرة فطرية مذهلة على التمييز بين الألوان ودمجها، لكنه نشأ في بيئة تفتقر لأي أدوات فنية ولم يتلقَ أي توجيه، فلم يطور هذه القدرة أبداً. يشير هذا الموقف إلى غياب إحدى ركائز الموهبة وهي","A":"أ) الركيزة الفطرية والعصبية","B":"ب) الاستعداد البيولوجي الكامن","C":"ج) التفكير التباعدي والأصالة","D":"د) الركيزة البيئية والرعاية التي توفر أدوات الصقل والتدريب","answer":"D","topic_question_no":2},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يخطئ البعض في حصر الموهبة في مجالات الرسم أو الغناء فقط. فعندما نـجد طالباً يمتلك قدرة استثنائية على التحليل المنطقي العميق، وسرعة فائقة في حل المشكلات البرمجية المجردة، فإننا نتحدث عن موهبة","A":"أ) قيادية واجتماعية","B":"ب) حركية وميكانيكية","C":"ج) فكرية وأكاديمية","D":"د) وجدانية وتعبيرية","answer":"C","topic_question_no":3},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يتمتع أحد الأفراد بكاريزما طاغية، وقدرة فطرية على استشعارات مشاعر من حوله، مما يجعله قادراً على فض النزاعات وقيادة فريقه للنـجـاح في أوقات الأزمات بسلاسة. يصنف هذا الشخص ضمن أصحاب الموهبة","A":"أ) الإبداعية والفنية","B":"ب) القيادية والاجتماعية","C":"ج) الفكرية والأكاديمية","D":"د) الميكانيكية والحركية","answer":"B","topic_question_no":4},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"صانع ساعات تقليدي يمتلك دقة لا متناهية وتآزراً عصبياً دقيقاً يمكنه من فك وتركيب تروس مجهرية ببراعة يدوية استثنائية دون أن ترتجف يده. هذا الإبداع يمثل تجسيداً للموهبة","A":"أ) الوجدانية والتعبيرية","B":"ب) الفكرية والأكاديمية","C":"ج) الإبداعية والفنية المجردة","D":"د) الحركية والميكانيكية","answer":"A","topic_question_no":5},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يميل الطلاب الموهوبون عادة إلى طرح أسئلة عميقة تبحث عن الجذور، ويمتلكون فضولاً علمياً لا يكتفي بالإجابات السطحية، مع قدرتهم على ابتكار حلول جديدة وكرههم الشديد للروتين. هذه الخصائص تندرج ضمن","A":"أ) السمات الوجدانية والانفعالية للموهوبين","B":"ب) السمات الاجتماعية والقيادية","C":"ج) السمات المعرفية والعقلية للموهوبين","D":"د) السمات الحركية والتآزر العصبي","answer":"C","topic_question_no":6},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يعاني بعض الموهوبين من توتر مستمر وشعور دائم بعدم الرضا عن أعمالهم، وذلك لأنهم يضعون لأنفسهم معايير أداء خيالية، ولا يتقبلون أي نتيجة أقل من المثالية. تُعرف هذه السمة الانفعالية بـ","A":"أ) السعي المتواصل للكمال","B":"ب) تحمل الغموض والمخاطرة","C":"ج) الحساسية المرهفة والتعاطف","D":"د) الاستقلالية في تكوين الآراء","answer":"A","topic_question_no":7},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يقضي مخترع شاب ساعات طويلة متواصلة في محاولة إصلاح جهاز معقد، متجاهلاً تعبه وحاجته للنوم، ليس طمعاً في مكافأة فورية، بل مدفوعاً بحبه العميق وشغفه بهذه المهمة. تعكس هذه الحالة إحدى السمات الدافعية للموهوبين وهي","A":"أ) الدافعية الذاتية للمثابرة النابعة من حب المهمة","B":"ب) كراهية الروتين والجمود الفكري","C":"ج) الفضول العلمي لطرح الأسئلة","D":"د) السعي لتحقيق كماليات المظهر الاجتماعي","answer":"A","topic_question_no":8},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"كثيراً ما يساء فهم الطالب الموهوب داخل الفصل الدراسي المكتظ؛ حيث قد يفسر المعلم «استقلالية» الموهوب و«فضوله الدائم» بطريقة خاطئة على أنهما سبب في","A":"أ) دليل على الرغبة في الانعزال والاكتئاب","B":"ب) تمرد وتشويش على سير الحصة يتطلب الكبت","C":"ج) محاولة للسيطرة على إدارة المدرسة","D":"د) افتقار لمهارات التفكير التباعدي","answer":"B","topic_question_no":9},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يكمن الفارق العلمي الدقيق بين الموهبة والمهارة؛ في أن الموهبة هي استعداد بيولوجي فطري يولد به الإنسان، بينما تمثل المهارة كفاءة أدائية إجرائية","A":"أ) فطرية تظهر فجأة دون أي مقدمات","B":"ب) تتأثر بالوراثة الجينية لعمى الألوان فقط","C":"ج) مكتسبة بالكامل عبر الخبرة والممارسة والتدريب","D":"د) تعتبر محركاً عاماً لحل المشكلات في جميع المجالات","answer":"C","topic_question_no":10},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يُنظر للموهبة في علم النفس الحديث على أنها استعداد فطري وقدرة استثنائية كامنة يولد بها الفرد، لكن لكي تتحول هذه الموهبة الكامنة إلى إبداع ملموس ونـجاح فائق، فإنها تحتاج حتماً إلى","A":"أ) إلغاء المرونة العصبية للدماغ لتركيز الطاقة.","B":"ب) تدريب مستمر ورعاية وتوفير بيئة محفزة تصقل هذا الاستعداد.","C":"ج) التخلي التام عن الجهد والاعتماد الكلي على البذرة الفطرية وحدها.","D":"د) مسايرة القطيع وتجنب المخاطرة والمجهول.","answer":"B","topic_question_no":11},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"المرونة العصبية للدماغ البشري قدرة مذهلة تفسر ظاهرة نـجاح الأفراد ذوي الإعاقات في تحقيق مستويات تفوق الأصحاء في مجالات معينة، التفسير العلمي لذلك هو أن الدماغ يقوم بـ","A":"أ) إيقاف عمل جميع الذكاءات المتعددة للتركيز على الجسد فقط.","B":"ب) الاستسالم لفقدان الحاسة والتوقف عن التطور المعرفي.","C":"ج) توجيه طاقته والتعويض العصبي لتعويض الحاسة المفقودة بمستويات عليا من القدرات الأخرى.","D":"د) تغيير التركيب الجيني للفرد لإعادة إنبات العضو المفقود.","answer":"C","topic_question_no":12},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"تمتلك مريم قدرة فطرية على استيعاب المعادلات الفيزيائية المعقدة وتحليلها منطقياً بسرعة تفوق أقرانها، وتمتلك ذاكرة حديدية لاسترجاع القوانين، هذا التميز يصنف علمياً ضمن مجال الموهبة","A":"أ) الوجدانية والتعبيرية.","B":"ب) الإبداعية والفنية.","C":"ج) القيادية والاجتماعية.","D":"د) الفكرية والأكاديمية.","answer":"D","topic_question_no":13},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"أثناء أزمة خانقة واجهت فريق العمل، برز موظف صغير في السن يمتلك قدرة فطرية غريبة على التأثير في زملائه (كاريزما)، وتمكن من امتصاص غضبهم، والإحساس بمشاعرهم، وتوجيههم لبناء توافق يخرجهم من الأزمة بنـجاح، نوع الموهبة التي يمتلكها هذا الموظف هي","A":"أ) الموهبة الحركية والميكانيكية.","B":"ب) الموهبة القيادية والاجتماعية.","C":"ج) الموهبة الإبداعية (التفكير التباعدي).","D":"د) الموهبة الفكرية والأكاديمية.","answer":"B","topic_question_no":14},{"exam_id":"U4-COMPREHENSIVE","unit":4,"topic":"الموهبة وتنميتها: كيف أكتشف موهبتي؟","question":"يتميز الموهوبون بسمات معرفية وعقلية قوية تمكنهم من الغوص في التفاصيل واستيعابها، من أبرز هذه السمات التي تجعلهم يبتكرون حلولاً جديدة ويكرهون الروتين التقليدي في حل المشكلات","A":"أ) السعي المتواصل للكمال المرضي.","B":"ب) المرونة الفكرية والفضول العلمي الذي يبحث عن الجذور.","C":"ج) التبعية المطلقة لآراء الأغلبية.","D":"د) تجنب الغموض والمخاطرة المحسوبة بأي ثمن.","answer":"B","topic_question_no":15}],"U5-COMPREHENSIVE":[{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"ترفض التوجهات المعاصرة في علم النفس الاعتماد على \"النموذج الطبي\" لتقييم حالة الإنسان النفسية، حيث يعتبر هذا النموذج قاصراً لكونه يعتمد على افتراض أساسي مفاده أن:","A":"أ) الصحة النفسية تتحقق بمجرد غياب المرض أو الاضطراب، متجاهلاً أن غياب المرض لا يعني بالضرورة العافية والرفاه","B":"ب) الفرد يحتاج إلى بناء علاقات دافئة لكي يتخلص من الفراغ الوجودي والمشكلات المادية","C":"ج) التوافق الاجتماعي داخل بيئة العمل هو المؤشر الوحيد على خلو الفرد من الأمراض البيولوجية","D":"د) الصحة النفسية تقتصر على قدرة الفرد على إخفاء الحيل الدفاعية اللاشعورية عن المجتمع","answer":"A","topic_question_no":1},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"موظف متفوق في عمله، لكنه يعاني دائماً من الإرهاق الشديد بسبب عجزه التام عن رفض أي مهام إضافية تُطلب منه، خوفاً من أن يغضب زملاؤه أو مديره، ويتحمل أعباء تفوق طاقته بشعور دائم بالذنب. يفتقر هذا الموظف إلى أحد مقومات الصحة النفسية وهو:","A":"أ) التخلي عن جلد الذات المفرط","B":"ب) الإحساس بالمعنى وامتلاك رسالة إنسانية","C":"ج) الكفاءة الاجتماعية وامتلاك مهارة \"التوكيدية\"","D":"د) المرونة النفسية وتجاوز المحن","answer":"C","topic_question_no":2},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"تعرض شخص لانتكاسة مالية أفقدته مشروعه الذي بناه لسنوات. بدلاً من انهياره، استوعب الصدمة، وقام بتحليل أخطائه، ثم بدأ مشروعاً جديداً بمهارات وخبرات أعمق لم يكن يمتلكها سابقاً. تُعرف هذه القدرة الديناميكية على العودة للتوازن والتطور بـ:","A":"أ) الاستقلالية ومقاومة الضغوط","B":"ب) المرونة النفسية و\"النمو ما بعد الصدمة\"","C":"ج) تقبل الذات والاعتراف بنقاط الضعف","D":"د) التوافق البيئي وحل المشكلات الاجتماعية","answer":"B","topic_question_no":3},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"يعيش بعض الشباب في حالة من التخبط والاكتئاب رغم توفر كافة الاحتياجات المادية والأمان الأسري، وذلك لعدم وجود غاية يسعون إليها أو قيمة يضيفونها لمن حولهم. الدرع الواقي الذي يقترحه علم النفس ضد هذا \"الفراغ الوجودي\" هو:","A":"أ) الإحساس بالمعنى عبر امتلاك هدف واضح ورسالة إنسانية","B":"ب) استخدام الحيل الدفاعية كالتعويض","C":"ج) الانفصال الاستراتيجي الواعي عن البيئة","D":"د) التنازل عن الاستقلالية لتلبية رغبات المجتمع","answer":"A","topic_question_no":4},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"عند تقييم العوامل المؤثرة في الصحة النفسية، نـجد أن هناك تداخلًا بين الجسد والبيئة. فبينما تلعب البيئة دوراً في تقديم الدعم أو التسلط، يقتصر دور \"العوامل البيولوجية\" بشكل أساسي على:","A":"أ) تحديد طبيعة الأحداث الضاغطة والمحن التي سيمر بها الفرد مستقبلاً","B":"ب) رسم الحدود الشخصية وتطوير مهارة التوكيدية","C":"ج) كيمياء الدماغ المنظمة للمزاج، والجينات المحددة للاستعداد الانفعالي، والتاريخ الصحي","D":"د) صياغة أساليب التنشئة الأسرية ونقلها للأجيال القادمة","answer":"C","topic_question_no":5},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"يمر جميع الطلاب بضغوط نفسية وقلق ملحوظ خلال فترة الامتحانات النهائية. لكي يحكم الأخصائي النفسي بأن هذا الضغط الطبيعي قد تحول إلى \"اضطراب نفسي\" يستوجب تدخلاً، فإنه يعتمد على معايير محددة من بينها:","A":"أ) ظهور الحيل الدفاعية كالتبرير بشكل مؤقت بعد الامتحان","B":"ب) شدة المشاعر المفرطة، واستمرارها لأسابيع بعد زوال المسبب، وإعاقتها للحياة اليومية","C":"ج) قدرة الطالب على التوافق الاجتماعي مع زملائه داخل اللجان","D":"د) استخدام الطالب لمهارات الرفاه الرقمي أثناء المذاكرة","answer":"B","topic_question_no":6},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"تصفحت فتاة حسابات صديقاتها على وسائل التواصل الاجتماعي، فشاهدت صوراً مثالية لرحلاتهن ونـجـاحاتهن المستمرة، مما جعلها تشعر بالنقص الشديد والتعاسة تجاه حياتها العادية المليئة بالتحديات. للتعامل مع هذا التحدي الرقمي، ينصح علم النفس بـ:","A":"أ) زيادة التفاعل الاجتماعي مع هذه الحسابات لاكتساب المرونة","B":"ب) استخدام حيلة الإسقاط لاتهام الصديقات بالزيف","C":"ج) الحذر من المقارنات الوهمية بين كواليس حياتها الحقيقية واللقطات المثالية المصطنعة للآخرين","D":"د) التخلي عن تقبل الذات والسعي للكمالية المرضية لتطابق الصور","answer":"C","topic_question_no":7},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"العلاقة بين \"التوافق النفسي\" و\"التوافق الاجتماعي\" هي علاقة ديناميكية تكاملية لا يمكن فصلها. ويظهر هذا التكامل جلياً في القاعدة النفسية التي تؤكد على أنه:","A":"أ) يجب أن يتخلى الفرد عن التوافق النفسي إذا تعارض مع قواعد الجماعة لتحقيق التوافق الاجتماعي","B":"ب) التوافق النفسي يمنح الفرد الصلابة لبناء العلاقات، والنـجـاح الاجتماعي يعزز الرضا عن الذات","C":"ج) التوافق الاجتماعي يعتمد حصرياً على العوامل البيولوجية، بينما التوافق النفسي يعتمد على البيئة","D":"د) لا يوجد أي رابط بين تقبل الذات داخلياً وبين العمل بروح الفريق خارجياً","answer":"B","topic_question_no":8},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"أخطأ موظف في إعداد تقرير هام مما تسبب في خسارة لشركته. وبدلاً من تحمل المسؤولية، بدأ في تقديم أعذار تبدو عقلانية مقنعة نفسه بأن \"أجهزة الحاسوب كانت بطيئة وأن وقت التسليم كان غير منطقي\". هذه الاستراتيجية اللاشعورية تسمى:","A":"أ) الكبت","B":"ب) الإسقاط","C":"ج) التبرير","D":"د) التعويض","answer":"C","topic_question_no":9},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"شخص يتسم بالبخل الشديد والحرص المبالغ فيه على المال، ولكنه لا يرى هذا العيب في نفسه أبداً، بل يوجه اتهامات دائمة لجميع أقاربه وأصدقائه بأنهم ماديون ولا يهتمون إلا بالمال. الميكانيزم النفسي الدفاعي المستخدم هنا هو:","A":"أ) التعويض","B":"ب) الإسقاط","C":"ج) الكبت","D":"د) الانفصال الواعي","answer":"B","topic_question_no":10},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"صممت إحدى المنظمات استبياناً لقياس مستوى الصحة النفسية للعاملين فيها. استبعد مصمم الاستبيان الأسئلة التي تسأل فقط عن عدم وجود أمراض عصبية أو زيارات لعيادات الطب النفسي، واستبدلها بأسئلة حول مدى شعور الموظف بقدرته على التعلم، والمساهمة في مجتمعه، وتحمل الضغوط. هذا التغيير المنهجي في تصميم الاستبيان يعتمد على","A":"أ) مبدأ استقلالية الهوية داخل الجماعة وتجنب الذوبان فيها","B":"ب) تعريف منظمة الصحة العالمية الذي يركز على الرفاه النفسي وإعمال القدرات","C":"ج) النموذج الطبي التقليدي الذي يحصر الصحة في غياب الأعراض","D":"د) الحيل الدفاعية اللاشعورية التي يخفي بها الفرد عيوبه","answer":"B","topic_question_no":11},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"بطل رياضي حصل على الميدالية الفضية في بطولة عالمية، وبدلاً من الاحتفال بإنـجازه، دخل في نوبة بكاء هستيري واعتزل اللعبة، مبرراً ذلك بأنه إما أن يكون في المركز الأول أو أنه لا يساوي شيئاً. هذه الحالة النفسية المعيقة تدل على افتقار الرياضي لأحد مقومات الصحة النفسية وهو","A":"تقبل الذات والتخلي عن وهم الكمالية المرضية","B":"الكفاءة الاجتماعية وممارسة التوكيدية","C":"الإحساس بالمعنى ووجود رسالة إنسانية","D":"التوافق البيئي وقراءة الواقع باحترام","answer":"A","topic_question_no":12},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"كاتبة شابة ُرفضت روايتها الأولى من قبل عشر دور نشر مختلفة. بدلاً من الاستسالم لليأس، استخدمت الانتقادات القاسية التي وجهت لها لإعادة كتابة الرواية بأسلوب جديد تماماً، وتعلمت مهارات تسويق الكتب حتى نـجحت في نشرها ذاتياً محققة مبيعات هائلة. يُطلق علم النفس على هذه القدرة الديناميكية المذهلة اسم","A":"التبرير العقلاني لتجنب الشعور بالفشل","B":"التوكيدية في رسم الحدود وحماية الكرامة","C":"المرونة النفسية وتحقيق النمو ما بعد الصدمة","D":"الانفصال الاستراتيجي الواعي عن البيئة الضاغطة","answer":"C","topic_question_no":13},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"مدير تنفيذي يتقاضى راتباً خيالياً ويمتلك سلطة واسعة، ورغم ذلك يعاني من شعور قاتل بالملل والاكتئاب، ويصرح دائماً بأن أيامه تتكرر بلا غاية وأن حياته فارغة. المقوم النفسي الذي يشكل درعاً واقياً ضد هذا الفراغ الوجودي ويفتقده هذا المدير هو","A":"تقبل نقاط الضعف بلا خجل","B":"الإحساس بالمعنى عبر امتلاك هدف واضح ورسالة تتجاوز المنفعة الذاتية","C":"مقاومة الضغوط الاجتماعية لتحقيق الاستقلالية","D":"استخدام حيلة التعويض لتغطية النقص العاطفي","answer":"B","topic_question_no":14},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"صحتي النفسية: كيف أحقق التوافق مع نفسي والآخرين؟","question":"فتاة جامعية توافق دائماً على إعارة سيارتها لزميلتها المستهترة رغم حاجتها الماسة للسيارة، وتقوم بكتابة الأبحاث نيابة عن باقي زملائها في المجموعة لكي يتجنبوا الغضب منها، مما يستنزف وقتها وصحتها. الأداة النفسية التي تحتاج هذه الفتاة للتدرب عليها فوراً هي","A":"مهارة التوكيدية وبناء الحدود وقول لا دون الشعور بالذنب","B":"مهارة الإسقاط النفسي لاتهام زملائها بالاستغلال","C":"الانفصال الاستراتيجي التام عن الحياة الجامعية","D":"التخلي عن الإحساس بالمعنى لتقليل سقف التوقعات","answer":"A","topic_question_no":15},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يرفض علم النفس النظرة السطحية التي تحكم على شخصية الفرد من خلال مظهره الخارجي أو نبرة صوته فقط، ويستبدل ذلك بتعريف علمي دقيق يؤكد أن الشخصية هي:","A":"أ) مجموعة من السمات الجسدية الموروثة التي لا تتغير بتغير البيئة","B":"ب) التنظيم الديناميكي والمتكامل والنامي داخل الفرد، والذي يحدد طريقته الفريدة في التفكير والشعور والتكيف","C":"ج) الاستجابات اللحظية المتقطعة التي لا يربطها أي تنظيم عقلي أو وجداني","D":"د) قدرة الفرد على استنسخ سلوكيات الآخرين لتحقيق التوافق الاجتماعي","answer":"B","topic_question_no":1},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تلعب التنشئة الأسرية دوراً محورياً في بناء الشخصية الإنسانية. فبينما تؤدي التربية القائمة على الحوار والدعم إلى إنتاج شخصية واثقة ومستقلة، فإن الإفراط في \"الحماية الزائدة\" من قبل الآباء ينتج عنه غالباً شخصية تتسم بـ:","A":"أ) الإبداع وحل المشكلات المعقدة","B":"ب) الانفتاح العالي على الخبرات الجديدة","C":"ج) الاعتمادية والتمرد المستمر","D":"د) يقظة الضمير والتنظيم الذاتي العالي","answer":"C","topic_question_no":2},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"وفقاً لنموذج العوامل الخمسة الكبرى للشخصية (Big Five)، فإن الشخص الذي يتميز بأنه \"محب للتجديد والمغامرة، مبدع، واسع الخيال، وفضولي يبحث عن أفكار خارج الصندوق\" يمتلك درجة مرتفعة في سمة","A":"أ) يقظة الضمير (التفاني)","B":"ب) الانبساطية","C":"ج) الانفتاح على الخبرة","D":"د) المقبولية","answer":"C","topic_question_no":3},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"أثناء العمل على مشروع جماعي، برز أحد الطلاب بقدرته الفائقة على الانضباط، وتنظيم المهام بدقة، والتخطيط الجيد قبل اتخاذ أي قرار، مع تحمله للمسؤولية حتى تسليم المشروع في موعده. هذا السلوك يمثل الجانب الإيجابي (الدرجة المرتفعة) لسمة","A":"أ) العصابية (الاتزان الانفعالي)","B":"ب) الانفتاح على الخبرة","C":"ج) المقبولية والود","D":"د) يقظة الضمير (التفاني)","answer":"D","topic_question_no":4},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تختلف طريقة استمداد الطاقة النفسية بين الأفراد بناءً على سمة \"الانبساطية.\" فالشخص الذي يسجل \"درجة منخفضة\" في هذه السمة (الانبواطي) يميل عادة إلى","A":"أ) استمداد طاقته من التواجد المستمر وسط حشود الناس وحب القيادة","B":"ب) الاستقلال واستمداد طاقته من الهدوء وتفضيل الإنـجاز الفردي والصداقات العميقة","C":"ج) الاندفاع والتهور والعشوائية في اتخاذ القرارات المصيرية","D":"د) الشك الدائم في نوايا الآخرين والمنافسة الشرسة معهم","answer":"B","topic_question_no":5},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"في بيئة العمل، يعرف الموظف الذي يسعى دائماً لاحتواء الخلافات بين زملائه، ويتسم بالرحمة والدبلوماسية، ويفضل التعاون على المنافسة الشرسة، بأنه شخص يسجل درجة مرتفعة في عامل","A":"أ) الانفتاح على الخبرة","B":"ب) الانبساطية","C":"ج) العصابية","D":"د) المقبولية","answer":"D","topic_question_no":6},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"واجه فريقان أزمة مفاجئة هددت استمرار عملهما. قائد الفريق الأول بدأ في التفكير بعقلانية بهدوء وبحث عن بدائل ميدانية، بينما دخل قائد الفريق الثاني في حالة من القلق والتشاؤم وبدأ بتضخيم الإحباط وإلقاء اللوم. الاختلاف الجوهري بين القائدين يكمن في سمة","A":"أ) الانفتاح على الخبرات الجديدة والمغامرة","B":"ب) العصابية (الاتزان الانفعالي العالي مقابل المنخفض)","C":"ج) يقظة الضمير في القدرة على التخطيط المبكر","D":"د) المقبولية والتعاطف مع الآخرين","answer":"B","topic_question_no":7},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تلعب العوامل البيولوجية والوراثية دوراً في التكوين الأساسي لشخصية الفرد، ولا يقتصر هذا الدور على الشكل الخارجي، بل يمتد ليحدد جوانب عميقة مثل","A":"أ) نوع التنشئة الثقافية التي سيتعرض لها الفرد مستقبلاً","B":"ب) استعدادات عصبية كحساسية الجهاز العصبي وتوازن الموصلات الدماغية المؤثرة في الاندفاع","C":"ج) طريقة تعامل الفرد مع الخوارزميات الرقمية في الفضاء الافتراضي حصراً","D":"د) اكتساب الفرد لمهارة الحوار والدعم المدرسي بشكل تلقائي","answer":"B","topic_question_no":8},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يعتبر \"التكامل والشمول\" من الحقائق الجوهرية في فهم الشخصية، وهذا يعني أن أي سلوك يصدر عن الإنسان (كاتخاذ قرار مهني) هو في الواقع","A":"أ) ناتج عن نشاط جزء واحد فقط من الدماغ دون تدخل المشاعر","B":"ب) نتيجة لتفاعل جميع أجهزته النفسية والعصبية والمعرفية والوجدانية","C":"ج) رد فعل لحظي غير مرتبط بماضيه أو جيناته الوراثية","D":"د) تأثير خالص للبيئة الرقمية دون تدخل التكوين البيولوجي","answer":"B","topic_question_no":9},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"عند تشكيل فريق لإدارة \"المخاطر ووضع خطط الطوارئ\" في شركة مالية كبرى، فإن النمط الشخصي الأنسب (وفقاً لـ العوامل الخمسة الكبرى) والذي يميل للتحليل الحذر هو الذي يجمع بين","A":"أ) الانفتاح العالي على الخبرة والانبساطية المفرطة","B":"ب) يقظة الضمير المرتفعة والاتزان الانفعالي العالي","C":"ج) المقبولية المنخفضة والانبساطية المنخفضة","D":"د) العصابية العالية (قلق وتوتر) والانفتاح المرتفع","answer":"B","topic_question_no":10},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"يُعد فهمنا لمفهوم الشخصية خطوة أساسية في علم النفس. أي من العبارات التالية يتطابق مع التعريف العلمي الدقيق للشخصية؟","A":"أ) . د) هي المرادف الدقيق لمستوى الذكاء الأكاديمي والتحصيل الدراسي للفرد","B":"ب) مجموعة ثابتة من الاستجابات الموروثة التي لا تقبل التعديل بتغير البيئة","C":"ج) التنظيم الديناميكي المتكامل والنامي داخل الفرد، والذي يشمل أجهزته النفسية والعصبية والجسدية، ويحدد طريقته الفريدة في التفكير والشعور","D":"د) هي الانطباع الخارجي الذي يتركه الفرد بناءً على مظهره وصوته فقط","answer":"C","topic_question_no":11},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"تلعب التنشئة الأسرية والبيئة الاجتماعية دوراً حاسماً في صياغة شخصية الطفل. فالتربية التي تعتمد على التسلط والحماية الزائدة تفرز غالباً شخصية تعاني من","A":"أ) الاستقلالية المفرطة والجرأة في الحق","B":"ب) الاعتمادية على الآخرين والتمرد العشوائي","C":"ج) يقظة الضمير العالية والتنظيم الذاتي الصارم","D":"د) المرونة النفسية والقدرة على التعافي السريع","answer":"B","topic_question_no":12},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"في سياق تحليل الشخصية، ماذا يُقصد بأن \"التفرد والبصمة السلوكية\" هي إحدى الحقائق الجوهرية للشخصية؟","A":"أ) أن العوامل الوراثية وحدها هي من ترسم شكل السلوك البشري دون استثناء","B":"ب) أن جميع الأشخاص الذين يتلقون نفس التعليم سيتصرفون بنفس الطريقة تماماً","C":"ج) أن التفاعل المعقد بين البيولوجيا والبيئة والخبرات يُنتج تركيبة فريدة، تجعل استجابة كل إنسان للمثيرات أمراً خاصاً لا يتطابق مع غيره","D":"د) أن سمات الشخصية تعمل بشكل منفصل عن بعضها البعض دون أي تكامل","answer":"C","topic_question_no":13},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"موظفة تُكلف بمهام إدارية روتينية، لكنها دائماً ما تبحث عن طرق مبتكرة لإنـجازها، وتقضي وقتها في القراءة لاكتشاف أفكار (خارج الصندوق)، وتعشق التغيير المستمر. وفقاً لنموذج العوامل الخمسة (Big Five)، هذه الموظفة تمتلك درجة مرتفعة في سمة","A":"أ) المقبولية","B":"ب) يقظة الضمير (التفاني)","C":"ج) الانفتاح على الخبرة","D":"د) العصابية (الاتزان الانفعالي المنخفض)","answer":"C","topic_question_no":14},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"شخصيتي: كيف أفهمها وأطورها؟","question":"عند مقارنة الفرد ذي المقبولية المرتفعة (الجانب الإيجابي) بزميله ذي المقبولية المنخفضة (الجانب السلبي) في بيئة العمل، نـجد أن الأول يميل إلى الدبلوماسية والرحمة، بينما يميل الثاني بشكل واضح إلى","A":"أ) الارتجال العشوائي والتسويف الدائم للمهام","B":"ب) أن يكون حاد الطباع، شكاكاً في النوايا، يفضل المنافسة على التعاون، ونقده مباشر وقاسٍ","C":"ج) الانطواء التام واستمداد الطاقة من الهدوء والعزلة","D":"د) القلق الشديد وسرعة التوتر عند مواجهة أي ضغط مهني","answer":"B","topic_question_no":15},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"المفهوم العلمي الدقيق لـ \"جودة الحياة\" في علم النفس لا يقتصر أبداً على مجرد امتلاك الفرد للثراء المادي الاستهلاكي، بل يعتمد في جوهره على","A":"أ) التزام الفرد بالانعزال التام عن المجتمع لتوفير الطاقة","B":"ب) إدراك الفرد التقييمي والشامل لدرجة الرضا والإيجابية والإشباع التي يختبرها في كافة جوانب حياته وفقاً لمنظومة قيمه","C":"ج) التوافق الجسدي حصراً دون النظر للجانب الوجداني أو المهني","D":"د) نـجـاح الفرد في إثبات تفوقه على جميع أقرانه في منصات التواصل الاجتماعي","answer":"B","topic_question_no":1},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"تتكون جودة الحياة من ركيزتين: جانب موضوعي وجانب ذاتي. يؤكد علماء النفس أن \"الجانب الذاتي\" هو الأهم في تحديد مستوى سعادة الفرد لأنه يمثل","A":"أ) توفر الاحتياجات المادية الأساسية كالمسكن والدخل والأمان","B":"ب) القدرة على تجميع أكبر قدر من الممتلكات ومقارنتها بالآخرين","C":"ج) تقييم الفرد التفاؤلي لظروفه، واستمتاعه بالمتاح، والامتنان والصلابة النفسية لتحويل العثرات لدرجات ارتقاء","D":"د) التمتع بصحة جسدية تامة خالية من أي إصابات طوال الحياة","answer":"C","topic_question_no":2},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"شخص يمتلك وظيفة ذات دخل مرتفع، وسكناً آمناً، وتأميناً صحياً ممتازاً (توفر الجانب الموضوعي)، ولكنه دائم الشكوى، يشعر بالنقص المستمر، ولا يمتلك أي قدرة على تحويل العثرات لدروس مستفادة. هذا الشخص يعاني من ضعف حاد في جودة حياته ناتج عن خلل في","A":"أ) العامل الجسدي البيولوجي","B":"ب) العامل النفسي والجانب الذاتي التقييمي","C":"ج) البيئة المجتمعية والمساحات الخضراء","D":"د) الجانب الموضوعي المادي","answer":"B","topic_question_no":3},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"أحد العوامل المؤثرة في جودة الحياة هو \"العامل المهني\". ويحذر علم النفس من حالة خطيرة تُعتبر من أشد العوامل تدميراً لجودة الحياة وتسبباً مباشراً في الاكتئاب وفقدان الإحساس بالمعنى، وهي حالة","A":"أ) الفراغ والبطالة وانعدام الشعور بالإنتاجية","B":"ب) العمل ضمن فريق يمتلك تنوعاً في السمات الشخصية","C":"ج) الانتقال التدريجي لتقبل الذات وتجنب الكمالية","D":"د) الانخراط في ممارسة الرياضة بشكل يومي منتظم","answer":"A","topic_question_no":4},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"تُعد \"العلاقات الاجتماعية\" المنبئ الأقوى بالسعادة وطول العمر وفقاً للدراسات النفسية، ويعود ذلك لعدة أسباب فسيولوجية ونفسية، من أبرزها أن شبكة الدعم الصادقة (كالإنصات والمؤازرة) تقوم بـ","A":"أ) زيادة الشعور بالمنافسة الشرسة داخل الأسرة مما يحفز الإنـجاز المادي","B":"ب) تخفيف إفراز هرمونات التوتر من الغدتين الكظريتين لتعمل كمظلة حماية نفسية","C":"ج) إلغاء حاجة الفرد لممارسة مهارة التوكيدية مع الآخرين","D":"د) تعزيز المقارنات الاجتماعية الهابطة لرفع الغرور الذاتي المؤقت","answer":"B","topic_question_no":5},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"لكي يضمن الفرد أن تساهم علاقاته الاجتماعية في رفع \"جودة الحياة\" بدلاً من تدميرها، فإنه يحتاج إلى ممارسة مهارة إدارة العلاقات بقوة، والتي تتطلب منه أساساً","A":"أ) السعي لزيادة عدد المتابعين الافتراضيين وتجاهل العمق العاطفي","B":"ب) الموافقة الدائمة على طلبات الأصدقاء لتجنب غضبهم حتى لو استنزفوا طاقته","C":"ج) ممارسة الحزم والتوكيدية لوضع حدود تحمي طاقته من الشخصيات السلبية المستنزفة، فالجودة تُقاس بالعمق والأمان","D":"د) فرض عزلته الخاصة وقطع كافة أشكال التواصل عند أول خلاف بسيط","answer":"C","topic_question_no":6},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"لتحقيق التوازن الضروري بين \"الحياة الواقعية المباشرة\" و\"الحياة الرقمية الافتراضية\"، ينصح خبراء الصحة النفسية بتطبيق استراتيجية \"الفصل المكاني والزماني الصارم\". التطبيق العملي الأفضل لهذه الاستراتيجية هو","A":"أ) متابعة الإشعارات أثناء الجلسات العائلية فقط لضمان عدم تفويت الأخبار الهامة","B":"ب) دمج الشاشات في كل تفاصيل اليوم لتوثيق جميع اللحظات فوراً لتعزيز الذكريات","C":"ج) منع وجود الشاشات تماماً في أوقات وأماكن محددة كطاولة الطعام العائلية لحماية الروابط والانتباه المباشر","D":"د) تخصيص وقت الشاشة لاستهلاك المحتوى الترفيهي التافه للهروب من الضغوط اليومية","answer":"C","topic_question_no":7},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"أثناء قضاء نزهة في الطبيعة الخلابة مع أصدقائه، أمضى شاب معظم وقته في التقاط مئات الصور ونشرها فوراً على حساباته، وقراءة التعليقات عليها، بدلاً من الاستمتاع بالمنظر أو التحدث مع أصدقائه. هذا الشاب يخل بمبدأ أساسي لجودة الحياة الرقمية وهو","A":"أ) الاستخدام الرقمي للإنتاج وتطوير الذات بدلاً من التمرير اللانهائي","B":"ب) سيادة العالم الواقعي المباشر، وعيش اللحظة بالحواس الخمس وجعل التوثيق أمراً ثانوياً","C":"ج) الانقطاع الرقمي الدوري لتنظيف الجهاز العصبي","D":"د) السعي للانتماء عبر الانضمام لفرق تطوعية ميدانية","answer":"B","topic_question_no":8},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"\"الخوف من تفويت الأشياء\" (FOMO) ظاهرة نفسية تدفع الإنسان لتفقد شاشاته بشكل قهري مستمر خوفاً من غيابه عن الأحداث. السيطرة على هذا القلق الداخلي تعتبر خطوة ضرورية لتحقيق","A":"أ) التحول نحو نموذج طبي تقليدي لتعريف العافية","B":"ب) الانخراط التام في المقارنات الاجتماعية الصاعدة","C":"ج) التوازن بين الحياة الواقعية والرقمية وحماية التركيز الذهني","D":"د) زيادة الاعتماد على الشخصيات السلبية المستنزفة لتقليل الوحدة","answer":"C","topic_question_no":9},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"من أجل استعادة الحساسية الطبيعية للجهاز العصبي تجاه الهدوء، وتخفيف حدة التوتر الناتج عن المؤثرات السريعة المتتالية، ينصح علم النفس بـ","A":"أ) التفريد المعرفي عبر مشاهدة مقاطع فيديو مزدوجة","B":"ب) الانقطاع الرقمي الدوري، كتخصيص عطلة للامتناع التام عن الشاشات والنزول للطبيعة (ديتوكس رقمي)","C":"ج) استخدام التوكيدية الحازمة للرد على المتنمرين عبر الإنترنت طوال الليل","D":"د) الانخراط المستمر في حالة التدفق (Flow) عبر ألعاب الفيديو العنيفة","answer":"B","topic_question_no":10},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"يشير المفهوم الدقيق لـ جودة الحياة في علم النفس إلى حقيقة هامة وهي أن جودة الحياة ليست مرتبطة تلقائياً بالثراء المادي، بل ترتكز جوهرياً على","A":"أ) الهروب المستمر من الضغوط لتحقيق السلام المؤقت","B":"ب) إدراك الفرد التقييمي الشامل لدرجة الرضا والإشباع في جوانب حياته ضمن منظومة قيمه","C":"ج) التوافق الجسدي والتغذية السليمة كعنصر وحيد للرفاه","D":"د) قدرة الفرد على استنساخ أسلوب حياة المشاهير الافتراضي","answer":"B","topic_question_no":11},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"تتألف جودة الحياة من جانبين متكاملين (موضوعي وذاتي). الجانب الموضوعي ضروري لتوفير الأساس، لكن علماء النفس يؤكدون أن \"الجانب الذاتي\" هو الأهم، لأنه يتمثل في قدرة الإنسان على","A":"أ) السيطرة المادية على مساحات خضراء واسعة","B":"ب) توفير الدخل الأساسي والرعاية الصحية للأقارب","C":"ج) التقييم التفاؤلي لظروفه، والامتنان للمتاح، والصلابة النفسية لتحويل العثرات لدرجات ارتقاء","D":"د) التنازل عن منظومة القيم لضمان تحقيق مكاسب مهنية سريعة","answer":"C","topic_question_no":12},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"العامل النفسي والوجداني هو ركيزة أساسية في جودة الحياة. يتحقق هذا العامل بقوة عندما يمارس الفرد سلوكاً داخلياً يحرره من القيود المرهقة، ويُعرف هذا السلوك بـ","A":"أ) التحرر من التفكير العقلاني في حل المشكلات","B":"ب) السعي المستميت للكمالية المرضية لتجنب أي نقد محتمل","C":"ج) التنظيم الانفعالي، التقييم الإيجابي للذات، والتحرر من \"الكمالية\" الخانقة التي لا تقبل الخطأ الطبيعي","D":"د) الكبت اللاشعوري لكافة الصدمات العاطفية القديمة لضمان نسيانها","answer":"C","topic_question_no":13},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"موظف يحصل على راتب ممتاز ويسكن في منزل آمن، لكن بيئة عمله تهمش أفكاره الإبداعية، ومديره ينسب الجهد لنفسه دائماً. الموظف يعاني هنا من تدني في جودة حياته بسبب خلل في العامل","A":"أ) الجسدي البيولوجي وتأثيره على النوم","B":"ب) البيئي والمهني الذي يفقد التقدير للجهد ويقمع مساحات الإبداع","C":"ج) الموضوعي المتمثل في توفير الاحتياجات الأساسية","D":"د) الشخصي المستقل عما حوله من متغيرات","answer":"B","topic_question_no":14},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"جودة حياتي: كيف أحققها في عالم متغير؟","question":"يُحذر علماء النفس من حالة خطيرة تضرب جودة الحياة في مقتل، وتعتبر من أشد العوامل المسببة لـ الاكتئاب السريري لكونها تسلب الفرد الشعور بالإنتاجية والإتقان في خدمة مجتمعه، هذه الحالة هي","A":"أ) زيادة ساعات العمل التطوعي في الجمعيات الأهلية","B":"ب) ممارسة الرياضة البدنية العنيفة","C":"ج) الفراغ، البطالة المستمرة، وانعدام الهدف المهني","D":"د) التفاعل المستمر مع شبكات الدعم الاجتماعي","answer":"C","topic_question_no":15},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"يعتبر علم النفس الإيجابي، الذي أسسه مارتن سليجمان عام 1998، تحولاً جذرياً في مسار علم النفس التقليدي، حيث يتميز بأنه ينقل التركيز من دراسة الأمراض وكيفية إصلاح العيوب (مجرد التعافي)، إلى","A":"أ) الاعتماد على الخيال والشعارات السطحية لرفع الروح المعنوية","B":"ب) الدراسة العلمية الصارمة لنقاط القوة والفضائل التي تمكن الأفراد من الازدهار والرفاه الفائق","C":"ج) إنكار وجود الحزن أو المشكلات في حياة الإنسان والتعامل بإيجابية سامة","D":"د) استخدام الحيل الدفاعية للهروب من الواقع المحبط وتزيين الحقائق","answer":"B","topic_question_no":1},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"إحدى الركائز العلمية التي تميز \"علم النفس الإيجابي\" عن كتب المساعدة الذاتية التجارية (التنمية البشرية السطحية) هي أنه","A":"أ) يبني نظرياته على الحدس الشخصي والتجارب الفردية العابرة للمؤلفين","B":"ب) ينكر وجود الألم النفسي ويطالب الفرد بابتسامة دائمة غير واقعية","C":"ج) يرتكز على منهجية علمية صارمة مبنية على التجارب، الدراسات الطولية، وقياس النشاط العصبي","D":"د) يعتمد حصرياً على المقارنات الاجتماعية لتحفيز الإنـجاز المادي السريع","answer":"C","topic_question_no":2},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"وفقاً لنموذج سليجمان للازدهار النفسي (PERMA)، فإن قدرة الفرد على الانفصال التام عن القلق، والاستغراق الكامل والعميق في أداء مهارة أو عمل يحبه لدرجة نسيان الوقت وما يحيط به، تُمثل عنصر","A":"أ) المعنى والرسالة الأكبر","B":"ب) العلاقات الإيجابية الداعمة","C":"ج) الإنـجاز وتحقيق الأهداف المادية","D":"د) الاندماج (حالة التدفق Flow)","answer":"D","topic_question_no":3},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"يشعر طبيب متطوع في مناطق الكوارث برضا نفسي هائل وازدهار داخلي يفوق ما يشعر به في عيادته الخاصة الفاخرة المربحة. يفسر نموذج (PERMA) هذه الحالة بأن الطبيب قد حقق عنصراً أساسياً للازدهار وهو","A":"أ) المشاعر الإيجابية اللحظية العابرة كالفرح السطحي","B":"ب) المعنى (الإحساس برسالة تخدم غاية إنسانية كبرى تتجاوز المنفعة الذاتية)","C":"ج) الانخراط في مقارنات اجتماعية صاعدة لتحقيق السلطة","D":"د) التمتع بمستوى عالٍ من الانفتاح على الخبرات الرقمية","answer":"B","topic_question_no":4},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"تتضمن \"الفضائل الإنسانية الست الكبرى\" في علم النفس الإيجابي فضيلة \"الاعتدال\". وتتجسد هذه الفضيلة عملياً في قدرة الإنسان وتدريبه على ممارسة","A":"أ) الإبداع والفضول والتفكير الناقد في استيعاب المعلومات المعقدة","B":"ب) الجرأة في قول الحق، والمثابرة والإصرار وقت الشدائد","C":"ج) التسامح والتواضع، التنظيم الذاتي وضبط الرغبات المندفعة والتروي قبل الحكم","D":"د) تذوق الجمال، الأمل المفرط وعاطفة المرح وروح الدعابة في كل الأوقات","answer":"C","topic_question_no":5},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"قرر مدير مدرسة تغيير بيئة التعليم لتتوافق مع تطبيقات \"علم النفس الإيجابي\". الخطوة الاستراتيجية الأولى التي يجب عليه اتخاذها لتحويل بيئة التعلم لبيئة \"مزدهرة\" هي","A":"أ) تكثيف التركيز على تصيد الأخطاء ومعاقبة الطلاب الضعفاء لضبط النظام","B":"ب) الاعتماد الكلي على اختبارات ورقية موحدة تقيس الذكاء المنطقي وإلغاء الأنشطة الفنية","C":"ج) الانتقال لتصميم أنشطة تُركز على اكتشاف نقاط القوة والذكاءات المتعددة لكل طالب وتوزيع الأدوار وفقاً لها لاستثمار الميزة الفريدة","D":"د) إجبار الطلاب المتفوقين على إخفاء قدراتهم لضمان مساواة صورية تمنع تنمر الأقران","answer":"C","topic_question_no":6},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"\"القيادة الإيجابية\" لا تعني تساهل المدير أو تسيبه، بل تعني تبني أسلوب إداري يحقق الازدهار لفريق العمل من خلال ممارسات محددة أهمها","A":"أ) استخدام السلطة القهرية لضمان الطاعة العمياء وتسريع الإنـجاز","B":"ب) توفير رسالة ملهمة للعمل، الاحتفال بالإنـجازات الصغيرة، وخلق بيئة عمل عادلة يشعر فيها الموظف بالأمان النفسي","C":"ج) تعزيز المنافسة الشرسة بين الموظفين والاعتماد على المقارنات النقدية اللاذعة لاكتشاف الأفضل","D":"د) كبت مشاعر الموظفين ومنع أي تواصل اجتماعي بينهم أثناء ساعات العمل لزيادة التدفق المهني","answer":"B","topic_question_no":7},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"ممارسة \"التقدير والامتنان الأسري\" تعد من أقوى التطبيقات لبناء روابط أسرية متينة ومزدهرة. التطبيق النفسي السليم للامتنان مع الأبناء يتطلب من الآباء أن يركزوا بشكل رئيسي على","A":"أ) مقارنة إنـجاز الابن المستمرة بإنـجازات زملائه الأفضل منه لدفعه للتفوق (مقارنة صاعدة)","B":"ب) مدح الجهد المبذول والمثابرة ولغة الامتنان الصريحة وتخصيص وقت لاستحضار الممتنات اليومية","C":"ج) ربط التقدير بحصول الابن على الدرجات النهائية فقط دون النظر لجهده أو محاولته","D":"د) استخدام حيلة التعويض لإجبار الابن على تحقيق أحلام الآباء التي فشلوا فيها","answer":"B","topic_question_no":8},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"تضم فضيلة \"الإنسانية\" في علم النفس الإيجابي مجموعة من السمات الراقية التي تحسن التوافق الاجتماعي، من أبرزها","A":"أ) الإبداع المعرفي والفضول لاكتشاف المجهول","B":"ب) العدالة في توزيع الموارد والقيادة المجتمعية المنصفة","C":"ج) المحبة واللطف والرحمة وتقديم المساعدة والذكاء الاجتماعي العاطفي","D":"د) التواضع ونكران الذات والتحكم في الغرائز","answer":"C","topic_question_no":9},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"لكي يحمي الشاب نفسه من الآثار المدمرة لـ \"الاستهلاك الإلكتروني المفرط والمقارنات المفلترة\"، ينصحه علم النفس الإيجابي بتوظيف فضيلتين أساسيتين هما","A":"أ) \"الإبداع\" لتصميم صور مزيفة، و\"المحبة\" للتعاطف مع المتنمرين","B":"ب) \"العدالة\" للمطالبة بالمساواة المطلقة، و\"الشجاعة\" للتشهير بالأصدقاء المخطئين","C":"ج) \"التنظيم الذاتي (الاعتدال)\" لفرض أوقات انقطاع صارمة، و\"الحكمة\" لمقاومة فخ المقارنات السامة وإدراك زيفها","D":"د) \"التسامي\" للهروب من الواقع في أحلام اليقظة، و\"حب التعلم\" لاستهلاك المزيد من الإشعارات","answer":"C","topic_question_no":10},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"مثل تأسيس علم النفس الإيجابي على يد مارتن سليجمان عام 1998 نقلة نوعية في تاريخ التخصص، حيث تجاوز الهدف التقليدي المتمثل في .إصلاح العيوب ومجرد التعافي من الأمراض. ليصل إلى هدف أسمى وأعمق يتمثل في","A":"أ) استخدام الحيل الدفاعية للهروب من الواقع المؤلم وتخيل واقع مثالي بديل","B":"ب) الدراسة العلمية لنقاط القوة والفضائل التي تمكن الأفراد والمجتمعات من الازدهار وتحقيق أعلى مستويات الرفاه","C":"ج) إلغاء الفروق الفردية الوراثية وتوحيد سمات الشخصية لضمان انسجام اجتماعي مثالي","D":"د) الاعتماد الكلي على الشعارات التحفيزية السطحية وتجاهل المنهجية العلمية والقياسات العصبية","answer":"B","topic_question_no":11},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"وفقاً لنموذج سليجمان للازدهار النفسي (PERMA)، عندما يصل الجراح إلى قمة تركيزه أثناء عملية دقيقة، أو يغوص الرسام في تفاصيل لوحته لدرجة ينفصل فيها تماماً عن القلق وينسى مرور الوقت وما يحيط به، فإنه يعيش حالة يصفها النموذج بـ","A":"أ) الإنـجاز وتحقيق الأهداف المادية البحتة للحصول على التقدير الخارجي","B":"ب) المعنى والإحساس برسالة تخدم غاية إنسانية كبرى تتجاوز المنفعة الذاتية اللحظية","C":"ج) الاندماج (حالة التدفق Flow) والاستغراق الكامل في المهارة","D":"د) المشاعر الإيجابية العابرة كالفرح السطحي وتذوق الجمال المؤقت في اللوحة أو المشرط","answer":"D","topic_question_no":12},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"يشعر شاب بالضياع والاكتئاب رغم نـجاحه المهني وتوفره المالي. بالعودة لنموذج (PERMA)، العنصر الجوهري المفقود الذي يجب أن يبحث عنه هذا الشاب ليحمي نفسه من الفراغ الوجودي ويشعر بأن لوجوده قيمة حقيقية تفوق متعته الشخصية هو عنصر","A":"أ) المشاعر الإيجابية التي يمكن تعويضها بالترفيه","B":"ب) المعنى (الإحساس برسالة تخدم قضية أكبر كالتطوع والدفاع عن الحقوق)","C":"ج) الاندماج في أنشطة روتينية لنسيان مشكلاته","D":"د) العلاقات السطحية العابرة لتمضية الوقت وتجنب الوحدة الخانقة","answer":"C","topic_question_no":13},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"فضيلة \"الاعتدال\" في علم النفس الإيجابي ليست مجرد كلمة، بل هي تدريب نفسي شاق ومستمر لكبح الاندفاعات الغريزية. تتجسد هذه الفضيلة عملياً من خلال ممارسات مثل","A":"أ) الجرأة في قول الحق، والمثابرة وقت الشدائد، والصراحة القاسية دون مراعاة للمشاعر","B":"ب) التسامح، التواضع ونكران الذات، الحذر والتروي قبل الحكم، والتنظيم الذاتي الصارم للرغبات","C":"ج) تذوق الجمال الفني، وممارسة الامتنان العميق، والتمسك الدائم بالأمل التفاؤلي المفرط","D":"د) الإبداع، الفضول، التفكير الناقد، وبعد النظر في التعامل مع المعطيات الرقمية الحديثة","answer":"B","topic_question_no":14},{"exam_id":"U5-COMPREHENSIVE","unit":5,"topic":"علم النفس الإيجابي: كيف أصنع به حياة أفضل؟","question":"\"القيادة الإيجابية\" لا تعني ضعف الإدارة أو تراخيها في تطبيق القوانين، بل هي نهج إداري متطور يحقق الازدهار والإنتاجية العالية للفريق عبر استراتيجيات محددة من أهمها","A":"أ) استخدام السلطة القهرية لضمان الطاعة العمياء وتسريع الإنـجاز في أوقات الأزمات الخانقة","B":"ب) تعزيز المنافسة السلبية بين الموظفين والاعتماد على المقارنات النقدية اللاذعة لاستبعاد الأضعف وتصفية الفريق","C":"ج) توفير رسالة ملهمة للعمل، الاحتفال بالإنـجازات الصغيرة، وخلق بيئة عادلة ومساحة آمنة نفسياً لا تخاف التجربة والخطأ","D":"د) كبت مشاعر الموظفين ومنع أي تواصل اجتماعي غير رسمي بينهم أثناء ساعات العمل لزيادة الاندماج والتدفق المهني","answer":"D","topic_question_no":15}],"U6-COMPREHENSIVE":[{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"وفقاً لتعريف \"جوردون ألبورت\" لـ علم النفس الاجتماعي كجسر يربط بين الفرد والمجتمع، فإن المحور الأساسي الذي تنطلق منه كافة دراسات هذا العلم هو الإيمان الراسخ بأن","A":"أ) الفرد يولد مزوداً بخبرات اجتماعية جاهزة تغنيه عن الاحتكاك بالبيئة المحيطة","B":"ب) الإنسان كائن الاجتماعي لا يمكن تفسير أو فهم سلوكه الفردي بمعزل عن تأثير الناس المحيطين به والتفاعل المتبادل معهم","C":"ج) المجتمع يمثل كياناً مستقلاً لا يتأثر بأي شكل من الأشكال بمبادرات الأفراد أو إنـجازاتهم الخاصة","D":"د) العوامل البيولوجية والفسيولوجية هي المحرك الوحيد للسلوك بمعزل عن قوانين المجتمع وعاداته","answer":"B","topic_question_no":1},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"يعيش طالب عربي في دولة أجنبية للدراسة، ورغم عدم وجود أسرته أو أصدقائه حوله، فإنه يمتنع تماماً عن القيام ببعض التصرفات المرفوضة في بلده الأم، متمسكاً بعاداته وقيمه الوطنية. نوع التأثير الاجتماعي الذي يوجه سلوك هذا الطالب يعرف بـ","A":"أ) الحضور الفعلي (وجهاً لوجه)","B":"ب) الحضور المتخيل لرد فعل المعلم","C":"ج) الحضور الضمني أو الرمزي للمجتمع والقيم","D":"د) التأثير البيولوجي للاستعداد الانفعالي","answer":"C","topic_question_no":2},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"أثناء نقاش رياضي، عرّف أحد المشجعين نفسه بحماس شديد قائلاً: \"نحن أبناء النادي العريق الذي لا يعرف الهزيمة\"، متجاهلاً ذكر اسمه أو مهنته الشخصية. هذا الجزء من مفهوم الذات الذي يستمده الفرد من الانتماء لمجموعة وما يرافقه من دلالة انفعالية يعرف بـ","A":"أ) الهوية الفردية المستقلة","B":"ب) الاتجاه السلوكي والعملي","C":"ج) الهوية الاجتماعية (حسب هنري تاجفل)","D":"د) المكون المعرفي للاتجاهات","answer":"C","topic_question_no":3},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"تقدم شاب لشغل وظيفة إدارية، ولاحظ مدير الموارد البشرية أن الشاب يتحدث بطلاقة وتأنق شديد في اختيار مفرداته. بناءً على هذه الملاحظة الجيدة فقط، قرر المدير أن الشاب يتمتع أيضاً بالأمانة العالية والقدرة الممتازة على إدارة الأزمات المالية. الخطأ الإدراكي الذي وقع فيه المدير هو","A":"أ) خطأ العزو (تفسير أسباب السلوك)","B":"ب) تأثير الهالة (التعميم الأعمى لسمة بارزة)","C":"ج) القولبة أو الصور النمطية بناءً على المهنة","D":"د) التحيز التأكيدي للخبرات السابقة","answer":"B","topic_question_no":4},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"فشل موظف في تسليم مشروعه في الوقت المحدد، فعزا ذلك إلى \"بطء أجهزة الشركة وسوء بيئة العمل\". في المقابل، عندما تأخر زميله في تسليم مشروعه، اتهمه الموظف الأول بأنه \"شخص مستهتر وكسول بطبعه\". هذا التناقض في التفسير يجسد إحدى التحيزات الذهنية وهي","A":"أ) فرضية الاحتكاك","B":"ب) التحيز التأكيدي","C":"ج) خطأ العزو","D":"د) الصور النمطية","answer":"C","topic_question_no":5},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"لتقليل التحيز والصراع بين فريقين في العمل، قررت الإدارة دمج أعضاء الفريقين معا. وفقاً لـ \"فرضية الاحتكاك\" لـ ألبورت، لكي ينـجح هذا التفاعل المباشر في إزالة التحيزات، فإنه يشترط بالضرورة توفر","A":"أ) سلطة قهرية تجبر أحد الفريقين على التنازل عن آرائه للفريق الآخر","B":"ب) تكافؤ المكانة بين الأعضاء، والسعي لتحقيق أهداف مشتركة بدعم من مؤسسة العمل","C":"ج) تركيز الإدارة على إبراز الأخطاء الفردية لتصحيحها علناً","D":"د) اعتماد كل فريق على الصور النمطية الإيجابية بدلاً من السلبية","answer":"B","topic_question_no":6},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"الاتجاه النفسي يتكون من بناء متكامل (معرفي، وجداني، سلوكي). إذا كان شخص يمتلك معلومات دقيقة حول أضرار التدخين (الشق المعرفي)، وقرر فعلياً الانضمام لحملة توعية ضده (الشق السلوكي)، فإن الشق (الوجداني) المكمل لهذا الاتجاه يتمثل في","A":"أ) قراءة المزيد من الأبحاث الطبية حول أمراض الرئة","B":"ب) الشعور الداخلي بالنفور أو الكراهية العميقة لرائحة وعادة التدخين","C":"ج) جمع التبرعات لعلاج مرضى التدخين","D":"د) تذكر ردود أفعال والديه الغاضبة من التدخين (حضور متخيل)","answer":"B","topic_question_no":7},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"يحذر علماء النفس من خطورة \"التحيز التأكيدي\" عند تكوين الانطباعات عن الآخرين. يتجلى هذا التحيز المدمر عندما يقوم الفرد بـ","A":"أ) التقاط وتذكر المواقف التي تؤكد انطباعه السلبي الأول فقط، وتجاهل أي مواقف لاحقة تثبت إخلاص وتعاون الشخص","B":"ب) تصنيف جميع الأفراد من منطقة جغرافية معينة في قالب جامد ووحيد","C":"ج) تعميم صفة الأناقة لتشمل صفات الذكاء والأمانة","D":"د) تفسير أخطائه الشخصية بأسباب خارجية بحتة لتجنب اللوم","answer":"A","topic_question_no":8},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"رفض مدير شركة توظيف شاب قروي في وظيفة مكتبية متقدمة، مبرراً ذلك في نفسه بأن \"أبناء القرى لا يمتلكون المرونة الكافية لمجاراة سرعة العمل المكتبي التكنولوجي\"، متجاهلاً السيرة الذاتية الممتازة للشاب. الخطأ الإدراكي الذي أعمى المدير هنا هو","A":"أ) تأثير الهالة","B":"ب) القولبة (الصور النمطية)","C":"ج) خطأ العزو","D":"د) المكون الوجداني للاتجاه","answer":"B","topic_question_no":9},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"عند محاولة تغيير اتجاهات سلبية عميقة ومترسخة (كاحتقار مهنة يدوية معينة)، أثبتت الدراسات الاجتماعية أن الاكتفاء بتقديم المحاضرات النظرية والأرقام (تغيير البنية المعرفية) لا يكفي غالباً، بل يجب تعزيزه بقوة من خلال","A":"أ) الاعتماد على الحضور الضمني للعادات والتقاليد القديمة لإجبار الأفراد على التغيير","B":"ب) الاتصال المباشر والتجربة الميدانية لدمج الشباب وإزالة الصورة النمطية بالاحتكاك الحي","C":"ج) استخدام حيلة \"الإسقاط\" النفسي لاتهام المجتمع بالجهل","D":"د) تجاهل المكون السلوكي والتركيز حصراً على الشق المعرفي فقط","answer":"B","topic_question_no":10},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"باحث مهتم بدراسة التغيرات التي طرأت على أسلوب استهلاك الأفراد بعد صدور قوانين بيئية جديدة في الدولة، وفي نفس الوقت يدرس كيف أدت مبادرات هؤلاء الأفراد ومقاطعتهم لبعض السلع إلى إجبار الشركات على تغيير سياساتها. هذا الباحث يطبق المفهوم الدقيق لعلم النفس الاجتماعي كما صاغه جوردون ألبورت والذي يرتكز على","A":"أ) استخدام منهج الاستبطان لوصف المشاعر الاستهلاكية الفردية","B":"ب) تحليل العمليات البيولوجية الدماغية أثناء اتخاذ قرار الشراء","C":"ج) التفاعل المتبادل؛ كيف يُشكل المجتمع سلوك الإنسان، وكيف يؤثر الإنسان في تطوير مجتمعه","D":"د) دراسة الدوافع اللاشعورية التي تحرك الأفراد لشراء السلع","answer":"C","topic_question_no":11},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"أثناء جلوسه وحيداً في غرفة لإجراء اختبار إلكتروني غير مراقب، فكر طالب في الغش، لكنه تذكر فجأة نظرة خيبة الأمل التي سترتسم على وجه والده إذا اكتشف الأمر، فتراجع فوراً واعتمد على نفسه. قوة المجتمع في ضبط سلوك هذا الطالب تحققت هنا عبر آلية","A":"الحضور الضمني للقيم الوطنية","B":"فرضية الاحتكاك والتفاعل المباشر","C":"الحضور المتخيل للآخرين","D":"الحضور الفعلي (وجهاً لوجه)","answer":"C","topic_question_no":12},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"في أول يوم عمل له في شركة أجنبية، ُسئل مهندس مصري عن نفسه، فبدأ حديثه بوصف تاريخ بلده العريق واعتزازه بثقافته وحضارته قبل أن يذكر مؤهلته الهندسية. هذا الجزء العميق من مفهوم ذاته والذي يحمل دلالة انفعالية وفخراً يُعرف علمياً بـ","A":"المكون السلوكي لالاتجاهات","B":"الهوية الفردية المستقلة","C":"الهوية الاجتماعية","D":"التأثير المعلوماتي المكتسب","answer":"C","topic_question_no":13},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"أثناء تقييم أداء المعلمين، لاحظ الموجه أن أحد المعلمين يمتلك صوتاً جهورياً وإلقاءً مسرحياً جذاباً جداً. بناءً على هذه الملاحظة، كتب الموجه في تقريره أن هذا المعلم يتميز بعمق المادة العلمية، والعدالة المطلقة بين الطلاب، والتنظيم الإداري الفائق. الخطأ الإدراكي الفادح الذي ارتكبه الموجه هنا هو","A":"خطأ العزو","B":"القولبة أو الصور النمطية","C":"التحيز التأكيدي","D":"تأثير الهالة (التعميم الأعمى)","answer":"D","topic_question_no":14},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الاجتماعي: كيف أفهم الآخرين؟","question":"طالب تأخر عن موعد تسليم بحثه، فذهب للأستاذ غاضباً وقال: مكتبة الجامعة كانت مغلقة، والمراجع غير متوفرة. وفي نفس اليوم، تأخر زميله في تسليم نفس البحث، فقال الطالب للأستاذ: زميلي هذا غير مبالٍ ولا يحب الدراسة أصلاً. هذه الازدواجية في التفسير تجسد حيلة إدراكية تُعرف بـ","A":"تأثير الهالة الإيجابية والسلبية","B":"خطأ العزو (تفسير أسباب السلوك)","C":"المكون المعرفي الخاطئ","D":"فرضية الاحتكاك المباشر","answer":"B","topic_question_no":15},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"عندما يدخل شخص إلى مطعم جديد كلياً ولا يعرف قواعد طلب الطعام فيه، فإنه يقف جانباً ليراقب ما يفعله الزبائن الآخرون ثم يقلدهم بدقة، ظناً منه أنهم يمتلكون المعرفة الصحيحة للنظام. هذا التغير التلقائي في السلوك يصنف علمياً كـ","A":"أ) طاعة عمياء لسلطة قهرية","B":"ب) امتثال مدفوع بـ \"التأثير المعلوماتي\" (الرغبة في الصواب عند الغموض)","C":"ج) تأثير معياري للبحث عن القبول الاجتماعي المتبادل","D":"د) انقياد ناتج عن غسيل دماغ خوارزمي في غرف الصدى","answer":"B","topic_question_no":1},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"يمتنع شاب عن ارتداء ملابس غريبة الأطوار في حفل زفاف تقليدي، رغم حبه الشديد لهذا النوع من الملابس، وذلك فقط ليتجنب نظرات الاستهجان والسخرية من الحاضرين وينال استحسانهم. الدافع الحقيقي خلف امتثال هذا الشاب هو","A":"أ) التأثير المعلوماتي الذي منحه دليلاً على الصواب","B":"ب) السلطة الجنائية والقانونية المنظمة للحفل","C":"ج) التأثير المعياري (الرغبة في التوافق وتجنب الرفض)","D":"د) التفكير النقدي الرقمي وقاعدة التوقف الانفعالي","answer":"C","topic_question_no":2},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"الفرق الجوهري الذي يفصل مفهوم \"الامتثال\" عن مفهوم \"الطاعة\" في ديناميكيات التأثير الاجتماعي، هو أن \"الامتثال\" يحدث استجابة لـ ()، بينما تحدث \"الطاعة\" استجابة لـ ()","A":"أ) أمر مباشر من سلطة أعلى / ضغط أفقي من أقران يساوونك في المكانة","B":"ب) رغبة في الابتكار الإبداعي / قواعد غير مكتوبة للثقافة","C":"ج) ضغط اجتماعي (حقيقي/متخيل) لتطابق المعايير دون أمر صريح / توجيه رأسي صريح من سلطة تمتلك قوة العقاب أو النظام","D":"د) تأثير اللاشعور والغرائز المكبوتة / التحيز التأكيدي للمعلومات","answer":"C","topic_question_no":3},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تُشكل \"جماعة الأقران\" قوة هائلة في صياغة هوية المراهق واستقلاليته. ويؤكد علماء النفس أن السر البيولوجي وراء خضوع الشاب لسطوة الأقران بقوة يرجع إلى أن","A":"أ) الأقران يمتلكون سلطة منح الدرجات الأكاديمية في المدرسة","B":"ب) الدماغ البشري يترجم \"رفض الأقران ونبذهم\" كألم نفسي يعادل ألم الإصابة الجسدية الفعلية","C":"ج) الأقران يعتمدون على التأثير المعلوماتي المبني على الحقائق العلمية دائماً","D":"د) التفاعل معهم يخلو من أي مشاعر عاطفية أو وجدانية ويقتصر على المعرفة","answer":"B","topic_question_no":4},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تتصفح إحدى المنصات الرقمية فتجد إعلاناً لمنتج عادي جداً، ولكن ما لفت انتباهك هو وجود \"مليون إعجاب ومائة ألف مشاركة\" تحت الإعلان، فشعرت فجأة برغبة في شرائه لا شعورياً لاعتقادك أن \"كل هؤلاء الناس لا يمكن أن يخطئوا\". الإستراتيجية النفسية المستخدمة لإقناعك هنا هي","A":"أ) الندرة والاستعجال","B":"ب) السلطة والخبرة العلمية","C":"ج) التخصيص الخوارزمي الموجه","D":"د) الدليل الاجتماعي (الكثرة الوهمية)","answer":"D","topic_question_no":5},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"عبارات تومض باللون الأحمر على شاشة الحجز الإلكتروني مثل: \"الفرصة الأخيرة! تبقى مقعدان فقط وينتهي العرض خلال 5 دقائق!\". تعتمد هذه المنصات على أسلوب الإقناع بالندرة والاستعجال بهدف مباشر وهو","A":"أ) بناء دليل اجتماعي على مصداقية المنصة","B":"ب) منح المستهلك وقتاً أطول للتفكير النقدي والمقارنة","C":"ج) إثارة قلق التفويت (FOMO) لتعطيل المنطق ودفع الفرد لقرار انفعالي مندفع","D":"د) تعزيز الحضور الضمني للقيم المجتمعية الأصيلة","answer":"D","topic_question_no":6},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"\"غرف الصدى (Echo Chambers)\" هي إحدى أخطر الآليات التي تدمر العقل في الفضاء الرقمي، حيث تقوم الخوارزميات فيها بوظيفة خفية تتمثل في","A":"أ) حصر المستخدم في دوامة من المحتوى الذي يوافق آراءه المسبقة فقط، مما يمنع تعرضه لآراء متباينة ويرسخ التعصب الأعمى","B":"ب) تعريض المستخدم باستمرار لآراء المعارضة لاستفزازه وتطوير مرونته النفسية","C":"ج) كشف زيف المعلومات المضللة وتزويد المستخدم بالحقائق والأرقام الموثقة","D":"د) دفع المستخدم لممارسة القراءة المتقاطعة من مصادر محايدة لتقليل التحيز","answer":"A","topic_question_no":7},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تشير الدراسات إلى أن \"الأخبار المزيفة والمضللة\" تنتشر بسرعة النيران في الهشيم مقارنة بالحقائق المملة. الآلية النفسية والعصبية الأولى التي تقف خلف هذا الانتشار المرعب هي","A":"أ) الفلترة الذهنية المعقدة للمحتوى قبل النشر","B":"ب) الاستثارة العاطفية الفائقة (مخاطبة الغضب أو الخوف لتعطيل القشرة المخية المنطقية ودفع الفرد للمشاركة الفورية)","C":"ج) الاعتماد على البحث الأفقي وتعدد المصادر لتأكيد الخبر","D":"د) غياب أي تفاعل وجداني أو عاطفي في صياغة الشائعات","answer":"B","topic_question_no":8},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"كثرة تكرار ظهور كذبة معينة أو شائعة سخيفة من عدة حسابات مختلفة في نفس اليوم، تجعل العقل البشري يميل لا شعورياً لتصديقها وتقبلها مع مرور الوقت. تُعرف هذه الظاهرة النفسية المعرفية بـ","A":"أ) أثر الألفة ووهم الحقيقة (كثرة التكرار تجعل الكذب مألوفاً)","B":"ب) التوقف الانفعالي وفصل العاطفة عن الدليل","C":"ج) التفكير النقدي الرقمي لتفنيد الشائعات","D":"د) تأثير التأثير المعلوماتي في المواقف الواضحة تماماً","answer":"A","topic_question_no":9},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"الخطوة الأولى والأهم في درع \"التفكير النقدي الرقمي\" لحماية الوعي من الاستفزاز والخداع هي تطبيق (قاعدة العشر ثوانٍ). وتعني هذه القاعدة عملياً ما يلي","A":"أ) قراءة الخبر كاملاً في عشر ثوانٍ ثم مشاركته لدعم الدليل الاجتماعي","B":"ب) التوقف الانفعالي فوراً وفصل العاطفة وعدم المشاركة المندفعة لأي خبر يستفز الغضب أو الخوف قبل التفكير","C":"ج) التأكد من عدد الإعجابات التي حصدها الخبر خلال أول عشر ثوانٍ من نشره","D":"د) البحث عن المستفيد المادي من الإعلان خلال فترة زمنية قصيرة لضمان سرعة الاستجابة","answer":"B","topic_question_no":10},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"سائح أجنبي يسير في شوارع القاهرة لأول مرة، ولاحظ أن الناس يتوقفون فجأة وينظرون جميعاً في اتجاه واحد نحو السماء. رغم عدم فهمه لما يحدث، توقف السائح ونظر معهم إلى السماء، معتقداً أن هؤلاء المحليين يمتلكون فكرة عما يجري وأنه من الصواب تقليدهم. هذا التغير التلقائي في سلوكه يرجع إلى","A":"أ) التأثير المعياري للبحث عن القبول.","B":"ب) التأثير المعلوماتي (الدافع المعرفي الفطري للبحث عن الصواب في المواقف الغامضة).","C":"ج) الطاعة العمياء لرجال إنفاذ القانون.","D":"د) تأثير الهالة الإيجابية للمارة.","answer":"B","topic_question_no":11},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"في أول أيام عمله، لاحظ موظف جديد أن جميع زملائه في القسم يستخدمون مصطلحات أجنبية معينة أثناء حديثهم رغم أن لغتهم الأم العربية. ورغم كراهيته لهذا الأسلوب، بدأ في استخدام نفس المصطلحات تجنباً لسخريتهم ولضمان اندماجه في فريقهم. يُفسر هذا السلوك في علم النفس بـ","A":"أ) التأثير المعلوماتي الذي يمنحه دليلاً معرفياً.","B":"ب) الطاعة القانونية والأخلاقية لقواعد المؤسسة.","C":"ج) الامتثال الناتج عن \"التأثير المعياري\" (الرغبة في التوافق وتجنب الرفض).","D":"د) التفكير النقدي الرقمي وتفكيك المصالح.","answer":"C","topic_question_no":12},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"\"عندما تمتثل، فأنت تتأثر بضغط أفقي من أقران يساوونك في المكانة. وعندما تطيع، فأنت تتأثر بتوجيه رأسي من سلطة تمتلك حق العقاب\". هذا التمييز الجوهري يوضح أن الامتثال غالباً ما يكون ، بينما الطاعة غالباً ما تكون","A":"أ) بأمر صريح ومباشر / استجابة لضغط اجتماعي غير مرئي.","B":"ب) استجابة لضغط اجتماعي حقيقي أو متخيل دون أمر صريح / تنفيذاً لتعليمات مباشرة صادرة عن جهة عليا.","C":"ج) للتهرب من القوانين الأخلاقية / للبحث عن القبول الاجتماعي المتبادل.","D":"د) نابعاً من اللوزة الدماغية السريعة / نابعاً من القشرة المخية المنطقية.","answer":"B","topic_question_no":13},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"دراسة سيكولوجية أثبتت أن استبعاد الشاب من مجموعة أصدقائه على منصات التواصل يؤدي إلى إضاءة مراكز الألم في الدماغ تماماً كما يحدث عند تعرضه لحرق في يده. يفسر هذا الاكتشاف البيولوجي لماذا تمتلك \"جماعة الأقران\" سطوة هائلة تجعل المراهق","A":"أ) يمتثل لمعايير الأقران حتى ولو كانت خاطئة (صحبة الهدم) لتجنب ألم العزلة والنبذ.","B":"ب) يميل للطاعة العمياء للقوانين المرورية والمدنية في بلده.","C":"ج) يستخدم \"التوقف الانفعالي\" قبل الموافقة على آراء المجموعة.","D":"د) يتجاهل الدليل الاجتماعي ويتبع السلطة والخبرة الحقيقية فقط.","answer":"A","topic_question_no":14},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"التأثير الاجتماعي: كيف يغير العالم الرقمي أفكاري؟","question":"تضع بعض المواقع الإلكترونية عداداً يظهر للمتسوق أن \"500 شخص يشاهدون هذه السلعة الآن، و10 ألف قاموا بشرائها اليوم\". الهدف النفسي الخفي (الخوارزمي) من هذا العداد هو شل تفكير المتسوق المنطقي وإقناعه من خلال الاعتماد على استراتيجية","A":"أ) التخصيص الخوارزمي الموجه للفرد.","B":"ب) السلطة المعنوية للمشاهير.","C":"ج) الدليل الاجتماعي (الكثرة الوهمية لإيهام الفرد بتوافق الأغلبية).","D":"د) القراءة المتقاطعة وتعدد المصادر.","answer":"C","topic_question_no":15},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"المراهق الذي ينشأ في أسرة تقدر تراثها ووطنها، يطور شعوراً عميقاً بكلمة \"نحن\"، ويمتلك إجابة واضحة عن سؤال \"إلى أي مجتمع وثقافة أنتمي؟\". يُمثل هذا الجانب في علم نفس النمو مفهوم","A":"الهوية الفردية والبصمة الشخصية المستقلة","B":"الهوية الاجتماعية (جذور الانتماء)","C":"البصمة الرقمية والواجهة المفلترة","D":"التأثير المعلوماتي التلقائي","answer":"B","topic_question_no":1},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"يعتقد بعض الآباء خطأ أن تشبث أبنائهم بالعادات الثقافية الوطنية القديمة سيمنعهم من اكتساب المهارات الحديثة والإبداع الفردي في مجالات البرمجة أو الفنون. الرد العلمي على هذا الاعتقاد يكمن في إثبات حقيقة \"التكامل الديناميكي\"، والذي ينص على أن","A":"أ) الهوية الفردية تتطلب بالضرورة ذوبان الشاب في مجتمعات افتراضية أجنبية للتخلص من التخلف الثقافي","B":"ب) اعتزاز الشاب بهويته الثقافية يمنحه أرضية صلبة وأماناً وجدانياً يعزز ثقته لتطوير بصمته الفردية وإبداعه دون صراع أو اغتراب","C":"ج) الإبداع الفردي لا يمكن أن ينمو إلا بالتمرد الكامل على ثقافة المجتمع الأصلي والانعزال عنه","D":"د) الهوية الاجتماعية تلغي الفروق الفردية تماماً لصالح الأغلبية","answer":"B","topic_question_no":2},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"\"الحاجة إلى الانتماء\" ليست مجرد رغبة تكميلية، بل هي حاجة فطرية ونفسية أولية. من أخطر العواقب النفسية التي تصيب الشاب الذي يفشل في تحقيق أي شكل من أشكال الانتماء الإيجابي (سواء للأسرة أو الأصدقاء أو الفرق الرياضية)","A":"أ) اكتمال بناء الهوية الاجتماعية والاعتماد التام على الذكاء الشخصي","B":"ب) انخفاض حاد في التقدير الذاتي، والشعور بالعزلة القاتلة، والاغتراب الاجتماعي الذي قد يدفعه للانحراف","C":"ج) الوصول السريع إلى حالة (التدفق Flow) في أي مهارة يمارسها بمفرده","D":"د) تطور مذهل في قدرات التفكير التباعدي والإبداع بسبب الهدوء","answer":"B","topic_question_no":3},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"مجموعة افتراضية مغلقة على الإنترنت تدعو أعضاءها للتنمر على زملائهم من المدارس الأخرى، وتعتبر أن أي فرد ينتقد أفعالهم هو خائن يجب إقصاؤه. يوفر هذا الكيان للمراهقين إحساساً بالانتماء، ولكنه يُصنف علمياً بأنه","A":"أ) تطبيق عملي لاستراتيجية \"المرونة النفسية\" في مواجهة الضغوط المدرسية","B":"ب) انتماء سلبي تعصبي يمثل أداة هشاشة وتعبية عمياء تلغي إعمال العقل وتغذي الكراهية","C":"ج) تكامل ديناميكي بين الهوية والفردية","D":"د) انتماء إيجابي بناء يعتمد على التكافل المجتمعي","answer":"B","topic_question_no":4},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"تُتيح أدوات تصفية الصور (الفالتر) والذكاء الاصطناعي للمراهق تصميم \"ذات افتراضية\" خالية تماماً من عيوبه الجسدية وحياته البسيطة. الخطر النفسي المدمر (صراع الهوية) يبدأ عندما","A":"أ) ينـجح المراهق في تحويل هذه الذات الافتراضية إلى مصدر للإلهام والتعليم الذاتي","B":"ب) يطبق المراهق مهارة \"التطابق والشفافية\" لحماية البصمة الرقمية للمجتمع","C":"ج) يقتنع المراهق بأن واجهته الافتراضية أصبحت حقيقته، وتتسع الفجوة بينها وبين ذاته الواقعية المليئة بالعيوب، مما يصيبه بالاغتراب والخوف من مواجهة الناس لئلا تُكشف حقيقته","D":"د) تتطابق هذه الذات الافتراضية تماماً مع الذات الواقعية في كل التفاصيل","answer":"C","topic_question_no":5},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"\"ربط القيمة الإنسانية وثقة الشاب بنفسه بـ (عداد الإعجابات) ومعدل التفاعل اللحظي على منشوراته\". هذه الآلية الخبيثة التي تعتمد على استغلال هرمون (الدوبامين) تؤدي بالمراهق إلى حالة من","A":"أ) الاستقلالية في اتخاذ القرارات بعيداً عن ضغط الأقران والمجتمع","B":"ب) الكفاءة الاجتماعية والقدرة على بناء علاقات دافئة ومستقرة في الحياة الواقعية","C":"ج) الصلابة النفسية العميقة التي تحميه من التنمر وتجاهل الآخرين له","D":"د) الهشاشة الرقمية، حيث يصبح مسلوب الإرادة، ترتفع معنوياته بضغطة زر وتنهار حياته إذا تم تجاهله رقمياً","answer":"D","topic_question_no":6},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"فتاة بسيطة تتابع يومياً حسابات لعارضات أزياء يعشن في قصور فارهة ويقضين أوقاتهن في رحلات باهظة التكاليف حول العالم. النتيجة النفسية لهذه المتابعة المستمرة هي شعور الفتاة الدائم بالتعاسة والنقص والتمرد على أهلها. هذا التأثير السلبي يُعرف في نظرية \"ليون فيستنـجر\" بـ","A":"الدليل الاجتماعي الإيجابي للتحفيز المادي","B":"المقارنة الاجتماعية الهابطة لزيادة الغرور","C":"المقارنة الاجتماعية الصاعدة (النظر للأفضل حالاً باستمرار مما يولد الإحباط)","D":"التفريد المعرفي والتعلم المستقل من تجارب الآخرين","answer":"C","topic_question_no":7},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"من أكثر الأخطاء الإدراكية فداحة في عصر السوشيال ميديا ظاهرة \"خداع المقارنة\". يقع الشاب في هذا الخداع السيكولوجي القاسي عندما يقوم بـ","A":"أ) مقارنة المكون الوجداني لاتجاهاته بالمكون المعرفي للأحداث السياسية المحيطة به","B":"ب) مقارنة قدراته الحركية والرياضية بقدرات زملائه ذوي الذكاء اللغوي لتحديد التخصص الجامعي","C":"ج) مقارنة كواليس حياته الواقعية المليئة بالجهد والملل والإخفاقات، بالواجهة المثالية المبرمجة للآخرين والتي صُممت لإخفاء تعبهم وعرض لحظات النـجاح فقط","D":"د) مقارنة إنـجازاته اليوم بإنـجازاته في العام الماضي لقياس مدى تقدمه (المقارنة الطولية السوية)","answer":"C","topic_question_no":8},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"لبناء هوية راسخة ومستقرة في خضم العواصف الرقمية، يقترح علم النفس تطبيق قاعدة \"التطابق والشفافية\". التطبيق العملي والصحي لهذه القاعدة يتمثل في أن يمتلك الفرد شجاعة","A":"أ) تقليد أنماط حياة المشاهير بمهارة فائقة ليثبت قدرته على الاندماج في الثقافة العالمية الحديثة","B":"ب) الانعزال التام عن أي تفاعل رقمي وإلغاء جميع حساباته الافتراضية هرباً من المقارنة","C":"ج) إنشاء حسابات وهمية متعددة ليعبر عن آراء مختلفة دون أن يُحاسب على أي منها","D":"د) إلغاء المسافة الشاسعة بين الواقع والشاشة بالصدق التام، وعدم ادعاء مثالية مزيفة أو ارتداء أقنعة لحصد إعجابات لا تمثل حقيقته الفعلية","answer":"D","topic_question_no":9},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"عند تحليل \"صراع الهوية والمبادئ\" الذي يواجهه المراهق بين تأثير الأقران السلبيين وبين توجيهات أسرته، فإن المهارة النفسية الحاسمة (الصلابة النفسية) تتجلى عندما يمتلك المراهق القدرة والجرأة على","A":"أ) الطاعة العمياء لآراء زعيم الشلة (القائد المباشر) لتجنب العزلة","B":"ب) استخدام التخفي الرقمي لممارسة السلوكيات الخاطئة دون علم أسرته لتقليل الصدام","C":"ج) تقديم تبريرات منطقية لأسرته ليسمحوا له بمسايرة القطيع مؤقتاً","D":"د) قول \"لا\" والتمسك بمبادئه ورفض مسايرة القطيع المفسد رغم التهديد بالنبذ","answer":"D","topic_question_no":10},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"أي شق من الهوية يجيب بصورة أساسية عن سؤال «ما الذي يميزني كإنسان؟»؟","A":"الهوية الاجتماعية المرتبطة بالجماعة والثقافة","B":"الهوية الفردية التي تعبر عن خصائص الشخص ومهاراته المميزة","C":"البصمة الرقمية الناتجة عن استخدام الإنترنت","D":"التأثير المعياري الذي تمارسه الجماعة","answer":"B","topic_question_no":11},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"ما النتيجة النفسية المتوقعة عندما يجمع الشاب بين اعتزازه بثقافته واستقلاله في التفكير والإبداع؟","A":"يتحول الانتماء بالضرورة إلى تعصب","B":"يفقد قدرته على تكوين هوية فردية","C":"يحصل على أرضية من الأمان والانتماء تساعده على تطوير هويته الفردية","D":"يصبح غير قادر على التفاعل مع الثقافات الأخرى","answer":"C","topic_question_no":12},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"أي موقف يمثل انتماءً إيجابيًا صحيًا؟","A":"الطاعة العمياء للجماعة ورفض كل رأي مخالف","B":"الاعتزاز بالجماعة مع احترام الآخرين والعمل لتحقيق هدف مشترك","C":"إقصاء المختلف لحماية هوية الجماعة","D":"ربط قيمة الفرد بالكامل بقبول أعضاء الجماعة له","answer":"B","topic_question_no":13},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"فشل المراهق المستمر في تكوين انتماء إيجابي قد يرتبط أكثر بـ:","A":"ارتفاع التقدير الذاتي تلقائياً","B":"العزلة والاغتراب وانخفاض التقدير الذاتي","C":"زيادة الاستقلالية دون أي ضغوط","D":"اختفاء الحاجة إلى العلاقات الاجتماعية","answer":"B","topic_question_no":14},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"هويتي وانتمائي","question":"ما الفرق الأساسي بين الهوية الفردية والهوية الاجتماعية؟","A":"الفردية تتعلق بما يميز الشخص، والاجتماعية تتعلق بإحساسه بالانتماء إلى جماعات وثقافات","B":"الفردية رقمية والاجتماعية بيولوجية","C":"الفردية ثابتة تماماً والاجتماعية مؤقتة دائماً","D":"لا يوجد فرق بينهما","answer":"A","topic_question_no":15},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"تفتقر بيئة التواصل الرقمي (الدردشات النصية) إلى \"الإشارات غير اللفظية\" التي نعتمد عليها في التواصل المباشر (مثل لغة الجسد، نظرة العين، ونبرة الصوت). هذا النقص الجوهري في بيئة الإنترنت يؤدي غالباً إلى","A":"أ) نقل المعاني والمشاعر بوضوح ودقة متناهية لا تقبل التأويل","B":"ب) تكرار سوء الفهم بين المستخدمين وتفسير الكلمات أو الرموز الجامدة بمحمل عدائي وخاطئ","C":"ج) زيادة مستوى التعاطف الوجداني العميق وتبادل المشاعر الصادقة بعيداً عن التشويش المادي","D":"د) تعزيز مهارات التواصل الفعال وتقليل الحاجة إلى مهارة الاستماع الجيد","answer":"B","topic_question_no":1},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"يفرض التواجد المباشر (وجهاً لوجه) في المجتمع الواقعي التزاماً بالمعايير الأخلاقية خوفاً من المساءلة أو الإحراج. أما في الفضاء الرقمي، فإن إمكانية التخفي وراء الحسابات الوهمية تسهل على الفرد الإساءة للآخرين بلا رادع. تُعرف هذه الظاهرة النفسية الخطيرة بـ","A":"أ) الانفصال الاستراتيجي الواعي من ضغوط العمل لتنظيف الجهاز العصبي","B":"ب) فك الارتباط الأخلاقي والتحلل من الرقابة بسبب التخفي وانعدام المواجهة المباشرة","C":"ج) التفريد المعرفي الذي يتيح للفرد اختبار قدراته بعيداً عن أقرانه","D":"د) الاستقلالية الكاملة للهوية الفردية وتصالح الذات الداخلي بمعزل عن القوانين","answer":"B","topic_question_no":2},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"من أبرز الخصائص التي تجعل التنمر أو الإساءة في الفضاء الافتراضي أشد قسوة وتدميراً من الإساءة في الواقع الميداني، أن السلوك الرقمي يبتسم بـ:","A":"أ) ينتهي أثره النفسي المزعج بمجرد انصراف الحاضرين أو انتهاء النقاش اللفظي في نفس اللحظة.","B":"ب) يخترق الحدود المكانية والزمانية، فالمنشور يصل للملايين بسرعة فائقة ويظل محفوظاً لسنوات (البصمة الدائمة).","C":"ج) يكون دائماً مدعوماً بتغذية راجعة فورية ورؤية واضحة لألم الضحية مما يوقف المتنمر فوراً.","D":"د) يعتمد كلياً على الإشارات غير اللفظية ولغة الجسد لتوصيل الإهانة بشكل غير مباشر ومهذب.","answer":"B","topic_question_no":3},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"شخص يقوم باستخدام منصات التواصل الاجتماعي باحترافية لتسويق منتجات يدوية محلية، ونشر ثقافة بلده الإيجابية للعالم، وإبراز قصص نـجـاح ذوي الإعاقات كشركاء تميز في مجتمعه. يعكس هذا الاستخدام الموجه للإنترنت الجانب الذي يوصف بـ:","A":"أ) المشرق والإيجابي (توظيف الأداة الجبارة لتعزيز الهوية ونشر المبادرات المجتمعية الإيجابية).","B":"ب) المظلم والسلبي (إعادة هندسة الذات المفلترة والتبعية العمياء للقطيع).","C":"ج) التعصبي الإقصائي (نبذ الآخر وتغذية الصراعات الثقافية).","D":"د) التخديري الاستهلاكي (الهروب من مواجهة الواقع عبر التصفح اللانهائي للترفيه).","answer":"A","topic_question_no":4},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"يعرّف علم النفس \"التنمر الرقمي\" بأنه سلوك عدواني، مقصود، ومتكرر عبر الوسائط لإيذاء وإحراج فرد لا يستطيع الدفاع عن نفسه. عند تحليل دوافع المتنمر، نـجد أنه لا يقوم بذلك لامتلاكه قوة حقيقية، بل غالباً لسعيه المريض خلف:","A":"أ) تطوير كفاءته الاجتماعية وبناء علاقات دافئة ومستدامة.","B":"ب) المكانة والشعبية الزائفة، أو الخضوع لضغط الأقران لتجنب نبذه، وإسقاط إحباطاته الشخصية كحيلة دفاعية.","C":"ج) تحقيق الرضا عن الهوية الشخصية والوصول لقمة الازدهار في خماسية سليجمان (PERMA).","D":"د) تعميق الفهم لرسائل التواصل الفعال وتطبيق مبدأ الاحترام المتبادل للاختلاف.","answer":"B","topic_question_no":5},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"من أشكال التنمر الرقمي الخبيثة التي تهدف إلى زيادة عزلة الضحية وتدمير شعورها بالانتماء، تعمد مجموعة من الطلاب طرد زميل لهم من المجموعات الدراسية الافتراضية (الجروبات) بشكل متكرر ومهين. يسمى هذا الشكل بـ:","A":"أ) التحرش اللفظي والصور التعبيرية الساخرة المباشرة.","B":"ب) الإقصاء والنبذ الافتراضي العمدي من المجموعات لفرض العزلة وتطبيق العقاب النفسي.","C":"ج) التشهير واختلاق الشائعات وتزييف الصور لتدمير السمعة المجتمعية.","D":"د) كسر الفقاعة الرقمية الموجه لفتح آفاق الحوار الإجباري وتقليل التحيز التأكيدي.","answer":"B","topic_question_no":6},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"طالب يتعرض لتهديد وابتزاز صريح من حساب مجهول يطالبه بتصرفات غير أخلاقية. درع الصلابة الرقمية ينصح بخطوات حاسمة للمواجهة. تتمثل الخطوة الأهم والأولى لعدم إعطاء المتنمر ما يريده في:","A":"أ) الدخول في حوار طويل ومحاولة استعطافه لتعديل بنيته المعرفية وإيقاظ ضميره.","B":"ب) التجاهل التام وعدم التغذية للانفعال (لأن المتنمر يتغذى على رؤية غضبك وضعفك).","C":"ج) حذف الحساب الشخصي للضحية فوراً ومحاولة إخفاء أي دليل لتجنب الفضيحة الاجتماعية.","D":"د) الرد بتهديد مماثل واستخدام صور مزيفة لإخافة المتنمر وإجباره على التراجع السريع.","answer":"B","topic_question_no":7},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"بعد تجاهل المتنمر، يجب على الضحية اتخاذ خطوة قانونية وميدانية حاسمة لمنع تمادي الإساءة، وتتمثل هذه الخطوة التوثيقية في:","A":"أ) أخذ لقطات شاشة (Screenshots) توثق التهديد كدليل قانوني ثابت، ثم حظر الحساب (البلوك) فوراً والإبلاغ.","B":"ب) نشر التهديد على الصفحة العامة ليقوم المتابعون بالرد على المتنمر وتطبيق الدليل الاجتماعي ضده.","C":"ج) استخدام الحيل الدفاعية كالتبرير النفسي لإقناع الذات بأن المتنمر يمزح ولا يقصد الإيذاء الفعلي.","D":"د) الخضوع المؤقت لمطالب المتنمر لكسب الوقت حتى يتدخل الخبراء في الأمن السيبراني.","answer":"A","topic_question_no":8},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"الإدمان الرقمي (الاستخدام القهري للشاشات) يشكل خطراً فسيولوجياً يبرمج الدماغ عبر إفراز مستمر لهرمون \"الدوبامين\". من أبرز الأعراض الجسدية المباشرة لهذا الإدمان التي تؤثر على جودة الحياة البيولوجية:","A":"أ) العزلة الانطوائية الشديدة داخل الأسرة وتراجع الاهتمام بالمشاركة في الأنشطة العائلية الجماعية.","B":"ب) الفشل المتكرر في تقليل ساعات التصفح، والتوتر والعصبية الشديدة كأعراض انسحابية نفسية عند انقطاع الإنترنت.","C":"ج) أرق مزمن ناتج عن منع الضوء الأزرق لإفراز هرمون النوم الطبيعي، إجهاد العين الحاد، وآلام العمود الفقري.","D":"د) الانهيار الملحوظ في جودة الأداء المدرسي وإهمال الواجبات المدرسية والمشاريع العلمية.","answer":"C","topic_question_no":9},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"يقترح الخبراء \"بروتوكول الانقطاع الرقمي\" كخطة تعافي من الإدمان. إحدى الخطوات الاستراتيجية الفعالة في هذا البروتوكول هي \"خلق مناطق خالية من الشاشات (حرم مقدس)\". الهدف التربوي والنفسي من هذه الخطوة تحديداً هو:","A":"أ) توفير بيئة هادئة لإجبار الدماغ على استخدام التفكير التباعدي المعقد لحل المشكلات طوال فترة التواجد بها.","B":"ب) إجبار الأسرة على النقاشات الحادة لتفريغ شحنات الغضب المكبوتة نتيجة ضغوط العمل والدراسة.","C":"ج) حماية الأوقات المخصصة للروابط العائلية الحقيقية (كطاولة الطعام) والراحة الجسدية العميقة (كغرفة النوم) من التشتت والاستنزاف الرقمي.","D":"د) قياس حجم الساعات الضائعة بدقة عبر استخدام تطبيقات المراقبة والمحاسبة الذاتية الصارمة.","answer":"C","topic_question_no":10},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"عندما يحدث خلاف بين صديقين \"وجهاً لوجه\"، يمكنهما قراءة ملامح بعضهما وملاحظة حزن الطرف الآخر وتدارك الموقف بلغة الجسد والنبرة الهادئة. في المقابل، تشتعل الخلافات وتصل للقطيعة في \"الدردشات النصية الرقمية\" بسرعة مرعبة بسبب","A":"أ) التدخل السريع لخوارزميات التطبيقات لحل النزاعات بين المستخدمين بطريقة الدليل الاجتماعي","B":"ب) ارتفاع مستوى \"الذكاء الوجداني الرقمي\" الذي يجعل الأصدقاء يبالغون في حساسيتهم تجاه بعضهم البعض لدرجة الانفصال","C":"ج) غياب \"الإشارات غير اللفظية\" (كالنبرة والملامح)، مما يجعل النصوص جامدة وعُرضة للتفسير السيء وبمحمل عدائي خاطئ دائماً","D":"د) وضوح الرسائل وتحديد الأهداف المشتركة بدقة متناهية في النصوص","answer":"C","topic_question_no":11},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"طالب يتميز بالأدب الشديد واحترام معلميه داخل الفصل الدراسي، ولكنه يستخدم حساباً وهمياً بلقب مستعار لشتم نفس المعلمين والسخرية منهم بأقذع الألفاظ على الإنترنت. يُطلق علم النفس على هذه الظاهرة الخطيرة (الناتجة عن التخفي الرقمي) مصطلح","A":"أ) التكامل الديناميكي بين الذات الواقعية المنضبطة والذات الافتراضية المتمردة لحفظ التوازن النفسي","B":"ب) الاستقلالية والهوية الفردية التي ترفض القيود المعيارية لثقافة المؤسسات التعليمية القمعية","C":"ج) فك الارتباط الأخلاقي والتحلل التام من الرقابة والضوابط المجتمعية لغياب المواجهة المباشرة والمحاسبة","D":"د) التفريد المعرفي الإبداعي والتفكير التباعدي غير المحدود","answer":"C","topic_question_no":12},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"إذا قام شخص بالاعتداء اللفظي على آخر في الشارع، فإن أثر الإهانة ينحصر في الحاضرين وينتهي بانصرافهم. لكن الإهانة أو التنمر في الفضاء الرقمي أشد قسوة وفتكاً بنفسية الضحية لأن السلوك الرقمي يتميز بـ","A":"أ) اعتماده كلياً على الإشارات غير اللفظية ولغة الجسد لتوصيل الإهانة بشكل غير مباشر ومهذب لا يجرح المشاعر بوضوح","B":"ب) قدرته السريعة على استثارة \"التعاطف الوجداني الفوري\" من قِبَل المتنمر بمجرد أن يرى تأثير منشوره على حساب الضحية ليتراجع فوراً","C":"ج) كونه مقتصراً على أفراد المجموعة المغلقة ولا يمكن لأي شخص خارجها الاطلاع عليه أبداً بفضل الحماية السيبرانية الفائقة","D":"د) اختراق الحدود المكانية والزمانية؛ فالمنشور المسيء ينتشر للملايين في لحظات، ويظل موثقاً ومحفوظاً (البصمة الدائمة التي تطارد الضحية)","answer":"D","topic_question_no":13},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"شخص يتنمر باستمرار على صور زملائه عبر الإنترنت ويُصمم صوراً ساخرة لهم. عند إخضاع هذا المتنمر للتحليل النفسي لاكتشاف دوافعه الحقيقية، نـجد أنه غالباً لا يتصرف بقوة حقيقية، بل تحركه دوافع مريضة أهمها","A":"أ) الرغبة في تعميق الفهم لرسائل التواصل الفعال وتطبيق مبدأ الاحترام المتبادل للاختلاف الفكري","B":"ب) السعي لتحقيق الرضا عن الهوية الشخصية والوصول لقمة الازدهار والاندماج (Flow) في نموذج سليجمان","C":"ج) السعي المريض للمكانة والظهور (شعبية مزيفة)، الخضوع لضغط الأقران لتجنب نبذه، وإسقاط إحباطاته وعقده الشخصية على الأضعف كحيلة دفاعية","D":"د) رغبته في تطوير كفاءته الاجتماعية وبناء حدود واضحة لعلاقاته المستقبلية","answer":"C","topic_question_no":14},{"exam_id":"U6-COMPREHENSIVE","unit":6,"topic":"سلوكي الرقمي","question":"طالب يجد نفسه فجأة مطروداً ومحذوفاً من كافة المجموعات الدراسية الافتراضية (جروبات الدفعة) بدون سبب واضح، وكلما أنشأ حساباً تم حظره وتجاهله من الجميع باتفاق مسبق. هذا الشكل القاسي من أشكال التنمر الرقمي والذي يهدف للتدمير النفسي يُسمى","A":"أ) كسر الفقاعة الرقمية الموجه لفتح آفاق الحوار الإجباري بالقوة الغاشمة وتقليل التحيز","B":"ب) التشهير واختلاق الشائعات وتزييف الصور الخاصة لتدمير السمعة المجتمعية","C":"ج) الإقصاء والنبذ الافتراضي المهين لفرض العزلة التامة وقطع روابط الانتماء للضحية","D":"د) التحرش اللفظي المباشر والصور التعبيرية الساخرة الموجهة للجسد","answer":"C","topic_question_no":15}]};

